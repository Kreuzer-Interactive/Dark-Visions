 023A   0092    '----- draw one slot's stats: Location + Progress%, or "- empty
                 -" for an unused slot.
 023A   0092    '----- Also records slUsed(slot). Progress mirrors GAME3 drawSt
                ats.
 023A   0092    SUB slDrawStat (slot AS INTEGER, sx AS INTEGER, sy AS INTEGER, 
                fontData() AS INTEGER)
 0245   0092            DIM f$, sq$, sdn$, stt$, sa$, slf$
 0245   0092            DIM scl AS SINGLE, spt AS SINGLE, sob AS INTEGER, j AS 
                INTEGER, pc AS INTEGER
 0245   0092            '----- wipe the stat area (covers a previous "- empty -
                " on refresh)
 0245   0092            LINE (sx - 1, sy - 1)-(sx + 56, sy + 12), 0, BF
 0245   0092            f$ = "saver" + CHR$(slot + 96) + ".pac"
 0245   0092            OPEN f$ FOR APPEND AS #2: CLOSE #2          ' ensure th
                e file exists (no truncate)
 0245   0092            OPEN f$ FOR INPUT AS #2
 0245   0092            IF EOF(2) THEN
 0245   0092                    slUsed(slot) = 0
 0245   0092                    CALL drawText(sx - 1, sy + 3, "- empty -", 2, f
                ontData())
 034F   0092                    CLOSE #2: EXIT SUB
 034F   0092            END IF
 035F   0092            slUsed(slot) = 1
 035F   0092            INPUT #2, sq$, scl, spt, sdn$, stt$, sa$, slf$
 0375   0092            pc = 0
 0375   0092            FOR j = 1 TO 65
 03DE   0092                    sob = 0: IF NOT EOF(2) THEN INPUT #2, sob
 040F   0092                    IF j <= 51 AND sob = 1 THEN pc = pc + 1
 042F   0092                    IF j = 35 AND sob = 1 THEN pc = pc + 2
 0450   0092                    IF j = 36 AND sob = 1 THEN pc = pc + 2
 0471   0092            NEXT j
 0480   0092            CLOSE #2
 0480   0092            pc = CINT(pc * 100 / 47)
 0480   0092            CALL drawText(sx - 1, sy - 1, slLoc$(sq$), 2, fontData(
                ))
 04E7   0092            CALL drawText(sx - 1, sy + 6, LTRIM$(STR$(pc)) + "% don
                e", 2, fontData())
 0543   0092    END SUB
