 0A28   0574                    IF mx >= 64 AND mx <= 152 THEN cs = r
 0A5A   0574                    IF mx >= 166 AND mx <= 254 THEN cs = r + 5
 0A82   0574                    IF cs > 0 AND cs <> sel THEN GOSUB erasecur4: C
