 05F6   00B8                    REDIM rgL(400) AS INTEGER
 0618   00B8                    OPEN "RING2.DAT" FOR INPUT AS #2
 0618   00B8                    INPUT #2, rgNL
 0636   00B8                    FOR i = 1 TO rgNL: INPUT #2, rgL(i): NEXT
 0684   00B8                    CLOSE #2
 0684   00B8                    rgOk = 1
 0684   00B8            END IF
 0697   00B8    
 0697   00B8            '----- mlb starts PRESSED so the click/keypress that op
                ened this screen
 0697   00B8            '----- doesn't re-register here
 0697   00B8            act = 0: done = 0: mlb = 1: cdrn = 0: dcs = 0: dct = 0
 0697   00B8            sel = 1: IF slLast >= 1 AND slLast <= 10 THEN sel = slL
                ast
 06E7   00B8            SCREEN 1
 06E7   00B8            GOSUB ssall
 06FD   00B8            IF msen = 1 THEN
 06FD   00B8                    mr.ax = 2: CALL INTERRUPT(mvint, mr, mo)
