                o): mx = 160: my = 100: GOSUB drawcur4
 0715   0574    
 0715   0574            slwait:
 0715   0574            IF msen = 1 THEN
 0715   0574                    mr.ax = 3: CALL INTERRUPT(mvint, mr, mo)
 0746   0574                    nmx = mo.cx \ 2: nmy = mo.dx
 0746   0574                    IF nmx > 312 THEN nmx = 312 ELSE IF nmx < 0 THE
                N nmx = 0
 0778   0574                    IF nmy > 192 THEN nmy = 192 ELSE IF nmy < 0 THE
                N nmy = 0
 0798   0574                    IF nmx <> mx OR nmy <> my THEN GOSUB erasecur4:
                 mx = nmx: my = nmy: GOSUB drawcur4
 07D5   0574                    IF (mo.bx AND 1) <> 0 AND mlb = 0 THEN GOSUB sl
                click
 07FE   0574                    mlb = (mo.bx AND 1)
 07FE   0574            END IF
 0807   0574            k$ = INKEY$
 0807   0574            IF k$ <> "" THEN GOSUB slkey
 0830   0574            IF done = 0 THEN GOTO slwait
 0839   0574            IF msen = 1 THEN GOSUB erasecur4
 0858   0574            EXIT SUB
 0858   0574    
 0858   0574            '----- (re)draw the whole screen: background, all slot 
                stats, the selector ring.
 0858   0574            '----- Used at startup and to wipe a confirm modal.
 0858   0574            drawall:
 085B   0574            DEF SEG = &HB800: BLOAD "SVLDBG.PIC", 0: DEF SEG
 085B   0574            PALETTE 1, 8: PALETTE 2, 7: PALETTE 3, 6
 085B   0574            IF dead = 1 THEN LINE (60, 170)-(106, 190), 0, BF: LINE
                 (214, 170)-(289, 190), 0, BF
 090A   0574            FOR i = 1 TO 10
 0910   0574                    IF i <= 5 THEN sx = 91: sy = 41 + (i - 1) * 21 
                ELSE sx = 193: sy = 41 + (i - 6) * 21
 093C   0574                    CALL slDrawStat(i, sx, sy, fontData())
 0950   0574            NEXT i
 095C   0574            CALL slRing(sel, 1)
 096E   0574            RETURN
 096E   0574    
 096E   0574            '----- mouse click: pick a slot, or fire a bottom butto
                n
 096E   0574            slclick:
 0973   0574            r = 0
 0973   0574            IF my >= 37 AND my <= 58 THEN r = 1
 099F   0574            IF my >= 59 AND my <= 79 THEN r = 2
 09C1   0574            IF my >= 80 AND my <= 100 THEN r = 3
