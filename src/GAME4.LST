 00F5   00B8    '----- map a saved room tag (q$) to a short location name shown
                 on the slot
 00F5   00B8    FUNCTION slLoc$ (rq AS STRING)
 0100   00B8            DIM hd$, nm$, q1 AS INTEGER, q2 AS INTEGER
 0100   00B8            IF rq = "" THEN
 0100   00B8                    slLoc$ = "?"
 0100   00B8            ELSEIF LEFT$(rq, 4) = "room" THEN
 0121   00B8                    nm$ = ""
 0121   00B8                    OPEN rq + ".pac" FOR INPUT AS #4
 0121   00B8                    LINE INPUT #4, hd$
 0170   00B8                    CLOSE #4
