 0A1D   00B8            rgo = 6: IF sel > 5 THEN rgo = 14
 0A30   00B8            GET (sgx1 - rgo, sgy1)-(sgx1 - rgo + 99, sgy2), srb
 0A30   00B8            FOR i = 1 TO rgNL
