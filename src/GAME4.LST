 0030   0006    '----- map a saved room tag (q$) to a short location name shown
                 on the slot
 0030   0006    FUNCTION slLoc$ (rq AS STRING)
 0040   0574            DIM hd$, nm$, q1 AS INTEGER, q2 AS INTEGER
 0040   0574            IF rq = "" THEN
 0040   0574                    slLoc$ = "?"
 0040   0574            ELSEIF LEFT$(rq, 4) = "room" THEN
 0061   0574                    nm$ = ""
 0061   0574                    OPEN rq + ".pac" FOR INPUT AS #4
 0061   0574                    LINE INPUT #4, hd$
 00B0   0574                    CLOSE #4
 00B0   0574                    q1 = INSTR(hd$, CHR$(34))
 00B0   0574                    IF q1 > 0 THEN
 00B0   0574                            q2 = INSTR(q1 + 1, hd$, CHR$(34))
 00B0   0574                            IF q2 > q1 + 1 THEN nm$ = MID$(hd$, q1 
                + 1, q2 - q1 - 1)
 0132   0574                    END IF
 0132   0574                    IF nm$ <> "" THEN slLoc$ = nm$ ELSE slLoc$ = "R
                oom " + MID$(rq, 5)
 0178   0574            ELSE
 017B   0574                    slLoc$ = rq
 017B   0574            END IF
 0187   0574    END FUNCTION
 01AA   0574    
 01AA   0574    '----- draw one slot's stats: Location + Progress%, or "- empty
                 -" for an unused slot.
 01AA   0574    '----- Also records slUsed(slot). Progress mirrors GAME3 drawSt
                ats.
 01AA   0574    SUB slDrawStat (slot AS INTEGER, sx AS INTEGER, sy AS INTEGER, 
                fontData() AS INTEGER)
 01B5   0574            DIM f$, sq$, sdn$, stt$, sa$, slf$
 01B5   0574            DIM scl AS SINGLE, spt AS SINGLE, sob AS INTEGER, j AS 
                INTEGER, pc AS INTEGER
 01B5   0574            '----- wipe the stat area (covers a previous "- empty -
                " on refresh)
 01B5   0574            LINE (sx - 1, sy - 1)-(sx + 53, sy + 12), 0, BF
 01B5   0574            f$ = "saver" + CHR$(slot + 96) + ".pac"
 01B5   0574            OPEN f$ FOR APPEND AS #2: CLOSE #2          ' ensure th
                e file exists (no truncate)
 01B5   0574            OPEN f$ FOR INPUT AS #2
 01B5   0574            IF EOF(2) THEN
 01B5   0574                    slUsed(slot) = 0
 01B5   0574                    CALL drawText(sx - 1, sy + 3, "- empty -", 2, f
                ontData())
 02BF   0574                    CLOSE #2: EXIT SUB
 02BF   0574            END IF
 02CF   0574            slUsed(slot) = 1
 02CF   0574            INPUT #2, sq$, scl, spt, sdn$, stt$, sa$, slf$
 02E5   0574            pc = 0
 02E5   0574            FOR j = 1 TO 65
 034E   0574                    sob = 0: IF NOT EOF(2) THEN INPUT #2, sob
 037F   0574                    IF j <= 51 AND sob = 1 THEN pc = pc + 1
 039F   0574                    IF j = 35 AND sob = 1 THEN pc = pc + 2
 03C0   0574                    IF j = 36 AND sob = 1 THEN pc = pc + 2
                                                                      PAGE   3
                                                                      06 Jul 26
                                                                      11:32:14
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 03E1   0574            NEXT j
 03F0   0574            CLOSE #2
 03F0   0574            pc = CINT(pc * 100 / 47)
 03F0   0574            CALL drawText(sx - 1, sy - 1, slLoc$(sq$), 2, fontData(
                ))
 0457   0574            CALL drawText(sx - 1, sy + 6, LTRIM$(STR$(pc)) + "% don
                e", 2, fontData())
 04B3   0574    END SUB
 04FA   0574    
 04FA   0574    '----- draw (vis=1, orange) or erase (vis=0, black interior) th
                e selection ring
 04FA   0574    '----- around a slot's number. Drawn on the black slot interior
                , so erase = black.
 04FA   0574    '----- draw (vis=1) the SLRing sprite around a slot via PSET (a
                fter GETting a save-under),
 04FA   0574    '----- or erase (vis=0) by PUTting the save-under back. Left sl
                ots rx=52, right rx=156.
 04FA   0574    SUB slRing (slot AS INTEGER, vis AS INTEGER)
 0505   0574            DIM rx AS INTEGER, ry AS INTEGER, i AS INTEGER, p AS IN
                TEGER
 0505   0574            IF slot <= 5 THEN rx = 54 ELSE rx = 157
 051D   0574            ry = 37 + ((slot - 1) MOD 5) * 21
 051D   0574            IF vis = 1 THEN
 051D   0574                    GET (rx, ry)-(rx + 98, ry + 20), slrbuf
 051D   0574                    FOR i = 1 TO slrN
 057A   0574                            p = slrp(i)
 057A   0574                            PSET (rx + p MOD 100, ry + (p \ 100) MO
                D 100), p \ 10000
 057A   0574                    NEXT
 05BC   0574            ELSE
 05BF   0574                    PUT (rx, ry), slrbuf, PSET
 05BF   0574            END IF
 05DF   0574    END SUB
