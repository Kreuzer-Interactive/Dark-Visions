 0030   0006    '----- GAME4.BAS: graphical Save / Load screen (10 slots). Own 
                64K code segment.
 0030   0006    '----- Pure library module (no COMMON SHARED): invoked from inv
                hi as
 0030   0006    '-----   CALL SaveLoadScreen(fontData(), mvint, msen, act)
 0030   0006    '----- It loads SVLDBG.PIC, reads each saver?.pac header to sho
                w per-slot
 0030   0006    '----- Location + Progress%, runs its own mouse/keyboard loop w
                ith a self-drawn
 0030   0006    '----- cursor, and delegates the real file I/O to SaveGame/Load
                Game (GAME.BAS).
 0030   0006    '----- New Game / overwrite-save / load each confirm via a yes/
                no modal.
 0030   0006    '----- act returns 1 if a game was LOADED, 2 if NEW GAME chosen
                 (caller RUNs), else 0.
 0030   0006    
 0030   0006    TYPE RegType
 0030   0006            ax AS INTEGER
 0030   0006            bx AS INTEGER
 0030   0006            cx AS INTEGER
 0030   0006            dx AS INTEGER
 0030   0006            bp AS INTEGER
 0030   0006            si AS INTEGER
 0030   0006            di AS INTEGER
 0030   0006            flags AS INTEGER
 0030   0006            ds AS INTEGER
 0030   0006            es AS INTEGER
 0030   0006    END TYPE
 0030   0006    DECLARE SUB INTERRUPT (intnum AS INTEGER, inreg AS RegType, out
                reg AS RegType)
 0030   0006    DECLARE SUB drawText (x AS INTEGER, y AS INTEGER, text AS STRIN
                G, textColor AS INTEGER, fontData() AS INTEGER)
 0030   0006    DECLARE FUNCTION textWidth (text AS STRING, fontData() AS INTEG
                ER)
 0030   0006    DECLARE SUB DrawYNBox (msg AS STRING, dk AS INTEGER, fontData()
                 AS INTEGER)
 0030   0006    DECLARE SUB SaveGame (slot AS INTEGER)
 0030   0006    DECLARE SUB LoadGame (slot AS INTEGER)
 0030   0006    DECLARE FUNCTION slLoc$ (rq AS STRING)
 0030   0006    
 0030   0006    '----- per-slot occupancy (1 = has a save); set by slDrawStat, 
                read for overwrite/load confirms
 0030   0006    DIM SHARED slUsed(10) AS INTEGER
 0030   0006    '----- selection ring from src/ART/SLRing.png, parsed to SLRING
                .DAT: slrN packed pixels
 0030   0006    '----- (attr*10000 + dy*100 + dx); slrbuf = GET save-under for 
                clean erase.
 0030   0006    DIM SHARED slrp(400) AS INTEGER
 0030   0006    DIM SHARED slrbuf(280) AS INTEGER
 0030   0006    DIM SHARED slrN AS INTEGER
 0030   0006    '----- last slot saved/loaded; persists across SaveLoadScreen o
                pens (reset by RUN/New Game)
 0030   0006    DIM SHARED slLast AS INTEGER
 0030   0006    
