 00C5   0092    '----- map a saved room tag (q$) to a short location name shown
                 on the slot
 00C5   0092    FUNCTION slLoc$ (rq AS STRING)
 00D0   0092            DIM hd$, nm$, q1 AS INTEGER, q2 AS INTEGER
 00D0   0092            IF rq = "" THEN
 00D0   0092                    slLoc$ = "?"
 00D0   0092            ELSEIF LEFT$(rq, 4) = "room" THEN
 00F1   0092                    nm$ = ""
 00F1   0092                    OPEN rq + ".pac" FOR INPUT AS #4
 00F1   0092                    LINE INPUT #4, hd$
 0140   0092                    CLOSE #4
 0140   0092                    q1 = INSTR(hd$, CHR$(34))
 0140   0092                    IF q1 > 0 THEN
 0140   0092                            q2 = INSTR(q1 + 1, hd$, CHR$(34))
 0140   0092                            IF q2 > q1 + 1 THEN nm$ = MID$(hd$, q1 
                + 1, q2 - q1 - 1)
 01C2   0092                    END IF
 01C2   0092                    IF nm$ <> "" THEN slLoc$ = nm$ ELSE slLoc$ = "R
                oom " + MID$(rq, 5)
 0208   0092            ELSE
 020B   0092                    slLoc$ = rq
