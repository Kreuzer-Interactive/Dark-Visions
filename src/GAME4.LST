 0D7C   0574            IF k$ = CHR$(0) + CHR$(80) THEN sel = sel + 1
 0DA6   0574            IF k$ = CHR$(0) + CHR$(75) AND sel > 5 THEN sel = sel -
                 5
 0DE5   0574            IF k$ = CHR$(0) + CHR$(77) AND sel <= 5 THEN sel = sel 
                + 5
 0E24   0574            IF sel < 1 THEN sel = 1
 0E32   0574            IF sel > 10 THEN sel = 10
 0E40   0574            IF sel <> osel THEN GOSUB erasecur4: CALL slRing(osel, 
                0): CALL slRing(sel, 1): GOSUB drawcur4
 0E83   0574            RETURN
