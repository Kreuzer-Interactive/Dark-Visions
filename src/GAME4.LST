                + size the save-under buffer
 064A   0574            OPEN "SLRING.DAT" FOR INPUT AS #2
 064A   0574            INPUT #2, slrN
 0676   0574            FOR i = 1 TO slrN: INPUT #2, slrp(i): NEXT
 06C2   0574            CLOSE #2
 06C2   0574            GOSUB drawall
