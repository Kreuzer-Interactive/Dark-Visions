                drn AS INTEGER
 060A   0574            DIM cmsg$, ck$
 060A   0574            DIM cyes AS INTEGER, cmlb AS INTEGER, cnodraw AS INTEGE
                R
 060A   0574    
 060A   0574            '----- mlb starts PRESSED so the click that opened this
                 screen (still held) is not
 060A   0574            '----- re-registered as a button press here (it overlap
                s the New Game button).
 060A   0574            act = 0: done = 0: sel = 1: mlb = 1: cdrn = 0
 060A   0574            IF slLast >= 1 AND slLast <= 10 THEN sel = slLast
