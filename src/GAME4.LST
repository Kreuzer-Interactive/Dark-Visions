 0170   00B8                    CLOSE #4
 0170   00B8                    q1 = INSTR(hd$, CHR$(34))
 0170   00B8                    IF q1 > 0 THEN
 0170   00B8                            q2 = INSTR(q1 + 1, hd$, CHR$(34))
 0170   00B8                            IF q2 > q1 + 1 THEN nm$ = MID$(hd$, q1 
                + 1, q2 - q1 - 1)
 01F2   00B8                    END IF
 01F2   00B8                    IF nm$ <> "" THEN slLoc$ = nm$ ELSE slLoc$ = "R
                oom " + MID$(rq, 5)
