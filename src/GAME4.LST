 4F61   00B8    '----- DialGame: the safe-dial minigame, moved VERBATIM from GA
                ME.BAS dial:
 4F61   00B8    '----- (that module is at the 64K ceiling). STATIC so the dial 
                angle di and
 4F61   00B8    '----- the tumbler states dn1-dn3 persist across visits like th
                e module vars
 4F61   00B8    '----- did. 4/6 turn the dial (joystick too), g/x leaves; solvi
                ng sets ob(45).
 4F61   00B8    SUB DialGame (sf3, sf4, ob() AS SINGLE) STATIC
 4F6C   00B8            DRAW "bm153,104"
 4F75   00B8            d1550:
 4F75   00B8            DRAW "c3bl5nl10br5bd4nd9bu4br5nr10bl5c1bu5nu9bd5"
 4F83   00B8            d1560:
 4F83   00B8            k$ = INKEY$
 4F83   00B8            CALL JoyPoll(k$, vk$)
 4FA4   00C0            IF k$ = "" THEN GOTO d1560
 4FB3   00C0            DRAW "c2bl5nl10br5bd4nd9bu4br5nr10bl5bu5nu9bd5"
 4FBC   00C0            IF k$ = "6" THEN GOSUB ddialdn: DRAW "ta=" + VARPTR$(di
                ): GOTO d1550
 4FF5   00C4            IF k$ = "4" THEN GOSUB ddialup: DRAW "ta=" + VARPTR$(di
                ): GOTO d1550
 502F   00C4            IF dn3 = 1 AND dn2 = 1 AND dn1 = 1 THEN SOUND sf4, .5: 
                ob(45) = 1
 50B3   00D0            IF k$ = "g" OR k$ = "x" THEN EXIT SUB
 50E8   00D0            GOTO d1560
 50E8   00D0    
 50E8   00D0            '----- counter-clockwise turn, tumbler tracking (verbat
                im)
 50E8   00D0            ddialdn:
 50EB   00D0            di = di - 10
 50EB   00D0            IF di = -10 THEN di = 350
 5123   00D0            IF (di / 10) = 5 THEN SOUND sf3, .1: dn1 = 0
 5163   00D0            IF (di / 10) = 9 THEN SOUND sf3, .1: IF dn2 = 1 THEN dn
                1 = 1
 51B9   00D0            IF (di / 10) = 14 THEN SOUND sf3, .1: dn1 = 0: IF dn2 =
                 0 THEN dn3 = 0
 521B   00D0            IF (di / 10) = 18 THEN SOUND sf3, .1: dn3 = 1
 525B   00D0            IF (di / 10) = 23 THEN SOUND sf3, .1
 528F   00D0            IF (di / 10) = 27 THEN SOUND sf3, .1
 52C3   00D0            IF (di / 10) = 32 THEN SOUND sf3, .1
 52F7   00D0            IF (di / 10) = 0 THEN SOUND sf3, .1
 532B   00D0            RETURN
