 026A   00B8    
 026A   00B8    '----- draw one slot's stats: Location + Progress%, or "- empty
                 -" for an unused slot.
 026A   00B8    '----- Also records slUsed(slot). Progress mirrors GAME3 drawSt
                ats.
 026A   00B8    SUB slDrawStat (slot AS INTEGER, sx AS INTEGER, sy AS INTEGER, 
                fontData() AS INTEGER)
 0275   00B8            DIM f$, sq$, sdn$, stt$, sa$, slf$
 0275   00B8            DIM scl AS SINGLE, spt AS SINGLE, sob AS INTEGER, j AS 
                INTEGER, pc AS INTEGER
 0275   00B8            '----- wipe the stat area (covers a previous "- empty -
                " on refresh)
 0275   00B8            LINE (sx - 1, sy - 1)-(sx + 56, sy + 12), 0, BF
 0275   00B8            f$ = "saver" + CHR$(slot + 96) + ".pac"
 0275   00B8            OPEN f$ FOR APPEND AS #2: CLOSE #2          ' ensure th
                e file exists (no truncate)
 0275   00B8            OPEN f$ FOR INPUT AS #2
 0275   00B8            IF EOF(2) THEN
 0275   00B8                    slUsed(slot) = 0
 0275   00B8                    CALL drawText(sx - 1, sy + 3, "- empty -", 2, f
                ontData())
 037F   00B8                    CLOSE #2: EXIT SUB
 037F   00B8            END IF
 038F   00B8            slUsed(slot) = 1
 038F   00B8            INPUT #2, sq$, scl, spt, sdn$, stt$, sa$, slf$
 03A5   00B8            pc = 0
 03A5   00B8            FOR j = 1 TO 65
 040E   00B8                    sob = 0: IF NOT EOF(2) THEN INPUT #2, sob
 043F   00B8                    IF j <= 51 AND sob >= 1 THEN pc = pc + 1
 045F   00B8                    IF j = 35 AND sob >= 1 THEN pc = pc + 2
 0480   00B8                    IF j = 36 AND sob >= 1 THEN pc = pc + 2
 04A1   00B8            NEXT j
 04B0   00B8            CLOSE #2
 04B0   00B8            pc = CINT(pc * 100 / 47)
 04B0   00B8            CALL drawText(sx - 1, sy - 1, slLoc$(sq$), 2, fontData(
                ))
 0517   00B8            CALL drawText(sx - 1, sy + 6, LTRIM$(STR$(pc)) + "% don
                e", 2, fontData())
 0573   00B8    END SUB
