 0697   00B8            act = 0: done = 0: mlb = 1: cdrn = 0: dcs = 0: dct = 0
 0697   00B8            sel = 1: IF slLast >= 1 AND slLast <= 10 THEN sel = slL
                ast
 06E7   00B8            SCREEN 1
