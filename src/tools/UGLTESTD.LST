 0030   0006    DECLARE SUB VSync ()
 0030   0006    DECLARE SUB Done ()
 0030   0006    
 0030   0006    DIM SHARED lf AS INTEGER
 0030   0006    
 0030   0006    DIM video AS LONG, inf AS TDC
 0030   0006    DIM pal(0 TO 255) AS tRGB
 0030   0006    DIM blk(0 TO 255) AS tRGB
 0030   0006    DIM ps AS STRING * 1024
 0030   0006    DIM bmp AS STRING
 0030   0006    DIM t0 AS SINGLE, t1 AS SINGLE
 0030   0006    DIM f0 AS LONG, f1 AS LONG, f2 AS LONG, f3 AS LONG
 0030   0006    DIM p1 AS LONG, p2 AS LONG, p3 AS LONG, p4 AS LONG, p5 AS LONG,
                 p6 AS LONG
 0030   0006    DIM r AS INTEGER, i AS INTEGER, bf AS INTEGER, pg AS INTEGER
 0030   0006    DIM xr AS INTEGER, yr AS INTEGER, np AS INTEGER, cx AS INTEGER,
                 cy AS INTEGER
 0030   0006    
 0030   0006    lf = FREEFILE
 0030   0A6E    OPEN "ugltest.log" FOR OUTPUT AS #lf
 0030   0A6E    f0 = FRE(-1)
 0030   0A6E    CALL Lg("free far heap before uglInit:" + STR$(f0))
 0090   0A72    
 0090   0A72    IF NOT uglInit THEN CALL Lg("uglInit FAILED"): CALL Done
 00C8   0A78    f1 = FRE(-1)
 00C8   0A78    CALL Lg("uglInit ok; free:" + STR$(f1))
 010B   0A7C    
 010B   0A7C    '----- mode ladder: 640x480 2 pages -> 640x480 1 page -> 320x20
                0 1 page (mode 13h)
 010B   0A7C    xr = 640: yr = 480: np = 2
 010B   0A7C    video = uglSetVideoDC(UGL.8BIT, xr, yr, np)
 010B   0A7C    IF video = 0 THEN
 010B   0A7C            CALL Lg("640x480x8 2 pages: not available")
 017C   0A84            np = 1
 017C   0A84            video = uglSetVideoDC(UGL.8BIT, xr, yr, np)
 017C   0A84    END IF
 01AB   0A88    IF video = 0 THEN
 01AB   0A88            CALL Lg("640x480x8 1 page: not available")
 01E1   0A8C            xr = 320: yr = 200: np = 1
 01E1   0A8C            video = uglSetVideoDC(UGL.8BIT, xr, yr, np)
 01E1   0A8C    END IF
 021C   0A90    IF video = 0 THEN CALL Lg("320x200x8: not available - no logo p
                ossible"): uglEnd: CALL Done
 025C   0A94    IF xr = 640 THEN bmp = "tplogo.bmp" ELSE bmp = "tplog320.bmp"
 0284   0A94    cx = xr \ 2: cy = yr \ 2
 0284   0A94    f2 = FRE(-1)
 0284   0A94    uglDCGet video, inf
 02BD   0A94    CALL Lg("mode set:" + STR$(xr) + "x" + LTRIM$(STR$(yr)) + " pag
                es" + STR$(np) + " art " + bmp)
 033A   0A98    CALL Lg("video DC: free:" + STR$(f2) + " xRes" + STR$(inf.xRes)
                 + " yRes" + STR$(inf.yRes) + " bps" + STR$(inf.bps) + " pages"
                 + STR$(inf.pages) + " size" + STR$(inf.size))
 03F3   0A9C    
 03F3   0A9C    '----- palette straight from the BMP file (54-byte header, then
                                                                      PAGE  17
                                                                      13 Sep 26
                                                                      16:06:37
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

                 256 BGRA entries)
 03F3   0A9C    bf = FREEFILE
 03F3   0A9C    OPEN bmp FOR BINARY AS #bf
 03F3   0A9C    GET #bf, 55, ps
 03F3   0A9C    CLOSE #bf
 03F3   0A9C    FOR i = 0 TO 255
 043C   0A9C            pal(i).blue = MID$(ps, i * 4 + 1, 1)
 043C   0A9C            pal(i).green = MID$(ps, i * 4 + 2, 1)
 043C   0A9C            pal(i).red = MID$(ps, i * 4 + 3, 1)
 043C   0A9C            blk(i).red = CHR$(0): blk(i).green = CHR$(0): blk(i).bl
                ue = CHR$(0)
 043C   0A9C    NEXT
 0561   0A9C    
 0561   0A9C    '----- page 0: black palette, load the logo hidden, then reveal
 0561   0A9C    uglSetWrkPage 0
 0569   0A9C    uglSetVisPage 0
 0571   0A9C    uglPalSetBuff 0, 256, blk(0)
 0584   0A9C    r = uglPutBMPEx(video, 0, 0, bmp, BMPOPT.NO332)
 0584   0A9C    CALL Lg("uglPutBMPEx " + bmp + ":" + STR$(r))
 05E9   0AA2    uglPalSetBuff 0, 256, pal(0)
 05FC   0AA2    p1 = uglPGet(video, 0, 0)
 05FC   0AA2    p2 = uglPGet(video, cx, cy)
 05FC   0AA2    p3 = uglPGet(video, 50, 50)
 05FC   0AA2    CALL Lg("page0 pixels (0,0)=" + STR$(p1) + " (centre)=" + STR$(
                p2) + " (50,50)=" + STR$(p3))
 06E2   0AB2    CALL Hold(4)
 06F7   0AB6    
 06F7   0AB6    IF np = 2 THEN
 06F7   0AB6            '----- page 1: solid fill + rectangle, flip to it
 06F7   0AB6            uglSetWrkPage 1
 070A   0AB6            uglClear video, 40
 071D   0AB6            uglRectF video, 100, 100, 539, 379, 200
 073D   0AB6            CALL VSync
 0742   0AB6            uglSetVisPage 1
 074B   0AB6            p4 = uglPGet(video, 10, 10)
 074B   0AB6            p5 = uglPGet(video, cx, cy)
 074B   0AB6            CALL Lg("page1 pixels (10,10)=" + STR$(p4) + " (centre)
                =" + STR$(p5))
 07ED   0AC2            CALL Hold(1)
 0802   0AC6    
 0802   0AC6            '----- flip timing: 60 vsync-locked flips between the t
                wo pages
 0802   0AC6            t0 = TIMER
 0802   0AC6            FOR i = 1 TO 60
 081A   0AC6                    CALL VSync
 081F   0AC6                    pg = i AND 1
 081F   0AC6                    uglSetVisPage pg
 082E   0AC6            NEXT
 083A   0AC6            t1 = TIMER - t0
 083A   0AC6            CALL Lg("60 vsync flips took" + STR$(t1) + " s")
 088D   0ACA            CALL VSync
 0892   0ACA            uglSetVisPage 0
 089A   0ACA            uglSetWrkPage 0
 08A2   0ACA            p6 = uglPGet(video, cx, cy)
