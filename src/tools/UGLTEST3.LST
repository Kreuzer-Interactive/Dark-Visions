 0030   0006    
 0030   0006    lf = FREEFILE
 0030   0018    OPEN "ugltest3.log" FOR OUTPUT AS #lf
 0030   0018    IF NOT uglInit THEN CALL Lg("uglInit FAILED"): CALL Done
 0085   001E    video = uglSetVideoDC(UGL.8BIT, 640, 480, 2)
 0085   001E    IF video = 0 THEN CALL Lg("no 640x480x2"): uglEnd: CALL Done
 00EE   0026    strip = uglNew(UGL.MEM, UGL.8BIT, 640, 48)
 00EE   0026    CALL Lg("strip dc:" + STR$(strip))
 0147   002E    
 0147   002E    FOR p = 0 TO 1
 014C   002E            uglSetWrkPage p
