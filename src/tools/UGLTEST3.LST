                 + p * 64 + k
 0197   002E            NEXT
 01A3   002E    NEXT
 01AF   002E    uglSetWrkPage 0
 01B7   002E    uglSetVisPage 0
 01BF   002E    OUT &H3D4, &H18: OUT &H3D5, 459 AND 255
 01BF   002E    OUT &H3D4, 7: ln = INP(&H3D5): OUT &H3D5, (ln AND &HEF) OR 16
 01BF   002E    OUT &H3D4, 9: ln = INP(&H3D5): OUT &H3D5, ln AND &HBF
 01BF   002E    CALL VStart(20)
