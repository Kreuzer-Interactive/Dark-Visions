 03CC   005A    SUB Hold (secs AS SINGLE)
 03D7   005A            DIM t9 AS SINGLE, d9 AS SINGLE
 03D7   005A            t9 = TIMER
 03D7   005A            DO
 03E8   005A                    d9 = TIMER - t9: IF d9 < 0 THEN d9 = d9 + 86400
 0420   005A            LOOP WHILE d9 < secs
