 0548   0082    FUNCTION BiosMode%
 0553   0082            DIM r AS RegType, r2 AS RegType, vi AS INTEGER
 0553   0082            vi = &H10
 0553   0082            r.ax = &HF00
 0553   0082            CALL INTERRUPT(vi, r, r2)
 056E   0082            BiosMode% = r2.ax AND 255
 056E   0082    END FUNCTION
