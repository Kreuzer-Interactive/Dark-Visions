 0030   0006    DIM v AS LONG, strip AS LONG, cur AS LONG, c AS INTEGER, r AS I
                NTEGER, inf AS TDC
 0030   0006    
 0030   0006    lf = FREEFILE
 0030   0034    OPEN "ugltest8.log" FOR OUTPUT AS #lf
 0030   0034    CALL Lg("start: bios mode" + STR$(BiosMode%) + " free" + STR$(F
                RE(-1)))
 00A5   003A    IF NOT uglInit THEN CALL Lg("uglInit FAILED"): CALL Done
 00DD   0040    CALL Lg("init once: free" + STR$(FRE(-1)))
 0113   0044    FOR c = 1 TO 5
 011A   0044            v = uglSetVideoDC(UGL.8BIT, 640, 480, 2)
 011A   0044            IF v = 0 THEN
 011A   0044                    CALL Lg("cycle" + STR$(c) + ": 640x480x2 FAILED
                ")
 0193   004C                    v = uglSetVideoDC(UGL.8BIT, 320, 200, 1)
 0193   004C                    CALL Lg("cycle" + STR$(c) + ": 320x200 ->" + ST
                R$(v <> 0))
 021A   0054            ELSE
 021D   0054                    uglDCGet v, inf
 0231   0054                    CALL Lg("cycle" + STR$(c) + ": 640x480x2 ok, pa
                ges" + STR$(inf.pages) + " free" + STR$(FRE(-1)))
 029B   0058            END IF
 029B   0058            strip = uglNew(UGL.MEM, UGL.8BIT, 640, 48)
 029B   0058            cur = uglNew(UGL.MEM, UGL.8BIT, 12, 18)
 029B   0058            CALL Lg("  strip" + STR$(strip <> 0) + " cur" + STR$(cu
                r <> 0) + " free" + STR$(FRE(-1)))
 037B   0064            IF v <> 0 THEN r = uglPutBMPEx(v, 0, 0, "tplogo.bmp", B
                MPOPT.NO332)
 03CA   006A            CALL Hold(.5)
 03DF   006E            uglDel strip
 03EB   006E            uglDel cur
 03F7   006E            uglRestore
 03FC   006E            CALL Lg("  restored: bios mode" + STR$(BiosMode%) + " f
                ree" + STR$(FRE(-1)))
 0454   0074            IF c = 1 THEN SCREEN 1: LINE (0, 0)-(319, 199), 2, BF: 
