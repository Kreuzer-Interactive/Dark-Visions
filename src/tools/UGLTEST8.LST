 05A7   0082    SUB Hold (secs AS SINGLE)
 05B2   0082            DIM t9 AS SINGLE, d9 AS SINGLE
 05B2   0082            t9 = TIMER
 05B2   0082            DO
 05C2   0082                    d9 = TIMER - t9: IF d9 < 0 THEN d9 = d9 + 86400
 05FA   0082            LOOP WHILE d9 < secs
 05FA   0082    END SUB
