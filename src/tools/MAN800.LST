 08BB   0066            xo = (scrW - w) \ 2: IF xo < 0 THEN xo = 0
 08E1   0066            yo = (artH - h) \ 2: IF yo < 0 THEN yo = 0
 0907   0066            uglSetWrkPage 0
 090F   0066            CALL PalBlack
 0914   0066            uglRectF v, 0, 0, scrW - 1, 599, cBlack
 0933   0066            IF uglPutBMPEx(v, xo, yo, bmp, BMPOPT.NO332) = 0 THEN E
                XIT FUNCTION
 095A   0066            CALL PalLoad(bmp)
 0963   0066            pg = n
