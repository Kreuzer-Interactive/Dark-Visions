 07F2   0066    FUNCTION LoadP% (n AS INTEGER)
 07FD   0066            DIM bmp AS STRING, fh AS INTEGER, w AS LONG, h AS LONG,
                 xo AS INTEGER, yo AS INTEGER
 07FD   0066            bmp = PName$(n)
