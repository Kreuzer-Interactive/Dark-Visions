                ne dot per page
 04B2   0066    SUB Bar
 04C2   0066            DIM c AS INTEGER, i AS INTEGER, x AS INTEGER
 04C2   0066            REDIM pt(0 TO 2) AS PNT2D
 04DA   0066            uglSetWrkPage 0
 04E2   0066            uglRectF v, 0, barY, scrW - 1, 599, cDGray
 0504   0066            uglHLine v, 0, barY, scrW - 1, cLGray
 0522   0066            IF pg > 1 THEN c = cParch ELSE c = cMGray
