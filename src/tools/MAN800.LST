 0030   0006    '----- MAN800.BAS: standalone 800x600x256 demo of the page-flip
                 manual, to see the
 0030   0006    '----- higher-resolution art on the 486. Sets VESA 800x600 one 
                page (600 KB, fits a
 0030   0006    '----- 1 MB card; two pages would need 1.2 MB, so one page only
                ), shows each sub-page
 0030   0006    '----- (M801H, M801HB, M802H, M802HB - the two comic spreads sp
                lit top/bottom, 784
 0030   0006    '----- wide) centred, with the nav bar at the bottom 20 lines. 
                NO scrolling and NO
 0030   0006    '----- page-flip via the card (this Cirrus VESA BIOS honours ne
                ither) - each page is
 0030   0006    '----- one image at display start 0; a turn fades through black
                . Keys: Left/Up/PgUp
 0030   0006    '----- previous, Right/Down/PgDn next, Home/End, Tab/Esc quit. 
                Logs MAN800.LOG.
 0030   0006    DEFINT A-Z
 0030   0006    '$INCLUDE: 'UGL.BI'
 0030   0006    ''
 0030   0006    '' ugl.bi -- UGL routines
 0030   0006    ''
 0030   0006    
 0030   0006    Const UGL.TRUE%     = -1%
 0030   0006    Const UGL.FALSE%    = 0%
 0030   0006    
 0030   0006    Const DCTSIZE%      = 64%
 0030   0006    '' dc types:
 0030   0006    Const UGL.MEM%      = 0% * DCTSIZE%
 0030   0006    Const UGL.BNK%      = 1% * DCTSIZE%
 0030   0006    Const UGL.EMS%      = 2% * DCTSIZE%
 0030   0006    
 0030   0006    Const FMTSIZE%      = 128%
 0030   0006    '' color formats:
 0030   0006    Const UGL.8BIT%     = 0% * FMTSIZE%
 0030   0006    Const UGL.15BIT%    = 1% * FMTSIZE%
 0030   0006    Const UGL.16BIT%    = 2% * FMTSIZE%
 0030   0006    Const UGL.32BIT%    = 3% * FMTSIZE%
 0030   0006    
 0030   0006    '' buffer formats for uglRow Read/Write/SetPal routines
 0030   0006    Const UGL.BF.8BIT%  = 0% * 2%
 0030   0006    Const UGL.BF.15BIT% = 1% * 2%
 0030   0006    Const UGL.BF.16BIT% = 2% * 2%
 0030   0006    Const UGL.BF.32BIT% = 3% * 2%
 0030   0006    Const UGL.BF.24BIT% = 4% * 2%
 0030   0006    Const UGL.BF.IDX1%  = 5% * 2%
 0030   0006    Const UGL.BF.IDX4%  = 6% * 2%
 0030   0006    Const UGL.BF.IDX8%  = 7% * 2%
 0030   0006    
 0030   0006    '' flipping modes:
 0030   0006    Const UGL.VFLIP%    = 1%
 0030   0006    Const UGL.HFLIP%    = 2%
 0030   0006    Const UGL.VHFLIP%   = UGL.VFLIP% or UGL.HFLIP%
 0030   0006    
 0030   0006    '' Mask modes for uglTriT and uglQuadT
