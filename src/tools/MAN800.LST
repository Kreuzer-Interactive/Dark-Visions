 0A84   0066    
 0A84   0066    '----- pal() scaled by f/16 into the DAC (16 = as loaded, 0 = b
                lack)
 0A84   0066    SUB PalApply (f AS INTEGER)
 0A8F   0066            DIM i AS INTEGER
 0A8F   0066            REDIM p(0 TO 255) AS tRGB
 0AA7   0066            FOR i = 0 TO 255
 0AAC   0066                    p(i).red = CHR$(ASC(pal(i).red) * f \ 16)
 0AAC   0066                    p(i).green = CHR$(ASC(pal(i).green) * f \ 16)
 0AAC   0066                    p(i).blue = CHR$(ASC(pal(i).blue) * f \ 16)
 0AAC   0066            NEXT
 0BB2   0066            uglPalSetBuff 0, 256, p(0)
 0BCB   0066    END SUB
 0BDC   0066    
 0BDC   0066    SUB PalBlack
 0BE7   0066            DIM i AS INTEGER
 0BE7   0066            REDIM blk(0 TO 255) AS tRGB
 0BFF   0066            FOR i = 0 TO 255
 0C04   0066                    blk(i).red = CHR$(0): blk(i).green = CHR$(0): b
                lk(i).blue = CHR$(0)
 0C04   0066            NEXT
 0C89   0066            uglPalSetBuff 0, 256, blk(0)
 0CA2   0066    END SUB
 0CB3   0066    
 0CB3   0066    '----- 256 BGRA entries at file offset 55 (54-byte header) -> p
                al()
 0CB3   0066    SUB PalLoad (bmp AS STRING)
 0CBE   0066            DIM i AS INTEGER, fh AS INTEGER, s AS STRING
 0CBE   0066            fh = FREEFILE
 0CBE   0066            OPEN bmp FOR BINARY AS #fh
 0CBE   0066            SEEK #fh, 55
 0CBE   0066            s = INPUT$(1024, #fh)
 0CBE   0066            CLOSE #fh
 0CBE   0066            FOR i = 0 TO 255
 0D0C   0066                    pal(i).blue = MID$(s, i * 4 + 1, 1)
 0D0C   0066                    pal(i).green = MID$(s, i * 4 + 2, 1)
 0D0C   0066                    pal(i).red = MID$(s, i * 4 + 3, 1)
 0D0C   0066            NEXT
 0DBE   0066            s = ""
 0DBE   0066    END SUB
