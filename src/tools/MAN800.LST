                 = barY + 16: pt(2).x = 14: pt(2).y = barY + 10
 0539   0066            uglPolyF v, pt(0), 3, c
 05B8   0066            IF pg < npg THEN c = cParch ELSE c = cMGray
 05D1   0066            pt(0).x = scrW - 45: pt(0).y = barY + 3: pt(1).x = scrW
                 - 45: pt(1).y = barY + 16: pt(2).x = scrW - 15: pt(2).y = barY
