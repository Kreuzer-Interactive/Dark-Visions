 071A   0066    '----- fade to black, load sub-page n centred, fade in (the pag
                e-flip effect)
 071A   0066    SUB Flip (n AS INTEGER)
 0725   0066            DIM i AS INTEGER
 0725   0066            IF n < 1 OR n > npg OR n = pg THEN EXIT SUB
 0754   0066            FOR i = 10 TO 0 STEP -1: CALL Sync: CALL PalApply(i * 1
                6 \ 10): NEXT
 0787   0066            CALL PalBlack
 078C   0066            IF LoadP%(n) = 0 THEN i = LoadP%(pg)
 07B2   0066            CALL Bar
 07B7   0066            FOR i = 0 TO 10: CALL Sync: CALL PalApply(i * 16 \ 10):
                 NEXT
 07EA   0066    END SUB
