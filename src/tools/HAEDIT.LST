 16D8   09EE    '--- decode one CGA SCREEN 1 pixel (x 0-319, y 0-199) -> colour
                 index 0-3
 16D8   09EE    FUNCTION cgapix (x, y)
 1726   09EE       bank = y AND 1
 1726   09EE       row = y \ 2
 1726   09EE       ofs = 7 + bank * 8192 + row * 80 + (x \ 4)
 1726   09EE       b = ASC(MID$(pic$, ofs + 1, 1))
 1726   09EE       SELECT CASE x AND 3
 1726   09EE          CASE 0: cgapix = (b \ 64) AND 3
 1726   09EE          CASE 1: cgapix = (b \ 16) AND 3
 17BD   09EE          CASE 2: cgapix = (b \ 4) AND 3
 17D8   09EE          CASE ELSE: cgapix = b AND 3
 17F3   09EE       END SELECT
 17FC   09EE    END FUNCTION
