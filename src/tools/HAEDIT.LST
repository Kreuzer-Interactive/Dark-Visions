 0030   0006    '==============================================================
                =======
 0030   0006    ' HAEDIT.BAS - Dark Visions hit-area (.PAC) editor
 0030   0006    '
 0030   0006    ' Loads a room .PIC (CGA SCREEN 1, 320x200) into SCREEN 12 (640
                x480,
 0030   0006    ' 16 colour) at 1:1 in the top-left, leaving the rest of the sc
                reen
 0030   0006    ' for data: a list of all 25 objects on the right (colour, name
                , verb,
 0030   0006    ' direction, point count) and the selected object's detail + he
                lp at
 0030   0006    ' the bottom-left.  The .PAC hit points are overlaid as bright 
                markers,
 0030   0006    ' one colour per object; the selected object's points show whit
                e.
 0030   0006    '
 0030   0006    ' Drag the LEFT button to paint hit points for the selected obj
                ect;
 0030   0006    ' the RIGHT button erases the point under the cursor.  Click an
                 object
 0030   0006    ' row in the list (or [ ] / 1-9) to pick it.  Hold SPACE to pee
                k the
 0030   0006    ' bare picture under the markers.  E edits the selected object'
                s text;
 0030   0006    ' S saves the .PAC in the game's exact format.
 0030   0006    '
 0030   0006    ' Run it from the folder that holds the .PIC/.PAC files.  Build
                 (Q: =
 0030   0006    ' QB45 toolchain):  BC HAEDIT /O ;   LINK HAEDIT ,,, Q:\QB.LIB 
                ;
 0030   0006    ' and run with a mouse driver loaded (MOUSE.COM).
 0030   0006    '==============================================================
                =======
 0030   0006    DEFINT A-Z
 0030   0006    
 0030   0006    TYPE RegType
 0030   0006       ax AS INTEGER
 0030   0006       bx AS INTEGER
 0030   0006       cx AS INTEGER
 0030   0006       dx AS INTEGER
 0030   0006       bp AS INTEGER
 0030   0006       si AS INTEGER
 0030   0006       di AS INTEGER
 0030   0006       flags AS INTEGER
 0030   0006    END TYPE
 0030   0006    DECLARE SUB INTERRUPT (intnum AS INTEGER, inreg AS RegType, out
                reg AS RegType)
 0030   0006    DECLARE FUNCTION cgapix (x, y)
 0030   0006    
 0030   0006    CONST MAXH = 256, MAXO = 25
 0030   0006    
 0030   0006    DIM SHARED reg AS RegType
 0030   0006    DIM SHARED pic$
