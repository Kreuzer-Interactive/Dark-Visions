 0030   0006    lf = FREEFILE
 0030   003A    OPEN "ugltest2.log" FOR OUTPUT AS #lf
 0030   003A    IF NOT uglInit THEN CALL Lg("uglInit FAILED"): CALL Done
 0085   0040    video = uglSetVideoDC(UGL.8BIT, 640, 480, 2)
 0085   0040    IF video = 0 THEN CALL Lg("no 640x480x2"): uglEnd: CALL Done
 00EE   0048    
 00EE   0048    '----- bands on both pages
 00EE   0048    FOR p = 0 TO 1
 00F4   0048            uglSetWrkPage p
 00FA   0048            FOR k = 0 TO 29
 0100   0048                    uglRectF video, 0, k * 16, 639, k * 16 + 15, 16
                 + p * 64 + k
 013F   0048            NEXT
 014B   0048    NEXT
 0157   0048    '----- does the BMP loader honour the work page? draw TPLOG320.
                BMP on page 1 and read both pages
 0157   0048    uglSetWrkPage 1
 0160   0048    v = uglPutBMPEx(video, 0, 0, "tplog320.bmp", BMPOPT.NO332)
 0160   0048    CALL Lg("PutBMPEx on wrk page 1 returned" + STR$(v))
 01D0   0052    uglSetWrkPage 0
 01D8   0052    CALL Lg("page 0 (10,100) now" + STR$(uglPGet(video, 10, 100)) +
                 " (band expects" + STR$(16 + 100 \ 16) + "; a logo pixel means
                 the loader wrote page 0)")
 024B   005A    uglSetWrkPage 1
 0254   005A    CALL Lg("page 1 (10,100) now" + STR$(uglPGet(video, 10, 100)) +
                 " (band expects" + STR$(80 + 100 \ 16) + ")")
 02C7   0062    CALL Lg("page 1 (160,100) now" + STR$(uglPGet(video, 160, 100))
                 + " (logo centre would be 48)")
 0320   006A    uglSetWrkPage 0
 0328   006A    CALL Lg("page 0 (160,100) now" + STR$(uglPGet(video, 160, 100))
                 + " (logo centre would be 48)")
