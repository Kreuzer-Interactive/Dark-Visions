 0030   0006    DECLARE SUB Lg (s AS STRING)
 0030   0006    DECLARE SUB HoldS (secs AS SINGLE)
 0030   0006    
 0030   0006    DIM SHARED lf AS INTEGER
 0030   0006    
 0030   0006    DIM video AS LONG, back AS LONG, tex AS LONG, rc AS CLIPRECT
 0030   0006    DIM vq AS QuadType, t1 AS TriType
 0030   0006    DIM pal(0 TO 255) AS tRGB, ps AS STRING * 1024
 0030   0006    DIM eq AS INTEGER, fpu AS INTEGER, i AS INTEGER, bf AS INTEGER
 0030   0006    DIM c AS SINGLE, cx AS INTEGER, cy AS INTEGER, w2 AS SINGLE, h2
                 AS SINGLE
 0030   0006    
 0030   0006    lf = FREEFILE
 0030   0814    OPEN "pgdiag.log" FOR OUTPUT AS #lf
 0030   0814    CALL Lg("PGDIAG " + DATE$ + " " + TIME$)
 008E   0818    
 008E   0818    '----- FPU present? BIOS equipment word at 0040:0010, bit 1 = m
                ath coprocessor
 008E   0818    DEF SEG = &H40
 008E   0818    eq = PEEK(&H10)
 008E   0818    DEF SEG
 008E   0818    fpu = (eq AND 2)
 008E   0818    CALL Lg("BIOS equip low byte = " + HEX$(eq) + "h  coprocessor b
                it(AND 2) =" + STR$(fpu) + " (0 = NO FPU)")
 0111   081C    
 0111   081C    IF NOT uglInit THEN CALL Lg("uglInit FAILED"): CLOSE #lf: END
 0156   0822    video = uglSetVideoDC(UGL.8BIT, 640, 480, 1)
 0156   0822    IF video = 0 THEN CALL Lg("mode fail"): uglEnd: CLOSE #lf: END
 01CC   082A    rc.xMin = 0: rc.yMin = 0: rc.xMax = 639: rc.yMax = 479
 01CC   082A    uglSetClipRect video, rc
 01F8   082A    tex = uglNewBMPEx(UGL.MEM, UGL.8BIT, "mantex.bmp", BMPOPT.NO332
                )
 01F8   082A    CALL Lg("texture handle =" + STR$(tex))
 0267   0836    IF tex = 0 THEN CALL Lg("no texture"): uglRestore: uglEnd: CLOS
                E #lf: END
 02B9   083A    
 02B9   083A    bf = FREEFILE
 02B9   083A    OPEN "manp00.bmp" FOR BINARY AS #bf
 02B9   083A    GET #bf, 55, ps
 02B9   083A    CLOSE #bf
 02B9   083A    FOR i = 0 TO 255
 0302   083A            pal(i).blue = MID$(ps, i * 4 + 1, 1): pal(i).green = MI
                D$(ps, i * 4 + 2, 1): pal(i).red = MID$(ps, i * 4 + 3, 1)
 0302   083A    NEXT
 03C2   083A    uglPalSetBuff 0, 256, pal(0)
 03D5   083A    cx = 320: cy = 240: w2 = 256: h2 = 192
 03D5   083A    c = COS(30 * D2R)
 03D5   083A    
 03D5   083A    '----- (A) AFFINE quad straight to video (a 30-degree-narrowed 
                rectangle)
 03D5   083A    uglClear video, 248
 041F   083A    vq.v1.x = cx - w2 * c: vq.v1.y = cy - h2: vq.v1.u = 0: vq.v1.v 
                = 0
 041F   083A    vq.v2.x = cx + w2 * c: vq.v2.y = cy - h2: vq.v2.u = 1: vq.v2.v 
                                                                      PAGE  17
                                                                      16 Sep 26
                                                                      22:17:52
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

                = 0
 041F   083A    vq.v3.x = cx + w2 * c: vq.v3.y = cy + h2: vq.v3.u = 1: vq.v3.v 
                = 1
 041F   083A    vq.v4.x = cx - w2 * c: vq.v4.y = cy + h2: vq.v4.u = 0: vq.v4.v 
                = 1
 041F   083A    uglQuadT video, vq, UGL.MASK.FALSE, tex
 055E   083A    CALL Lg("(A) AFFINE uglQuadT -> video: px(320,240)=" + STR$(ugl
                PGet(video, 320, 240)) + " (260,240)=" + STR$(uglPGet(video, 26
                0, 240)) + "  [248 = drew nothing]")
 05F1   0846    CALL HoldS(2.5)
 0606   084A    
 0606   084A    '----- (B) PERSPECTIVE triangle into a MEM back-buffer (flat, z
                =1)
 0606   084A    back = uglNew(UGL.MEM, UGL.8BIT, 640, 480)
 0606   084A    CALL Lg("back-buffer handle =" + STR$(back))
 065F   0852    IF back <> 0 THEN
 065F   0852            uglSetClipRect back, rc
 068A   0852            uglClear back, 248
 069D   0852            t1.v1.x = cx - w2: t1.v1.y = cy - h2: t1.v1.z = 1: t1.v
                1.u = 0: t1.v1.v = 0
 069D   0852            t1.v2.x = cx + w2: t1.v2.y = cy - h2: t1.v2.z = 1: t1.v
                2.u = 1: t1.v2.v = 0
 069D   0852            t1.v3.x = cx + w2: t1.v3.y = cy + h2: t1.v3.z = 1: t1.v
                3.u = 1: t1.v3.v = 1
 069D   0852            uglTriTP back, t1, UGL.MASK.FALSE, tex
 07A0   0852            CALL Lg("(B) PERSP uglTriTP -> back: px(300,200)=" + ST
                R$(uglPGet(back, 300, 200)) + " (330,240)=" + STR$(uglPGet(back
                , 330, 240)) + "  [248 = drew nothing]")
 0833   085E            uglPut video, 0, 0, back
 084C   085E            CALL Lg("(C) uglPut back -> video: px(300,200)=" + STR$
                (uglPGet(video, 300, 200)))
 089B   0866            CALL HoldS(2.5)
 08B0   086A    END IF
 08B0   086A    CALL Lg("DONE")
 08CF   086E    uglRestore
 08D4   086E    uglEnd
 08D9   086E    CLOSE #lf
 08D9   086E    END
 08D9   086E    
 08D9   086E    SUB HoldS (secs AS SINGLE)
 08F6   086E            DIM t9 AS SINGLE, d9 AS SINGLE
 08F6   086E            t9 = TIMER
 08F6   086E            DO
 0906   086E                    d9 = TIMER - t9: IF d9 < 0 THEN d9 = d9 + 86400
 093E   086E            LOOP WHILE d9 < secs
 093E   086E    END SUB
 0959   086E    
 0959   086E    SUB Lg (s AS STRING)
 0964   086E            PRINT #lf, s
 0964   086E    END SUB
 097D   086E    
 0982   086E    
