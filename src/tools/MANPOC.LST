 08D7   0074    SUB PalLoad (bmp AS STRING)
 08E2   0074            DIM i AS INTEGER, fh AS INTEGER, s AS STRING
 08E2   0074            fh = FREEFILE
 08E2   0074            OPEN bmp FOR BINARY AS #fh
 08E2   0074            SEEK #fh, 55
 08E2   0074            s = INPUT$(1024, #fh)
 08E2   0074            CLOSE #fh
 08E2   0074            FOR i = 0 TO 255
 0930   0074                    pal(i).blue = MID$(s, i * 4 + 1, 1)
 0930   0074                    pal(i).green = MID$(s, i * 4 + 2, 1)
 0930   0074                    pal(i).red = MID$(s, i * 4 + 3, 1)
 0930   0074            NEXT
 09E2   0074            s = ""
 09E2   0074    END SUB
