 05D4   0074    '----- turn to view n with a fade through black
 05D4   0074    SUB Turn (n AS INTEGER)
 05DF   0074            DIM i AS INTEGER
 05DF   0074            IF n < 0 OR n > npg - 1 OR n = pg THEN EXIT SUB
 060E   0074            FOR i = 10 TO 0 STEP -1
 0614   0074                    CALL Sync
 0619   0074                    CALL PalApply(i * 16 \ 10)
 0636   0074            NEXT
 0641   0074            CALL PalBlack
 0646   0074            IF Load%(n) = 0 THEN i = Load%(pg)
 066C   0074            FOR i = 0 TO 10
 0672   0074                    CALL Sync
 0677   0074                    CALL PalApply(i * 16 \ 10)
 0694   0074            NEXT
 06A0   0074    END SUB
 06A8   0074    
 06A8   0074    SUB PalApply (f AS INTEGER)
 06B3   0074            DIM i AS INTEGER
 06B3   0074            REDIM p(0 TO 255) AS tRGB
 06CB   0074            FOR i = 0 TO 255
 06D0   0074                    p(i).red = CHR$(ASC(pal(i).red) * f \ 16)
 06D0   0074                    p(i).green = CHR$(ASC(pal(i).green) * f \ 16)
 06D0   0074                    p(i).blue = CHR$(ASC(pal(i).blue) * f \ 16)
 06D0   0074            NEXT
 07D6   0074            uglPalSetBuff 0, 256, p(0)
 07EF   0074    END SUB
