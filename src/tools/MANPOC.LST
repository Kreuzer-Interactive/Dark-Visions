 050E   0074    '----- load view n full-screen at (0,0), palette from the file
 050E   0074    FUNCTION Load% (n AS INTEGER)
 0519   0074            DIM bmp AS STRING
 0519   0074            bmp = "manp" + RIGHT$("0" + LTRIM$(STR$(n)), 2) + ".bmp
                "
 0519   0074            Load% = 0
 0519   0074            IF NOT Exists%(bmp) THEN EXIT FUNCTION
 0578   0074            uglSetWrkPage 0
 0580   0074            CALL PalBlack
