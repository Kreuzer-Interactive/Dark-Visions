 0030   0006    DECLARE SUB Lg (s AS STRING)
 0030   0006    DECLARE SUB Hold (secs AS SINGLE)
 0030   0006    DECLARE FUNCTION CrtcR% (idx AS INTEGER)
 0030   0006    DECLARE SUB CrtcW (idx AS INTEGER, v AS INTEGER)
 0030   0006    DECLARE FUNCTION SeqR% (idx AS INTEGER)
 0030   0006    DECLARE SUB SeqW (idx AS INTEGER, v AS INTEGER)
 0030   0006    DECLARE SUB StartAt (ofs AS LONG)
 0030   0006    DECLARE SUB Digit2 ()
 0030   0006    
 0030   0006    DIM SHARED lf AS INTEGER
 0030   0006    DIM SHARED video AS LONG
 0030   0006    DIM SHARED pitch AS LONG, unit AS INTEGER, cirrus AS INTEGER, c
                hip AS INTEGER
 0030   0006    
 0030   0006    DIM inf AS TDC
 0030   0006    DIM pal(0 TO 255) AS tRGB
 0030   0006    DIM xr AS INTEGER, yr AS INTEGER, np AS INTEGER, i AS INTEGER, 
                y AS INTEGER, cyc AS INTEGER
 0030   0006    DIM s6b AS INTEGER, s6c AS INTEGER
 0030   0006    
 0030   0006    lf = FREEFILE
 0030   0342    OPEN "scrlt2.log" FOR OUTPUT AS #lf
 0030   0342    CALL Lg("SCRLT2 " + DATE$ + " " + TIME$)
 008E   0346    IF NOT uglInit THEN CALL Lg("uglInit FAILED"): CLOSE #lf: END
 00D3   034C    xr = 640: yr = 480: np = 2
 00D3   034C    video = uglSetVideoDC(UGL.8BIT, xr, yr, np)
 00D3   034C    IF video = 0 THEN CALL Lg("640x480x8 2 pages refused"): uglEnd:
                 CLOSE #lf: END
 015B   0354    uglDCGet video, inf
 016F   0354    pitch = inf.bps
 016F   0354    CALL Lg("mode 640x480x8 2pg bps" + STR$(inf.bps) + " size" + ST
                R$(inf.size))
 01C7   0358    
 01C7   0358    '----- CRTC addressing unit: CR14 bit6 = dword, else CR17 bit6 
                = byte, else word
 01C7   0358    IF CrtcR%(&H14) AND &H40 THEN
 01C7   0358            unit = 4
 01C7   0358    ELSEIF CrtcR%(&H17) AND &H40 THEN
 01EF   035C            unit = 1
 01EF   035C    ELSE
 0217   0360            unit = 2
 0217   0360    END IF
 021D   0360    '----- Cirrus? SR06 reads 0Fh when locked, 12h after the 12h un
                lock
 021D   0360    CALL SeqW(6, &HA): s6b = SeqR%(6)
 0236   0364    CALL SeqW(6, &H12): s6c = SeqR%(6)
                                                                      PAGE  17
                                                                      16 Sep 26
                                                                      20:35:55
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 0267   036C    cirrus = 0: chip = 0
 0267   036C    IF s6b = &HF AND s6c = &H12 THEN cirrus = -1: chip = CrtcR%(&H2
                7)
 02C6   0374    CALL Lg("unit" + STR$(unit) + " cirrus" + STR$(cirrus) + " CR27
                 " + HEX$(chip) + " CR1B " + HEX$(CrtcR%(&H1B)))
 0365   037C    
 0365   037C    '----- vivid palette: 1 white, 2 red, 3 green, 4 blue, 5 yellow
                 (rest black)
 0365   037C    FOR i = 0 TO 255
 036A   037C            pal(i).red = CHR$(0): pal(i).green = CHR$(0): pal(i).bl
                ue = CHR$(0)
 036A   037C    NEXT
 03DA   037C    pal(1).red = CHR$(255): pal(1).green = CHR$(255): pal(1).blue =
                 CHR$(255)
 03DA   037C    pal(2).red = CHR$(255): pal(2).green = CHR$(0): pal(2).blue = C
                HR$(0)
 03DA   037C    pal(3).red = CHR$(0): pal(3).green = CHR$(210): pal(3).blue = C
                HR$(0)
 03DA   037C    pal(4).red = CHR$(40): pal(4).green = CHR$(90): pal(4).blue = C
                HR$(255)
 03DA   037C    pal(5).red = CHR$(255): pal(5).green = CHR$(210): pal(5).blue =
                 CHR$(0)
 03DA   037C    uglPalSetBuff 0, 256, pal(0)
 058C   037C    
 058C   037C    '----- page 0 (VRAM lines 0-479): red top half, green bottom ha
                lf, edge stripes
 058C   037C    uglSetWrkPage 0
 0594   037C    uglRectF video, 0, 0, 639, 239, 2
 05B3   037C    uglRectF video, 0, 240, 639, 479, 3
 05D5   037C    uglRectF video, 0, 0, 639, 9, 1
 05F4   037C    uglRectF video, 0, 470, 639, 479, 5
 0616   037C    '----- page 1 (VRAM lines 480-959): solid blue + a big white "2
                "
 0616   037C    uglSetWrkPage 1
 061F   037C    uglRectF video, 0, 0, 639, 479, 4
 063E   037C    CALL Digit2
 0643   037C    uglSetWrkPage 0
 064B   037C    
 064B   037C    '----- start on page 0, then scroll down to page 1 and back, tw
                ice
 064B   037C    CALL StartAt(0)
 0660   0380    CALL Hold(2.5)
 0675   0384    FOR cyc = 1 TO 2
 067C   0384            FOR y = 0 TO 480 STEP 2
 0682   0384                    CALL StartAt(y * pitch)
 06A2   0388            NEXT
 06B0   0388            CALL Lg("cycle" + STR$(cyc) + " at page1: CR0C " + HEX$
                (CrtcR%(&HC)) + " CR0D " + HEX$(CrtcR%(&HD)) + " CR1B " + HEX$(
                CrtcR%(&H1B)))
 077B   0398            CALL Hold(2.5)
 0790   039C            FOR y = 480 TO 0 STEP -2
 0796   039C                    CALL StartAt(y * pitch)
 07B6   03A0            NEXT
 07C3   03A0            CALL Hold(2.5)
