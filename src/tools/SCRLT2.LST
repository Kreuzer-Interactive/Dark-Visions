 08F9   03AC    
 08F9   03AC    '----- direct CRTC display start: ofs = byte offset into video 
                memory
 08F9   03AC    SUB StartAt (ofs AS LONG)
 0904   03AC            DIM u AS LONG, b AS INTEGER
 0904   03AC            u = ofs \ unit
 0904   03AC            WAIT &H3DA, 8, 8
 0904   03AC            CALL CrtcW(&HC, (u \ 256) AND 255)
 0958   03AC            CALL CrtcW(&HD, u AND 255)
 0979   03AC            IF cirrus THEN
 0979   03AC                    b = CrtcR%(&H1B) AND &HF2
 0979   03AC                    IF u AND &H10000 THEN b = b OR 1
 09BD   03AC                    IF u AND &H20000 THEN b = b OR 4
 09D9   03AC                    IF u AND &H40000 THEN b = b OR 8
 09F5   03AC                    CALL CrtcW(&H1B, b)
 0A07   03AC                    IF chip >= &HA0 THEN
 0A07   03AC                            b = CrtcR%(&H1D) AND &H7F
 0A07   03AC                            IF u AND &H80000 THEN b = b OR &H80
 0A4C   03AC                            CALL CrtcW(&H1D, b)
 0A5E   03AC                    END IF
 0A5E   03AC            END IF
 0A5E   03AC            WAIT &H3DA, 8
 0A5E   03AC    END SUB
