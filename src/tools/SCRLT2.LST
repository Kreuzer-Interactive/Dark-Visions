 0030   0006    '----- SCRLT2.BAS: clean visual proof of direct-CRTC scrolling 
                on the 486 Cirrus.
 0030   0006    '----- v1 (SCRLTEST) set no palette, so its bands showed as yel
                low/white mush. This
 0030   0006    '----- one sets a vivid palette and does ONE unmistakable thing
                : a 640x480x256 two-
 0030   0006    '----- page screen with page 0 = red top / green bottom and pag
                e 1 (VRAM line 480) =
 0030   0006    '----- solid blue with a big white "2". It scrolls the display 
                start straight from
 0030   0006    '----- page 0 down to page 1 and back, twice, by writing the Ci
                rrus CRTC start-
 0030   0006    '----- address registers directly (CR0C/CR0D + CR1B bits 0,2,3 
                = address bits 16-18;
 0030   0006    '----- Cirrus extensions unlocked with SR06=12h). No VESA BIOS 
                call. What you should
 0030   0006    '----- see: RED, then GREEN, then a BLUE screen with a white 2,
                 then back - a smooth
 0030   0006    '----- vertical scroll through three clear colours. Writes SCRL
                T2.LOG, auto-exits.
 0030   0006    '----- Build/run: src\tools\scrlt2.conf (DOSBox-X S3 proves it 
                too, minus the Cirrus
 0030   0006    '----- high-address bits which only the real card needs).
 0030   0006    DEFINT A-Z
 0030   0006    '$INCLUDE: 'UGL.BI'
 0030   0006    ''
 0030   0006    '' ugl.bi -- UGL routines
 0030   0006    ''
 0030   0006    
 0030   0006    Const UGL.TRUE%     = -1%
 0030   0006    Const UGL.FALSE%    = 0%
 0030   0006    
 0030   0006    Const DCTSIZE%      = 64%
 0030   0006    '' dc types:
 0030   0006    Const UGL.MEM%      = 0% * DCTSIZE%
 0030   0006    Const UGL.BNK%      = 1% * DCTSIZE%
 0030   0006    Const UGL.EMS%      = 2% * DCTSIZE%
 0030   0006    
 0030   0006    Const FMTSIZE%      = 128%
 0030   0006    '' color formats:
 0030   0006    Const UGL.8BIT%     = 0% * FMTSIZE%
 0030   0006    Const UGL.15BIT%    = 1% * FMTSIZE%
 0030   0006    Const UGL.16BIT%    = 2% * FMTSIZE%
 0030   0006    Const UGL.32BIT%    = 3% * FMTSIZE%
 0030   0006    
 0030   0006    '' buffer formats for uglRow Read/Write/SetPal routines
 0030   0006    Const UGL.BF.8BIT%  = 0% * 2%
 0030   0006    Const UGL.BF.15BIT% = 1% * 2%
 0030   0006    Const UGL.BF.16BIT% = 2% * 2%
 0030   0006    Const UGL.BF.32BIT% = 3% * 2%
 0030   0006    Const UGL.BF.24BIT% = 4% * 2%
 0030   0006    Const UGL.BF.IDX1%  = 5% * 2%
 0030   0006    Const UGL.BF.IDX4%  = 6% * 2%
 0030   0006    Const UGL.BF.IDX8%  = 7% * 2%
                                                                      PAGE   2
                                                                      16 Sep 26
