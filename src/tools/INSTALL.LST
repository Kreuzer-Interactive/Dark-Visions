 1074   0358    SUB Panel (r1, c1, r2, c2, tit$)
 107F   0358            DIM r, w
 107F   0358            w = c2 - c1 + 1
 108D   0358            COLOR 15, 1
 10A3   0358            LOCATE r1, c1: PRINT CHR$(201) + STRING$(w - 2, 205) + 
                CHR$(187);
 10F1   0358            FOR r = r1 + 1 TO r2 - 1
 1104   0358                    LOCATE r, c1: PRINT CHR$(186) + SPACE$(w - 2) +
                 CHR$(186);
 114C   0358            NEXT
 115B   0358            LOCATE r2, c1: PRINT CHR$(200) + STRING$(w - 2, 205) + 
                CHR$(188);
 11A9   0358            IF LEN(tit$) > 0 THEN
 11B8   0358                    COLOR 14, 1
 11CE   0358                    LOCATE r1, c1 + (w - LEN(tit$)) \ 2: PRINT tit$
                ;
 1204   0358            END IF
 1204   0358            COLOR 7, 1
 121A   0358    END SUB
 1222   0358    
