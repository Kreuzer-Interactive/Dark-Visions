 13C2   0358                    ELSE
 13C5   0358                            COLOR 15, 1: LOCATE r, 31: PRINT "  Yes
                  ";
 13FB   0358                            COLOR 0, 7: LOCATE r, 43: PRINT "  No  
                ";
 1433   0358                    END IF
 1433   0358                    COLOR 7, 1
 1449   0358                    CALL Status("LEFT / RIGHT to choose     ENTER t
                o accept")
 1468   0358                    k$ = INKEY$
 1477   0358                    IF LEN(k$) = 2 THEN
 1488   0358                            IF ASC(RIGHT$(k$, 1)) = 75 THEN sel = -
                1
 14A8   0358                            IF ASC(RIGHT$(k$, 1)) = 77 THEN sel = 0
 14C8   0358                    ELSEIF k$ = CHR$(13) THEN
 14E3   0358                            YesNo% = sel: EXIT FUNCTION
 14EC   0358                    ELSEIF k$ = "Y" OR k$ = "y" THEN
 1524   0358                            YesNo% = -1: EXIT FUNCTION
 152C   0358                    ELSEIF k$ = "N" OR k$ = "n" THEN
 1564   0358                            YesNo% = 0: EXIT FUNCTION
 156C   0358                    END IF
 156C   0358            LOOP
 156F   0358    END FUNCTION
 1583   0358    
 1583   0358    FUNCTION Exists% (f$)
 158E   0358            DIM fh
 158E   0358            fh = FREEFILE
 1596   0358            erflag = 0
 159C   0358            ON ERROR GOTO fhandler
 15A6   0358            OPEN f$ FOR INPUT AS #fh
 15B9   0358            ON ERROR GOTO 0
 15C3   0358            IF erflag = 0 THEN
 15CD   0358                    CLOSE #fh
 15D9   0358                    Exists% = -1
 15DE   0358            ELSE
 15E1   0358                    Exists% = 0
 15E6   0358            END IF
 15E6   0358    END FUNCTION
 15F1   0358    
 15F1   0358    '----- one VESA INT 10h call with ES:DI -> vbuf (the 256-byte i
                nfo block)
 15F1   0358    SUB VbeInt (rx AS RegTypeX)
 15FC   0358            DIM rx2 AS RegTypeX, vi AS INTEGER
 15FC   0358            rx.bp = 0: rx.si = 0: rx.flags = 0: rx.ds = -1
 162C   0358            rx.es = VARSEG(vbuf(0)): rx.di = VARPTR(vbuf(0))
 1645   0358            vi = &H10
 164A   0358            CALL INTERRUPTX(vi, rx, rx2)
 165A   0358            rx.ax = rx2.ax: rx.bx = rx2.bx: rx.cx = rx2.cx: rx.dx =
                 rx2.dx
 1689   0358    END SUB
 1691   0358    
 1691   0358    '----- byte / word i of vbuf (unsigned)
 1691   0358    FUNCTION VBb% (i AS INTEGER)
 169C   0358            DIM w AS LONG
                                                                      PAGE   8
                                                                      15 Sep 26
                                                                      19:11:49
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 169C   0358            w = vbuf(i \ 2)
 16B6   0358            IF w < 0 THEN w = w + 65536
 16DD   0358            IF (i AND 1) THEN VBb% = w \ 256 ELSE VBb% = w AND 255
 1712   0358    END FUNCTION
 171D   0358    
 171D   0358    FUNCTION VBw& (i AS INTEGER)
 1728   0358            VBw& = VBb%(i) + 256& * VBb%(i + 1)
 176F   0358    END FUNCTION
 177D   0358    
 177D   0358    '----- TRUE if the card has VESA VBE with 640x480x256 (mode 101
                h) = what the
 177D   0358    '----- illustrated manual needs. Non-destructive (query only, s
                creen untouched).
 177D   0358    FUNCTION ManualOK%
 1788   0358            DIM rx AS RegTypeX, i AS INTEGER
 1788   0358            ManualOK% = 0
 178D   0358            '----- VBE present? (4F00h -> "VESA" signature, AL = 4F
                h)
 178D   0358            FOR i = 0 TO 255: vbuf(i) = 0: NEXT
 17AB   0358            rx.ax = &H4F00: rx.bx = 0: rx.cx = 0: rx.dx = 0
 17BF   0358            CALL VbeInt(rx)
 17C8   0358            IF rx.ax <> &H4F THEN EXIT FUNCTION
 17D4   0358            IF VBb%(0) <> 86 OR VBb%(1) <> 69 OR VBb%(2) <> 83 OR V
                Bb%(3) <> 65 THEN EXIT FUNCTION
 1850   0358            '----- mode 101h (640x480x256) present + supported by t
                his hardware?
 1850   0358            FOR i = 0 TO 255: vbuf(i) = 0: NEXT
 186F   0358            rx.ax = &H4F01: rx.bx = 0: rx.cx = &H101: rx.dx = 0
 1883   0358            CALL VbeInt(rx)
 188C   0358            IF rx.ax <> &H4F THEN EXIT FUNCTION
 1898   0358            IF (VBw&(0) AND 1) = 0 THEN EXIT FUNCTION
 18CC   0358            IF VBw&(18) = 640 AND VBw&(20) = 480 AND VBb%(25) = 8 T
                HEN ManualOK% = -1
 1951   0358    END FUNCTION
