 0030   0006    '----- INSTALL.BAS - Dark Visions setup (DOS text-mode installe
                r, QB4.5).
 0030   0006    '----- Disk 1 carries INSTALL.EXE + GAME.ZIP + PKUNZIP.EXE and 
                installs the game.
 0030   0006    '----- If the player chooses the manual, it asks for Disk 2 (MA
                NUAL.ZIP) and
 0030   0006    '----- installs the 640x480 illustrated manual into the same fo
                lder.
 0030   0006    '----- PKUNZIP is copied to the target with QB file I/O (NOT th
                e DOS COPY command,
 0030   0006    '----- which errors on real MS-DOS) so it is present after the 
                Disk 2 swap. PKUNZIP
 0030   0006    '----- output is shown on screen (no redirection) for maximum D
                OS compatibility.
 0030   0006    DEFINT A-Z
 0030   0006    TYPE RegTypeX
 0030   0006            ax AS INTEGER
 0030   0006            bx AS INTEGER
 0030   0006            cx AS INTEGER
 0030   0006            dx AS INTEGER
 0030   0006            bp AS INTEGER
 0030   0006            si AS INTEGER
 0030   0006            di AS INTEGER
 0030   0006            flags AS INTEGER
 0030   0006            ds AS INTEGER
 0030   0006            es AS INTEGER
 0030   0006    END TYPE
 0030   0006    DECLARE SUB INTERRUPTX (intnum AS INTEGER, inreg AS RegTypeX, o
                utreg AS RegTypeX)
 0030   0006    DECLARE SUB VbeInt (rx AS RegTypeX)
 0030   0006    DECLARE FUNCTION ManualOK% ()
 0030   0006    DECLARE FUNCTION VBb% (i AS INTEGER)
 0030   0006    DECLARE FUNCTION VBw& (i AS INTEGER)
 0030   0006    DECLARE SUB Backdrop ()
 0030   0006    DECLARE SUB Panel (r1, c1, r2, c2, tit$)
 0030   0006    DECLARE SUB Cent (r, s$)
 0030   0006    DECLARE SUB At (r, c, s$)
 0030   0006    DECLARE SUB Status (s$)
 0030   0006    DECLARE SUB WaitKey ()
 0030   0006    DECLARE SUB Quit ()
 0030   0006    DECLARE SUB CopyFile (src$, dst$)
 0030   0006    DECLARE FUNCTION Exists% (f$)
 0030   0006    DECLARE FUNCTION YesNo% (r, defyes)
 0030   0006    DECLARE FUNCTION GetPath$ (defp$)
 0030   0006    
 0030   0006    DIM SHARED erflag AS INTEGER
 0030   0006    DIM SHARED vbuf(0 TO 255) AS INTEGER
 0030   0006    DIM dest AS STRING, wantman AS INTEGER, k AS STRING, ok AS INTE
                GER
 0030   0006    
 0030   0006    '============ WELCOME ============
 0030   0006    CALL Backdrop
 0035   0214    CALL Panel(6, 15, 19, 66, " Setup ")
 007C   0220    CALL Cent(8, "D A R K   V I S I O N S")
