 0CE3   0358    
 0CE3   0358    '----- copy a file with QB binary I/O (no DOS COPY; real MS-DOS
                 rejects some COPY forms)
 0CE3   0358    SUB CopyFile (src$, dst$)
 0CEE   0358            DIM total AS LONG
 0CEE   0358            DIM bpos AS LONG
 0CEE   0358            erflag = 0
 0CF4   0358            ON ERROR GOTO fhandler
 0CFE   0358            fh1 = FREEFILE
 0D06   0358            OPEN src$ FOR BINARY ACCESS READ AS #fh1
 0D19   0358            IF erflag THEN
 0D23   0358                    ON ERROR GOTO 0
 0D2D   0358                    EXIT SUB
 0D30   0358            END IF
 0D30   0358            total = LOF(fh1)
 0D3E   0358            fh2 = FREEFILE
 0D46   0358            OPEN dst$ FOR OUTPUT AS #fh2
 0D59   0358            CLOSE #fh2
 0D65   0358            OPEN dst$ FOR BINARY AS #fh2
 0D78   0358            bpos = 1
 0D82   0358            DO WHILE bpos <= total
 0D98   0358                    chunk = 16384
 0D9D   0358                    IF total - bpos + 1 < chunk THEN chunk = CINT(t
                otal - bpos + 1)
 0DD6   0358                    buf$ = SPACE$(chunk)
 0DE8   0358                    GET #fh1, bpos, buf$
 0E00   0358                    PUT #fh2, bpos, buf$
 0E18   0358                    bpos = bpos + chunk
 0E28   0358            LOOP
 0E2C   0358            CLOSE #fh1
 0E38   0358            CLOSE #fh2
 0E44   0358            ON ERROR GOTO 0
 0E4E   0358    END SUB
 0E5F   0358    
 0E5F   0358    '----- editable path field with a default
 0E5F   0358    FUNCTION GetPath$ (defp$)
 0E6A   0358            DIM p$, k$
 0E6A   0358            p$ = defp$
 0E76   0358            COLOR 15, 1: LOCATE 12, 22: PRINT "Path:";
 0EAE   0358            DO
 0EAE   0358                    COLOR 14, 1: LOCATE 12, 28: PRINT p$ + "_" + SP
                ACE$(40 - LEN(p$));
 0F0B   0358                    CALL Status("Type a path   BKSP = edit   ENTER 
                = accept")
 0F2A   0358                    DO: k$ = INKEY$: LOOP WHILE k$ = ""
 0F48   0358                    IF k$ = CHR$(13) THEN
 0F60   0358                            IF LEN(p$) > 0 THEN EXIT DO
 0F73   0358                    ELSEIF k$ = CHR$(8) THEN
 0F8E   0358                            IF LEN(p$) > 0 THEN p$ = LEFT$(p$, LEN(
                p$) - 1)
 0FBC   0358                    ELSEIF k$ = CHR$(27) THEN
 0FD7   0358                            CALL Quit
 0FDC   0358                    ELSEIF LEN(k$) = 1 THEN
 0FF0   0358                            IF k$ >= " " AND LEN(p$) < 40 THEN p$ =
                                                                      PAGE   6
                                                                      15 Sep 26
                                                                      19:11:49
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

                 p$ + UCASE$(k$)
 1041   0358                    END IF
 1041   0358            LOOP
 1044   0358            GetPath$ = p$
 1051   0358    END FUNCTION
