 1337   0358    '----- highlighted Yes / No selector (arrows + ENTER, or Y/N)
 1337   0358    FUNCTION YesNo% (r, defyes)
 1342   0358            DIM sel, k$
 1342   0358            sel = defyes
 134A   0358            DO
 134A   0358                    IF sel THEN
 1354   0358                            COLOR 0, 7: LOCATE r, 31: PRINT "  Yes 
                 ";
 138C   0358                            COLOR 15, 1: LOCATE r, 43: PRINT "  No 
                 ";
                                                                      PAGE   7
