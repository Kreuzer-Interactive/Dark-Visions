 096F   088C    '----- draw the page at angle ang as two perspective-correct te
                xtured triangles into
 096F   088C    '----- the MEM back-buffer, then blit the back-buffer to video.
                 Corners rotate about
 096F   088C    '----- the vertical centre; persp = dist/(dist+Z); vertex z = p
                ersp (=1/w), u/v =
 096F   088C    '----- texCoord*persp. texcoords TL(0,0) TR(1,0) BR(1,1) BL(0,1
                ).
 096F   088C    SUB Frame (back AS LONG, video AS LONG, t1 AS TriType, t2 AS Tr
                iType, tex AS LONG, ang AS SINGLE, cx AS INTEGER, cy AS INTEGER
                , w2 AS SINGLE, h2 AS SINGLE, dist AS SINGLE)
 098C   088C            DIM s AS SINGLE, c AS SINGLE, pl AS SINGLE, pr AS SINGL
                E
 098C   088C            DIM tlx AS SINGLE, tly AS SINGLE, trx AS SINGLE, tryy A
                S SINGLE
 098C   088C            DIM brx AS SINGLE, bry AS SINGLE, blx AS SINGLE, bly AS
                 SINGLE
 098C   088C            s = SIN(ang * D2R): c = COS(ang * D2R)
 098C   088C            pl = dist / (dist + (-w2 * s))
 098C   088C            pr = dist / (dist + (w2 * s))
 098C   088C            tlx = cx + (-w2 * c) * pl: tly = cy + (-h2) * pl
 098C   088C            trx = cx + (w2 * c) * pr: tryy = cy + (-h2) * pr
 098C   088C            brx = cx + (w2 * c) * pr: bry = cy + (h2) * pr
 098C   088C            blx = cx + (-w2 * c) * pl: bly = cy + (h2) * pl
 098C   088C            t1.v1.x = tlx: t1.v1.y = tly: t1.v1.z = pl: t1.v1.u = 0
                : t1.v1.v = 0
 098C   088C            t1.v2.x = trx: t1.v2.y = tryy: t1.v2.z = pr: t1.v2.u = 
                pr: t1.v2.v = 0
 098C   088C            t1.v3.x = brx: t1.v3.y = bry: t1.v3.z = pr: t1.v3.u = p
                r: t1.v3.v = pr
 098C   088C            t2.v1.x = tlx: t2.v1.y = tly: t2.v1.z = pl: t2.v1.u = 0
                : t2.v1.v = 0
 098C   088C            t2.v2.x = brx: t2.v2.y = bry: t2.v2.z = pr: t2.v2.u = p
                r: t2.v2.v = pr
 098C   088C            t2.v3.x = blx: t2.v3.y = bly: t2.v3.z = pl: t2.v3.u = 0
                : t2.v3.v = pl
 098C   088C            uglClear back, 248
 0CD4   088C            uglTriTP back, t1, UGL.MASK.FALSE, tex
 0CF3   088C            uglTriTP back, t2, UGL.MASK.FALSE, tex
 0D12   088C            uglPut video, 0, 0, back
 0D2B   088C    END SUB
