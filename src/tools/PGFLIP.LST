 0D33   088C    SUB Hold (secs AS SINGLE)
 0D3E   088C            DIM t9 AS SINGLE, d9 AS SINGLE
 0D3E   088C            t9 = TIMER
 0D3E   088C            DO
 0D4E   088C                    d9 = TIMER - t9: IF d9 < 0 THEN d9 = d9 + 86400
 0D86   088C            LOOP WHILE d9 < secs
