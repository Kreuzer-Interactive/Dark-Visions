 0030   0006    CONST PI = 3.141593, D2R = PI / 180!
 0030   0006    
 0030   0006    DECLARE SUB Lg (s AS STRING)
 0030   0006    DECLARE SUB Frame (back AS LONG, video AS LONG, t1 AS TriType, 
                t2 AS TriType, tex AS LONG, ang AS SINGLE, cx AS INTEGER, cy AS
                 INTEGER, w2 AS SINGLE, h2 AS SINGLE, dist AS SINGLE)
 0030   0006    DECLARE SUB Hold (secs AS SINGLE)
 0030   0006    
 0030   0006    DIM SHARED lf AS INTEGER
 0030   0006    
 0030   0006    DIM video AS LONG, back AS LONG, tex AS LONG, inf AS TDC, rc AS
                 CLIPRECT
 0030   0006    DIM t1 AS TriType, t2 AS TriType
 0030   0006    DIM pal(0 TO 255) AS tRGB
 0030   0006    DIM ps AS STRING * 1024
 0030   0006    DIM ang AS SINGLE, dist AS SINGLE, w2 AS SINGLE, h2 AS SINGLE
 0030   0006    DIM cx AS INTEGER, cy AS INTEGER, i AS INTEGER, bf AS INTEGER, 
                rep AS INTEGER, big AS INTEGER
 0030   0006    DIM fr AS INTEGER, t0 AS SINGLE, t1t AS SINGLE
 0030   0006    
 0030   0006    lf = FREEFILE
 0030   081E    OPEN "pgflip.log" FOR OUTPUT AS #lf
 0030   081E    CALL Lg("PGFLIP persp-bb " + DATE$ + " " + TIME$)
 008E   0822    IF NOT uglInit THEN CALL Lg("uglInit FAILED"): CLOSE #lf: END
 00D3   0828    video = uglSetVideoDC(UGL.8BIT, 640, 480, 1)
 00D3   0828    IF video = 0 THEN CALL Lg("640x480x8 refused"): uglEnd: CLOSE #
                lf: END
 0149   0830    
 0149   0830    '----- MEM back-buffer for the perspective triangles (blitted t
                o video each frame)
 0149   0830    back = uglNew(UGL.MEM, UGL.8BIT, 640, 480)
 0149   0830    CALL Lg("back-buffer 640x480 MEM = " + STR$(back) + " (0 = allo
                c failed)")
 01AC   0838    IF back = 0 THEN CALL Lg("no back-buffer"): uglRestore: uglEnd:
                 CLOSE #lf: END
 01FE   083C    rc.xMin = 0: rc.yMin = 0: rc.xMax = 639: rc.yMax = 479
 01FE   083C    uglSetClipRect back, rc
 022A   083C    
 022A   083C    big = -1
 022A   083C    tex = uglNewBMPEx(UGL.MEM, UGL.8BIT, "mantex.bmp", BMPOPT.NO332
                )
 022A   083C    IF tex = 0 THEN big = 0: tex = uglNewBMPEx(UGL.MEM, UGL.8BIT, "
                mantx128.bmp", BMPOPT.NO332)
 02C5   084C    IF tex = 0 THEN CALL Lg("no texture DC"): uglRestore: uglEnd: C
                LOSE #lf: END
 0317   0850    uglDCGet tex, inf
 032B   0850    CALL Lg("texture" + STR$(inf.xRes) + "x" + STR$(inf.yRes) + " s
                ize" + STR$(inf.size) + " (256 ok:" + STR$(big) + ")")
 03B6   0854    
 03B6   0854    '----- the page's real palette (the texture holds MANP00's indi
                ces)
 03B6   0854    bf = FREEFILE
 03B6   0854    OPEN "manp00.bmp" FOR BINARY AS #bf
 03B6   0854    GET #bf, 55, ps
                                                                      PAGE  17
                                                                      16 Sep 26
                                                                      22:14:02
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 03B6   0854    CLOSE #bf
 03B6   0854    FOR i = 0 TO 255
 0400   0854            pal(i).blue = MID$(ps, i * 4 + 1, 1)
 0400   0854            pal(i).green = MID$(ps, i * 4 + 2, 1)
 0400   0854            pal(i).red = MID$(ps, i * 4 + 3, 1)
 0400   0854    NEXT
 04C0   0854    uglPalSetBuff 0, 256, pal(0)
 04D3   0854    CALL Lg("palette set; about to draw frame 1")
 04F2   0858    
 04F2   0858    cx = 320: cy = 240: w2 = 256: h2 = 192
 04F2   0858    dist = 700
 04F2   0858    
 04F2   0858    CALL Frame(back, video, t1, t2, tex, 0, cx, cy, w2, h2, dist)
 055F   085C    CALL Lg("px in(320,240)=" + STR$(uglPGet(video, 320, 240)) + " 
                in(120,120)=" + STR$(uglPGet(video, 120, 120)) + " out(10,10)="
                 + STR$(uglPGet(video, 10, 10)))
 061C   086C    CALL Hold(3)
 0631   0870    '----- max-speed timing (unpaced) = the real 486 frame rate for
                 this flip
 0631   0870    fr = 0: t0 = TIMER
 0631   0870    FOR rep = 1 TO 3
 064E   0870            FOR ang = 0 TO 88 STEP 4
 0656   0870                    CALL Frame(back, video, t1, t2, tex, ang, cx, c
                y, w2, h2, dist): fr = fr + 1
 0687   0870            NEXT
 06AF   0870            FOR ang = 88 TO 0 STEP -4
 06B8   0870                    CALL Frame(back, video, t1, t2, tex, ang, cx, c
                y, w2, h2, dist): fr = fr + 1
 06E9   0870            NEXT
 0711   0870    NEXT
 0720   0870    t1t = TIMER - t0: IF t1t <= 0 THEN t1t = .001
 0758   0870    CALL Lg("max-speed flip:" + STR$(fr) + " frames in" + STR$(t1t)
                 + " s =" + STR$(fr / t1t) + " fps")
 07DC   0874    '----- now the slow, watchable version
 07DC   0874    FOR rep = 1 TO 3
 07E2   0874            FOR ang = 0 TO 88 STEP 4
 07EA   0874                    CALL Frame(back, video, t1, t2, tex, ang, cx, c
                y, w2, h2, dist)
 081B   0874                    CALL Hold(.05)
 0830   0878            NEXT
 0854   0878            FOR ang = 88 TO 0 STEP -4
 085C   0878                    CALL Frame(back, video, t1, t2, tex, ang, cx, c
                y, w2, h2, dist)
 088D   0878                    CALL Hold(.05)
 08A2   087C            NEXT
 08C6   087C    NEXT
 08D5   087C    CALL Frame(back, video, t1, t2, tex, 0, cx, cy, w2, h2, dist)
 0912   0880    CALL Lg("shown: full cover + 3 rock-flips + full cover")
 0931   0884    CALL Hold(3)
 0946   0888    CALL Lg("DONE")
 0965   088C    uglRestore
 096A   088C    uglEnd
 096F   088C    CLOSE #lf
 096F   088C    END
