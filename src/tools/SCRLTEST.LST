 09BE   0128    SUB Bands (pg AS INTEGER, shift AS INTEGER, mk AS INTEGER)
 09C9   0128            DIM b AS INTEGER, y AS INTEGER, k AS INTEGER, c AS LONG
 09C9   0128            uglSetWrkPage pg
 09D3   0128            FOR b = 0 TO 14
 09D8   0128                    c = ((b + shift) MOD 15) * 16 + 20
 09D8   0128                    uglRectF video, 0, b * 32, 639, b * 32 + 31, c
 0A27   0128            NEXT
 0A33   0128            '----- row markers every 60 lines: a 3-line bar, then n
                 ticks (n = line / 60)
 0A33   0128            FOR y = 0 TO 420 STEP 60
 0A38   0128                    uglRectF video, 0, y, 639, y + 2, CLNG(mk)
 0A5E   0128                    FOR k = 1 TO y \ 60
 0A70   0128                            uglRectF video, k * 24, y + 4, k * 24 +
                 12, y + 14, CLNG(mk)
 0A9D   0128                    NEXT
 0AA9   0128            NEXT
 0AB7   0128            uglSetWrkPage 0
 0ABF   0128    END SUB
 0AC7   0128    
 0AC7   0128    '----- n black squares top-left of page 0 (visible whenever the
                 start is 0)
 0AC7   0128    SUB Marker (n AS INTEGER)
 0AD2   0128            DIM k AS INTEGER
 0AD2   0128            uglSetWrkPage 0
 0ADA   0128            uglRectF video, 400, 4, 639, 26, 255
 0AFD   0128            FOR k = 1 TO n
 0B0C   0128                    uglRectF video, 400 + k * 30, 6, 400 + k * 30 +
                 20, 24, 0
 0B36   0128            NEXT
 0B42   0128    END SUB
 0B4A   0128    
                                                                      PAGE  20
                                                                      16 Sep 26
                                                                      20:22:25
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 0B4A   0128    '----- direct CRTC display start: ofs = byte offset into video 
                memory
 0B4A   0128    SUB StartDirect (ofs AS LONG)
 0B55   0128            DIM u AS LONG, b AS INTEGER
 0B55   0128            u = ofs \ unit
 0B55   0128            WAIT &H3DA, 8, 8
 0B55   0128            CALL CrtW(&HC, (u \ 256) AND 255)
 0BA9   0128            CALL CrtW(&HD, u AND 255)
 0BCA   0128            IF cirrus THEN
 0BCA   0128                    b = Crt%(&H1B) AND &HF2
 0BCA   0128                    IF u AND &H10000 THEN b = b OR 1
 0C0E   0128                    IF u AND &H20000 THEN b = b OR 4
 0C2A   0128                    IF u AND &H40000 THEN b = b OR 8
 0C46   0128                    CALL CrtW(&H1B, b)
 0C58   0128                    IF chip >= &HA0 THEN
 0C58   0128                            b = Crt%(&H1D) AND &H7F
 0C58   0128                            IF u AND &H80000 THEN b = b OR &H80
 0C9D   0128                            CALL CrtW(&H1D, b)
 0CAF   0128                    END IF
 0CAF   0128            END IF
 0CAF   0128            WAIT &H3DA, 8
 0CAF   0128    END SUB
 0CC2   0128    
 0CC2   0128    '----- VESA VBE 4F07h BL=0: CX = first pixel, DX = first line
 0CC2   0128    SUB StartVesa (x AS INTEGER, y AS INTEGER)
 0CCD   0128            DIM r AS RegTypeX, r2 AS RegTypeX, vi AS INTEGER
 0CCD   0128            WAIT &H3DA, 8, 8
 0CCD   0128            r.ax = &H4F07: r.bx = 0: r.cx = x: r.dx = y
 0CCD   0128            r.bp = 0: r.si = 0: r.di = 0: r.flags = 0: r.ds = -1: r
                .es = -1
 0CCD   0128            vi = &H10
 0CCD   0128            CALL INTERRUPTX(vi, r, r2)
 0D2A   0128            WAIT &H3DA, 8
 0D2A   0128    END SUB
 0D3D   0128    
 0D3D   0128    SUB LogRegs (tag AS STRING)
 0D48   0128            CALL Lg(tag + ": CR0C " + HEX$(Crt%(&HC)) + " CR0D " + 
                HEX$(Crt%(&HD)) + " CR1B " + HEX$(Crt%(&H1B)) + " CR1D " + HEX$
                (Crt%(&H1D)) + " CR13 " + HEX$(Crt%(&H13)) + " SR06 " + HEX$(Se
                qR%(6)))
 0E98   0128    END SUB
