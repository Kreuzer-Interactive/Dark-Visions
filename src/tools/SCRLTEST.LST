 04CF   00A0    CALL LogRegs("start as set by uGL")
 04EE   00A4    
 04EE   00A4    '----- the pictures: page 0 white markers, page 1 shifted bands
                 + black markers
 04EE   00A4    uglSetVisPage 0
 04F6   00A4    CALL Bands(0, 0, 255)
 0519   00AA    CALL Bands(1, 8, 0)
 053C   00B0    uglSetWrkPage 0
 0544   00B0    CALL Hold(2)
 0559   00B4    
 0559   00B4    '----- phase 1: VESA 4F07h
 0559   00B4    CALL Marker(1)
 0568   00B6    CALL Hold(1)
 057D   00BA    FOR y = 0 TO 480 STEP 2
 0582   00BA            CALL StartVesa(0, y)
 0595   00BC            IF y = 480 THEN CALL LogRegs("phase1 vesa y=480")
 05BF   00C0    NEXT
 05CD   00C0    CALL Hold(1)
 05E2   00C4    FOR y = 480 TO 0 STEP -2
 05E8   00C4            CALL StartVesa(0, y)
 05FB   00C6    NEXT
 0608   00C6    CALL LogRegs("phase1 vesa back at 0")
 0627   00CA    CALL Hold(1)
 063C   00CE    
 063C   00CE    '----- phase 2: direct CRTC, same movement
 063C   00CE    CALL Marker(2)
 064B   00D0    CALL Hold(1)
 0660   00D4    FOR y = 0 TO 480 STEP 2
 0666   00D4            CALL StartDirect(y * pitch)
 0686   00D8            IF y = 480 THEN CALL LogRegs("phase2 direct y=480")
 06B0   00DC    NEXT
 06BE   00DC    CALL Hold(1)
 06D3   00E0    FOR y = 480 TO 0 STEP -2
 06DA   00E0            CALL StartDirect(y * pitch)
 06FA   00E4    NEXT
 0707   00E4    CALL LogRegs("phase2 direct back at 0")
 0726   00E8    CALL Hold(1)
 073B   00EC    
 073B   00EC    '----- phase 3: sideways (x in bytes, must be a multiple of the
                 unit)
 073B   00EC    CALL Marker(3)
 074A   00EE    CALL Hold(1)
 075F   00F2    FOR x = 0 TO 384 STEP 4
 0764   00F2            CALL StartDirect(CLNG(x))
 0775   00F6    NEXT
 0783   00F6    CALL LogRegs("phase3 direct x=384")
 07A2   00FA    CALL Hold(1)
 07B7   00FE    FOR x = 384 TO 0 STEP -4
 07BE   00FE            CALL StartDirect(CLNG(x))
 07CF   0102    NEXT
 07DC   0102    CALL Hold(1)
 07F1   0106    
