 0030   0006    
 0030   0006    DIM SHARED lf AS INTEGER
 0030   0006    DIM SHARED video AS LONG
 0030   0006    DIM SHARED pitch AS LONG, unit AS INTEGER, cirrus AS INTEGER, c
                hip AS INTEGER
 0030   0006    
 0030   0006    DIM inf AS TDC
 0030   0006    DIM xr AS INTEGER, yr AS INTEGER, np AS INTEGER, i AS INTEGER, 
                y AS INTEGER, x AS INTEGER
 0030   0006    DIM t0 AS SINGLE, t1 AS SINGLE, n AS INTEGER, s6 AS INTEGER, s6
                b AS INTEGER, s6c AS INTEGER
 0030   0006    
 0030   0006    lf = FREEFILE
 0030   004E    OPEN "scrltest.log" FOR OUTPUT AS #lf
 0030   004E    CALL Lg("SCRLTEST " + DATE$ + " " + TIME$ + " free" + STR$(FRE(
                -1)))
 00AF   0052    IF NOT uglInit THEN CALL Lg("uglInit FAILED"): CALL Done
 00E7   0058    xr = 640: yr = 480: np = 2
 00E7   0058    video = uglSetVideoDC(UGL.8BIT, xr, yr, np)
 00E7   0058    IF video = 0 THEN
 00E7   0058            CALL Lg("640x480x8 2 pages: refused - nothing to scroll
                 into")
 0158   0060            uglEnd
 015D   0060            CALL Done
 0162   0060    END IF
 0162   0060    uglDCGet video, inf
 0176   0060    pitch = inf.bps
 0176   0060    CALL Lg("mode 640x480x8 2 pages, bps" + STR$(inf.bps) + " size"
                 + STR$(inf.size))
 01CE   0064    
 01CE   0064    '----- CRTC addressing unit: CR14 bit 6 = doubleword, else CR17
                 bit 6 = byte, else word
 01CE   0064    IF Crt%(&H14) AND &H40 THEN
 01CE   0064            unit = 4
 01CE   0064    ELSEIF Crt%(&H17) AND &H40 THEN
 01F6   0068            unit = 1
 01F6   0068    ELSE
 021E   006C            unit = 2
 021E   006C    END IF
 0224   006C    '----- Cirrus? SR06 reads 0Fh when locked (after any write but 
                12h), 12h when unlocked
 0224   006C    s6 = SeqR%(6)
 0224   006C    CALL SeqW(6, &HA)
 0255   0074    s6b = SeqR%(6)
 0255   0074    CALL SeqW(6, &H12)
 0286   007C    s6c = SeqR%(6)
 0286   007C    cirrus = 0: chip = 0
 0286   007C    IF s6b = &HF AND s6c = &H12 THEN cirrus = -1: chip = Crt%(&H27)
 02E5   0084    CALL Lg("SR06 as found " + HEX$(s6) + ", after 0A -> " + HEX$(s
                6b) + ", after 12 -> " + HEX$(s6c) + "  cirrus" + STR$(cirrus) 
                + " CR27 " + HEX$(chip))
 039C   0088    CALL Lg("unit" + STR$(unit) + " bytes (CR14 " + HEX$(Crt%(&H14)
                ) + " CR17 " + HEX$(Crt%(&H17)) + ")  CR13 " + HEX$(Crt%(&H13))
                 + " CR1B " + HEX$(Crt%(&H1B)) + " CR1D " + HEX$(Crt%(&H1D)))
