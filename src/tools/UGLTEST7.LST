 0030   0006    DECLARE SUB INTERRUPT (intnum AS INTEGER, inreg AS RegType, out
                reg AS RegType)
 0030   0006    DECLARE SUB Lg (s AS STRING)
 0030   0006    DECLARE SUB Hold (secs AS SINGLE)
 0030   0006    DECLARE SUB Done ()
 0030   0006    DECLARE FUNCTION BiosMode% ()
 0030   0006    DECLARE FUNCTION TryMode& (tag AS STRING, xr AS INTEGER, yr AS 
                INTEGER, np AS INTEGER)
 0030   0006    DECLARE SUB Cycle (tag AS STRING)
 0030   0006    
 0030   0006    DIM SHARED lf AS INTEGER
 0030   0006    
 0030   0006    lf = FREEFILE
 0030   0008    OPEN "ugltest7.log" FOR OUTPUT AS #lf
 0030   0008    CALL Lg("start: bios mode" + STR$(BiosMode%))
 0084   000E    CALL Cycle("c1 (from text)")
 00A3   0012    SCREEN 1
 00A3   0012    LINE (0, 0)-(319, 199), 2, BF
 00A3   0012    CALL Lg("after SCREEN 1: bios mode" + STR$(BiosMode%))
 010F   0018    CALL Hold(1)
 0124   001C    CALL Cycle("c2 (from CGA)")
 0143   0020    CALL Lg("after c2: bios mode" + STR$(BiosMode%) + " (game expec
                ts 4)")
 0184   0026    LINE (0, 0)-(319, 199), 1, BF
 0184   0026    CALL Hold(1)
 01C0   002A    CALL Cycle("c3 (from CGA again)")
 01DF   002E    CALL Lg("after c3: bios mode" + STR$(BiosMode%))
 0216   0034    SCREEN 0
 0216   0034    CALL Lg("DONE")
 0245   0038    CALL Done
 024A   0038    
 024A   0038    FUNCTION BiosMode%
 0255   0038            DIM r AS RegType, r2 AS RegType, vi AS INTEGER
 0255   0038            vi = &H10
 0255   0038            r.ax = &HF00
 0255   0038            CALL INTERRUPT(vi, r, r2)
 0270   0038            BiosMode% = r2.ax AND 255
 0270   0038    END FUNCTION
 0284   0038    
 0284   0038    '----- uglInit / ladder / hold / uglRestore / uglEnd, like VgaO
                pen + VgaClose
 0284   0038    SUB Cycle (tag AS STRING)
 028F   0038            DIM v AS LONG, r AS INTEGER
 028F   0038            IF NOT uglInit THEN CALL Lg(tag + " uglInit FAILED"): E
                XIT SUB
 02CE   0038            CALL Lg(tag + " init ok, bios mode" + STR$(BiosMode%))
 030D   0038            v = TryMode&(tag, 640, 480, 2)
 030D   0038            IF v = 0 THEN v = TryMode&(tag + " fallback", 640, 480,
                 1)
 03AC   0038            IF v = 0 THEN v = TryMode&(tag + " fallback", 320, 200,
                 1)
                                                                      PAGE  17
                                                                      13 Sep 26
                                                                      09:48:32
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 0416   0038            IF v <> 0 THEN
 0416   0038                    CALL Lg(tag + " in mode: bios mode" + STR$(Bios
                Mode%))
 046A   0038                    r = uglPutBMPEx(v, 0, 0, "tplogo.bmp", BMPOPT.N
                O332)
 046A   0038                    CALL Hold(1)
 04B4   0038            END IF
 04B4   0038            uglRestore
 04B9   0038            CALL Lg(tag + " after uglRestore: bios mode" + STR$(Bio
                sMode%))
 04F8   0038            uglEnd
 04FD   0038    END SUB
 0505   0038    
 0505   0038    SUB Done
 0510   0038            CLOSE #lf
 0510   0038            END
 0510   0038    END SUB
 052A   0038    
 052A   0038    SUB Hold (secs AS SINGLE)
 0535   0038            DIM t9 AS SINGLE, d9 AS SINGLE
 0535   0038            t9 = TIMER
 0535   0038            DO
 0546   0038                    d9 = TIMER - t9: IF d9 < 0 THEN d9 = d9 + 86400
 057E   0038            LOOP WHILE d9 < secs
 057E   0038    END SUB
 0599   0038    
 0599   0038    SUB Lg (s AS STRING)
 05A4   0038            PRINT #lf, s
 05A4   0038    END SUB
 05BD   0038    
 05BD   0038    FUNCTION TryMode& (tag AS STRING, xr AS INTEGER, yr AS INTEGER,
                 np AS INTEGER)
 05C8   0038            DIM v AS LONG, inf AS TDC
 05C8   0038            v = uglSetVideoDC(UGL.8BIT, xr, yr, np)
 05C8   0038            IF v = 0 THEN
 05C8   0038                    CALL Lg(tag + ":" + STR$(xr) + "x" + LTRIM$(STR
                $(yr)) + " pages" + STR$(np) + " -> FAILED")
 0685   0038            ELSE
 0688   0038                    uglDCGet v, inf
 069A   0038                    CALL Lg(tag + ":" + STR$(xr) + "x" + LTRIM$(STR
                $(yr)) + " pages" + STR$(np) + " -> ok, bps" + STR$(inf.bps) + 
                " pages" + STR$(inf.pages))
 0741   0038            END IF
 0741   0038            TryMode& = v
 0741   0038    END FUNCTION
