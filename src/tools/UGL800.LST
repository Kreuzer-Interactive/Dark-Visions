 0225   0032    
 0225   0032    SUB TryMode (bpp AS INTEGER, xr AS INTEGER, yr AS INTEGER, np A
                S INTEGER)
 0230   0032            DIM v AS LONG, inf AS TDC, tag AS STRING
 0230   0032            tag = LTRIM$(STR$(xr)) + "x" + LTRIM$(STR$(yr)) + " pag
                es" + STR$(np)
 0230   0032            v = uglSetVideoDC(bpp, xr, yr, np)
 0230   0032            IF v = 0 THEN
 0230   0032                    CALL Lg(tag + ": REFUSED")
 02EF   0032            ELSE
 02F2   0032                    uglDCGet v, inf
 0304   0032                    CALL Lg(tag + ": OK bps" + STR$(inf.bps) + " pa
                ges" + STR$(inf.pages) + " vram bytes" + STR$(inf.size) + " fre
                e" + STR$(FRE(-1)))
 0392   0032                    uglRestore
 0397   0032            END IF
 0397   0032    END SUB
