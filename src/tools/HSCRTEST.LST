 0030   0006    CONST NUDGE = 16                                  '----- how ma
                ny px the page nudges/slides
 0030   0006    
 0030   0006    DECLARE SUB Lg (s AS STRING)
 0030   0006    DECLARE SUB Hold (secs AS SINGLE)
 0030   0006    DECLARE FUNCTION CrtcR% (idx AS INTEGER)
 0030   0006    DECLARE SUB CrtcW (idx AS INTEGER, v AS INTEGER)
 0030   0006    DECLARE FUNCTION SeqR% (idx AS INTEGER)
 0030   0006    DECLARE SUB SeqW (idx AS INTEGER, v AS INTEGER)
 0030   0006    DECLARE SUB ScrollX (px AS INTEGER)
 0030   0006    DECLARE SUB PalApply (f AS INTEGER)
 0030   0006    DECLARE FUNCTION LoadPage% (n AS INTEGER)
 0030   0006    DECLARE SUB Advance (n AS INTEGER)
 0030   0006    
 0030   0006    DIM SHARED lf AS INTEGER, video AS LONG
 0030   0006    DIM SHARED gPitch AS LONG, gUnit AS INTEGER, gCirrus AS INTEGER
                , gChip AS INTEGER
 0030   0006    DIM SHARED mPal(0 TO 255) AS tRGB
 0030   0006    
 0030   0006    DIM inf AS TDC, ps AS STRING * 1024
 0030   0006    DIM i AS INTEGER, s6b AS INTEGER, s6c AS INTEGER, rep AS INTEGE
                R, pg AS INTEGER
 0030   0006    
 0030   0006    lf = FREEFILE
 0030   073C    OPEN "hscrtest.log" FOR OUTPUT AS #lf
 0030   073C    CALL Lg("HSCRTEST " + DATE$ + " " + TIME$)
 008E   0740    IF NOT uglInit THEN CALL Lg("uglInit FAILED"): CLOSE #lf: END
 00D3   0746    '----- 2 pages guarantees the 1024-byte pitch (per-line scroll 
                margin); we draw page 0
 00D3   0746    video = uglSetVideoDC(UGL.8BIT, 640, 480, 2)
 00D3   0746    IF video = 0 THEN video = uglSetVideoDC(UGL.8BIT, 640, 480, 1)
 013C   074E    IF video = 0 THEN CALL Lg("no 640x480"): uglEnd: CLOSE #lf: END
 0189   0752    uglDCGet video, inf
 019D   0752    gPitch = inf.bps
 019D   0752    CALL Lg("mode 640x480 bps(pitch)" + STR$(inf.bps) + "  (margin 
                px per line =" + STR$(inf.bps - 640) + ")")
 01FE   0756    
 01FE   0756    '----- CRTC addressing unit + Cirrus unlock (for the direct dis
                play-start writes)
 01FE   0756    IF CrtcR%(&H14) AND &H40 THEN gUnit = 4 ELSE IF CrtcR%(&H17) AN
                D &H40 THEN gUnit = 1 ELSE gUnit = 2
 0254   075E    CALL SeqW(6, &HA): s6b = SeqR%(6)
 026D   0762    CALL SeqW(6, &H12): s6c = SeqR%(6)
 029E   076A    gCirrus = 0: gChip = 0
 029E   076A    IF s6b = &HF AND s6c = &H12 THEN gCirrus = -1: gChip = CrtcR%(&
                H27)
                                                                      PAGE  17
                                                                      16 Sep 26
                                                                      22:29:55
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 02FD   0772    CALL Lg("unit" + STR$(gUnit) + " cirrus" + STR$(gCirrus) + " CR
                27 " + HEX$(gChip))
 0368   0776    
 0368   0776    uglSetWrkPage 0
 0370   0776    uglSetVisPage 0
 0378   0776    CALL Lg("margin BEFORE clear px(700,240)=" + STR$(uglPGet(video
                , 700, 240)))
 03C7   077E    uglClear video, 0
 03D9   077E    CALL Lg("margin AFTER uglClear px(700,240)=" + STR$(uglPGet(vid
                eo, 700, 240)) + " (900,300)=" + STR$(uglPGet(video, 900, 300))
                 + "  [0 = uglClear wiped the margin too]")
 046C   078A    CALL ScrollX(0)
 047B   078C    IF LoadPage%(0) = 0 THEN CALL Lg("MANP00 load failed"): uglRest
                ore: uglEnd: CLOSE #lf: END
 04D2   0794    CALL Lg("margin after page load px(700,240)=" + STR$(uglPGet(vi
                deo, 700, 240)))
 0521   079C    FOR i = 0 TO 10: CALL PalApply(i * 16 \ 10): CALL Hold(.03): NE
                XT
 0561   07A2    CALL Hold(1.5)
 0576   07A6    
 0576   07A6    '----- cycle forward through the pages twice with the nudge+fad
                e+slide
 0576   07A6    FOR rep = 1 TO 6
 057C   07A6            pg = (rep) MOD 3
 057C   07A6            CALL Advance(pg)
 0590   07A6            CALL Hold(1.2)
 05A5   07AA    NEXT
 05B1   07AA    CALL Lg("DONE")
 05D0   07AE    CALL PalApply(0)
 05DF   07B0    uglRestore
 05E4   07B0    uglEnd
 05E9   07B0    CLOSE #lf
 05E9   07B0    END
 05E9   07B0    
 05E9   07B0    '----- the page-turn: nudge current left + fade out, swap, slid
                e next in from left + fade up
 05E9   07B0    SUB Advance (n AS INTEGER)
 0606   07B0            DIM i AS INTEGER
 0606   07B0            '----- 1 + 2: nudge left (X 0->NUDGE) while fading to b
                lack
 0606   07B0            FOR i = 0 TO 8
 060C   07B0                    CALL ScrollX(NUDGE * i \ 8)
 0626   07B0                    CALL PalApply((8 - i) * 16 \ 8)
 0647   07B0                    CALL Hold(.03)
 065B   07B0            NEXT
 0667   07B0            '----- 3: black now; load the next page (unseen) + its 
                palette
 0667   07B0            IF LoadPage%(n) = 0 THEN i = LoadPage%(n)
 068C   07B0            '----- 4: page starts NUDGE px left, slide to 0 while f
                ading up
 068C   07B0            FOR i = 0 TO 8
 0692   07B0                    CALL ScrollX(NUDGE * (8 - i) \ 8)
 06B2   07B0                    CALL PalApply(i * 16 \ 8)
 06CF   07B0                    CALL Hold(.03)
                                                                      PAGE  18
                                                                      16 Sep 26
                                                                      22:29:55
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 06E3   07B0            NEXT
 06EF   07B0            CALL ScrollX(0)
 06FD   07B0    END SUB
 0705   07B0    
 0705   07B0    '----- load MANPnn onto page 0, its palette into mPal(), force 
                index 0 pure black
 0705   07B0    FUNCTION LoadPage% (n AS INTEGER)
 0710   07B0            DIM bmp AS STRING, fh AS INTEGER, ps AS STRING * 1024, 
                i AS INTEGER
 0710   07B0            bmp = "manp" + RIGHT$("0" + LTRIM$(STR$(n)), 2) + ".bmp
                "
 0710   07B0            LoadPage% = 0
 0710   07B0            uglSetWrkPage 0
 0760   07B0            IF uglPutBMPEx(video, 0, 0, bmp, BMPOPT.NO332) = 0 THEN
                 EXIT FUNCTION
 0787   07B0            fh = FREEFILE
 0787   07B0            OPEN bmp FOR BINARY AS #fh
 0787   07B0            SEEK #fh, 55
 0787   07B0            ps = INPUT$(1024, #fh)
 0787   07B0            CLOSE #fh
 0787   07B0            FOR i = 0 TO 255
 07E2   07B0                    mPal(i).blue = MID$(ps, i * 4 + 1, 1): mPal(i).
                green = MID$(ps, i * 4 + 2, 1): mPal(i).red = MID$(ps, i * 4 + 
                3, 1)
 07E2   07B0            NEXT
 08AE   07B0            mPal(0).red = CHR$(0): mPal(0).green = CHR$(0): mPal(0)
                .blue = CHR$(0)
 08AE   07B0            LoadPage% = -1
 08AE   07B0    END FUNCTION
 091A   07B0    
 091A   07B0    '----- mPal scaled by f/16 into the DAC (16 = full, 0 = black)
 091A   07B0    SUB PalApply (f AS INTEGER)
 0925   07B0            DIM i AS INTEGER
 0925   07B0            REDIM p(0 TO 255) AS tRGB
 093D   07B0            FOR i = 0 TO 255
 0942   07B0                    p(i).red = CHR$(ASC(mPal(i).red) * f \ 16)
 0942   07B0                    p(i).green = CHR$(ASC(mPal(i).green) * f \ 16)
 0942   07B0                    p(i).blue = CHR$(ASC(mPal(i).blue) * f \ 16)
 0942   07B0            NEXT
 0A2F   07B0            uglPalSetBuff 0, 256, p(0)
 0A48   07B0    END SUB
 0A59   07B0    
 0A59   07B0    '----- set the display start to horizontal pixel px (line 0), d
                irect CRTC (no BIOS)
 0A59   07B0    SUB ScrollX (px AS INTEGER)
 0A64   07B0            DIM u AS LONG, b AS INTEGER
 0A64   07B0            u = CLNG(px) \ gUnit
 0A64   07B0            WAIT &H3DA, 8, 8
 0A64   07B0            CALL CrtcW(&HC, (u \ 256) AND 255)
 0AB8   07B0            CALL CrtcW(&HD, u AND 255)
 0AD9   07B0            IF gCirrus THEN
 0AD9   07B0                    b = CrtcR%(&H1B) AND &HF2
 0AD9   07B0                    IF u AND &H10000 THEN b = b OR 1
 0B1D   07B0                    IF u AND &H20000 THEN b = b OR 4
