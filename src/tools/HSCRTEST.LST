 0030   0006    '----- HSCRTEST.BAS: horizontal page-turn test for the 486 (FPU
                -FREE - hardware
 0030   0006    '----- display-start scroll via the Cirrus CRTC + uGL BMP blits
                 + palette fade, none
 0030   0006    '----- of which need a coprocessor, unlike the uGL texture mapp
                ers). The effect the
 0030   0006    '----- user asked for, per page turn:
 0030   0006    '-----   1. nudge the current page LEFT a few px (display start
                 X 0 -> N) while fading
 0030   0006    '-----      the palette down to black
 0030   0006    '-----   2. at black, load the next page (uGL blit) + its palet
                te (index 0 forced to
 0030   0006    '-----      pure black so the exposed right-edge margin stays b
                lack)
 0030   0006    '-----   3. the next page starts N px left (X = N) and slides t
                o normal (X -> 0) while
 0030   0006    '-----      the palette fades up
 0030   0006    '----- Cycles MANP00->01->02->00... a few times so you can watc
                h, and logs a pixel in
 0030   0006    '----- the off-screen margin (px 700) to see if it reads black 
                or garbage on the real
 0030   0006    '----- card. Writes HSCRTEST.LOG. Build/run: src\tools\hscrtest
                .conf.
 0030   0006    DEFINT A-Z
 0030   0006    '$INCLUDE: 'UGL.BI'
 0030   0006    ''
 0030   0006    '' ugl.bi -- UGL routines
 0030   0006    ''
 0030   0006    
 0030   0006    Const UGL.TRUE%     = -1%
 0030   0006    Const UGL.FALSE%    = 0%
 0030   0006    
 0030   0006    Const DCTSIZE%      = 64%
 0030   0006    '' dc types:
 0030   0006    Const UGL.MEM%      = 0% * DCTSIZE%
 0030   0006    Const UGL.BNK%      = 1% * DCTSIZE%
 0030   0006    Const UGL.EMS%      = 2% * DCTSIZE%
 0030   0006    
 0030   0006    Const FMTSIZE%      = 128%
 0030   0006    '' color formats:
 0030   0006    Const UGL.8BIT%     = 0% * FMTSIZE%
 0030   0006    Const UGL.15BIT%    = 1% * FMTSIZE%
 0030   0006    Const UGL.16BIT%    = 2% * FMTSIZE%
 0030   0006    Const UGL.32BIT%    = 3% * FMTSIZE%
 0030   0006    
 0030   0006    '' buffer formats for uglRow Read/Write/SetPal routines
 0030   0006    Const UGL.BF.8BIT%  = 0% * 2%
 0030   0006    Const UGL.BF.15BIT% = 1% * 2%
 0030   0006    Const UGL.BF.16BIT% = 2% * 2%
 0030   0006    Const UGL.BF.32BIT% = 3% * 2%
 0030   0006    Const UGL.BF.24BIT% = 4% * 2%
 0030   0006    Const UGL.BF.IDX1%  = 5% * 2%
 0030   0006    Const UGL.BF.IDX4%  = 6% * 2%
 0030   0006    Const UGL.BF.IDX8%  = 7% * 2%
                                                                      PAGE   2
                                                                      16 Sep 26
