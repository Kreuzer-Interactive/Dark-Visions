 05CC   00C6    
 05CC   00C6    '----- 32px colour bands with a white ruler bar (width = VRAM l
                ine / 2) on each
 05CC   00C6    SUB Bands (v AS LONG, pg AS INTEGER, cbas AS INTEGER)
 05E9   00C6            DIM py AS INTEGER, bi AS INTEGER, col AS LONG, w AS INT
                EGER, vln AS INTEGER
 05E9   00C6            uglSetWrkPage pg
