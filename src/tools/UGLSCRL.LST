 0890   00C6            DIM vv AS INTEGER
 0890   00C6            OUT &H3D4, &H18: OUT &H3D5, ln AND 255
 0890   00C6            OUT &H3D4, 7: vv = INP(&H3D5)
 0890   00C6            IF ln AND 256 THEN vv = vv OR 16 ELSE vv = vv AND &HEF
 08D2   00C6            OUT &H3D5, vv
 08D2   00C6            OUT &H3D4, 9: vv = INP(&H3D5)
 08D2   00C6            IF ln AND 512 THEN vv = vv OR 64 ELSE vv = vv AND &HBF
 090B   00C6            OUT &H3D5, vv
