 01D1   003E    
 01D1   003E    '----- paint both pages once (page 0 rainbow, page 1 shifted so
                 a flip is obvious)
 01D1   003E    CALL Bands(v, 0, 0)
 01EE   0042    CALL Bands(v, 1, 3)
 020B   0046    uglSetWrkPage 0
 0213   0046    uglSetVisPage 0
 021B   0046    
 021B   0046    '----- each phase draws a full-width MARKER STRIPE at screen ro
                ws 464..479 in a
 021B   0046    '----- phase colour, using the split screen (VRAM lines 0..15 s
                hown at the bottom
 021B   0046    '----- always, unaffected by display start) so you can tell pha
                ses apart on film:
 021B   0046    '----- P1 red P2 green P3 yellow P4 magenta P5 cyan P6 white. T
                he TOP band colour
 021B   0046    '----- tells you whether the display actually moved.
 021B   0046    CALL VSplit(463)
 022A   0048    DO
 022A   0048            CALL Marker(v, uglColor(UGL.8BIT, 255, 0, 0))
 024E   004C            CALL Vbe07(0)
 025D   004E            CALL Lg("P1 red    4F07 line 0   want top RED         g
                etback:" + Vbe07get$)
 0295   0056            IF Held%(4) THEN EXIT DO
 02B7   005C    
 02B7   005C            CALL Marker(v, uglColor(UGL.8BIT, 0, 255, 0))
 02DB   0060            CALL Vbe07(32)
 02EA   0062            CALL Lg("P2 green  4F07 line 32  VESA scroll? top GREEN
                 getback:" + Vbe07get$)
 0322   006A            IF Held%(4) THEN EXIT DO
 0344   0070    
 0344   0070            CALL Marker(v, uglColor(UGL.8BIT, 255, 255, 0))
 0368   0074            CALL Vbe07(96)
 0377   0076            CALL Lg("P3 yellow 4F07 line 96  VESA scroll? top YELLO
                W getback:" + Vbe07get$)
 03AF   007E            IF Held%(4) THEN EXIT DO
 03D1   0084    
 03D1   0084            CALL Vbe07(0)
 03E0   0086            CALL Marker(v, uglColor(UGL.8BIT, 255, 0, 255))
 0407   008A            uglSetVisPage 1
 0410   008A            CALL Lg("P4 magenta uglSetVisPage 1 page flip? colours 
                shift")
 042F   008E            IF Held%(4) THEN EXIT DO
 0451   0094            uglSetVisPage 0
 0459   0094    
 0459   0094            CALL Marker(v, uglColor(UGL.8BIT, 0, 255, 255))
 047B   0098            CALL Crtc(8192)
 0490   009C            CALL Lg("P5 cyan   CRTC 0C/0D=8192  dword card? top GRE
                EN line32")
 04AF   00A0            IF Held%(4) THEN EXIT DO
 04D1   00A6    
 04D1   00A6            CALL Marker(v, uglColor(UGL.8BIT, 255, 255, 255))
 04F3   00AA            CALL Crtc(32768)
 0508   00AE            CALL Lg("P6 white  CRTC 0C/0D=32768 byte card? top GREE
                                                                      PAGE  18
                                                                      13 Sep 26
                                                                      16:54:41
