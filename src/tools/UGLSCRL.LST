 0030   0006    lf = FREEFILE
 0030   0028    OPEN "uglscrl.log" FOR OUTPUT AS #lf
 0030   0028    CLOSE #lf
 0030   0028    CALL Lg("UGLSCRL start " + DATE$ + " " + TIME$)
 009B   002C    IF NOT uglInit THEN CALL Lg("uglInit FAILED"): CLOSE #lf: SYSTE
                M
 00E0   0032    v = uglSetVideoDC(UGL.8BIT, 640, 480, 2)
 00E0   0032    IF v = 0 THEN CALL Lg("640x480x2 not available - test needs it"
                ): uglEnd: CLOSE #lf: SYSTEM
 0156   003A    uglDCGet v, inf
 016A   003A    CALL Lg("mode set: bps" + STR$(inf.bps) + " pages" + STR$(inf.p
                ages) + " size" + STR$(inf.size))
