                N line32")
 0527   00B2            IF Held%(4) THEN EXIT DO
 0549   00B8            CALL Crtc(0)
 055E   00BC    LOOP
 0562   00BC    
 0562   00BC    CALL Vbe07(0)
 0571   00BE    CALL Crtc(0)
 0586   00C2    uglRestore
 058B   00C2    uglEnd
 0590   00C2    SCREEN 0: WIDTH 80
