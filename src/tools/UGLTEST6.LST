 06C4   00DE    SUB Hold (secs AS SINGLE)
 06CF   00DE            DIM t9 AS SINGLE, d9 AS SINGLE
 06CF   00DE            t9 = TIMER
 06CF   00DE            DO
 06E0   00DE                    d9 = TIMER - t9: IF d9 < 0 THEN d9 = d9 + 86400
