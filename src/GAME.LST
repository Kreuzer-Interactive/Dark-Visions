 7FF2   059C    '----- ABS box just prefilters; sdd<snd is the real test = a ci
                rcle of radius snr (Euclidean)
 7FF2   059C    '----- breaks at first oy=0 exactly like action, so it never sn
                aps to an entry action can't reach
 7FF2   059C    msnap:
 8003   059C            IF snr <= 0 THEN RETURN
 8023   059C            ' tie-break: a hotspot exactly under the cursor's own c
                ell wins over an expanded (snapped) neighbour
 8023   059C            FOR sni = 1 TO 257
 802C   059C                    IF oy(sni) = 0# THEN EXIT FOR
 805C   05A0                    IF ox(sni) = b AND oy(sni) = a THEN RETURN
 80D2   05A0            NEXT
 80F9   05A0            snd = snr * snr + 1
 80F9   05A0            snx = -1
 80F9   05A0            FOR sni = 1 TO 257
 8124   05A8                    IF oy(sni) = 0# THEN EXIT FOR
 8154   05A8                    sdx = mx - ox(sni)
 8154   05A8                    sdy = my - oy(sni)
 8154   05A8                    IF ABS(sdx) <= snr AND ABS(sdy) <= snr THEN
 8154   05A8                            sdd = sdx * sdx + sdy * sdy
 8154   05A8                            IF sdd < snd THEN
 8154   05A8                                    snd = sdd
 8154   05A8                                    snx = ox(sni)
 8154   05A8                                    sny = oy(sni)
 8154   05A8                            END IF
 827B   05B8                    END IF
 827B   05B8            NEXT
 82A2   05B8            IF snx >= 0 THEN b = snx: a = sny
 82D0   05B8            RETURN
 82D0   05B8    
 82D0   05B8    '----- near a walkout exit? morph cursor to point the way the p
                layer leaves (exitcursor)
 82D0   05B8    '----- reads tg$ direction (wn=up ws=down we=right ww=left); re
                verts to NW arrow otherwise
 82D0   05B8    hovexit:
 82D5   05B8            IF exsen <> 1 THEN RETURN
 82F5   05B8            newshp = 0
 82F5   05B8            hvdir$ = ""
 82F5   05B8            hvb = hovr * hovr + 1
 82F5   05B8            FOR hvi = 1 TO 257
 832C   05C4                    IF oy(hvi) = 0# THEN EXIT FOR
 835C   05C8                    hvo = CINT(oi(hvi))
 835C   05C8                    IF LEFT$(tg$(hvo), 1) = "w" THEN
 835C   05C8                            hvx = mx - ox(hvi)
 835C   05C8                            hvy = my - oy(hvi)
 835C   05C8                            IF ABS(hvx) <= hovr AND ABS(hvy) <= hov
                r THEN
 835C   05C8                                    hvd = hvx * hvx + hvy * hvy
 835C   05C8                                    IF hvd < hvb THEN hvb = hvd: hv
                dir$ = RIGHT$(tg$(hvo), 1)
 84B6   05D8                            END IF
 84B6   05D8                    END IF
 84B6   05D8            NEXT
 84DD   05D8            IF hvb <= hovr * hovr THEN
                                                                      PAGE  32
                                                                      14 Jun 26
                                                                      20:23:42
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 84DD   05D8                    IF hvdir$ = "n" THEN newshp = 1
 8516   05D8                    IF hvdir$ = "s" THEN newshp = 2
 8534   05D8                    IF hvdir$ = "e" THEN newshp = 3
 8552   05D8                    IF hvdir$ = "w" THEN newshp = 4
 8570   05D8            END IF
 8570   05D8            IF newshp = cshp THEN RETURN
 858B   05D8            GOSUB erasecur
 8593   05D8            cshp = newshp
 8593   05D8            RETURN
