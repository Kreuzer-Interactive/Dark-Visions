 8A1B   0612    '----- install a custom mouse cursor shape (INT 33h AX=9)
 8A1B   0612    setcursor:
 8A2C   0612            IF msen <> 1 OR mcur < 1 THEN RETURN
 8A61   0612            FOR mi = 0 TO 31
 8A6A   0612                    cmask(mi) = 0
 8A6A   0612            NEXT
 8AAA   0612            mhsx = 7: mhsy = 7: mxor = 0: mraw = 0
 8AAA   0612            IF mcur = 1 THEN GOSUB shArrow
 8AE0   0612            IF mcur = 2 THEN GOSUB shCross
 8AF2   0612            IF mcur = 3 THEN GOSUB shBox
 8B04   0612            IF mcur = 4 THEN GOSUB shCross: mxor = 1
 8B22   0612            IF mcur = 5 THEN GOSUB shArrowNE
 8B34   0612            IF mraw = 0 THEN
 8B34   0612                    FOR mi = 0 TO 15
 8B52   0612                            IF mxor = 1 THEN cmask(mi) = &HFFFF ELS
                E cmask(mi) = NOT cmask(16 + mi)
 8BC3   0612                    NEXT
 8BEA   0612            END IF
 8BEA   0612            mregx.ax = 9
 8BEA   0612            mregx.bx = mhsx
 8BEA   0612            mregx.cx = mhsy
 8BEA   0612            mregx.dx = VARPTR(cmask(0))
 8BEA   0612            mregx.es = VARSEG(cmask(0))
 8BEA   0612            CALL INTERRUPTX(mvint, mregx, moutx)
 8C2A   0612            RETURN
