 9CFC   0B9A                    IF ky$(oi(sni)) = a$ AND ABS(sdx) <= snr AND AB
                S(sdy) <= snr THEN
 9CFC   0B9A                            sdd = sdx * sdx + sdy * sdy
 9CFC   0B9A                            IF sdd < snd THEN
