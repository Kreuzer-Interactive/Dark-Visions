 0A39   094C    
 0A39   094C    '----- startup
 0A39   094C    tmo = 2
 0A39   094C    'COM() statements in this programme
 0A39   094C    '----- reset the 8253 timer (channel 0) to the standard 18.2 Hz
                 tick.  Win98
 0A39   094C    '      "MS-DOS mode" can hand off with channel 0 left reprogram
                med faster,
 0A39   094C    '      which shortens SOUND durations (the intro races past) an
                d skews TIMER
 0A39   094C    '      (the in-room clock) -- prime suspect for the MS-DOS-mode
                 rush + lock-up.
 0A39   094C    '      No-op on a healthy DOS boot (it's already 18.2 Hz there)
                .
 0A39   094C    OUT &H43, &H36
 0A39   094C    OUT &H40, 0
 0A39   094C    OUT &H40, 0
 0A39   094C    CALL InitVars
 0A58   094C    CALL LoadConfig
 0A5D   094C    CALL initAllFonts(fontData(), font3Data(), fontbData())
 0A6E   094C    '----- guard Intro's cutscene sound loops on fast CPUs: QB's SO
                UND runtime
 0A6E   094C    '      can raise "Illegal function call" in the tight loops on 
                hardware far
 0A6E   094C    '      faster than this 1993 intro targets.  Intro has no handl
                er of its own
 0A6E   094C    '      (it runs before the ON ERROR GOTO errhand below).  RESUM
                E NEXT would
 0A6E   094C    '      need /X, which overflows the 64K module, so on such an e
                rror introSkip
 0A6E   094C    '      bails out of the cutscene to introDone -- the intro ends
                                                                      PAGE   6
                                                                      07 Jul 26
                                                                      01:34:17
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

                 early but the
 0A6E   094C    '      game runs instead of crashing to DOS.  (Throttle work re
                stores it.)
 0A6E   094C    ON ERROR GOTO introSkip
 0A78   094C    IF inon <> 0 AND qkon = 0 THEN CALL Intro
 0AB6   094C    introDone:
 0AB6   094C    ON ERROR GOTO 0
