 7F7C   06F2    '----- erase software cursor: restore saved background
 7F7C   06F2    erasecur:
 7FA5   06F2            IF cdrawn = 1 THEN PUT (cox, coy), curbuf, PSET
 7FEA   06F2            cdrawn = 0
