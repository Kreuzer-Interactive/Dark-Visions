 0AB1   09B0    
 0AB1   09B0    '----- startup
 0AB1   09B0    tmo = 2
 0AB1   09B0    'COM() statements in this programme
 0AB1   09B0    '----- reset the 8253 timer (channel 0) to the standard 18.2 Hz
                 tick.  Win98
 0AB1   09B0    '      "MS-DOS mode" can hand off with channel 0 left reprogram
                med faster,
 0AB1   09B0    '      which shortens SOUND durations (the intro races past) an
                d skews TIMER
 0AB1   09B0    '      (the in-room clock) -- prime suspect for the MS-DOS-mode
                 rush + lock-up.
 0AB1   09B0    '      No-op on a healthy DOS boot (it's already 18.2 Hz there)
                .
 0AB1   09B0    OUT &H43, &H36
 0AB1   09B0    OUT &H40, 0
 0AB1   09B0    OUT &H40, 0
 0AB1   09B0    CALL InitVars
 0AD0   09B0    CALL LoadConfig
 0AD5   09B0    CALL initAllFonts(fontData(), font3Data(), fontbData())
 0AE6   09B0    '----- guard Intro's cutscene sound loops on fast CPUs: QB's SO
                UND runtime
 0AE6   09B0    '      can raise "Illegal function call" in the tight loops on 
                hardware far
 0AE6   09B0    '      faster than this 1993 intro targets.  Intro has no handl
                er of its own
 0AE6   09B0    '      (it runs before the ON ERROR GOTO errhand below).  RESUM
                E NEXT would
 0AE6   09B0    '      need /X, which overflows the 64K module, so on such an e
                rror introSkip
 0AE6   09B0    '      bails out of the cutscene to introDone -- the intro ends
                 early but the
 0AE6   09B0    '      game runs instead of crashing to DOS.  (Throttle work re
                stores it.)
 0AE6   09B0    ON ERROR GOTO introSkip
 0AF0   09B0    IF inon <> 0 AND qkon = 0 THEN CALL Intro
 0B2E   09B0    introDone:
 0B2E   09B0    ON ERROR GOTO 0
 0B3D   09B0    KEY OFF
 0B3D   09B0    t0 = TIMER
 0B3D   09B0    
 0B3D   09B0    '----- joystick button handlers
 0B3D   09B0    ON STRIG(2) GOSUB vact
