 840C   05D6    '----- erase software cursor: restore saved background
 840C   05D6    erasecur:
 8435   05D6            IF cdrawn = 1 THEN PUT (cox, coy), curbuf, PSET
 847A   05D6            cdrawn = 0
 847A   05D6            RETURN
 847A   05D6    
 847A   05D6    '----- snap click to nearest hotspot within snr px (0 = off/exa
                ct)
 847A   05D6    '----- ABS box just prefilters; sdd<snd is the real test = a ci
                rcle of radius snr (Euclidean)
 847A   05D6    '----- breaks at first oy=0 exactly like action, so it never sn
                aps to an entry action can't reach
 847A   05D6    msnap:
 848B   05D6            IF snr <= 0 THEN RETURN
 84AB   05D6            ' tie-break: a hotspot exactly under the cursor's own c
                ell wins over an expanded (snapped) neighbour
 84AB   05D6            FOR sni = 1 TO 257
 84B4   05D6                    IF oy(sni) = 0# THEN EXIT FOR
 84E4   05DA                    IF ox(sni) = b AND oy(sni) = a THEN RETURN
 855A   05DA            NEXT
 8581   05DA            snd = snr * snr + 1
 8581   05DA            snx = -1
 8581   05DA            FOR sni = 1 TO 257
 85AC   05E2                    IF oy(sni) = 0# THEN EXIT FOR
 85DC   05E2                    sdx = mx - ox(sni)
 85DC   05E2                    sdy = my - oy(sni)
 85DC   05E2                    IF ABS(sdx) <= snr AND ABS(sdy) <= snr THEN
 85DC   05E2                            sdd = sdx * sdx + sdy * sdy
 85DC   05E2                            IF sdd < snd THEN
 85DC   05E2                                    snd = sdd
 85DC   05E2                                    snx = ox(sni)
 85DC   05E2                                    sny = oy(sni)
 85DC   05E2                            END IF
 8703   05F2                    END IF
 8703   05F2            NEXT
 872A   05F2            IF snx >= 0 THEN b = snx: a = sny
 8758   05F2            RETURN
 8758   05F2    
 8758   05F2    '----- near a walkout exit? morph cursor to point the way the p
                layer leaves (exitcursor)
 8758   05F2    '----- reads tg$ direction (wn=up ws=down we=right ww=left); re
                verts to NW arrow otherwise
 8758   05F2    hovexit:
 875D   05F2            IF exsen <> 1 THEN RETURN
 877D   05F2            newshp = 0
 877D   05F2            hvdir$ = ""
 877D   05F2            hvb = hovr * hovr + 1
 877D   05F2            FOR hvi = 1 TO 257
 87B4   05FE                    IF oy(hvi) = 0# THEN EXIT FOR
 87E4   0602                    hvo = CINT(oi(hvi))
 87E4   0602                    IF LEFT$(tg$(hvo), 1) = "w" THEN
 87E4   0602                            hvx = mx - ox(hvi)
 87E4   0602                            hvy = my - oy(hvi)
 87E4   0602                            IF ABS(hvx) <= hovr AND ABS(hvy) <= hov
                                                                      PAGE  33
                                                                      14 Jun 26
                                                                      21:36:24
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

                r THEN
 87E4   0602                                    hvd = hvx * hvx + hvy * hvy
 87E4   0602                                    IF hvd < hvb THEN hvb = hvd: hv
                dir$ = RIGHT$(tg$(hvo), 1)
 893E   0612                            END IF
 893E   0612                    END IF
 893E   0612            NEXT
 8965   0612            IF hvb <= hovr * hovr THEN
 8965   0612                    IF hvdir$ = "n" THEN newshp = 1
 899E   0612                    IF hvdir$ = "s" THEN newshp = 2
 89BC   0612                    IF hvdir$ = "e" THEN newshp = 3
 89DA   0612                    IF hvdir$ = "w" THEN newshp = 4
 89F8   0612            END IF
 89F8   0612            IF newshp = cshp THEN RETURN
 8A13   0612            GOSUB erasecur
 8A1B   0612            cshp = newshp
 8A1B   0612            RETURN
