 7CF0   06EA            mx = b
 7CF0   06EA            my = a
 7CF0   06EA            IF my > 190 THEN my = 190
 7D2F   06EA            GOSUB hovexit
 7D37   06EA            RETURN
 7D37   06EA    
 7D37   06EA    '----- synchit: re-derive the hit point from the cursor positio
                n (undo msnap's
 7D37   06EA    '----- action-only snap, so a following keyboard nudge starts f
                rom the cursor, not the hotspot)
 7D37   06EA    synchit:
 7D3C   06EA            b = (mx \ 4) * 4 + 2
 7D3C   06EA            a = (my \ 4) * 4 + 2
 7D3C   06EA            IF b > 302 THEN b = 302
 7DC7   06EA            IF a < 10 THEN a = 10
 7DE9   06EA            IF a > 190 THEN a = 190
 7E0B   06EA            RETURN
