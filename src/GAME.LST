                ell wins over an expanded (snapped) neighbour
 9B8C   0B8E            FOR sni = 1 TO 257
 9B94   0B8E                    IF oy(sni) = 0# THEN EXIT FOR
 9BC4   0B92                    IF ox(sni) = b AND oy(sni) = a AND ky$(oi(sni))
