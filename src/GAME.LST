 43A0   0564    '----- fps counter: update on-screen frame rate
 43A0   0564    fpstick:
 43A8   0564            fpsc = fpsc + 1
 43A8   0564            fpsd = TIMER - fpst
 43A8   0564            IF fpsd < 0 OR fpsd >= 2 THEN
 43A8   0564                    fpst = TIMER
 43A8   0564                    fpsc = 0
 43A8   0564            ELSEIF fpsd >= 1 THEN
 442D   0564                    fpsv = fpsc / fpsd
 442D   0564                    IF fpsv > 99999 THEN fpsv = 99999
 4476   0564                    LOCATE 1, 35
 4476   0564                    PRINT USING "#####"; fpsv;
 4476   0564                    fpst = TIMER
 4476   0564                    fpsc = 0
 4476   0564            END IF
 44C1   0564            RETURN
