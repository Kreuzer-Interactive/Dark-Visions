 7D00   057C            RETURN
 7D00   057C    
 7D00   057C    '----- snap click to nearest hotspot within snr px (0 = off/exa
                ct)
 7D00   057C    '----- ABS box just prefilters; sdd<snd is the real test = a ci
                rcle of radius snr (Euclidean)
 7D00   057C    '----- breaks at first oy=0 exactly like action, so it never sn
                aps to an entry action can't reach
 7D00   057C    msnap:
 7D11   057C            IF snr <= 0 THEN RETURN
 7D31   057C            snd = snr * snr + 1
 7D31   057C            snx = -1
 7D31   057C            FOR sni = 1 TO 100
 7D5C   0584                    IF oy(sni) = 0# THEN EXIT FOR
 7D8A   0588                    sdx = mx - ox(sni)
 7D8A   0588                    sdy = my - oy(sni)
 7D8A   0588                    IF ABS(sdx) <= snr AND ABS(sdy) <= snr THEN
 7D8A   0588                            sdd = sdx * sdx + sdy * sdy
 7D8A   0588                            IF sdd < snd THEN
 7D8A   0588                                    snd = sdd
 7D8A   0588                                    snx = ox(sni)
 7D8A   0588                                    sny = oy(sni)
 7D8A   0588                            END IF
 7EA3   0598                    END IF
 7EA3   0598            NEXT
 7ECA   0598            IF snx >= 0 THEN b = snx: a = sny
 7EF8   0598            RETURN
