 8A22   05D8    '----- load object display names from object.pac
 8A22   05D8    loadnames:
 8AD5   05D8            CLOSE
 8AD5   05D8            OPEN "object.pac" FOR INPUT AS #1
 8AD5   05D8            FOR i = 1 TO 50
 8B00   05D8                    IF EOF(1) THEN GOTO 12580
 8B10   05D8                    INPUT #1, b, dn$(b)
 8B19   05D8            NEXT
 8B6E   05D8            12580 CLOSE
 8B6E   05D8            RETURN
 8B6E   05D8    
 8B6E   05D8    '----- combine/use objects and wait for completion
 8B6E   05D8    usecombine:
 8B80   05D8            IF gr((gy + 1) + (gw * gx)) = 28 AND sel = 18 THEN LOCA
                TE 1, 1: PRINT "You find a key hidden inside the fruit.": ob(22
                ) = 1: done$ = "y"
 8C25   05D8            IF ob(11) = 1 AND ob(24) = 1 AND sel = 25 THEN LOCATE 1
                , 1: PRINT "You decode and combine the formula": ob(24) = 0: ob
                (12) = 0: ob(36) = 1: done$ = "y"
 8CEE   05D8            IF gr((gy + 1) + (gw * gx)) = 29 AND sel = 34 THEN LOCA
                TE 1, 1: PRINT "You insert the chemicals into the syringe.": ob
                (35) = 1: ob(29) = 0: ob(34) = 0: done$ = "y"
 8DB6   05D8            ti = TIMER
 8DB6   05D8            12800 IF done$ = "" THEN GOTO 12830
 8DDE   05D8            IF (TIMER - ti) >= tmo THEN GOTO 12830
 8DFE   05D8            GOTO 12800
 8DFE   05D8            12830 RETURN
 8E00   05D8    
 8E00   05D8    '----- trigger room4 golf event
 8E00   05D8    trigger:
 8E0A   05D8            IF doc = 2 OR doc = 1 THEN RETURN
 8E4D   05D8            IF q$ = "room4" AND ob(43) = 1 THEN GOTO 13970
 8E8D   05D8            GOTO 14010
 8E8D   05D8            13970 sy$ = "y": GOSUB golf: PUT (135, 135), wa, XOR
 8EAA   05D8            doc = 1: ti = TIMER
 8EAA   05D8            RETURN
 8EAA   05D8            14010 RETURN
 8EEB   05D8    
 8EEB   05D8            ti = TIMER
 8EEB   05D8            doc = 1
 8EEB   05D8            PRINT tmo
 8EEB   05D8            PALETTE 1, 8
