 0C7D   09B2    IF sfps = 1 AND itt > .5 THEN LOCATE 3, 1: PRINT USING "Intro: 
                ### steps in ###.# secs"; ifc; itt
 0D01   09B2    400 a$ = INKEY$
 0D01   09B2    IF a$ <> "" THEN GOTO 430
 0D27   09B2    GOTO 400
