 7925   06E2    '----- poll mouse: move cursor and read buttons
 7925   06E2    mousepoll:
 79A1   06E2            IF msen <> 1 THEN RETURN
 79C1   06E2            mreg.ax = 3
 79C1   06E2            CALL INTERRUPT(mvint, mreg, mout)
 79D8   06E2            nmx = mout.cx \ 2
 79D8   06E2            nmy = mout.dx
 79D8   06E2            IF nmx < 0 THEN nmx = 0
 7A1E   06EA            IF nmx > 304 THEN nmx = 304
 7A40   06EA            IF nmy < 0 THEN nmy = 0
 7A62   06EA            IF nmy > 190 THEN nmy = 190
 7A84   06EA            IF nmx <> lmx OR nmy <> lmy THEN
 7A84   06EA                    lmx = nmx
 7A84   06EA                    lmy = nmy
 7A84   06EA                    mx = nmx
 7A84   06EA                    my = nmy
 7A84   06EA                    b = (mx \ 4) * 4 + 2
 7A84   06EA                    a = (my \ 4) * 4 + 2
 7A84   06EA                    IF b > 302 THEN b = 302
 7B73   06EA                    IF a < 10 THEN a = 10
 7B95   06EA                    IF a > 190 THEN a = 190
 7BB7   06EA                    GOSUB hovexit
 7BBF   06EA            END IF
 7BBF   06EA            IF mxyon = 1 THEN GOSUB mxytick
 7BDD   06EA            IF cdrawn = 0 OR mx <> cox OR my <> coy THEN GOSUB eras
                ecur: GOSUB drawcur
 7C41   06EA            IF (mout.bx AND 1) <> 0 AND mlb = 0 THEN a$ = "a": GOSU
                B msnap
 7C84   06EA            IF (mout.bx AND 2) <> 0 AND mrb = 0 THEN a$ = "l": GOSU
                B msnap
 7CC7   06EA            mlb = (mout.bx AND 1)
 7CC7   06EA            mrb = (mout.bx AND 2)
 7CC7   06EA            RETURN
 7CC7   06EA    
 7CC7   06EA    '----- ksync: keyboard moved the hit point -> move the software
                 pointer to match
 7CC7   06EA    '----- (mouse stays put, so mousepoll won't override until the 
                mouse is moved)
 7CC7   06EA    ksync:
