 0AB1   09B2    
 0AB1   09B2    '----- startup
 0AB1   09B2    tmo = 2
 0AB1   09B2    'COM() statements in this programme
 0AB1   09B2    '----- reset the 8253 timer (channel 0) to the standard 18.2 Hz
                 tick.  Win98
 0AB1   09B2    '      "MS-DOS mode" can hand off with channel 0 left reprogram
                med faster,
 0AB1   09B2    '      which shortens SOUND durations (the intro races past) an
                d skews TIMER
 0AB1   09B2    '      (the in-room clock) -- prime suspect for the MS-DOS-mode
                 rush + lock-up.
 0AB1   09B2    '      No-op on a healthy DOS boot (it's already 18.2 Hz there)
                .
 0AB1   09B2    OUT &H43, &H36
 0AB1   09B2    OUT &H40, 0
 0AB1   09B2    OUT &H40, 0
 0AB1   09B2    CALL InitVars
 0AD0   09B2    CALL LoadConfig
 0AD5   09B2    CALL initAllFonts(fontData(), font3Data(), fontbData())
 0AE6   09B2    '----- guard Intro's cutscene sound loops on fast CPUs: QB's SO
                UND runtime
 0AE6   09B2    '      can raise "Illegal function call" in the tight loops on 
                hardware far
 0AE6   09B2    '      faster than this 1993 intro targets.  Intro has no handl
                er of its own
 0AE6   09B2    '      (it runs before the ON ERROR GOTO errhand below).  RESUM
                E NEXT would
 0AE6   09B2    '      need /X, which overflows the 64K module, so on such an e
                rror introSkip
 0AE6   09B2    '      bails out of the cutscene to introDone -- the intro ends
                                                                      PAGE   7
                                                                      09 Jul 26
                                                                      15:44:03
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

                 early but the
 0AE6   09B2    '      game runs instead of crashing to DOS.  (Throttle work re
                stores it.)
 0AE6   09B2    ON ERROR GOTO introSkip
 0AF0   09B2    IF inon <> 0 AND qkon = 0 THEN CALL Intro
 0B2E   09B2    introDone:
 0B2E   09B2    ON ERROR GOTO 0
 0B3D   09B2    KEY OFF
 0B3D   09B2    t0 = TIMER
 0B3D   09B2    
 0B3D   09B2    '----- joystick button handlers
 0B3D   09B2    ON STRIG(2) GOSUB vact
 0B64   09B2    ON STRIG(0) GOSUB vlook
