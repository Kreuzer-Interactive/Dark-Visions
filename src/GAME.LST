 9DB9   0C48            IF msen <> 1 THEN RETURN
 9DD9   0C48            '----- no mouse driver loaded? the INT 33h vector is 00
                00:0000 when none
 9DD9   0C48            '      is present; CALL INTERRUPT would then jump into 
                the interrupt
 9DD9   0C48            '      vector table and hang.  Bail out (disable the mo
                use) before calling.
 9DD9   0C48            '      Test the 4 vector bytes directly -- PEEK()*256 w
                ould overflow INTEGER.
 9DD9   0C48            DEF SEG = 0
 9DD9   0C48            m33a = PEEK(&HCC): m33b = PEEK(&HCD): m33c = PEEK(&HCE)
                : m33d = PEEK(&HCF)
 9DD9   0C48            DEF SEG
 9DD9   0C48            IF m33a = 0 AND m33b = 0 AND m33c = 0 AND m33d = 0 THEN
                 msen = 0: RETURN
 9ECE   0C58            '----- ...and bail if the vector points to a bare IRET 
                stub (first byte
 9ECE   0C58            '      &HCF).  That is what is there with NO real drive
                r (e.g. after
 9ECE   0C58            '      exiting Win98 to MS-DOS mode); calling INT 33h o
                n it hangs.  A real
 9ECE   0C58            '      driver's handler starts with executable code (mo
                use.com begins with
 9ECE   0C58            '      a JMP, &HEB), never a bare IRET (&HCF) or a 0/de
                ad byte -- so this
 9ECE   0C58            '      tells a real driver from a dead leftover vector 
                (seen as &HCF on one
 9ECE   0C58            '      PC, 0 on another) without ever calling INT 33h.
 9ECE   0C58            m33ls& = m33c + m33d * 256&
 9ECE   0C58            m33lo& = m33a + m33b * 256&
 9ECE   0C58            IF m33ls& > 32767 THEN m33si = m33ls& - 65536 ELSE m33s
                i = m33ls&
 9F51   0C64            IF m33lo& > 32767 THEN m33oi = m33lo& - 65536 ELSE m33o
                i = m33lo&
 9F98   0C68            DEF SEG = m33si
 9F98   0C68            m33fb = PEEK(m33oi)
 9F98   0C68            DEF SEG
 9F98   0C68            IF m33fb = &HCF OR m33fb = 0 THEN msen = 0: RETURN
