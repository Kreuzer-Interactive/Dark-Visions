 F9E2   0B50    '----- write the live game state to slot 1-10 (saver a-j.pac). 
                Lives in GAME.BAS for DIM SHARED access; called from the GAME4 
                save/load screen.
 F9E2   0B50    SUB SaveGame (slot AS INTEGER)
 F9ED   0B50            DIM slz AS INTEGER
 F9ED   0B50            OPEN "saver" + CHR$(slot + 96) + ".pac" FOR OUTPUT AS #
                1
