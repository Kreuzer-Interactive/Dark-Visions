 F630   0C96    SUB LoadGame (slot AS INTEGER)
 F63B   0C96            DIM slz AS INTEGER
 F63B   0C96            OPEN "saver" + CHR$(slot + 96) + ".pac" FOR INPUT AS #1
 F63B   0C96            INPUT #1, q$, cl, pt, done$, tt$, a$, lf$
 F678   0C96            tt$ = "n": done$ = "": IF LEN(lf$) <> 1 OR INSTR("12346
                789", lf$) = 0 THEN lf$ = "2"
