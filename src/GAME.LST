 9D62   0C3A            m33lo& = m33a + m33b * 256&
 9D62   0C3A            IF m33ls& > 32767 THEN m33si = m33ls& - 65536 ELSE m33s
                i = m33ls&
 9DE5   0C46            IF m33lo& > 32767 THEN m33oi = m33lo& - 65536 ELSE m33o
                i = m33lo&
