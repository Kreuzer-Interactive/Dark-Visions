 6E7F   0602    '----- poll mouse: move cursor and read buttons
 6E7F   0602    mousepoll:
 6EFB   0602            IF msen <> 1 THEN RETURN
 6F1B   0602            mreg.ax = 3
 6F1B   0602            CALL INTERRUPT(mvint, mreg, mout)
 6F32   0602            nmx = mout.cx \ 2
 6F32   0602            nmy = mout.dx
 6F32   0602            IF nmx < 0 THEN nmx = 0
 6F78   060A            IF nmx > 304 THEN nmx = 304
 6F9A   060A            IF nmy < 0 THEN nmy = 0
 6FBC   060A            IF nmy > 190 THEN nmy = 190
 6FDE   060A            IF nmx <> lmx OR nmy <> lmy THEN
 6FDE   060A                    lmx = nmx
 6FDE   060A                    lmy = nmy
 6FDE   060A                    mx = nmx
 6FDE   060A                    my = nmy
 6FDE   060A                    b = (mx \ 4) * 4 + 2
 6FDE   060A                    a = (my \ 4) * 4 + 2
 6FDE   060A                    IF b > 302 THEN b = 302
 70CD   060A                    IF a < 10 THEN a = 10
 70EF   060A                    IF a > 190 THEN a = 190
 7111   060A                    GOSUB hovexit
 7119   060A            END IF
 7119   060A            IF mxyon = 1 THEN GOSUB mxytick
 7137   060A            IF cdrawn = 0 OR mx <> cox OR my <> coy THEN GOSUB eras
                ecur: GOSUB drawcur
 719B   060A            IF (mout.bx AND 1) <> 0 AND mlb = 0 THEN a$ = "a": GOSU
                B msnap
 71DE   060A            IF (mout.bx AND 2) <> 0 AND mrb = 0 THEN a$ = "l": GOSU
                B msnap
 7221   060A            mlb = (mout.bx AND 1)
 7221   060A            mrb = (mout.bx AND 2)
 7221   060A            RETURN
 7221   060A    
 7221   060A    '----- ksync: keyboard moved the hit point -> move the software
                 pointer to match
 7221   060A    '----- (mouse stays put, so mousepoll won't override until the 
                mouse is moved)
 7221   060A    ksync:
                                                                      PAGE  29
                                                                      15 Jun 26
                                                                      02:54:32
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 724A   060A            mx = b
 724A   060A            my = a
 724A   060A            IF my > 190 THEN my = 190
 7289   060A            GOSUB hovexit
 7291   060A            RETURN
 7291   060A    
 7291   060A    '----- synchit: re-derive the hit point from the cursor positio
                n (undo msnap's
 7291   060A    '----- action-only snap, so a following keyboard nudge starts f
                rom the cursor, not the hotspot)
 7291   060A    synchit:
 7296   060A            b = (mx \ 4) * 4 + 2
 7296   060A            a = (my \ 4) * 4 + 2
 7296   060A            IF b > 302 THEN b = 302
 7321   060A            IF a < 10 THEN a = 10
 7343   060A            IF a > 190 THEN a = 190
 7365   060A            RETURN
 7365   060A    
 7365   060A    '----- draw software cursor: save background, then paint the ar
                row (1=gray, 2=blue)
 7365   060A    drawcur:
 736A   060A            GET (mx, my)-(mx + 15, my + 9), curbuf
 736A   060A            FOR mi = 0 TO npix(cshp) - 1
 73F4   060E                    PSET (mx + px(cshp, mi), my + py(cshp, mi)), pc
                (cshp, mi)
 73F4   060E            NEXT
 74D6   0612            cox = mx: coy = my: cdrawn = 1
 74D6   0612            RETURN
 74D6   0612    
 74D6   0612    '----- erase software cursor: restore saved background
 74D6   0612    erasecur:
 74FF   0612            IF cdrawn = 1 THEN PUT (cox, coy), curbuf, PSET
 7544   0612            cdrawn = 0
 7544   0612            RETURN
 7544   0612    
 7544   0612    '----- snap click to nearest hotspot within snr px (0 = off/exa
                ct)
 7544   0612    '----- ABS box just prefilters; sdd<snd is the real test = a ci
                rcle of radius snr (Euclidean)
 7544   0612    '----- breaks at first oy=0 exactly like action, so it never sn
                aps to an entry action can't reach
 7544   0612    msnap:
 7555   0612            IF snr <= 0 THEN RETURN
 7575   0612            ' tie-break: a hotspot exactly under the cursor's own c
                ell wins over an expanded (snapped) neighbour
 7575   0612            FOR sni = 1 TO 257
 757E   0612                    IF oy(sni) = 0# THEN EXIT FOR
 75AE   0616                    IF ox(sni) = b AND oy(sni) = a THEN RETURN
 7624   0616            NEXT
 764B   0616            snd = snr * snr + 1
 764B   0616            snx = -1
 764B   0616            FOR sni = 1 TO 257
 7676   061E                    IF oy(sni) = 0# THEN EXIT FOR
 76A6   061E                    sdx = mx - ox(sni)
                                                                      PAGE  30
                                                                      15 Jun 26
                                                                      02:54:32
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 76A6   061E                    sdy = my - oy(sni)
 76A6   061E                    IF ABS(sdx) <= snr AND ABS(sdy) <= snr THEN
 76A6   061E                            sdd = sdx * sdx + sdy * sdy
 76A6   061E                            IF sdd < snd THEN
 76A6   061E                                    snd = sdd
 76A6   061E                                    snx = ox(sni)
 76A6   061E                                    sny = oy(sni)
 76A6   061E                            END IF
 77CD   062E                    END IF
 77CD   062E            NEXT
 77F4   062E            IF snx >= 0 THEN b = snx: a = sny
 7822   062E            RETURN
