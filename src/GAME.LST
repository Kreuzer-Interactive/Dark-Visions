 7F3F   05CE    '----- poll mouse: move cursor and read buttons
 7F3F   05CE    mousepoll:
 7FBB   05CE            IF msen <> 1 THEN RETURN
 7FDB   05CE            mreg.ax = 3
 7FDB   05CE            CALL INTERRUPT(mvint, mreg, mout)
 7FF2   05CE            mx = mout.cx \ 2
 7FF2   05CE            my = mout.dx
 7FF2   05CE            IF mx < 0 THEN mx = 0
 8038   05CE            IF mx > 304 THEN mx = 304
 805A   05CE            IF my < 0 THEN my = 0
 807C   05CE            IF my > 190 THEN my = 190
 809E   05CE            b = (mx \ 4) * 4 + 2
 809E   05CE            a = (my \ 4) * 4 + 2
 809E   05CE            IF b > 302 THEN b = 302
 8124   05CE            IF a < 10 THEN a = 10
 8146   05CE            IF a > 190 THEN a = 190
 8168   05CE            IF mxyon = 1 THEN GOSUB mxytick
 8186   05CE            GOSUB hovexit
 818E   05CE            IF cdrawn = 0 OR mx <> cox OR my <> coy THEN GOSUB eras
                ecur: GOSUB drawcur
 81F2   05CE            IF (mout.bx AND 1) <> 0 AND mlb = 0 THEN a$ = "a": GOSU
                B msnap
 8235   05CE            IF (mout.bx AND 2) <> 0 AND mrb = 0 THEN a$ = "l": GOSU
                B msnap
 8278   05CE            mlb = (mout.bx AND 1)
 8278   05CE            mrb = (mout.bx AND 2)
 8278   05CE            RETURN
 8278   05CE    
 8278   05CE    '----- draw software cursor: save background, then paint the ar
                row (1=gray, 2=blue)
 8278   05CE    drawcur:
 82A1   05CE            GET (mx, my)-(mx + 15, my + 9), curbuf
 82A1   05CE            FOR mi = 0 TO npix(cshp) - 1
 832A   05D2                    PSET (mx + px(cshp, mi), my + py(cshp, mi)), pc
                (cshp, mi)
 832A   05D2            NEXT
 840C   05D6            cox = mx: coy = my: cdrawn = 1
 840C   05D6            RETURN
