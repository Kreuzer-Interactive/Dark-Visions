 0B8D   09B2    GOSUB strigon
 0B95   09B2    GOSUB loadnames
 0B9D   09B2    GOSUB loadmsgs
 0BA5   09B2    GOSUB mouseinit
 0BAD   09B2    ON ERROR GOTO errhand
 0BB7   09B2    
 0BB7   09B2    SCREEN 1
