 93CC   0BB2    '----- initialise the mouse driver (INT 33h)
 93CC   0BB2    mouseinit:
 93D1   0BB2            IF msen <> 1 THEN RETURN
 93F1   0BB2            '----- no mouse driver loaded? the INT 33h vector is 00
                00:0000 when none
 93F1   0BB2            '      is present; CALL INTERRUPT would then jump into 
                the interrupt
 93F1   0BB2            '      vector table and hang.  Bail out (disable the mo
                use) before calling.
 93F1   0BB2            '      Test the 4 vector bytes directly -- PEEK()*256 w
                ould overflow INTEGER.
 93F1   0BB2            DEF SEG = 0
 93F1   0BB2            m33a = PEEK(&HCC): m33b = PEEK(&HCD): m33c = PEEK(&HCE)
                : m33d = PEEK(&HCF)
 93F1   0BB2            DEF SEG
 93F1   0BB2            IF m33a = 0 AND m33b = 0 AND m33c = 0 AND m33d = 0 THEN
                 msen = 0: RETURN
 94E6   0BC2            '----- ...and bail if the vector points to a bare IRET 
                stub (first byte
 94E6   0BC2            '      &HCF).  That is what is there with NO real drive
                r (e.g. after
 94E6   0BC2            '      exiting Win98 to MS-DOS mode); calling INT 33h o
                n it hangs.  A real
 94E6   0BC2            '      driver's handler starts with executable code (mo
                use.com begins with
 94E6   0BC2            '      a JMP, &HEB), never a bare IRET (&HCF) or a 0/de
                ad byte -- so this
 94E6   0BC2            '      tells a real driver from a dead leftover vector 
                (seen as &HCF on one
 94E6   0BC2            '      PC, 0 on another) without ever calling INT 33h.
 94E6   0BC2            m33ls& = m33c + m33d * 256&
 94E6   0BC2            m33lo& = m33a + m33b * 256&
 94E6   0BC2            IF m33ls& > 32767 THEN m33si = m33ls& - 65536 ELSE m33s
                i = m33ls&
                                                                      PAGE  43
                                                                      27 Jul 26
                                                                      15:23:59
