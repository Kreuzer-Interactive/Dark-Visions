Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 9EC3   0C48            '      vector table and hang.  Bail out (disable the mo
                use) before calling.
 9EC3   0C48            '      Test the 4 vector bytes directly -- PEEK()*256 w
                ould overflow INTEGER.
 9EC3   0C48            DEF SEG = 0
 9EC3   0C48            m33a = PEEK(&HCC): m33b = PEEK(&HCD): m33c = PEEK(&HCE)
                : m33d = PEEK(&HCF)
 9EC3   0C48            DEF SEG
 9EC3   0C48            IF m33a = 0 AND m33b = 0 AND m33c = 0 AND m33d = 0 THEN
                 msen = 0: RETURN
 9FB8   0C58            '----- ...and bail if the vector points to a bare IRET 
                stub (first byte
 9FB8   0C58            '      &HCF).  That is what is there with NO real drive
                r (e.g. after
 9FB8   0C58            '      exiting Win98 to MS-DOS mode); calling INT 33h o
                n it hangs.  A real
 9FB8   0C58            '      driver's handler starts with executable code (mo
                use.com begins with
 9FB8   0C58            '      a JMP, &HEB), never a bare IRET (&HCF) or a 0/de
                ad byte -- so this
 9FB8   0C58            '      tells a real driver from a dead leftover vector 
                (seen as &HCF on one
 9FB8   0C58            '      PC, 0 on another) without ever calling INT 33h.
 9FB8   0C58            m33ls& = m33c + m33d * 256&
 9FB8   0C58            m33lo& = m33a + m33b * 256&
 9FB8   0C58            IF m33ls& > 32767 THEN m33si = m33ls& - 65536 ELSE m33s
                i = m33ls&
 A03B   0C64            IF m33lo& > 32767 THEN m33oi = m33lo& - 65536 ELSE m33o
                i = m33lo&
 A082   0C68            DEF SEG = m33si
 A082   0C68            m33fb = PEEK(m33oi)
 A082   0C68            DEF SEG
 A082   0C68            IF m33fb = &HCF OR m33fb = 0 THEN msen = 0: RETURN
