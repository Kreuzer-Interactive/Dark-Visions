 33F2   05D6                    IF ABS(dbgx) <= snr AND ABS(dbgy) <= snr THEN
 33F2   05D6                            dbgdd = dbgx * dbgx + dbgy * dbgy
 33F2   05D6                            IF dbgdd < dbgmin THEN dbgmin = dbgdd: 
                dbgoi = CINT(oi(dbgsi))
 34F3   05E2                    END IF
