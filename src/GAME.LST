 0AC9   09C8    
 0AC9   09C8    '----- startup
 0AC9   09C8    tmo = 2
 0AC9   09C8    'COM() statements in this programme
 0AC9   09C8    '----- reset the 8253 timer (channel 0) to the standard 18.2 Hz
                 tick.  Win98
 0AC9   09C8    '      "MS-DOS mode" can hand off with channel 0 left reprogram
                med faster,
 0AC9   09C8    '      which shortens SOUND durations (the intro races past) an
                d skews TIMER
 0AC9   09C8    '      (the in-room clock) -- prime suspect for the MS-DOS-mode
                 rush + lock-up.
 0AC9   09C8    '      No-op on a healthy DOS boot (it's already 18.2 Hz there)
                .
 0AC9   09C8    OUT &H43, &H36
 0AC9   09C8    OUT &H40, 0
 0AC9   09C8    OUT &H40, 0
 0AC9   09C8    CALL InitVars
 0AE8   09C8    CALL LoadConfig
 0AED   09C8    CALL initAllFonts(fontData(), font3Data(), fontbData())
 0AFE   09C8    '----- guard Intro's cutscene sound loops on fast CPUs: QB's SO
                UND runtime
 0AFE   09C8    '      can raise "Illegal function call" in the tight loops on 
                hardware far
 0AFE   09C8    '      faster than this 1993 intro targets.  Intro has no handl
                er of its own
 0AFE   09C8    '      (it runs before the ON ERROR GOTO errhand below).  RESUM
                E NEXT would
 0AFE   09C8    '      need /X, which overflows the 64K module, so on such an e
                rror introSkip
 0AFE   09C8    '      bails out of the cutscene to introDone -- the intro ends
                 early but the
 0AFE   09C8    '      game runs instead of crashing to DOS.  (Throttle work re
                stores it.)
 0AFE   09C8    ON ERROR GOTO introSkip
 0B08   09C8    IF inon <> 0 AND qkon = 0 THEN CALL Intro
 0B46   09C8    introDone:
 0B46   09C8    ON ERROR GOTO 0
 0B55   09C8    KEY OFF
 0B55   09C8    t0 = TIMER
 0B55   09C8    
 0B55   09C8    '----- joystick button handlers
 0B55   09C8    ON STRIG(2) GOSUB vact
 0B7C   09C8    ON STRIG(0) GOSUB vlook
 0B89   09C8    ON STRIG(4) GOSUB vget
 0B97   09C8    ON STRIG(6) GOSUB vuse
 0BA5   09C8    GOSUB strigon
 0BAD   09C8    GOSUB loadnames
 0BB5   09C8    GOSUB loadmsgs
 0BBD   09C8    GOSUB mouseinit
 0BC5   09C8    ON ERROR GOTO errhand
 0BCF   09C8    
 0BCF   09C8    SCREEN 1
 0BCF   09C8    CLS
