                ll, show a non-repeating random line
 47AB   05B2    lookmiss:
 4948   05B2            FOR lmi = 1 TO 257
 4956   05B2                    IF oy(lmi) = 0# THEN EXIT FOR
 4986   05B6                    IF ox(lmi) = b AND oy(lmi) = a THEN lcount = 0:
                 RETURN
 4A08   05B6            NEXT
 4A2F   05B6            IF b = lastlx AND a = lastly THEN
 4A2F   05B6                    lcount = lcount + 1
 4A2F   05B6            ELSE
