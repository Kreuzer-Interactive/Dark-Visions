 78AE   063E                            hvx = mx - ox(hvi)
 78AE   063E                            hvy = my - oy(hvi)
 78AE   063E                            IF ABS(hvx) <= hovr AND ABS(hvy) <= hov
                r THEN
 78AE   063E                                    hvd = hvx * hvx + hvy * hvy
 78AE   063E                                    IF hvd < hvb THEN hvb = hvd: hv
                dir$ = RIGHT$(tg$(hvo), 1)
 7A08   064E                            END IF
 7A08   064E                    END IF
