 4552   059E                    IF oy(dbgsi) = 0# THEN EXIT FOR
 4582   05A2                    dbgx = mx - ox(dbgsi)
 4582   05A2                    dbgy = my - oy(dbgsi)
 4582   05A2                    IF ABS(dbgx) <= snr AND ABS(dbgy) <= snr THEN
 4582   05A2                            dbgdd = dbgx * dbgx + dbgy * dbgy
 4582   05A2                            IF dbgdd < dbgmin THEN dbgmin = dbgdd: 
                dbgoi = CINT(oi(dbgsi))
 4683   05AE                    END IF
