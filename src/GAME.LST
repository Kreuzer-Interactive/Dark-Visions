 0CAD   09DA    IF sfps = 1 AND itt > .5 THEN LOCATE 3, 1: PRINT USING "Intro: 
                ### steps in ###.# secs"; ifc; itt
 0D31   09DA    400 a$ = INKEY$
 0D31   09DA    IF a$ <> "" THEN GOTO 430
 0D57   09DA    GOTO 400
