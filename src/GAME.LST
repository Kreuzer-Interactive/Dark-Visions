 785F   0574            IF msen <> 1 THEN RETURN
 787F   0574            mreg.ax = 3
 787F   0574            CALL INTERRUPT(mvint, mreg, mout)
 7896   0574            mx = mout.cx \ 2
 7896   0574            my = mout.dx
 7896   0574            IF mx < 0 THEN mx = 0
 78DC   0574            IF mx > 304 THEN mx = 304
 78FE   0574            IF my < 0 THEN my = 0
 7920   0574            IF my > 190 THEN my = 190
 7942   0574            b = (mx \ 4) * 4 + 2
 7942   0574            a = (my \ 4) * 4 + 2
 7942   0574            IF b > 302 THEN b = 302
 79C8   0574            IF a < 10 THEN a = 10
 79EA   0574            IF a > 190 THEN a = 190
 7A0C   0574            GOSUB hovexit
 7A14   0574            IF cdrawn = 0 OR mx <> cox OR my <> coy THEN GOSUB eras
                ecur: GOSUB drawcur
 7A78   0574            IF (mout.bx AND 1) <> 0 AND mlb = 0 THEN a$ = "a": GOSU
                B msnap
 7ABB   0574            IF (mout.bx AND 2) <> 0 AND mrb = 0 THEN a$ = "l": GOSU
                B msnap
 7AFE   0574            mlb = (mout.bx AND 1)
 7AFE   0574            mrb = (mout.bx AND 2)
