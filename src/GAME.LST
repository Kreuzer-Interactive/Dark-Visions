 09B2   08E0    
 09B2   08E0    '----- startup
 09B2   08E0    tmo = 2
 09B2   08E0    'COM() statements in this programme
 09B2   08E0    '----- reset the 8253 timer (channel 0) to the standard 18.2 Hz
                 tick.  Win98
 09B2   08E0    '      "MS-DOS mode" can hand off with channel 0 left reprogram
                med faster,
 09B2   08E0    '      which shortens SOUND durations (the intro races past) an
                d skews TIMER
 09B2   08E0    '      (the in-room clock) -- prime suspect for the MS-DOS-mode
                 rush + lock-up.
 09B2   08E0    '      No-op on a healthy DOS boot (it's already 18.2 Hz there)
                .
 09B2   08E0    OUT &H43, &H36
 09B2   08E0    OUT &H40, 0
 09B2   08E0    OUT &H40, 0
 09B2   08E0    CALL InitVars
 09D1   08E0    CALL LoadConfig
 09D6   08E0    CALL initAllFonts(fontData(), font3Data(), fontbData())
 09E7   08E0    '----- guard Intro's cutscene sound loops on fast CPUs: QB's SO
                UND runtime
 09E7   08E0    '      can raise "Illegal function call" in the tight loops on 
                hardware far
 09E7   08E0    '      faster than this 1993 intro targets.  Intro has no handl
                er of its own
 09E7   08E0    '      (it runs before the ON ERROR GOTO errhand below).  RESUM
                E NEXT would
 09E7   08E0    '      need /X, which overflows the 64K module, so on such an e
                rror introSkip
 09E7   08E0    '      bails out of the cutscene to introDone -- the intro ends
                 early but the
 09E7   08E0    '      game runs instead of crashing to DOS.  (Throttle work re
                stores it.)
 09E7   08E0    ON ERROR GOTO introSkip
 09F1   08E0    IF inon <> 0 AND qkon = 0 THEN CALL Intro
 0A2F   08E0    introDone:
 0A2F   08E0    ON ERROR GOTO 0
 0A3E   08E0    KEY OFF
 0A3E   08E0    t0 = TIMER
 0A3E   08E0    
