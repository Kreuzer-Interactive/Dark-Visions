Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

                00:0000 when none
 8D67   0AD6            '      is present; CALL INTERRUPT would then jump into 
                the interrupt
 8D67   0AD6            '      vector table and hang.  Bail out (disable the mo
                use) before calling.
 8D67   0AD6            '      Test the 4 vector bytes directly -- PEEK()*256 w
                ould overflow INTEGER.
 8D67   0AD6            DEF SEG = 0
 8D67   0AD6            m33a = PEEK(&HCC): m33b = PEEK(&HCD): m33c = PEEK(&HCE)
                : m33d = PEEK(&HCF)
 8D67   0AD6            DEF SEG
 8D67   0AD6            IF m33a = 0 AND m33b = 0 AND m33c = 0 AND m33d = 0 THEN
                 msen = 0: RETURN
 8E5C   0AE6            '----- ...and bail if the vector points to a bare IRET 
                stub (first byte
 8E5C   0AE6            '      &HCF).  That is what is there with NO real drive
                r (e.g. after
 8E5C   0AE6            '      exiting Win98 to MS-DOS mode); calling INT 33h o
                n it hangs.  A real
 8E5C   0AE6            '      driver's handler starts with executable code (mo
                use.com begins with
 8E5C   0AE6            '      a JMP, &HEB), never a bare IRET (&HCF) or a 0/de
                ad byte -- so this
 8E5C   0AE6            '      tells a real driver from a dead leftover vector 
                (seen as &HCF on one
 8E5C   0AE6            '      PC, 0 on another) without ever calling INT 33h.
 8E5C   0AE6            m33ls& = m33c + m33d * 256&
 8E5C   0AE6            m33lo& = m33a + m33b * 256&
 8E5C   0AE6            IF m33ls& > 32767 THEN m33si = m33ls& - 65536 ELSE m33s
                i = m33ls&
 8EDF   0AF2            IF m33lo& > 32767 THEN m33oi = m33lo& - 65536 ELSE m33o
                i = m33lo&
 8F26   0AF6            DEF SEG = m33si
 8F26   0AF6            m33fb = PEEK(m33oi)
 8F26   0AF6            DEF SEG
 8F26   0AF6            IF m33fb = &HCF OR m33fb = 0 THEN msen = 0: RETURN
