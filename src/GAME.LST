 7FEA   06F2    
 7FEA   06F2    '----- snap click to nearest hotspot within snr px (0 = off/exa
                ct)
 7FEA   06F2    '----- ABS box just prefilters; sdd<snd is the real test = a ci
                rcle of radius snr (Euclidean)
 7FEA   06F2    '----- breaks at first oy=0 exactly like action, so it never sn
                aps to an entry action can't reach
 7FEA   06F2    msnap:
 7FFB   06F2            IF snr <= 0 THEN RETURN
 801B   06F2            ' tie-break: a hotspot exactly under the cursor's own c
                ell wins over an expanded (snapped) neighbour
 801B   06F2            FOR sni = 1 TO 257
 8024   06F2                    IF oy(sni) = 0# THEN EXIT FOR
 8054   06F6                    IF ox(sni) = b AND oy(sni) = a THEN RETURN
 80CA   06F6            NEXT
 80F1   06F6            snd = snr * snr + 1
 80F1   06F6            snx = -1
 80F1   06F6            FOR sni = 1 TO 257
 811C   06FE                    IF oy(sni) = 0# THEN EXIT FOR
 814C   06FE                    sdx = mx - ox(sni)
                                                                      PAGE  31
                                                                      18 Jun 26
                                                                      22:54:23
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 814C   06FE                    sdy = my - oy(sni)
 814C   06FE                    IF ABS(sdx) <= snr AND ABS(sdy) <= snr THEN
 814C   06FE                            sdd = sdx * sdx + sdy * sdy
 814C   06FE                            IF sdd < snd THEN
 814C   06FE                                    snd = sdd
 814C   06FE                                    snx = ox(sni)
 814C   06FE                                    sny = oy(sni)
 814C   06FE                            END IF
 8273   070E                    END IF
 8273   070E            NEXT
 829A   070E            IF snx >= 0 THEN b = snx: a = sny
 82C8   070E            RETURN
 82C8   070E    
 82C8   070E    '----- near a walkout exit? morph cursor to point the way the p
                layer leaves (exitcursor)
