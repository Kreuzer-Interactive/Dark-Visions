 7E0B   06EA    '----- draw software cursor: save background, then paint the ar
                row (1=gray, 2=blue)
 7E0B   06EA    drawcur:
 7E10   06EA            GET (mx, my)-(mx + 15, my + 9), curbuf
 7E10   06EA            FOR mi = 0 TO npix(cshp) - 1
 7E9A   06EE                    PSET (mx + px(cshp, mi), my + py(cshp, mi)), pc
                (cshp, mi)
 7E9A   06EE            NEXT
