 F5C3   0C98    '----- QuitConfirm: wait for Yes/No on the quit modal -- the in
                teractive loop
 F5C3   0C98    '----- lives in GAME4 (YNWait) to stay under GAME.BAS's 64K cod
                e ceiling
 F5C3   0C98    SUB QuitConfirm
 F5CE   0C98            CALL YNWait(mvint, msen, 1, qcr%)
 F5E8   0C98            IF qcr% = 1 THEN SYSTEM
 F5F6   0C98    END SUB
 F5FE   0C98    
 F5FE   0C98    '----- write the live game state to slot 1-10 (saver a-j.pac). 
                Lives in GAME.BAS for DIM SHARED access; called from the GAME4 
                save/load screen.
 F5FE   0C98    SUB SaveGame (slot AS INTEGER)
 F609   0C98            DIM slz AS INTEGER
 F609   0C98            OPEN "saver" + CHR$(slot + 96) + ".pac" FOR OUTPUT AS #
                1
 F609   0C98            WRITE #1, q$, cl, pt, done$, tt$, a$, lf$
 F609   0C98            FOR slz = 1 TO 80
 F698   0C98                    WRITE #1, ob(slz)
 F698   0C98            NEXT
 F6CE   0C98            CLOSE #1
 F6CE   0C98    END SUB
 F6E0   0C98    
 F6E0   0C98    '----- read game state from slot 1-10 + rebuild inventory acqui
                re-order/new-flags (mirrors the old reload: path)
 F6E0   0C98    SUB LoadGame (slot AS INTEGER)
 F6EB   0C98            DIM slz AS INTEGER
 F6EB   0C98            OPEN "saver" + CHR$(slot + 96) + ".pac" FOR INPUT AS #1
 F6EB   0C98            INPUT #1, q$, cl, pt, done$, tt$, a$, lf$
 F728   0C98            tt$ = "n": done$ = "": IF LEN(lf$) <> 1 OR INSTR("12346
                789", lf$) = 0 THEN lf$ = "2"
 F7E1   0C98            '----- old saves hold 65 flags; the extension reads wha
                t exists (EOF guard)
 F7E1   0C98            FOR slz = 66 TO 80: ob(slz) = 0: NEXT
 F80E   0C98            FOR slz = 1 TO 80
 F814   0C98                    IF EOF(1) THEN EXIT FOR
 F824   0C98                    INPUT #1, ob(slz)
 F82D   0C98            NEXT
 F855   0C98            CLOSE #1
 F855   0C98            aqc = 0
 F855   0C98            FOR slz = 1 TO 36
 F86C   0C98                    IF ob(iord(slz)) = 1 THEN aqc = aqc + 1: aqo(io
                rd(slz)) = aqc ELSE aqo(iord(slz)) = 0
 F905   0C98                    nwf(iord(slz)) = 0
 F905   0C98            NEXT
 F93F   0C98            ERASE er1
 F948   0C98            FOR slz = 1 TO 40
 F94E   0C98                    gp(slz) = 0#
 F94E   0C98            NEXT
 F974   0C98    END SUB
