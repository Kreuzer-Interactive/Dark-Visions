 43FD   0596    '----- fps counter: update on-screen frame rate
 43FD   0596    fpstick:
 4405   0596            fpsc = fpsc + 1
 4405   0596            fpsd = TIMER - fpst
 4405   0596            IF fpsd < 0 OR fpsd >= 2 THEN
 4405   0596                    fpst = TIMER
 4405   0596                    fpsc = 0
 4405   0596            ELSEIF fpsd >= 1 THEN
 448A   0596                    fpsv = fpsc / fpsd
 448A   0596                    IF fpsv > 99999 THEN fpsv = 99999
 44D3   0596                    LOCATE 1, 35
