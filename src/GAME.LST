 9569   0BCE            IF m33lo& > 32767 THEN m33oi = m33lo& - 65536 ELSE m33o
                i = m33lo&
 95B0   0BD2            DEF SEG = m33si
 95B0   0BD2            m33fb = PEEK(m33oi)
 95B0   0BD2            DEF SEG
 95B0   0BD2            IF m33fb = &HCF OR m33fb = 0 THEN msen = 0: RETURN
