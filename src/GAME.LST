 9B98   0C28    '----- initialise the mouse driver (INT 33h)
 9B98   0C28    mouseinit:
 9B9D   0C28            IF msen <> 1 THEN RETURN
 9BBD   0C28            '----- no mouse driver loaded? the INT 33h vector is 00
                00:0000 when none
 9BBD   0C28            '      is present; CALL INTERRUPT would then jump into 
                the interrupt
 9BBD   0C28            '      vector table and hang.  Bail out (disable the mo
                use) before calling.
 9BBD   0C28            '      Test the 4 vector bytes directly -- PEEK()*256 w
                ould overflow INTEGER.
 9BBD   0C28            DEF SEG = 0
 9BBD   0C28            m33a = PEEK(&HCC): m33b = PEEK(&HCD): m33c = PEEK(&HCE)
                : m33d = PEEK(&HCF)
 9BBD   0C28            DEF SEG
 9BBD   0C28            IF m33a = 0 AND m33b = 0 AND m33c = 0 AND m33d = 0 THEN
                 msen = 0: RETURN
 9CB2   0C38            '----- ...and bail if the vector points to a bare IRET 
                stub (first byte
 9CB2   0C38            '      &HCF).  That is what is there with NO real drive
                r (e.g. after
 9CB2   0C38            '      exiting Win98 to MS-DOS mode); calling INT 33h o
                n it hangs.  A real
 9CB2   0C38            '      driver's handler starts with executable code (mo
                use.com begins with
 9CB2   0C38            '      a JMP, &HEB), never a bare IRET (&HCF) or a 0/de
                ad byte -- so this
 9CB2   0C38            '      tells a real driver from a dead leftover vector 
                (seen as &HCF on one
 9CB2   0C38            '      PC, 0 on another) without ever calling INT 33h.
 9CB2   0C38            m33ls& = m33c + m33d * 256&
 9CB2   0C38            m33lo& = m33a + m33b * 256&
 9CB2   0C38            IF m33ls& > 32767 THEN m33si = m33ls& - 65536 ELSE m33s
                i = m33ls&
 9D35   0C44            IF m33lo& > 32767 THEN m33oi = m33lo& - 65536 ELSE m33o
                i = m33lo&
 9D7C   0C48            DEF SEG = m33si
 9D7C   0C48            m33fb = PEEK(m33oi)
 9D7C   0C48            DEF SEG
 9D7C   0C48            IF m33fb = &HCF OR m33fb = 0 THEN msen = 0: RETURN
 9E02   0C4C            mreg.ax = 0
 9E02   0C4C            CALL INTERRUPT(mvint, mreg, mout)
 9E19   0C4C            IF mout.ax = 0 THEN msen = 0
