 8354   071E                            hvx = mx - ox(hvi)
 8354   071E                            hvy = my - oy(hvi)
 8354   071E                            IF ABS(hvx) <= hovr AND ABS(hvy) <= hov
                r THEN
 8354   071E                                    hvd = hvx * hvx + hvy * hvy
 8354   071E                                    IF hvd < hvb THEN hvb = hvd: hv
                dir$ = RIGHT$(tg$(hvo), 1)
 84AE   072E                            END IF
 84AE   072E                    END IF
 84AE   072E            NEXT
 84D5   072E            IF hvb <= hovr * hovr THEN
 84D5   072E                    IF hvdir$ = "n" THEN newshp = 1
 850E   072E                    IF hvdir$ = "s" THEN newshp = 2
 852C   072E                    IF hvdir$ = "e" THEN newshp = 3
 854A   072E                    IF hvdir$ = "w" THEN newshp = 4
 8568   072E            END IF
 8568   072E            IF newshp = cshp THEN RETURN
