 7AB7   0594    '----- poll mouse: move cursor and read buttons
 7AB7   0594    mousepoll:
 7B33   0594            IF msen <> 1 THEN RETURN
 7B53   0594            mreg.ax = 3
 7B53   0594            CALL INTERRUPT(mvint, mreg, mout)
 7B6A   0594            mx = mout.cx \ 2
 7B6A   0594            my = mout.dx
 7B6A   0594            IF mx < 0 THEN mx = 0
 7BB0   0594            IF mx > 304 THEN mx = 304
 7BD2   0594            IF my < 0 THEN my = 0
 7BF4   0594            IF my > 190 THEN my = 190
 7C16   0594            b = (mx \ 4) * 4 + 2
 7C16   0594            a = (my \ 4) * 4 + 2
 7C16   0594            IF b > 302 THEN b = 302
 7C9C   0594            IF a < 10 THEN a = 10
 7CBE   0594            IF a > 190 THEN a = 190
 7CE0   0594            IF mxyon = 1 THEN GOSUB mxytick
 7CFE   0594            GOSUB hovexit
 7D06   0594            IF cdrawn = 0 OR mx <> cox OR my <> coy THEN GOSUB eras
                ecur: GOSUB drawcur
 7D6A   0594            IF (mout.bx AND 1) <> 0 AND mlb = 0 THEN a$ = "a": GOSU
                B msnap
 7DAD   0594            IF (mout.bx AND 2) <> 0 AND mrb = 0 THEN a$ = "l": GOSU
                B msnap
 7DF0   0594            mlb = (mout.bx AND 1)
 7DF0   0594            mrb = (mout.bx AND 2)
 7DF0   0594            RETURN
 7DF0   0594    
 7DF0   0594    '----- draw software cursor: save background, then paint the ar
                row (1=gray, 2=blue)
 7DF0   0594    drawcur:
 7E19   0594            GET (mx, my)-(mx + 15, my + 9), curbuf
 7E19   0594            FOR mi = 0 TO npix(cshp) - 1
 7EA2   0598                    PSET (mx + px(cshp, mi), my + py(cshp, mi)), pc
                (cshp, mi)
 7EA2   0598            NEXT
 7F84   059C            cox = mx: coy = my: cdrawn = 1
 7F84   059C            RETURN
 7F84   059C    
 7F84   059C    '----- erase software cursor: restore saved background
 7F84   059C    erasecur:
 7FAD   059C            IF cdrawn = 1 THEN PUT (cox, coy), curbuf, PSET
 7FF2   059C            cdrawn = 0
 7FF2   059C            RETURN
 7FF2   059C    
 7FF2   059C    '----- snap click to nearest hotspot within snr px (0 = off/exa
                ct)
                                                                      PAGE  31
