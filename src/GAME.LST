 8EB6   0ADA    '----- initialise the mouse driver (INT 33h)
 8EB6   0ADA    mouseinit:
 8EBB   0ADA            IF msen <> 1 THEN RETURN
 8EDB   0ADA            '----- no mouse driver loaded? the INT 33h vector is 00
                00:0000 when none
 8EDB   0ADA            '      is present; CALL INTERRUPT would then jump into 
                the interrupt
 8EDB   0ADA            '      vector table and hang.  Bail out (disable the mo
                use) before calling.
 8EDB   0ADA            '      Test the 4 vector bytes directly -- PEEK()*256 w
                ould overflow INTEGER.
 8EDB   0ADA            DEF SEG = 0
 8EDB   0ADA            m33a = PEEK(&HCC): m33b = PEEK(&HCD): m33c = PEEK(&HCE)
                : m33d = PEEK(&HCF)
 8EDB   0ADA            DEF SEG
 8EDB   0ADA            IF m33a = 0 AND m33b = 0 AND m33c = 0 AND m33d = 0 THEN
                 msen = 0: RETURN
 8FD0   0AEA            '----- ...and bail if the vector points to a bare IRET 
                stub (first byte
 8FD0   0AEA            '      &HCF).  That is what is there with NO real drive
                r (e.g. after
 8FD0   0AEA            '      exiting Win98 to MS-DOS mode); calling INT 33h o
                n it hangs.  A real
 8FD0   0AEA            '      driver's handler starts with executable code (mo
                use.com begins with
 8FD0   0AEA            '      a JMP, &HEB), never a bare IRET (&HCF) or a 0/de
                ad byte -- so this
 8FD0   0AEA            '      tells a real driver from a dead leftover vector 
                (seen as &HCF on one
 8FD0   0AEA            '      PC, 0 on another) without ever calling INT 33h.
 8FD0   0AEA            m33ls& = m33c + m33d * 256&
                                                                      PAGE  37
                                                                      07 Jul 26
                                                                      01:34:17
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 8FD0   0AEA            m33lo& = m33a + m33b * 256&
