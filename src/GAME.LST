 F4D0   0C34    '----- write the live game state to slot 1-10 (saver a-j.pac). 
                Lives in GAME.BAS for DIM SHARED access; called from the GAME4 
                save/load screen.
 F4D0   0C34    SUB SaveGame (slot AS INTEGER)
 F4DB   0C34            DIM slz AS INTEGER
 F4DB   0C34            OPEN "saver" + CHR$(slot + 96) + ".pac" FOR OUTPUT AS #
                1
