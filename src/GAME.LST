 EE80   0984    '----- QuitConfirm: wait for Yes/No on the quit modal (click a 
                button or press Y/N)
 EE80   0984    SUB QuitConfirm
 EE8B   0984            '----- let the opening click release so it doesn't carr
                y into Yes/No
 EE8B   0984            IF msen = 1 THEN
 EE8B   0984                    DO
 EEA2   0984                            mreg.ax = 3: CALL INTERRUPT(mvint, mreg
                , mout)
 EEB9   0984                    LOOP WHILE (mout.bx AND 1) <> 0
 EEB9   0984            END IF
 EEC3   0984            DO
 EEC4   0984                    qk$ = INKEY$
 EEC4   0984                    IF qk$ = "y" OR qk$ = "Y" THEN SYSTEM
 EF0D   0984                    IF qk$ = "n" OR qk$ = "N" THEN EXIT SUB
 EF42   0984                    IF msen = 1 THEN
 EF42   0984                            mreg.ax = 3: CALL INTERRUPT(mvint, mreg
                , mout)
 EF6F   0984                            nmx = mout.cx \ 2: nmy = mout.dx
 EF6F   0984                            IF nmx > 304 THEN nmx = 304 ELSE IF nmx
                 < 0 THEN nmx = 0
 EFA5   0984                            IF nmy > 190 THEN nmy = 190 ELSE IF nmy
                 < 0 THEN nmy = 0
 EFC9   0984                            IF nmx <> mx OR nmy <> my THEN CALL era
                secur: mx = nmx: my = nmy: CALL drawcur
 F002   0984                            IF (mout.bx AND 1) <> 0 THEN
 F002   0984                                    IF mx >= 92 AND mx <= 142 AND m
                y >= 105 AND my <= 117 THEN SYSTEM
 F04E   0984                                    IF mx >= 178 AND mx <= 228 AND 
                my >= 105 AND my <= 117 THEN EXIT SUB
 F089   0984                                    IF mx >= 260 AND mx <= 270 AND 
                my >= 80 AND my <= 87 THEN EXIT SUB
 F0C4   0984                            END IF
 F0C4   0984                    END IF
 F0C4   0984            LOOP
 F0C4   0984    END SUB
