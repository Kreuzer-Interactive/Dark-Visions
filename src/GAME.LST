 8593   05D8    '----- install a custom mouse cursor shape (INT 33h AX=9)
 8593   05D8    setcursor:
 85A4   05D8            IF msen <> 1 OR mcur < 1 THEN RETURN
 85D9   05D8            FOR mi = 0 TO 31
 85E2   05D8                    cmask(mi) = 0
 85E2   05D8            NEXT
 8622   05D8            mhsx = 7: mhsy = 7: mxor = 0: mraw = 0
 8622   05D8            IF mcur = 1 THEN GOSUB shArrow
 8658   05D8            IF mcur = 2 THEN GOSUB shCross
 866A   05D8            IF mcur = 3 THEN GOSUB shBox
 867C   05D8            IF mcur = 4 THEN GOSUB shCross: mxor = 1
 869A   05D8            IF mcur = 5 THEN GOSUB shArrowNE
 86AC   05D8            IF mraw = 0 THEN
 86AC   05D8                    FOR mi = 0 TO 15
 86CA   05D8                            IF mxor = 1 THEN cmask(mi) = &HFFFF ELS
                E cmask(mi) = NOT cmask(16 + mi)
 873B   05D8                    NEXT
 8762   05D8            END IF
 8762   05D8            mregx.ax = 9
 8762   05D8            mregx.bx = mhsx
 8762   05D8            mregx.cx = mhsy
 8762   05D8            mregx.dx = VARPTR(cmask(0))
 8762   05D8            mregx.es = VARSEG(cmask(0))
 8762   05D8            CALL INTERRUPTX(mvint, mregx, moutx)
 87A2   05D8            RETURN
