                the interrupt
 9C6D   0C2A            '      vector table and hang.  Bail out (disable the mo
                use) before calling.
 9C6D   0C2A            '      Test the 4 vector bytes directly -- PEEK()*256 w
                ould overflow INTEGER.
 9C6D   0C2A            DEF SEG = 0
 9C6D   0C2A            m33a = PEEK(&HCC): m33b = PEEK(&HCD): m33c = PEEK(&HCE)
                : m33d = PEEK(&HCF)
 9C6D   0C2A            DEF SEG
 9C6D   0C2A            IF m33a = 0 AND m33b = 0 AND m33c = 0 AND m33d = 0 THEN
                 msen = 0: RETURN
