 6D35   05FA    '----- poll mouse: move cursor and read buttons
 6D35   05FA    mousepoll:
 6DB1   05FA            IF msen <> 1 THEN RETURN
 6DD1   05FA            mreg.ax = 3
 6DD1   05FA            CALL INTERRUPT(mvint, mreg, mout)
 6DE8   05FA            mx = mout.cx \ 2
 6DE8   05FA            my = mout.dx
 6DE8   05FA            IF mx < 0 THEN mx = 0
 6E2E   05FA            IF mx > 304 THEN mx = 304
 6E50   05FA            IF my < 0 THEN my = 0
 6E72   05FA            IF my > 190 THEN my = 190
 6E94   05FA            b = (mx \ 4) * 4 + 2
 6E94   05FA            a = (my \ 4) * 4 + 2
 6E94   05FA            IF b > 302 THEN b = 302
 6F1A   05FA            IF a < 10 THEN a = 10
 6F3C   05FA            IF a > 190 THEN a = 190
 6F5E   05FA            IF mxyon = 1 THEN GOSUB mxytick
 6F7C   05FA            GOSUB hovexit
 6F84   05FA            IF cdrawn = 0 OR mx <> cox OR my <> coy THEN GOSUB eras
                ecur: GOSUB drawcur
 6FE8   05FA            IF (mout.bx AND 1) <> 0 AND mlb = 0 THEN a$ = "a": GOSU
                B msnap
 702B   05FA            IF (mout.bx AND 2) <> 0 AND mrb = 0 THEN a$ = "l": GOSU
                B msnap
 706E   05FA            mlb = (mout.bx AND 1)
 706E   05FA            mrb = (mout.bx AND 2)
 706E   05FA            RETURN
 706E   05FA    
 706E   05FA    '----- draw software cursor: save background, then paint the ar
                row (1=gray, 2=blue)
 706E   05FA    drawcur:
 7097   05FA            GET (mx, my)-(mx + 15, my + 9), curbuf
 7097   05FA            FOR mi = 0 TO npix(cshp) - 1
 7120   05FE                    PSET (mx + px(cshp, mi), my + py(cshp, mi)), pc
                (cshp, mi)
 7120   05FE            NEXT
 7202   0602            cox = mx: coy = my: cdrawn = 1
 7202   0602            RETURN
 7202   0602    
 7202   0602    '----- erase software cursor: restore saved background
 7202   0602    erasecur:
 722B   0602            IF cdrawn = 1 THEN PUT (cox, coy), curbuf, PSET
 7270   0602            cdrawn = 0
 7270   0602            RETURN
 7270   0602    
 7270   0602    '----- snap click to nearest hotspot within snr px (0 = off/exa
                ct)
 7270   0602    '----- ABS box just prefilters; sdd<snd is the real test = a ci
                                                                      PAGE  29
                                                                      15 Jun 26
                                                                      02:15:53
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

                rcle of radius snr (Euclidean)
 7270   0602    '----- breaks at first oy=0 exactly like action, so it never sn
                aps to an entry action can't reach
 7270   0602    msnap:
 7281   0602            IF snr <= 0 THEN RETURN
 72A1   0602            ' tie-break: a hotspot exactly under the cursor's own c
                ell wins over an expanded (snapped) neighbour
 72A1   0602            FOR sni = 1 TO 257
 72AA   0602                    IF oy(sni) = 0# THEN EXIT FOR
 72DA   0606                    IF ox(sni) = b AND oy(sni) = a THEN RETURN
 7350   0606            NEXT
 7377   0606            snd = snr * snr + 1
 7377   0606            snx = -1
 7377   0606            FOR sni = 1 TO 257
 73A2   060E                    IF oy(sni) = 0# THEN EXIT FOR
 73D2   060E                    sdx = mx - ox(sni)
 73D2   060E                    sdy = my - oy(sni)
 73D2   060E                    IF ABS(sdx) <= snr AND ABS(sdy) <= snr THEN
 73D2   060E                            sdd = sdx * sdx + sdy * sdy
 73D2   060E                            IF sdd < snd THEN
 73D2   060E                                    snd = sdd
 73D2   060E                                    snx = ox(sni)
 73D2   060E                                    sny = oy(sni)
 73D2   060E                            END IF
 74F9   061E                    END IF
 74F9   061E            NEXT
 7520   061E            IF snx >= 0 THEN b = snx: a = sny
 754E   061E            RETURN
 754E   061E    
 754E   061E    '----- near a walkout exit? morph cursor to point the way the p
                layer leaves (exitcursor)
 754E   061E    '----- reads tg$ direction (wn=up ws=down we=right ww=left); re
                verts to NW arrow otherwise
 754E   061E    hovexit:
 7553   061E            IF exsen <> 1 THEN RETURN
 7573   061E            newshp = 0
 7573   061E            hvdir$ = ""
 7573   061E            hvb = hovr * hovr + 1
 7573   061E            FOR hvi = 1 TO 257
 75AA   062A                    IF oy(hvi) = 0# THEN EXIT FOR
 75DA   062E                    hvo = CINT(oi(hvi))
 75DA   062E                    IF LEFT$(tg$(hvo), 1) = "w" THEN
 75DA   062E                            hvx = mx - ox(hvi)
 75DA   062E                            hvy = my - oy(hvi)
 75DA   062E                            IF ABS(hvx) <= hovr AND ABS(hvy) <= hov
                r THEN
 75DA   062E                                    hvd = hvx * hvx + hvy * hvy
 75DA   062E                                    IF hvd < hvb THEN hvb = hvd: hv
                dir$ = RIGHT$(tg$(hvo), 1)
 7734   063E                            END IF
 7734   063E                    END IF
 7734   063E            NEXT
 775B   063E            IF hvb <= hovr * hovr THEN
 775B   063E                    IF hvdir$ = "n" THEN newshp = 1
