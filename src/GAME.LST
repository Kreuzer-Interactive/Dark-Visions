 8EBC   0B52    '----- initialise the mouse driver (INT 33h)
 8EBC   0B52    mouseinit:
 8EC1   0B52            IF msen <> 1 THEN RETURN
 8EE1   0B52            '----- no mouse driver loaded? the INT 33h vector is 00
                00:0000 when none
 8EE1   0B52            '      is present; CALL INTERRUPT would then jump into 
                the interrupt
 8EE1   0B52            '      vector table and hang.  Bail out (disable the mo
                use) before calling.
 8EE1   0B52            '      Test the 4 vector bytes directly -- PEEK()*256 w
                ould overflow INTEGER.
 8EE1   0B52            DEF SEG = 0
 8EE1   0B52            m33a = PEEK(&HCC): m33b = PEEK(&HCD): m33c = PEEK(&HCE)
                : m33d = PEEK(&HCF)
 8EE1   0B52            DEF SEG
 8EE1   0B52            IF m33a = 0 AND m33b = 0 AND m33c = 0 AND m33d = 0 THEN
                 msen = 0: RETURN
 8FD6   0B62            '----- ...and bail if the vector points to a bare IRET 
                stub (first byte
 8FD6   0B62            '      &HCF).  That is what is there with NO real drive
                r (e.g. after
 8FD6   0B62            '      exiting Win98 to MS-DOS mode); calling INT 33h o
                n it hangs.  A real
 8FD6   0B62            '      driver's handler starts with executable code (mo
                use.com begins with
 8FD6   0B62            '      a JMP, &HEB), never a bare IRET (&HCF) or a 0/de
                ad byte -- so this
 8FD6   0B62            '      tells a real driver from a dead leftover vector 
                (seen as &HCF on one
 8FD6   0B62            '      PC, 0 on another) without ever calling INT 33h.
 8FD6   0B62            m33ls& = m33c + m33d * 256&
 8FD6   0B62            m33lo& = m33a + m33b * 256&
 8FD6   0B62            IF m33ls& > 32767 THEN m33si = m33ls& - 65536 ELSE m33s
                i = m33ls&
 9059   0B6E            IF m33lo& > 32767 THEN m33oi = m33lo& - 65536 ELSE m33o
                i = m33lo&
 90A0   0B72            DEF SEG = m33si
 90A0   0B72            m33fb = PEEK(m33oi)
 90A0   0B72            DEF SEG
                                                                      PAGE  39
                                                                      09 Jul 26
                                                                      14:34:08
