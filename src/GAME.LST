 9966   0B8E    '----- initialise the mouse driver (INT 33h)
 9966   0B8E    mouseinit:
 996B   0B8E            IF msen <> 1 THEN RETURN
 998B   0B8E            '----- no mouse driver loaded? the INT 33h vector is 00
                00:0000 when none
 998B   0B8E            '      is present; CALL INTERRUPT would then jump into 
                the interrupt
 998B   0B8E            '      vector table and hang.  Bail out (disable the mo
                use) before calling.
 998B   0B8E            '      Test the 4 vector bytes directly -- PEEK()*256 w
                ould overflow INTEGER.
 998B   0B8E            DEF SEG = 0
 998B   0B8E            m33a = PEEK(&HCC): m33b = PEEK(&HCD): m33c = PEEK(&HCE)
                : m33d = PEEK(&HCF)
 998B   0B8E            DEF SEG
 998B   0B8E            IF m33a = 0 AND m33b = 0 AND m33c = 0 AND m33d = 0 THEN
                 msen = 0: RETURN
 9A80   0B9E            '----- ...and bail if the vector points to a bare IRET 
                stub (first byte
 9A80   0B9E            '      &HCF).  That is what is there with NO real drive
                r (e.g. after
 9A80   0B9E            '      exiting Win98 to MS-DOS mode); calling INT 33h o
                n it hangs.  A real
 9A80   0B9E            '      driver's handler starts with executable code (mo
                use.com begins with
 9A80   0B9E            '      a JMP, &HEB), never a bare IRET (&HCF) or a 0/de
                ad byte -- so this
 9A80   0B9E            '      tells a real driver from a dead leftover vector 
                (seen as &HCF on one
 9A80   0B9E            '      PC, 0 on another) without ever calling INT 33h.
 9A80   0B9E            m33ls& = m33c + m33d * 256&
 9A80   0B9E            m33lo& = m33a + m33b * 256&
 9A80   0B9E            IF m33ls& > 32767 THEN m33si = m33ls& - 65536 ELSE m33s
                i = m33ls&
 9B03   0BAA            IF m33lo& > 32767 THEN m33oi = m33lo& - 65536 ELSE m33o
                i = m33lo&
 9B4A   0BAE            DEF SEG = m33si
 9B4A   0BAE            m33fb = PEEK(m33oi)
 9B4A   0BAE            DEF SEG
 9B4A   0BAE            IF m33fb = &HCF OR m33fb = 0 THEN msen = 0: RETURN
 9BD0   0BB2            mreg.ax = 0
