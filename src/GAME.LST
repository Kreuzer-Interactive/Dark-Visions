                row (1=gray, 2=blue)
 7AFE   0574    drawcur:
 7B27   0574            GET (mx, my)-(mx + 15, my + 9), curbuf
 7B27   0574            FOR mi = 0 TO npix(cshp) - 1
 7BB0   0578                    PSET (mx + px(cshp, mi), my + py(cshp, mi)), pc
                (cshp, mi)
