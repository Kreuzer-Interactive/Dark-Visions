 0AE1   09DA    
 0AE1   09DA    '----- startup
 0AE1   09DA    tmo = 2
 0AE1   09DA    'COM() statements in this programme
 0AE1   09DA    '----- reset the 8253 timer (channel 0) to the standard 18.2 Hz
                 tick.  Win98
 0AE1   09DA    '      "MS-DOS mode" can hand off with channel 0 left reprogram
                med faster,
 0AE1   09DA    '      which shortens SOUND durations (the intro races past) an
                d skews TIMER
 0AE1   09DA    '      (the in-room clock) -- prime suspect for the MS-DOS-mode
                 rush + lock-up.
 0AE1   09DA    '      No-op on a healthy DOS boot (it's already 18.2 Hz there)
                .
 0AE1   09DA    OUT &H43, &H36
 0AE1   09DA    OUT &H40, 0
 0AE1   09DA    OUT &H40, 0
 0AE1   09DA    CALL InitVars
 0B00   09DA    CALL LoadConfig
 0B05   09DA    CALL initAllFonts(fontData(), font3Data(), fontbData())
 0B16   09DA    '----- guard Intro's cutscene sound loops on fast CPUs: QB's SO
                UND runtime
 0B16   09DA    '      can raise "Illegal function call" in the tight loops on 
                hardware far
 0B16   09DA    '      faster than this 1993 intro targets.  Intro has no handl
                er of its own
 0B16   09DA    '      (it runs before the ON ERROR GOTO errhand below).  RESUM
                E NEXT would
 0B16   09DA    '      need /X, which overflows the 64K module, so on such an e
                rror introSkip
 0B16   09DA    '      bails out of the cutscene to introDone -- the intro ends
                 early but the
 0B16   09DA    '      game runs instead of crashing to DOS.  (Throttle work re
                stores it.)
 0B16   09DA    ON ERROR GOTO introSkip
 0B20   09DA    IF inon <> 0 AND qkon = 0 THEN CALL Intro
 0B5E   09DA    introDone:
 0B5E   09DA    ON ERROR GOTO 0
 0B6D   09DA    KEY OFF
 0B6D   09DA    t0 = TIMER
 0B6D   09DA    
 0B6D   09DA    '----- joystick button handlers
 0B6D   09DA    ON STRIG(2) GOSUB vact
 0B94   09DA    ON STRIG(0) GOSUB vlook
 0BA1   09DA    ON STRIG(4) GOSUB vget
 0BAF   09DA    ON STRIG(6) GOSUB vuse
 0BBD   09DA    GOSUB strigon
 0BC5   09DA    GOSUB loadnames
