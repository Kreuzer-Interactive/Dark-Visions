 864A   090E    '----- initialise the mouse driver (INT 33h)
 864A   090E    mouseinit:
 864F   090E            IF msen <> 1 THEN RETURN
 866F   090E            '----- no mouse driver loaded? the INT 33h vector is 00
                00:0000 when none
 866F   090E            '      is present; CALL INTERRUPT would then jump into 
                the interrupt
 866F   090E            '      vector table and hang.  Bail out (disable the mo
                use) before calling.
 866F   090E            '      Test the 4 vector bytes directly -- PEEK()*256 w
                ould overflow INTEGER.
 866F   090E            DEF SEG = 0
 866F   090E            m33a = PEEK(&HCC): m33b = PEEK(&HCD): m33c = PEEK(&HCE)
                : m33d = PEEK(&HCF)
 866F   090E            DEF SEG
 866F   090E            IF m33a = 0 AND m33b = 0 AND m33c = 0 AND m33d = 0 THEN
                 msen = 0: RETURN
 8764   091E            '----- ...and bail if the vector points to a bare IRET 
                stub (first byte
 8764   091E            '      &HCF).  That is what is there with NO real drive
                                                                      PAGE  32
                                                                      30 Jun 26
                                                                      18:25:51
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

                r (e.g. after
 8764   091E            '      exiting Win98 to MS-DOS mode); calling INT 33h o
                n it hangs.  A real
 8764   091E            '      driver's handler starts with executable code (mo
                use.com begins with
 8764   091E            '      a JMP, &HEB), never a bare IRET (&HCF) or a 0/de
                ad byte -- so this
 8764   091E            '      tells a real driver from a dead leftover vector 
                (seen as &HCF on one
 8764   091E            '      PC, 0 on another) without ever calling INT 33h.
 8764   091E            m33ls& = m33c + m33d * 256&
 8764   091E            m33lo& = m33a + m33b * 256&
 8764   091E            IF m33ls& > 32767 THEN m33si = m33ls& - 65536 ELSE m33s
                i = m33ls&
 87E7   092A            IF m33lo& > 32767 THEN m33oi = m33lo& - 65536 ELSE m33o
                i = m33lo&
 882E   092E            DEF SEG = m33si
 882E   092E            m33fb = PEEK(m33oi)
 882E   092E            DEF SEG
 882E   092E            IF m33fb = &HCF OR m33fb = 0 THEN msen = 0: RETURN
 88B4   0932            mreg.ax = 0
 88B4   0932            CALL INTERRUPT(mvint, mreg, mout)
 88CB   0932            IF mout.ax = 0 THEN msen = 0
