 7A2F   064E            IF hvb <= hovr * hovr THEN
 7A2F   064E                    IF hvdir$ = "n" THEN newshp = 1
 7A68   064E                    IF hvdir$ = "s" THEN newshp = 2
 7A86   064E                    IF hvdir$ = "e" THEN newshp = 3
 7AA4   064E                    IF hvdir$ = "w" THEN newshp = 4
 7AC2   064E            END IF
 7AC2   064E            IF newshp = cshp THEN RETURN
 7ADD   064E            GOSUB erasecur
 7AE5   064E            cshp = newshp
