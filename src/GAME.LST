 0AD5   09B2    CALL initAllFonts(fontData(), font3Data(), fontbData())
 0AE6   09B2    '----- guard Intro's cutscene sound loops on fast CPUs: QB's SO
                UND runtime
 0AE6   09B2    '      can raise "Illegal function call" in the tight loops on 
                hardware far
 0AE6   09B2    '      faster than this 1993 intro targets.  Intro has no handl
                er of its own
 0AE6   09B2    '      (it runs before the ON ERROR GOTO errhand below).  RESUM
                E NEXT would
 0AE6   09B2    '      need /X, which overflows the 64K module, so on such an e
                rror introSkip
 0AE6   09B2    '      bails out of the cutscene to introDone -- the intro ends
                 early but the
 0AE6   09B2    '      game runs instead of crashing to DOS.  (Throttle work re
                stores it.)
 0AE6   09B2    ON ERROR GOTO introSkip
 0AF0   09B2    IF inon <> 0 AND qkon = 0 THEN CALL Intro
 0B2E   09B2    introDone:
