                i = m33ls&
 9053   0AF6            IF m33lo& > 32767 THEN m33oi = m33lo& - 65536 ELSE m33o
                i = m33lo&
 909A   0AFA            DEF SEG = m33si
 909A   0AFA            m33fb = PEEK(m33oi)
 909A   0AFA            DEF SEG
