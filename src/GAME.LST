 9E62   0C48    mouseinit:
 9E67   0C48            IF msen <> 1 THEN RETURN
 9E87   0C48            '----- no mouse driver loaded? the INT 33h vector is 00
                00:0000 when none
 9E87   0C48            '      is present; CALL INTERRUPT would then jump into 
                the interrupt
 9E87   0C48            '      vector table and hang.  Bail out (disable the mo
                use) before calling.
 9E87   0C48            '      Test the 4 vector bytes directly -- PEEK()*256 w
                ould overflow INTEGER.
 9E87   0C48            DEF SEG = 0
 9E87   0C48            m33a = PEEK(&HCC): m33b = PEEK(&HCD): m33c = PEEK(&HCE)
                : m33d = PEEK(&HCF)
 9E87   0C48            DEF SEG
