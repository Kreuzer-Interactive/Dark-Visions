                rcle of radius snr (Euclidean)
 92A5   0946    '----- breaks at first oy=0 exactly like action, so it never sn
                aps to an entry action can't reach
 92A5   0946    msnap:
 92AA   0946            IF snr <= 0 THEN RETURN
 92CA   0946            ' tie-break: a hotspot exactly under the cursor's own c
                ell wins over an expanded (snapped) neighbour
 92CA   0946            FOR sni = 1 TO 257
 92D2   0946                    IF oy(sni) = 0# THEN EXIT FOR
 9302   094A                    IF ox(sni) = b AND oy(sni) = a AND ky$(oi(sni))
                 = a$ THEN RETURN
 93B8   094A            NEXT
 93DF   094A            snd = snr * snr + 1
 93DF   094A            snx = -1
 93DF   094A            FOR sni = 1 TO 257
 940A   0952                    IF oy(sni) = 0# THEN EXIT FOR
 943A   0952                    sdx = mx - ox(sni)
 943A   0952                    sdy = my - oy(sni)
 943A   0952                    IF ky$(oi(sni)) = a$ AND ABS(sdx) <= snr AND AB
                S(sdy) <= snr THEN
 943A   0952                            sdd = sdx * sdx + sdy * sdy
 943A   0952                            IF sdd < snd THEN
 943A   0952                                    snd = sdd
 943A   0952                                    snx = ox(sni)
 943A   0952                                    sny = oy(sni)
 943A   0952                            END IF
 9597   0962                    END IF
 9597   0962            NEXT
