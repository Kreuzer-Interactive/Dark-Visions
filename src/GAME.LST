 FA0C   0CC8    '----- write the live game state to slot 1-10 (saver a-j.pac). 
                Lives in GAME.BAS for DIM SHARED access; called from the GAME4 
                save/load screen.
 FA0C   0CC8    SUB SaveGame (slot AS INTEGER)
 FA17   0CC8            DIM slz AS INTEGER
 FA17   0CC8            OPEN "saver" + CHR$(slot + 96) + ".pac" FOR OUTPUT AS #
                1
 FA17   0CC8            WRITE #1, q$, cl, pt, done$, tt$, a$, lf$
 FA17   0CC8            FOR slz = 1 TO 80
 FAA6   0CC8                    WRITE #1, ob(slz)
 FAA6   0CC8            NEXT
 FADC   0CC8            CLOSE #1
 FADC   0CC8    END SUB
 FAEE   0CC8    
 FAEE   0CC8    '----- read game state from slot 1-10 + rebuild inventory acqui
                re-order/new-flags (mirrors the old reload: path)
 FAEE   0CC8    SUB LoadGame (slot AS INTEGER)
 FAF9   0CC8            DIM slz AS INTEGER
 FAF9   0CC8            OPEN "saver" + CHR$(slot + 96) + ".pac" FOR INPUT AS #1
 FAF9   0CC8            INPUT #1, q$, cl, pt, done$, tt$, a$, lf$
 FB36   0CC8            tt$ = "n": done$ = "": IF LEN(lf$) <> 1 OR INSTR("12346
