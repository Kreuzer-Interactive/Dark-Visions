 F0D8   0984    '----- write the live game state to slot 1-10 (saver a-j.pac). 
                Lives in GAME.BAS for DIM SHARED access; called from the GAME4 
                save/load screen.
 F0D8   0984    SUB SaveGame (slot AS INTEGER)
 F0E3   0984            DIM slz AS INTEGER
 F0E3   0984            OPEN "saver" + CHR$(slot + 96) + ".pac" FOR OUTPUT AS #
                1
 F0E3   0984            WRITE #1, q$, cl, pt, done$, tt$, a$, lf$
 F0E3   0984            FOR slz = 1 TO 65
 F172   0984                    WRITE #1, ob(slz)
 F172   0984            NEXT
 F1A8   0984            CLOSE #1
 F1A8   0984    END SUB
