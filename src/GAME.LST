 8E7A   0B54    '----- initialise the mouse driver (INT 33h)
 8E7A   0B54    mouseinit:
 8E7F   0B54            IF msen <> 1 THEN RETURN
 8E9F   0B54            '----- no mouse driver loaded? the INT 33h vector is 00
                00:0000 when none
 8E9F   0B54            '      is present; CALL INTERRUPT would then jump into 
                the interrupt
 8E9F   0B54            '      vector table and hang.  Bail out (disable the mo
                use) before calling.
 8E9F   0B54            '      Test the 4 vector bytes directly -- PEEK()*256 w
                ould overflow INTEGER.
 8E9F   0B54            DEF SEG = 0
 8E9F   0B54            m33a = PEEK(&HCC): m33b = PEEK(&HCD): m33c = PEEK(&HCE)
                : m33d = PEEK(&HCF)
 8E9F   0B54            DEF SEG
 8E9F   0B54            IF m33a = 0 AND m33b = 0 AND m33c = 0 AND m33d = 0 THEN
                 msen = 0: RETURN
 8F94   0B64            '----- ...and bail if the vector points to a bare IRET 
                stub (first byte
 8F94   0B64            '      &HCF).  That is what is there with NO real drive
                r (e.g. after
 8F94   0B64            '      exiting Win98 to MS-DOS mode); calling INT 33h o
                n it hangs.  A real
 8F94   0B64            '      driver's handler starts with executable code (mo
                use.com begins with
 8F94   0B64            '      a JMP, &HEB), never a bare IRET (&HCF) or a 0/de
                ad byte -- so this
 8F94   0B64            '      tells a real driver from a dead leftover vector 
                (seen as &HCF on one
 8F94   0B64            '      PC, 0 on another) without ever calling INT 33h.
 8F94   0B64            m33ls& = m33c + m33d * 256&
 8F94   0B64            m33lo& = m33a + m33b * 256&
                                                                      PAGE  39
                                                                      09 Jul 26
                                                                      15:44:03
