 999D   0B0E    
 999D   0B0E    '----- snap click to nearest hotspot within snr px (0 = off/exa
                ct)
 999D   0B0E    '----- VERB-AWARE: only weighs hotpoints whose object verb = a$
                , so a look-click snaps to
 999D   0B0E    '----- the nearest LOOK point, never a closer get/action point 
                that the action scan can't use
 999D   0B0E    '----- ABS box just prefilters; sdd<snd is the real test = a ci
                rcle of radius snr (Euclidean)
 999D   0B0E    '----- breaks at first oy=0 exactly like action, so it never sn
                aps to an entry action can't reach
 999D   0B0E    msnap:
 99A2   0B0E            IF snr <= 0 THEN RETURN
 99C2   0B0E            ' tie-break: a hotspot exactly under the cursor's own c
                ell wins over an expanded (snapped) neighbour
 99C2   0B0E            FOR sni = 1 TO 257
 99CA   0B0E                    IF oy(sni) = 0# THEN EXIT FOR
 99FA   0B12                    IF ox(sni) = b AND oy(sni) = a AND ky$(oi(sni))
                 = a$ THEN RETURN
 9AB0   0B12            NEXT
 9AD7   0B12            snd = snr * snr + 1
 9AD7   0B12            snx = -1
 9AD7   0B12            FOR sni = 1 TO 257
 9B02   0B1A                    IF oy(sni) = 0# THEN EXIT FOR
 9B32   0B1A                    sdx = mx - ox(sni)
 9B32   0B1A                    sdy = my - oy(sni)
 9B32   0B1A                    IF ky$(oi(sni)) = a$ AND ABS(sdx) <= snr AND AB
                S(sdy) <= snr THEN
 9B32   0B1A                            sdd = sdx * sdx + sdy * sdy
 9B32   0B1A                            IF sdd < snd THEN
 9B32   0B1A                                    snd = sdd
 9B32   0B1A                                    snx = ox(sni)
 9B32   0B1A                                    sny = oy(sni)
 9B32   0B1A                            END IF
 9C8F   0B2A                    END IF
