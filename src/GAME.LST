 F54E   0C96    '----- write the live game state to slot 1-10 (saver a-j.pac). 
                Lives in GAME.BAS for DIM SHARED access; called from the GAME4 
                save/load screen.
 F54E   0C96    SUB SaveGame (slot AS INTEGER)
 F559   0C96            DIM slz AS INTEGER
 F559   0C96            OPEN "saver" + CHR$(slot + 96) + ".pac" FOR OUTPUT AS #
                1
 F559   0C96            WRITE #1, q$, cl, pt, done$, tt$, a$, lf$
 F559   0C96            FOR slz = 1 TO 80
