 FA18   0C10    '----- write the live game state to slot 1-10 (saver a-j.pac). 
                Lives in GAME.BAS for DIM SHARED access; called from the GAME4 
                save/load screen.
 FA18   0C10    SUB SaveGame (slot AS INTEGER)
 FA23   0C10            DIM slz AS INTEGER
 FA23   0C10            OPEN "saver" + CHR$(slot + 96) + ".pac" FOR OUTPUT AS #
                1
 FA23   0C10            WRITE #1, q$, cl, pt, done$, tt$, a$, lf$
 FA23   0C10            FOR slz = 1 TO 65
 FAB2   0C10                    WRITE #1, ob(slz)
 FAB2   0C10            NEXT
 FAE8   0C10            CLOSE #1
 FAE8   0C10    END SUB
 FAFA   0C10    
 FAFA   0C10    '----- read game state from slot 1-10 + rebuild inventory acqui
                re-order/new-flags (mirrors the old reload: path)
 FAFA   0C10    SUB LoadGame (slot AS INTEGER)
 FB05   0C10            DIM slz AS INTEGER
 FB05   0C10            OPEN "saver" + CHR$(slot + 96) + ".pac" FOR INPUT AS #1
 FB05   0C10            INPUT #1, q$, cl, pt, done$, tt$, a$, lf$
 FB42   0C10            tt$ = "n": done$ = "": IF LEN(lf$) <> 1 OR INSTR("12346
                789", lf$) = 0 THEN lf$ = "2"
 FBFB   0C10            FOR slz = 1 TO 65
 FC02   0C10                    INPUT #1, ob(slz)
 FC0B   0C10            NEXT
 FC33   0C10            CLOSE #1
 FC33   0C10            aqc = 0
 FC33   0C10            FOR slz = 1 TO 35
 FC4A   0C10                    IF ob(iord(slz)) = 1 THEN aqc = aqc + 1: aqo(io
                rd(slz)) = aqc ELSE aqo(iord(slz)) = 0
 FCE3   0C10                    nwf(iord(slz)) = 0
 FCE3   0C10            NEXT
