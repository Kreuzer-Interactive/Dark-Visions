Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

                e-level so it
 0030   0006    '----- PERSISTS across walkTo calls -- short diagonal legs (1-3
                 steps) would
 0030   0006    '----- otherwise restart on frame A every walk and frame B woul
                d never show.
 0030   0006    DIM SHARED wfb%
 0030   0006    
 0030   0006    SUB OvTop (px!, py!, ovf%())
 0040   0008            IF ovf%(0) < 1 THEN EXIT SUB
 0056   0008            FOR oi% = 1 TO ovf%(0)
 006E   0008                    om% = 1 + (oi% - 1) * 4
 006E   0008                    ox% = ovf%(om%): oy% = ovf%(om% + 1)
 006E   0008                    os% = ovf%(om% + 2)
 006E   0008                    ow% = ovf%(os%) \ 2: oh% = ovf%(os% + 1)
 006E   0008                    IF ox% < px! + 31 AND ox% + ow% > px! AND oy% <
                 py! + 31 AND oy% + oh% > py! THEN
 006E   0008                            IF ovf%(om% + 3) > 0 THEN
 006E   0008                                    PUT (ox%, oy%), ovf%(ovf%(om% +
                 3)), AND
 006E   0008                                    PUT (ox%, oy%), ovf%(os%), OR
 006E   0008                            ELSE
 01DC   0008                                    PUT (ox%, oy%), ovf%(os%), PSET
 01DC   0008                            END IF
 0201   0008                    END IF
 0201   0008            NEXT
 0210   0008    END SUB
 0218   0008    
 0218   0008    SUB PStand (d$, px!, py!, nopl!, fbg%(), fd%(), mfd%(), fu%(), 
                mfu%(), fr%(), mfr%(), fl%(), mfl%(), fdl%(), mfdl%(), fdr%(), 
                mfdr%(), ful%(), mful%(), fur%(), mfur%(), ovf%())
 0223   0008            PUT (px!, py!), fbg%(0), PSET
 0223   0008            IF nopl! = 1 THEN EXIT SUB
 0266   0008            IF d$ = "4" THEN PUT (px!, py!), mfl%(0), AND: PUT (px!
                , py!), fl%(0), OR
 02CD   0008            IF d$ = "2" THEN PUT (px!, py!), mfd%(0), AND: PUT (px!
                , py!), fd%(0), OR
 0334   0008            IF d$ = "6" THEN PUT (px!, py!), mfr%(0), AND: PUT (px!
                , py!), fr%(0), OR
 039B   0008            IF d$ = "8" THEN PUT (px!, py!), mfu%(0), AND: PUT (px!
                , py!), fu%(0), OR
 0402   0008            IF d$ = "1" THEN PUT (px!, py!), mfdl%(0), AND: PUT (px
                !, py!), fdl%(0), OR
 0469   0008            IF d$ = "7" THEN PUT (px!, py!), mful%(0), AND: PUT (px
                !, py!), ful%(0), OR
 04D0   0008            IF d$ = "9" THEN PUT (px!, py!), mfur%(0), AND: PUT (px
                !, py!), fur%(0), OR
 0537   0008            IF d$ = "3" THEN PUT (px!, py!), mfdr%(0), AND: PUT (px
                !, py!), fdr%(0), OR
 059E   0008            IF d$ <> "" THEN CALL OvTop(px!, py!, ovf%())
 05BD   0008    END SUB
