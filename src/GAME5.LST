 2671   0008    
 2671   0008    '----- WalkFloor: floor-aware walk. Route (px,py)->(tx,ty) thro
                ugh the walk-boxes
 2671   0008    '----- and walk each straight leg. Feet = sprite + (15,30); box
                es are feet coords.
 2671   0008    SUB WalkFloor (tx!, ty!, px!, py!, sfrq!, bxa%(), cwa%(), cmwa%
                (), cwb%(), cmwb%(), wbg%(), ovf%())
 267C   0008            REDIM wpx(31) AS SINGLE, wpy(31) AS SINGLE
 26AC   0008            wpn% = 0
