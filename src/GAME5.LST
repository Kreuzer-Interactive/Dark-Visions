 0FD7   0008    
 0FD7   0008    '----- Walk-box floor (the convex areas the player may walk), a
                uthored per room in
 0FD7   0008    '----- haedit and stored as the sidecar ROOMx.BOX (one quad/lin
                e: x1,y1,..,x4,y4).
 0FD7   0008    '----- bxa(0) = box count; then 8 ints per box (4 corners). A m
                issing/empty file
 0FD7   0008    '----- leaves the count 0 and the caller keeps the old rectangl
                e walk-band.
 0FD7   0008    '----- Coordinates are the player's FEET (bottom-centre). Becau
                se a straight line
 0FD7   0008    '----- can't leave a convex box, snapping the stand target into
                 a box is enough to
 0FD7   0008    '----- keep the walk on the floor within that box (multi-box ro
                uting = phase 2).
 0FD7   0008    SUB LoadBoxes (rm$, bxa%())
 0FE2   0008            bxa%(0) = 0
 0FE2   0008            lbxN% = 0
 0FE2   0008            fh% = FREEFILE
 0FE2   0008            '----- a missing .box file errors on OPEN; the caller (
                loadroom) traps it and
 0FE2   0008            '----- keeps the count at 0. QB propagates an untrapped
                 SUB error to the caller.
 0FE2   0008            OPEN rm$ + ".box" FOR INPUT AS #fh%
 0FE2   0008            DO WHILE NOT EOF(fh%) AND lbxN% < 24
 101C   0008                    o% = 1 + lbxN% * 8
 101C   0008                    INPUT #fh%, bxa%(o%), bxa%(o% + 1), bxa%(o% + 2
                ), bxa%(o% + 3), bxa%(o% + 4), bxa%(o% + 5), bxa%(o% + 6), bxa%
                (o% + 7)
 104E   0008                    lbxN% = lbxN% + 1
 104E   0008            LOOP
 1104   0008            CLOSE #fh%
 1104   0008            bxa%(0) = lbxN%
 1104   0008    END SUB
