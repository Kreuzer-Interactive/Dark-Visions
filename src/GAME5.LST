 196D   0008    '----- segment (ax,ay)-(bx,by) x (cx,cy)-(dx,dy): -1 + point in
                 ix,iy if they cross
 196D   0008    FUNCTION SegInt% (ax!, ay!, bx!, by!, cx!, cy!, dx!, dy!, ix!, 
                iy!)
 1978   0008            SegInt% = 0
 1978   0008            r1! = bx! - ax!: r2! = by! - ay!
 1978   0008            s1! = dx! - cx!: s2! = dy! - cy!
 1978   0008            den! = r1! * s2! - r2! * s1!
 1978   0008            IF den! = 0 THEN EXIT FUNCTION
 19F3   0008            t! = ((cx! - ax!) * s2! - (cy! - ay!) * s1!) / den!
 19F3   0008            u! = ((cx! - ax!) * r2! - (cy! - ay!) * r1!) / den!
 19F3   0008            IF t! >= 0 AND t! <= 1 AND u! >= 0 AND u! <= 1 THEN ix!
                 = ax! + t! * r1!: iy! = ay! + t! * r2!: SegInt% = -1
 1AE0   0008    END FUNCTION
