 2414   0008    '----- walk the player STRAIGHT from (px,py) to (tx,ty) (sprite
                 top-left), one
 2414   0008    '----- 8-way direction for the leg (a straight line stays insid
                e a convex box)
 2414   0008    SUB WalkSeg (tx!, ty!, px!, py!, sfrq!, cwa%(), cmwa%(), cwb%()
                , cmwb%(), wbg%(), ovf%())
 241F   0008            dx! = tx! - px!: dy! = ty! - py!
 241F   0008            mv! = ABS(dx!): IF ABS(dy!) > mv! THEN mv! = ABS(dy!)
 2474   0008            ns% = INT(mv! / 3): IF ns% < 1 THEN ns% = 1
