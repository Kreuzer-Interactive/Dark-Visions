 076F   0008    SUB LoadWalks (cwa%(), cmwa%(), cwb%(), cmwb%())
 077A   0008            '----- fh = file handle (fn* names are illegal in QB --
                 reserved for DEF FN)
 077A   0008            FOR d% = 0 TO 7
 0780   0008                    fh% = FREEFILE
 0780   0008                    OPEN "joew" + CHR$(49 + d%) + ".pct" FOR INPUT 
                AS #fh%
 0780   0008                    FOR i% = 0 TO 125
 07BE   0008                            IF EOF(fh%) THEN EXIT FOR
 07CD   0008                            INPUT #fh%, cwa%(d% * 151 + i%), cwb%(d
                % * 151 + i%)
 07D5   0008                    NEXT
 0819   0008                    CLOSE #fh%
 0819   0008                    fh% = FREEFILE
 0819   0008                    OPEN "joew" + CHR$(49 + d%) + ".msk" FOR INPUT 
                AS #fh%
 0819   0008                    FOR i% = 0 TO 125
 0864   0008                            IF EOF(fh%) THEN EXIT FOR
 0873   0008                            INPUT #fh%, cmwa%(d% * 151 + i%), cmwb%
                (d% * 151 + i%)
 087B   0008                    NEXT
 08BF   0008                    CLOSE #fh%
 08BF   0008            NEXT
 08DA   0008    END SUB
 08E2   0008    
 08E2   0008    '----- PicSeq: full-screen .pic cutscene player (anim mode "seq
                "). BLOADs
 08E2   0008    '-----   sq$+"01".pic .. sq$+NN.pic at rate%*0.025s a frame -- 
                HALF the unit
 08E2   0008    '-----   the other anim modes use (integer rates were too coars
                e to tune a
 08E2   0008    '-----   14-frame cutscene: 0.10s vs 0.15s with nothing between
                ) -- then settles on
 08E2   0008    '-----   sq$+"x.pic" -- the SAME player-less end-state file a b
                g placement
 08E2   0008    '-----   shows on later room loads. Rows 0-21 (the live top mes
                sage) are
 08E2   0008    '-----   lifted before the first frame and re-stamped over ever
                y BLOAD so the
 08E2   0008    '-----   triggering action's message stays readable through the
                 play.
