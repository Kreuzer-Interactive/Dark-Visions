                mfu%(), fr%(), mfr%(), fl%(), mfl%(), fdl%(), mfdl%(), fdr%(), 
                mfdr%(), ful%(), mful%(), fur%(), mfur%())
 0040   0008            PUT (px!, py!), fbg%(0), PSET
 0040   0008            IF nopl! = 1 THEN EXIT SUB
 0083   0008            IF d$ = "4" THEN PUT (px!, py!), mfl%(0), AND: PUT (px!
                , py!), fl%(0), OR
 00EA   0008            IF d$ = "2" THEN PUT (px!, py!), mfd%(0), AND: PUT (px!
                , py!), fd%(0), OR
 0151   0008            IF d$ = "6" THEN PUT (px!, py!), mfr%(0), AND: PUT (px!
                , py!), fr%(0), OR
 01B8   0008            IF d$ = "8" THEN PUT (px!, py!), mfu%(0), AND: PUT (px!
                , py!), fu%(0), OR
 021F   0008            IF d$ = "1" THEN PUT (px!, py!), mfdl%(0), AND: PUT (px
                !, py!), fdl%(0), OR
 0286   0008            IF d$ = "7" THEN PUT (px!, py!), mful%(0), AND: PUT (px
                !, py!), ful%(0), OR
 02ED   0008            IF d$ = "9" THEN PUT (px!, py!), mfur%(0), AND: PUT (px
                !, py!), fur%(0), OR
 0354   0008            IF d$ = "3" THEN PUT (px!, py!), mfdr%(0), AND: PUT (px
                !, py!), fdr%(0), OR
 03BB   0008    END SUB
 03C3   0008    
 03C3   0008    SUB PStep (x!, y!, fb%, sfrq!, sdur!, ofs%, wa%(), mwa%(), wb%(
                ), mwb%(), wbg%())
 03CE   0008            GET (x!, y!)-(x! + 30, y! + 30), wbg%(0)
 03CE   0008            IF fb% = 0 THEN
 03CE   0008                    PUT (x!, y!), mwa%(ofs%), AND: PUT (x!, y!), wa
                %(ofs%), OR
 03CE   0008            ELSE
 048D   0008                    PUT (x!, y!), mwb%(ofs%), AND: PUT (x!, y!), wb
                %(ofs%), OR
 048D   0008            END IF
 04EE   0008            SOUND sfrq!, .1
 0507   0008            FOR j% = 1 TO 2: SOUND 32676, sdur!: NEXT
 052B   0008            PUT (x!, y!), wbg%(0), PSET
 052B   0008    END SUB
 055F   0008    
 055F   0008    SUB LoadWalks (cwa%(), cmwa%(), cwb%(), cmwb%())
 056A   0008            '----- fh = file handle (fn* names are illegal in QB --
                 reserved for DEF FN)
 056A   0008            FOR d% = 0 TO 7
 0570   0008                    fh% = FREEFILE
 0570   0008                    OPEN "joew" + CHR$(49 + d%) + ".pct" FOR INPUT 
                AS #fh%
 0570   0008                    FOR i% = 0 TO 125
 05AE   0008                            IF EOF(fh%) THEN EXIT FOR
 05BD   0008                            INPUT #fh%, cwa%(d% * 151 + i%), cwb%(d
                % * 151 + i%)
 05C5   0008                    NEXT
 0609   0008                    CLOSE #fh%
 0609   0008                    fh% = FREEFILE
 0609   0008                    OPEN "joew" + CHR$(49 + d%) + ".msk" FOR INPUT 
                AS #fh%
 0609   0008                    FOR i% = 0 TO 125
