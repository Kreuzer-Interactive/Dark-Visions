 08E2   0008    
 08E2   0008    '----- PicSeq: full-screen .pic cutscene player (anim mode "seq
                "). BLOADs
 08E2   0008    '-----   sq$+"01".pic .. sq$+NN.pic at rate%*0.025s a frame -- 
                HALF the unit
 08E2   0008    '-----   the other anim modes use (integer rates were too coars
                e to tune a
 08E2   0008    '-----   14-frame cutscene: 0.10s vs 0.15s with nothing between
                ) -- then settles on
 08E2   0008    '-----   sq$+"x.pic" -- the SAME player-less end-state file a b
                g placement
 08E2   0008    '-----   shows on later room loads. Rows 0-21 (the live top mes
                sage) are
 08E2   0008    '-----   lifted before the first frame and re-stamped over ever
                y BLOAD so the
 08E2   0008    '-----   triggering action's message stays readable through the
                 play.
 08E2   0008    '-----   sn2$ non-empty = PLAY string fired at the start ("MB..
                " = background).
 08E2   0008    SUB PicSeq (sq$, fr$, rate%, sn2$)
 08ED   0008            n% = VAL(fr$)
 08ED   0008            IF n% < 1 THEN EXIT SUB
 090A   0008            REDIM tb%(884)
 0922   0008            GET (0, 0)-(319, 21), tb%
 0922   0008            IF sn2$ <> "" THEN PLAY sn2$
 0960   0008            FOR f% = 1 TO n%
 096C   0008                    pf$ = LTRIM$(STR$(f%))
 096C   0008                    IF f% < 10 THEN pf$ = "0" + pf$
 09A2   0008                    DEF SEG = -18432
 09A2   0008                    BLOAD sq$ + pf$ + ".pic", 0
 09A2   0008                    DEF SEG
 09A2   0008                    PUT (0, 0), tb%, PSET
 09A2   0008                    t! = TIMER
 09A2   0008                    DO
 0A00   0008                            IF TIMER < t! THEN EXIT DO
 0A1A   0008                    LOOP WHILE TIMER < t! + rate% * .025
 0A40   0008            NEXT
 0A4F   0008            DEF SEG = -18432
 0A4F   0008            BLOAD sq$ + "x.pic", 0
 0A4F   0008            DEF SEG
 0A4F   0008            PUT (0, 0), tb%, PSET
 0A4F   0008            ERASE tb%
 0A9B   0008    END SUB
 0AB5   0008    
 0AB5   0008    SUB walkTo (tx!, ty!, px!, py!, sfrq!, cwa%(), cmwa%(), cwb%(),
                 cmwb%(), wbg%(), ovf%())
 0AC0   0008            '----- stride phase wfb% carries over from the previous
                 walk (no reset)
 0AC0   0008            '----- diagonal leg: full (3,2) steps while both axes s
                till need one
 0AC0   0008            WHILE ABS(tx! - px!) >= 3 AND ABS(ty! - py!) >= 2
 0AC0   0008                    IF ty! > py! THEN
                                                                      PAGE   5
                                                                      22 Sep 26
                                                                      13:59:26
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 0AC0   0008                            IF tx! > px! THEN d% = 5 ELSE d% = 4
 0B44   0008                            sd! = 1.1
 0B44   0008                    ELSE
 0B52   0008                            IF tx! > px! THEN d% = 7 ELSE d% = 6
 0B77   0008                            sd! = 1.2
 0B77   0008                    END IF
 0B82   0008                    px! = px! + SGN(tx! - px!) * 3
 0B82   0008                    py! = py! + SGN(ty! - py!) * 2
 0B82   0008                    CALL PStep(px!, py!, wfb%, sfrq!, sd!, d% * 151
                , cwa%(), cmwa%(), cwb%(), cmwb%(), wbg%(), ovf%())
 0BF7   0008                    wfb% = 1 - wfb%
 0BF7   0008            WEND
 0C04   0008            WHILE px! <> tx!
 0C04   0008                    '----- 4px stride at down-walk cadence = same s
                peed, step sound in rhythm
 0C04   0008                    IF tx! > px! THEN d% = 2 ELSE d% = 3
 0C3B   0008                    IF ABS(tx! - px!) <= 3 THEN px! = tx! ELSE px! 
                = px! + SGN(tx! - px!) * 4
 0C86   0008                    CALL PStep(px!, py!, wfb%, sfrq!, 1.12, d% * 15
                1, cwa%(), cmwa%(), cwb%(), cmwb%(), wbg%(), ovf%())
 0CC6   0008                    wfb% = 1 - wfb%
 0CC6   0008            WEND
 0CD4   0008            WHILE py! <> ty!
 0CD4   0008                    IF ty! > py! THEN d% = 0: sd! = 1.2 ELSE d% = 1
                : sd! = 1.4
 0D21   0008                    IF ABS(ty! - py!) <= 2 THEN py! = ty! ELSE py! 
                = py! + SGN(ty! - py!) * 2
 0D6C   0008                    CALL PStep(px!, py!, wfb%, sfrq!, sd!, d% * 151
                , cwa%(), cmwa%(), cwb%(), cmwb%(), wbg%(), ovf%())
 0DA1   0008                    wfb% = 1 - wfb%
 0DA1   0008            WEND
 0DAE   0008    END SUB
 0DB6   0008    
 0DB6   0008    '----- ClimbSeq: rope-climb cutscene (room12). Loads CLIMB.PCT/
                .MSK (2
 0DB6   0008    '----- interleaved 31x31 frames, golf-style 2-column text) into
                 the caller's
 0DB6   0008    '----- scratch arrays, then PStep-walks the sprite vertically a
                t x: up=0
 0DB6   0008    '----- descends y0->y1, up=1 ascends y1->y0. 2px half-steps, fr
                ames alternate,
 0DB6   0008    '----- and each step restores its save-under so the rope stays 
                clean behind.
 0DB6   0008    SUB ClimbSeq (up%, x!, y0!, y1!, sfrq!, wa%(), mwa%(), wb%(), m
                wb%(), wbg%(), ovf%())
 0DC1   0008            fh% = FREEFILE
 0DC1   0008            OPEN "climb.pct" FOR INPUT AS #fh%
 0DC1   0008            FOR i% = 0 TO 149
 0DE2   0008                    IF EOF(fh%) THEN EXIT FOR
 0DF1   0008                    INPUT #fh%, wa%(i%), wb%(i%)
 0DF9   0008            NEXT
 0E37   0008            CLOSE #fh%
 0E37   0008            fh% = FREEFILE
 0E37   0008            OPEN "climb.msk" FOR INPUT AS #fh%
