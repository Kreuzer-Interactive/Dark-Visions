 1129   0008    
 1129   0008    '----- point (fx,fy) inside convex box bi% -- all four edge cro
                ss products share a
 1129   0008    '----- sign (a point on an edge = 0 counts as inside). Reads th
                e box's own winding
 1129   0008    '----- so clockwise or counter-clockwise both work.
 1129   0008    FUNCTION PtInBox% (fx!, fy!, bxa%(), bi%)
 1134   0008            o% = 1 + bi% * 8
 1134   0008            cvP% = 0: cvN% = 0
 1134   0008            FOR e% = 0 TO 3
 1152   0008                    ax% = bxa%(o% + e% * 2): ay% = bxa%(o% + e% * 2
                 + 1)
 1152   0008                    g% = (e% + 1) MOD 4
 1152   0008                    cx% = bxa%(o% + g% * 2): cy% = bxa%(o% + g% * 2
                 + 1)
 1152   0008                    cr& = CLNG(cx% - ax%) * (fy! - ay%) - CLNG(cy% 
                - ay%) * (fx! - ax%)
 1152   0008                    IF cr& > 0 THEN cvP% = 1
 1220   0008                    IF cr& < 0 THEN cvN% = 1
 123A   0008            NEXT
 1249   0008            PtInBox% = (cvP% = 0 OR cvN% = 0)
 1249   0008    END FUNCTION
 126D   0008    
 126D   0008    '----- snap a stand target (sprite top-left sx,sy) so the FEET 
                (sx+15,sy+30) land
 126D   0008    '----- on the floor: if already inside a box, no-op; else move 
                to the nearest point
 126D   0008    '----- on any box edge. Convex boxes -> the straight walkTo the
                n stays on the floor.
 126D   0008    SUB SnapFloor (sx!, sy!, bxa%())
 1278   0008            IF bxa%(0) < 1 THEN EXIT SUB
 128E   0008            fx! = sx! + 15: fy! = sy! + 30
 128E   0008            IF BoxAt%(fx!, fy!, bxa%()) >= 0 THEN EXIT SUB
 12CC   0008            b% = NearBox%(fx!, fy!, bxa%())
 12CC   0008            IF b% < 0 THEN EXIT SUB
 12EC   0008            CALL NearInBox(fx!, fy!, bxa%(), b%, nx!, ny!)
 1308   0008            sx! = nx! - 15: sy! = ny! - 30
 1308   0008    END SUB
 1332   0008    
 1332   0008    '----- nearest point to (fx,fy) within/on convex box bi% (the p
                oint itself if inside)
 1332   0008    SUB NearInBox (fx!, fy!, bxa%(), bi%, nx!, ny!)
 133D   0008            IF PtInBox%(fx!, fy!, bxa%(), bi%) THEN nx! = fx!: ny! 
                = fy!: EXIT SUB
 137A   0008            o% = 1 + bi% * 8
 137A   0008            bestd! = 1E30
 137A   0008            nx! = fx!: ny! = fy!
 137A   0008            FOR e% = 0 TO 3
 13B6   0008                    ax! = bxa%(o% + e% * 2): ay! = bxa%(o% + e% * 2
                 + 1)
 13B6   0008                    g% = (e% + 1) MOD 4
 13B6   0008                    cx! = bxa%(o% + g% * 2): cy! = bxa%(o% + g% * 2
                 + 1)
 13B6   0008                    dx! = cx! - ax!: dy! = cy! - ay!
                                                                      PAGE   8
                                                                      22 Sep 26
                                                                      13:59:26
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 13B6   0008                    slen! = dx! * dx! + dy! * dy!
 13B6   0008                    IF slen! <= 0 THEN
 13B6   0008                            px! = ax!: py! = ay!
 13B6   0008                    ELSE
 149D   0008                            t! = ((fx! - ax!) * dx! + (fy! - ay!) *
                 dy!) / slen!
 149D   0008                            IF t! < 0 THEN t! = 0
 14E6   0008                            IF t! > 1 THEN t! = 1
 1506   0008                            px! = ax! + t! * dx!: py! = ay! + t! * 
                dy!
 1506   0008                    END IF
 152A   0008                    dd! = (px! - fx!) * (px! - fx!) + (py! - fy!) *
                 (py! - fy!)
 152A   0008                    IF dd! < bestd! THEN bestd! = dd!: nx! = px!: n
                y! = py!
 1591   0008            NEXT
 15A0   0008    END SUB
