 08E2   0008    '-----   sn2$ non-empty = PLAY string fired at the start ("MB..
                " = background).
 08E2   0008    SUB PicSeq (sq$, fr$, rate%, sn2$)
 08ED   0008            n% = VAL(fr$)
 08ED   0008            IF n% < 1 THEN EXIT SUB
 090A   0008            REDIM tb%(884)
 0922   0008            GET (0, 0)-(319, 21), tb%
 0922   0008            IF sn2$ <> "" THEN PLAY sn2$
 0960   0008            FOR f% = 1 TO n%
 096C   0008                    pf$ = LTRIM$(STR$(f%))
 096C   0008                    IF f% < 10 THEN pf$ = "0" + pf$
 09A2   0008                    DEF SEG = -18432
 09A2   0008                    BLOAD sq$ + pf$ + ".pic", 0
 09A2   0008                    DEF SEG
 09A2   0008                    PUT (0, 0), tb%, PSET
 09A2   0008                    t! = TIMER
 09A2   0008                    DO
 0A00   0008                            IF TIMER < t! THEN EXIT DO
 0A1A   0008                    LOOP WHILE TIMER < t! + rate% * .025
 0A40   0008            NEXT
 0A4F   0008            DEF SEG = -18432
 0A4F   0008            BLOAD sq$ + "x.pic", 0
 0A4F   0008            DEF SEG
 0A4F   0008            PUT (0, 0), tb%, PSET
 0A4F   0008            ERASE tb%
 0A9B   0008    END SUB
 0AB5   0008    
 0AB5   0008    SUB walkTo (tx!, ty!, px!, py!, sfrq!, cwa%(), cmwa%(), cwb%(),
                 cmwb%(), wbg%(), ovf%())
 0AC0   0008            '----- stride phase wfb% carries over from the previous
                 walk (no reset)
 0AC0   0008            '----- diagonal leg: full (3,2) steps while both axes s
                till need one
 0AC0   0008            WHILE ABS(tx! - px!) >= 3 AND ABS(ty! - py!) >= 2
 0AC0   0008                    IF ty! > py! THEN
 0AC0   0008                            IF tx! > px! THEN d% = 5 ELSE d% = 4
 0B44   0008                            sd! = 1.1
 0B44   0008                    ELSE
 0B52   0008                            IF tx! > px! THEN d% = 7 ELSE d% = 6
 0B77   0008                            sd! = 1.2
 0B77   0008                    END IF
 0B82   0008                    px! = px! + SGN(tx! - px!) * 3
 0B82   0008                    py! = py! + SGN(ty! - py!) * 2
 0B82   0008                    CALL PStep(px!, py!, wfb%, sfrq!, sd!, d% * 151
                , cwa%(), cmwa%(), cwb%(), cmwb%(), wbg%(), ovf%())
 0BF7   0008                    wfb% = 1 - wfb%
 0BF7   0008            WEND
 0C04   0008            WHILE px! <> tx!
 0C04   0008                    '----- 4px stride at down-walk cadence = same s
                peed, step sound in rhythm
 0C04   0008                    IF tx! > px! THEN d% = 2 ELSE d% = 3
 0C3B   0008                    IF ABS(tx! - px!) <= 3 THEN px! = tx! ELSE px! 
                = px! + SGN(tx! - px!) * 4
 0C86   0008                    CALL PStep(px!, py!, wfb%, sfrq!, 1.12, d% * 15
