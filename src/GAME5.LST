 0654   0008                            IF EOF(fh%) THEN EXIT FOR
 0663   0008                            INPUT #fh%, cmwa%(d% * 151 + i%), cmwb%
                (d% * 151 + i%)
 066B   0008                    NEXT
 06AF   0008                    CLOSE #fh%
 06AF   0008            NEXT
