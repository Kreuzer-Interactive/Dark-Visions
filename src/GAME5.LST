 15A8   0008    '----- index of the box nearest (fx,fy) by its closest interior
                /edge point
 15A8   0008    FUNCTION NearBox% (fx!, fy!, bxa%())
 15B3   0008            NearBox% = -1
 15B3   0008            bestd! = 1E30
 15B3   0008            FOR b% = 0 TO bxa%(0) - 1
 15DA   0008                    CALL NearInBox(fx!, fy!, bxa%(), b%, nx!, ny!)
 15F4   0008                    dd! = (nx! - fx!) * (nx! - fx!) + (ny! - fy!) *
                 (ny! - fy!)
 15F4   0008                    IF dd! < bestd! THEN bestd! = dd!: NearBox% = b
                %
 1649   0008            NEXT
 1655   0008    END FUNCTION
 1660   0008    
 1660   0008    '----- index of the box containing (fx,fy), or -1
 1660   0008    FUNCTION BoxAt% (fx!, fy!, bxa%())
 166B   0008            BoxAt% = -1
 166B   0008            FOR b% = 0 TO bxa%(0) - 1
 1688   0008                    IF PtInBox%(fx!, fy!, bxa%(), b%) THEN BoxAt% =
                 b%: EXIT FUNCTION
 16B0   0008            NEXT
 16BC   0008    END FUNCTION
 16C7   0008    
 16C7   0008    '----- do convex boxes i,j overlap or touch? (SAT: separated if
                 any edge-normal
