 076F   0008    SUB LoadWalks (cwa%(), cmwa%(), cwb%(), cmwb%())
 077A   0008            '----- fh = file handle (fn* names are illegal in QB --
                 reserved for DEF FN)
 077A   0008            FOR d% = 0 TO 7
 0780   0008                    fh% = FREEFILE
 0780   0008                    OPEN "joew" + CHR$(49 + d%) + ".pct" FOR INPUT 
                AS #fh%
 0780   0008                    FOR i% = 0 TO 125
 07BE   0008                            IF EOF(fh%) THEN EXIT FOR
 07CD   0008                            INPUT #fh%, cwa%(d% * 151 + i%), cwb%(d
                % * 151 + i%)
 07D5   0008                    NEXT
 0819   0008                    CLOSE #fh%
 0819   0008                    fh% = FREEFILE
 0819   0008                    OPEN "joew" + CHR$(49 + d%) + ".msk" FOR INPUT 
                AS #fh%
 0819   0008                    FOR i% = 0 TO 125
 0864   0008                            IF EOF(fh%) THEN EXIT FOR
 0873   0008                            INPUT #fh%, cmwa%(d% * 151 + i%), cmwb%
                (d% * 151 + i%)
 087B   0008                    NEXT
 08BF   0008                    CLOSE #fh%
