 05D0   0008            IF fb% = 0 THEN
 05D0   0008                    PUT (x!, y!), mwa%(ofs%), AND: PUT (x!, y!), wa
                %(ofs%), OR
 05D0   0008            ELSE
 068F   0008                    PUT (x!, y!), mwb%(ofs%), AND: PUT (x!, y!), wb
                %(ofs%), OR
 068F   0008            END IF
 06F0   0008            CALL OvTop(x!, y!, ovf%())
 06FE   0008            SOUND sfrq!, .1
 0717   0008            FOR j% = 1 TO 2: SOUND 32676, sdur!: NEXT
 073B   0008            PUT (x!, y!), wbg%(0), PSET
