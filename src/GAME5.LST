                 sxg! + pcx!: syg! = syg! + pcy!: cg% = cg% + 1
 1BB0   0008            NEXT
 1BBF   0008            FOR e% = 0 TO 3
 1BC4   0008                    pcx! = bxa%(oj% + e% * 2): pcy! = bxa%(oj% + e%
                 * 2 + 1)
