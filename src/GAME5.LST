 0654   0008                            IF EOF(fh%) THEN EXIT FOR
 0663   0008                            INPUT #fh%, cmwa%(d% * 151 + i%), cmwb%
                (d% * 151 + i%)
 066B   0008                    NEXT
 06AF   0008                    CLOSE #fh%
 06AF   0008            NEXT
 06CA   0008    END SUB
 06D2   0008    
 06D2   0008    SUB walkTo (tx!, ty!, px!, py!, sfrq!, cwa%(), cmwa%(), cwb%(),
                 cmwb%(), wbg%())
 06DD   0008            '----- stride phase wfb% carries over from the previous
                 walk (no reset)
 06DD   0008            '----- diagonal leg: full (3,2) steps while both axes s
                till need one
 06DD   0008            WHILE ABS(tx! - px!) >= 3 AND ABS(ty! - py!) >= 2
 06DE   0008                    IF ty! > py! THEN
 06DE   0008                            IF tx! > px! THEN d% = 5 ELSE d% = 4
 0762   0008                            sd! = 1.1
 0762   0008                    ELSE
 0770   0008                            IF tx! > px! THEN d% = 7 ELSE d% = 6
 0795   0008                            sd! = 1.2
 0795   0008                    END IF
 07A0   0008                    px! = px! + SGN(tx! - px!) * 3
 07A0   0008                    py! = py! + SGN(ty! - py!) * 2
 07A0   0008                    CALL PStep(px!, py!, wfb%, sfrq!, sd!, d% * 151
                , cwa%(), cmwa%(), cwb%(), cmwb%(), wbg%())
 0812   0008                    wfb% = 1 - wfb%
 0812   0008            WEND
 0820   0008            WHILE px! <> tx!
 0820   0008                    '----- 4px stride at down-walk cadence = same s
                peed, step sound in rhythm
 0820   0008                    IF tx! > px! THEN d% = 2 ELSE d% = 3
 0857   0008                    IF ABS(tx! - px!) <= 3 THEN px! = tx! ELSE px! 
                = px! + SGN(tx! - px!) * 4
 08A2   0008                    CALL PStep(px!, py!, wfb%, sfrq!, 1.12, d% * 15
                1, cwa%(), cmwa%(), cwb%(), cmwb%(), wbg%())
 08DF   0008                    wfb% = 1 - wfb%
 08DF   0008            WEND
 08EC   0008            WHILE py! <> ty!
 08EC   0008                    IF ty! > py! THEN d% = 0: sd! = 1.2 ELSE d% = 1
                : sd! = 1.4
 0939   0008                    IF ABS(ty! - py!) <= 2 THEN py! = ty! ELSE py! 
                = py! + SGN(ty! - py!) * 2
 0984   0008                    CALL PStep(px!, py!, wfb%, sfrq!, sd!, d% * 151
                , cwa%(), cmwa%(), cwb%(), cmwb%(), wbg%())
 09B6   0008                    wfb% = 1 - wfb%
 09B6   0008            WEND
 09C4   0008    END SUB
