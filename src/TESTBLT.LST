 03C0   0406    CALL ABSOLUTE(BYVAL bs, BYVAL bo, BYVAL 12, BYVAL 100, BYVAL rw
                , BYVAL rb, BYVAL rb, BYVAL 0, SADD(blt$))
 03FC   0408    GET (48, 100)-(71, 115), got
 03FC   0408    
 03FC   0408    bad = 0
 03FC   0408    FOR i = 2 TO 49
 0434   040A            IF ref(i) <> got(i) THEN bad = bad + 1
 0449   040A    NEXT
 0455   040A    
 0455   040A    ' ---- odd row-bytes path: 20px = 5 bytes/row, copy mode + blit
 0455   040A    FOR y = 0 TO 7: FOR x = 0 TO 19: PSET (x, y), (x * y + x) MOD 4
                : NEXT: NEXT
 0499   040A    GET (0, 0)-(19, 7), odds
 0499   040A    CLS
 0499   040A    PUT (100, 50), odds, PSET
 0499   040A    GET (100, 50)-(119, 57), oddr
 0499   040A    DEF SEG = VARSEG(bop$)
 0499   040A    CALL ABSOLUTE(BYVAL VARSEG(odds(2)), BYVAL VARPTR(odds(2)), BYV
                AL VARSEG(oddb(2)), BYVAL VARPTR(oddb(2)), BYVAL 8, BYVAL 5, BY
                VAL 5, BYVAL 5, BYVAL 0, SADD(bop$))
 054E   040C    DEF SEG = VARSEG(blt$)
 054E   040C    CALL ABSOLUTE(BYVAL VARSEG(oddb(2)), BYVAL VARPTR(oddb(2)), BYV
                AL 25, BYVAL 100, BYVAL 8, BYVAL 5, BYVAL 5, BYVAL 1, SADD(blt$
                ))
 0587   040E    GET (100, 100)-(119, 107), oddg
 0587   040E    obad = 0
 0587   040E    FOR i = 2 TO 21
 05BC   0410            IF oddr(i) <> oddg(i) THEN obad = obad + 1
 05D1   0410    NEXT
 05DD   0410    
 05DD   0410    ' ---- benchmark: 300 iterations of a 4-op composite, QB vs asm
 05DD   0410    n! = 3000
 05DD   0410    t1! = TIMER
 05DD   0410    FOR i! = 1 TO n!
 060E   0414            PUT (48, 50), src1, PSET
 060E   0414            PUT (48, 50), src2, AND
 060E   0414            PUT (48, 50), src3, OR
 060E   0414            PUT (48, 50), src2, AND
 060E   0414    NEXT
 06BC   0414    t1! = TIMER - t1!
 06BC   0414    t2! = TIMER
 06BC   0414    DEF SEG = VARSEG(bop$)
 06BC   0414    FOR i! = 1 TO n!
 0700   0418            CALL ABSOLUTE(BYVAL VARSEG(src1(2)), BYVAL VARPTR(src1(
                2)), BYVAL bs, BYVAL bo, BYVAL rw, BYVAL rb, BYVAL rb, BYVAL rb
                , BYVAL 0, SADD(bop$))
 0737   041A            CALL ABSOLUTE(BYVAL VARSEG(src2(2)), BYVAL VARPTR(src2(
                2)), BYVAL bs, BYVAL bo, BYVAL rw, BYVAL rb, BYVAL rb, BYVAL rb
                , BYVAL 1, SADD(bop$))
 076F   041C            CALL ABSOLUTE(BYVAL VARSEG(src3(2)), BYVAL VARPTR(src3(
                2)), BYVAL bs, BYVAL bo, BYVAL rw, BYVAL rb, BYVAL rb, BYVAL rb
                , BYVAL 2, SADD(bop$))
 07A7   041E            DEF SEG = VARSEG(blt$)
 07A7   041E            CALL ABSOLUTE(BYVAL bs, BYVAL bo, BYVAL 12, BYVAL 100, 
