 07E3   0420            DEF SEG = VARSEG(bop$)
 07E3   0420    NEXT
 0812   0420    t2! = TIMER - t2!
 0812   0420    
 0812   0420    OPEN "RESULTS.TXT" FOR OUTPUT AS #1
 0812   0420    PRINT #1, "composite mismatch ints:"; bad; "of 48"
