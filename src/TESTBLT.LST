 0030   0006    ' TESTBLT.BAS -- standalone proof for SHADBOP/SHADBLT (CALL ABS
                OLUTE blitters)
 0030   0006    ' Composites the same frame via QB PUTs and via the asm path, c
                ompares the
 0030   0006    ' results pixel-for-pixel, exercises odd-width rows, and benchm
                arks both.
 0030   0006    ' Writes RESULTS.TXT and exits (run headless from the build DOS
                Box).
 0030   0006    DEFINT A-Z
 0030   0006    DIM src1(60), src2(60), src3(60), buf(60), ref(60), got(60)
 0030   0006    DIM odds(30), oddb(30), oddr(30), oddg(30)
 0030   0006    DIM t1!, t2!, i!, n!
 0030   0006    
 0030   0006    OPEN "SHADBOP.OVL" FOR BINARY AS #1
 0035   03EA    bop$ = SPACE$(LOF(1)): GET #1, 1, bop$: CLOSE #1
 0035   03EA    OPEN "SHADBLT.OVL" FOR BINARY AS #1
 0035   03EA    blt$ = SPACE$(LOF(1)): GET #1, 1, blt$: CLOSE #1
 0035   03EA    
 0035   03EA    SCREEN 1: CLS
 0035   03EA    ' three 24x16 GET blocks: pattern / AND mask with a hole / spar
                se OR dots
 0035   03EA    FOR y = 0 TO 15: FOR x = 0 TO 23: PSET (x, y), (x + y) MOD 4: N
                EXT: NEXT
 012F   03F6    GET (0, 0)-(23, 15), src1
 012F   03F6    LINE (0, 0)-(23, 15), 3, BF
 012F   03F6    LINE (6, 4)-(17, 11), 0, BF
 012F   03F6    GET (0, 0)-(23, 15), src2
 012F   03F6    LINE (0, 0)-(23, 15), 0, BF
 012F   03F6    FOR i = 0 TO 40: PSET ((i * 7) MOD 24, (i * 5) MOD 16), 2: NEXT
 022E   03F8    GET (0, 0)-(23, 15), src3
 022E   03F8    CLS
 022E   03F8    
 022E   03F8    ' ---- reference: QB PUT composite at (48,50)
 022E   03F8    PUT (48, 50), src1, PSET
 022E   03F8    PUT (48, 50), src2, AND
 022E   03F8    PUT (48, 50), src3, OR
 022E   03F8    GET (48, 50)-(71, 65), ref
 022E   03F8    
 022E   03F8    ' ---- asm path: compose in buf() then blit to (48,100). 24px =
                 6 bytes/row.
 022E   03F8    rb = 6: rw = 16
 022E   03F8    bs = VARSEG(buf(2)): bo = VARPTR(buf(2))
 022E   03F8    buf(0) = 48: buf(1) = 16
 022E   03F8    DEF SEG = VARSEG(bop$)
 022E   03F8    CALL ABSOLUTE(BYVAL VARSEG(src1(2)), BYVAL VARPTR(src1(2)), BYV
                AL bs, BYVAL bo, BYVAL rw, BYVAL rb, BYVAL rb, BYVAL rb, BYVAL 
                0, SADD(bop$))
 0350   0402    CALL ABSOLUTE(BYVAL VARSEG(src2(2)), BYVAL VARPTR(src2(2)), BYV
                AL bs, BYVAL bo, BYVAL rw, BYVAL rb, BYVAL rb, BYVAL rb, BYVAL 
                1, SADD(bop$))
 0388   0404    CALL ABSOLUTE(BYVAL VARSEG(src3(2)), BYVAL VARPTR(src3(2)), BYV
                AL bs, BYVAL bo, BYVAL rw, BYVAL rb, BYVAL rb, BYVAL rb, BYVAL 
                2, SADD(bop$))
 03C0   0406    DEF SEG = VARSEG(blt$)
                                                                      PAGE   2
