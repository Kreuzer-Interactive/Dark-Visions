 20C4   0384    
 20C4   0384    '----- parse a move-anim script into 1px step arrays (max 60 st
                eps).
 20C4   0384    '----- Tokens split on ";": letters u/d/l/r combine into a dire
                ction (ul = up-left),
 20C4   0384    '----- a trailing number repeats it ("ul5"); "p" (no direction 
                letters) = a pause
 20C4   0384    '----- step in place ("p6" holds 6 steps). Example: "u;d;u;d;u;
                d;p6;ul5;dr2"
 20C4   0384    SUB MovParse (s$, mdx%(), mdy%(), mn%, bx1%, by1%, bx2%, by2%)
 20CF   0384            mn% = 0
 20CF   0384            t$ = LCASE$(s$) + ";"
 20CF   0384            sp% = 1
 20CF   0384            FOR i% = 1 TO LEN(t$)
 210A   0384                    IF MID$(t$, i%, 1) = ";" THEN
 210A   0384                            w$ = MID$(t$, sp%, i% - sp%)
 210A   0384                            sp% = i% + 1
 210A   0384                            IF w$ <> "" THEN
 210A   0384                                    dx% = 0: dy% = 0: rp% = 0
 210A   0384                                    FOR j% = 1 TO LEN(w$)
 2180   0384                                            c$ = MID$(w$, j%, 1)
 2180   0384                                            IF c$ = "u" THEN dy% = 
                dy% - 1
 21AF   0384                                            IF c$ = "d" THEN dy% = 
                dy% + 1
 21C4   0384                                            IF c$ = "l" THEN dx% = 
                dx% - 1
 21D9   0384                                            IF c$ = "r" THEN dx% = 
                dx% + 1
 21EE   0384                                            IF c$ >= "0" AND c$ <= 
                "9" THEN rp% = rp% * 10 + VAL(c$)
 2244   0384                                    NEXT
 2253   0384                                    IF rp% < 1 THEN rp% = 1
 2261   0384                                    FOR j% = 1 TO rp%
 226E   0384                                            IF mn% < 60 THEN mn% = 
                mn% + 1: mdx%(mn%) = dx%: mdy%(mn%) = dy%
 22A1   0384                                    NEXT
 22AD   0384                            END IF
 22AD   0384                    END IF
 22AD   0384            NEXT
