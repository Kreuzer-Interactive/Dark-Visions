 44F9   0418    '----- ShadTick: idle-loop driver. Recomputes the lookahead eve
                ry pass (cheap
 44F9   0418    '----- KillChk table scan -- and polling self-heals across load
                /death), applies
 44F9   0418    '----- pending light toggles, and paces the shadow: 1px steps w
                ith a 1px bob,
 44F9   0418    '----- direction flip + pause at the light's edges (the right e
                dge lets it slip
 44F9   0418    '----- mostly past the pool before turning). Holds like animtic
                k while the
 44F9   0418    '----- player box or the cursor overlaps the rect so no save-un
                der goes stale.
 44F9   0418    '----- Lookahead: leaving NOW costs +8 (the exit click) +30 (th
                e transition)
 44F9   0418    '----- ticks, so the arrival step is INT((cl + 38) / 60) -- hot
                 when KillChk
 44F9   0418    '----- says a killer owns the room behind the door at that step
                .
 44F9   0418    SUB ShadTick (q2$, clv!, h9b!, t1b!, t2b!, t3b!, ob43%, pjxv!, 
                pjyv!, bv!, av!)
 4504   0418            DIM w2 AS SINGLE, kw2 AS INTEGER
 4504   0418            IF sdwOn = 0 OR sdwHave = 0 THEN EXIT SUB
 4523   0418            IF q2$ <> "room2" THEN EXIT SUB
 4534   0418            sdwWant = 0
 4534   0418            IF klon <> 0 THEN
 4534   0418                    '----- the lit-curtain endgame owns room4: neve
                r spoil that encounter
 4534   0418                    IF sdwDst$ <> "room4" OR ob43% <> 1 THEN
 4534   0418                            w2 = INT((clv! + 38) / 60)
 4534   0418                            CALL KillChk(sdwDst$, w2, h9b!, t1b!, t
                2b!, t3b!, f3, kw2)
 45B6   0418                            IF kw2 <> 0 THEN sdwWant = 1
 45C5   0418                    END IF
 45C5   0418            END IF
 45C5   0418            IF pjxv! < sdwTX + sdwTW AND pjxv! + 31 > sdwTX AND pjy
                v! < sdwTY + sdwTH AND pjyv! + 31 > sdwTY THEN EXIT SUB
 4653   0418            IF sdwTX < bv! + 12 AND sdwTX + sdwTW > bv! - 6 AND sdw
                TY < av! + 12 AND sdwTY + sdwTH > av! - 6 THEN EXIT SUB
 46EE   0418            IF sdwWant <> sdwArm THEN
 46EE   0418                    IF sdwWant = 1 THEN
 46EE   0418                            PUT (sdwTX, sdwTY), sdwDat(sdwOLt), PSE
                T
 46EE   0418                            sdwX = sdwTX: sdwDir = 1: sdwBob = 0
 46EE   0418                            sdwMode = 0: sdwY = sdwTY + sdwTH - sdw
                SH - 1
 46EE   0418                            sdwNxt = TIMER + .5
 46EE   0418                    ELSE
 476D   0418                            PUT (sdwTX, sdwTY), sdwDat(sdwOId), PSE
                T
 476D   0418                    END IF
 4796   0418                    sdwArm = sdwWant
