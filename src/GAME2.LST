 0FFC   0366    
 0FFC   0366    '----- apply combine recipe r%: swap the ingredient ob() flags 
                for the result, and
 0FFC   0366    '----- re-derive 33 (ready to mix) since 36 may just have appea
                red
 0FFC   0366    SUB CombDo2 (r%, ob(), cn%)
 1007   0366            '----- ingredients become state 2 ("used up"): out of t
                he inventory but
 1007   0366            '----- still counting as taken, so their pickup spots n
                ever re-arm
 1007   0366            cn% = 0
 1007   0366            IF r% = 1 THEN ob(18) = 2: ob(28) = 2: ob(22) = 1: cn% 
                = 22
 105F   0366            IF r% = 2 THEN ob(24) = 2: ob(11) = 2: ob(52) = 1: cn% 
                = 52
 10B0   0366            IF r% = 3 THEN ob(29) = 2: ob(34) = 2: ob(35) = 1: cn% 
                = 35
 1101   0366            IF r% = 4 THEN ob(52) = 2: ob(36) = 1: cn% = 36
 113E   0366            IF ob(32) = 1 AND ob(36) = 1 THEN ob(33) = 1
 119E   0366    END SUB
 11A6   0366    
 11A6   0366    '----- keyboard/joystick navigation for the inventory screen. Z
                ones: 0 = item grid,
 11A6   0366    '----- 1 = tabs (left pane), 2 = bottom buttons. k$ = U/D/L/R m
                ove, E = activate.
 11A6   0366    '----- Grid: left off column 0 -> tabs (active tab first); movi
                ng toward the inactive
 11A6   0366    '----- tab ACTIVATES it; down off the grid (or from the tabs) -
                > the buttons.
 11A6   0366    '----- Returns the cursor park spot for the focus in mx2%/my2% 
                and act%:
 11A6   0366    '----- 1 selection changed | 2 tab switched | 3 focus moved | 4
                 quit | 5 save/load |
 11A6   0366    '----- 6 exit | 7 combine (grid E on combine tab) | 8 examine (
                grid E on info tab)
 11A6   0366    SUB InvNav (k$, nvz, nvb, isel, cic, invtab, ivscr, ivmax, mx2%
                , my2%, act%)
 11B1   0366            act% = 3
 11B1   0366            IF nvz = 0 THEN
 11B1   0366                    IF k$ = "L" THEN
 11B1   0366                            IF cic = 0 OR (INT(isel) MOD 4) = 0 THE
                N nvz = 1 ELSE isel = isel - 1: act% = 1
 125A   0366                    ELSEIF k$ = "R" THEN
 125D   0366                            IF (INT(isel) MOD 4) < 3 AND isel + 1 <
                 cic THEN isel = isel + 1: act% = 1
 12DA   0366                    ELSEIF k$ = "U" THEN
 12DD   0366                            IF isel - 4 >= 0 THEN isel = isel - 4: 
                act% = 1 ELSE nvz = 1
 132E   0366                    ELSEIF k$ = "D" THEN
 1331   0366                            IF isel + 4 < cic THEN isel = isel + 4:
                 act% = 1 ELSE nvz = 2
