 20C4   0CC2    
 20C4   0CC2    '----- parse a move-anim script into 1px step arrays (max 60 st
                eps).
 20C4   0CC2    '----- Tokens split on ";": letters u/d/l/r combine into a dire
                ction (ul = up-left),
 20C4   0CC2    '----- a trailing number repeats it ("ul5"); "p" (no direction 
                letters) = a pause
 20C4   0CC2    '----- step in place ("p6" holds 6 steps). Example: "u;d;u;d;u;
                d;p6;ul5;dr2"
 20C4   0CC2    SUB MovParse (s$, mdx%(), mdy%(), mn%, bx1%, by1%, bx2%, by2%)
 20CF   0CC2            mn% = 0
 20CF   0CC2            t$ = LCASE$(s$) + ";"
 20CF   0CC2            sp% = 1
 20CF   0CC2            FOR i% = 1 TO LEN(t$)
 210A   0CC2                    IF MID$(t$, i%, 1) = ";" THEN
 210A   0CC2                            w$ = MID$(t$, sp%, i% - sp%)
 210A   0CC2                            sp% = i% + 1
 210A   0CC2                            IF w$ <> "" THEN
 210A   0CC2                                    dx% = 0: dy% = 0: rp% = 0
 210A   0CC2                                    FOR j% = 1 TO LEN(w$)
 2180   0CC2                                            c$ = MID$(w$, j%, 1)
 2180   0CC2                                            IF c$ = "u" THEN dy% = 
                dy% - 1
 21AF   0CC2                                            IF c$ = "d" THEN dy% = 
                dy% + 1
 21C4   0CC2                                            IF c$ = "l" THEN dx% = 
                dx% - 1
 21D9   0CC2                                            IF c$ = "r" THEN dx% = 
                dx% + 1
 21EE   0CC2                                            IF c$ >= "0" AND c$ <= 
                "9" THEN rp% = rp% * 10 + VAL(c$)
 2244   0CC2                                    NEXT
 2253   0CC2                                    IF rp% < 1 THEN rp% = 1
 2261   0CC2                                    FOR j% = 1 TO rp%
 226E   0CC2                                            IF mn% < 60 THEN mn% = 
                mn% + 1: mdx%(mn%) = dx%: mdy%(mn%) = dy%
 22A1   0CC2                                    NEXT
 22AD   0CC2                            END IF
 22AD   0CC2                    END IF
 22AD   0CC2            NEXT
 22BC   0CC2            '----- path bounds (cumulative offsets) for player-over
                lap tests during the travel
 22BC   0CC2            bx1% = 0: by1% = 0: bx2% = 0: by2% = 0
 22BC   0CC2            cx% = 0: cy% = 0
 22BC   0CC2            FOR i% = 1 TO mn%
 22F0   0CC2                    cx% = cx% + mdx%(i%): cy% = cy% + mdy%(i%)
 22F0   0CC2                    IF cx% < bx1% THEN bx1% = cx%
 2328   0CC2                    IF cx% > bx2% THEN bx2% = cx%
 233A   0CC2                    IF cy% < by1% THEN by1% = cy%
