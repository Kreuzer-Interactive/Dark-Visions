 1FFD   0CC2            CALL AnimK(acPct%(), acN%(), acs, kk%)
 200F   0CC2            w% = acPct%(acs, 1) \ 2
 200F   0CC2            h% = acPct%(acs, kk% + 1)
 200F   0CC2            IF w% < 1 OR h% < 1 THEN EXIT SUB
