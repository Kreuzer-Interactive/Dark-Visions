 1790   0024    '----- frame geometry exactly tiles the file wins; fall back to
                 the raw count.
 1790   0024    SUB AnimK (acPct%(), acN%(), acs, kk%)
 179B   0024            kk% = 1
 179B   0024            anf% = acN%(acs)
 179B   0024            IF anf% < 2 THEN EXIT SUB
 17C8   0024            ld% = 0
 17C8   0024            DO WHILE ld% < anf%
 17CE   0024                    IF acPct%(acs, ld% + 1) <> acPct%(acs, 1) THEN 
                EXIT DO
 182F   0024                    ld% = ld% + 1
 182F   0024            LOOP
 1834   0024            IF ld% < 1 THEN ld% = 1
 1842   0024            w0& = acPct%(acs, 1)
 1842   0024            IF w0& < 0 THEN w0& = w0& + 65536
 1897   0024            FOR k% = ld% TO 1 STEP -1
 189E   0024                    IF (anf% MOD k%) = 0 THEN
 189E   0024                            h& = acPct%(acs, k% + 1)
 189E   0024                            IF h& < 0 THEN h& = h& + 65536
 1907   0024                            IF h& >= 1 AND h& <= 140 AND w0& >= 2 A
                ND w0& <= 280 THEN
 1907   0024                                    per& = 2 + INT((INT((w0& + 7) /
                 8) * h& + 1) / 2)
 1907   0024                                    IF per& * k% = anf% THEN kk% = 
                k%: EXIT SUB
 19F6   0024                            END IF
 19F6   0024                    END IF
 19F6   0024            NEXT
 1A05   0024            kk% = ld%
 1A05   0024    END SUB
 1A15   0024    
 1A15   0024    '----- measure cache slot acs's frame size in pixels (moved fro
                m GAME.BAS): frame
 1A15   0024    '----- count via AnimK; capped so the region fits a 150-int sav
                e-under slot
 1A15   0024    SUB AnimDims (acPct%(), acN%(), acs, adw, adh)
 1A20   0024            adw = 31: adh = 31
 1A20   0024            IF acN%(acs) < 2 THEN EXIT SUB
 1A5D   0024            CALL AnimK(acPct%(), acN%(), acs, kk%)
 1A6F   0024            w% = acPct%(acs, 1) \ 2
 1A6F   0024            h% = acPct%(acs, kk% + 1)
 1A6F   0024            IF w% < 1 OR h% < 1 THEN EXIT SUB
 1AE3   0024            '----- any shape is fine as long as the region fits a 1
                50-int save-under slot
 1AE3   0024            IF ((w% * 2 + 7) \ 8) * h% > 296 THEN EXIT SUB
 1AFC   0024            adw = w%: adh = h%
 1AFC   0024    END SUB
