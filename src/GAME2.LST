 04EF   0006    '----- debug readout (moved from GAME.BAS -- 64K ceiling): raw 
                mouse xy, snapped hit
 04EF   0006    '----- point, and the object+verb a click here resolves to
 04EF   0006    SUB MxyTick (mx%, my%, bx, ay, snr2, ox%(), oy%(), oi%(), ky$()
                )
 04FA   0006            oi2% = 0
 04FA   0006            mind% = snr2 * snr2 + 1
 04FA   0006            FOR i% = 1 TO 257
 051C   0006                    IF oy%(i%) = 0 THEN EXIT FOR
 0534   0006                    dx% = mx% - ox%(i%)
 0534   0006                    dy% = my% - oy%(i%)
 0534   0006                    IF ABS(dx%) <= snr2 AND ABS(dy%) <= snr2 THEN
 0534   0006                            dd% = dx% * dx% + dy% * dy%
 0534   0006                            IF dd% < mind% THEN mind% = dd%: oi2% =
                 oi%(i%)
 05E4   0006                    END IF
 05E4   0006            NEXT
 05F3   0006            v$ = "-"
 05F3   0006            IF oi2% >= 1 AND oi2% <= 25 THEN v$ = ky$(oi2%)
 0634   0006            IF v$ = "" THEN v$ = "-"
 0653   0006            LOCATE 24, 1
 0653   0006            PRINT USING "mxy ### ### hit ### ### obj ## v="; mx%; m
                y%; bx; ay; oi2%;
 0653   0006            PRINT v$; "  ";
 0653   0006    END SUB
