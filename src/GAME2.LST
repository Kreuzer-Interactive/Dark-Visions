                 sliding
 4892   0418                    sdwBob = 1 - sdwBob
 4892   0418                    IF sdwDir > 0 THEN
 4892   0418                            IF sdwBob = 1 THEN sdwX = sdwX + 1 ELSE
                 sdwY = sdwY - 1
 48B9   0418                    ELSE
 48BC   0418                            IF sdwBob = 1 THEN sdwY = sdwY + 1 ELSE
                 sdwX = sdwX - 1
 48D1   0418                    END IF
 48D1   0418                    IF sdwY <= sdwTY + sdwTH - sdwSH - 1 - sdwDp TH
                EN
 48D1   0418                            sdwX = sdwAx + sdwDp: sdwY = sdwTY + sd
                wTH - sdwSH - 1 - sdwDp
 48D1   0418                            sdwDir = -1: sdwBob = 0: sdwNxt = TIMER
                 + .6 + RND * .9
 48D1   0418                    END IF
 4931   0418                    IF sdwX <= sdwAx AND sdwDir < 0 THEN
 4931   0418                            sdwX = sdwAx: sdwY = sdwTY + sdwTH - sd
                wSH - 1
 4931   0418                            sdwDir = 1: sdwBob = 0: sdwNxt = TIMER 
                + .6 + RND * .9
 4931   0418                    END IF
 4998   0418            END IF
 4998   0418            '----- draw: lit base -> shadow -> clip to the light ->
