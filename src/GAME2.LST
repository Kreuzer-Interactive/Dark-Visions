                s(20) AS INTEGER, sdwMode(20) AS INTEGER
 0030   0006    DIM SHARED sdwX(20) AS INTEGER, sdwY(20) AS INTEGER, sdwDir(20)
                 AS INTEGER, sdwBob(20) AS INTEGER
 0030   0006    DIM SHARED sdwNxt(20) AS SINGLE, sdwDst$(20)
 0030   0006    '----- per-watcher "the strip under the standing player is stal
                e" flag
 0030   0006    DIM SHARED sdwDty(20) AS INTEGER
 0030   0006    '----- the standing player composed INTO the watcher frames (hi
                s mask makes
 0030   0006    '----- it exact): PGrab copies the current facing's 31x31 GET p
                air here;
 0030   0006    '----- ShadTick re-shifts it to the byte phase of (pjx AND 3) o
                nce per stand
 0030   0006    '----- (sdwPLX/PLY track the shift position; sdwPNew = grab hap
                pened).
 0030   0006    '----- Shifted rows are 10 bytes (9 + even-pad), 31 rows = 155 
                ints each.
 0030   0006    DIM SHARED sdwPS(130) AS INTEGER, sdwPM(130) AS INTEGER
 0030   0006    DIM SHARED sdwPSh(160) AS INTEGER, sdwPMh(160) AS INTEGER
 0030   0006    DIM SHARED sdwPRdy AS INTEGER, sdwPNew AS INTEGER
 0030   0006    DIM SHARED sdwPLX AS INTEGER, sdwPLY AS INTEGER
