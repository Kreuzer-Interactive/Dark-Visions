 044C   0006            IF jsen <> 1 THEN EXIT SUB
 0462   0006            js0 = STICK(0)
 0462   0006            js1 = STICK(1)
 0462   0006            IF js1 = 0# AND js0 = 0 THEN EXIT SUB
