 0DAF   0CA4    '----- parse an anim frames field like "0;1;2" into fsq(1..nfr2
                ) frame indices
 0DAF   0CA4    SUB AnimParse (s$, fsq%(), nfr2%)
 0DBA   0CA4            nfr2% = 0
 0DBA   0CA4            t$ = s$ + ";"
 0DBA   0CA4            sp% = 1
 0DBA   0CA4            FOR i% = 1 TO LEN(t$)
 0DEE   0CA4                    IF MID$(t$, i%, 1) = ";" THEN
 0DEE   0CA4                            IF i% > sp% AND nfr2% < 30 THEN
 0DEE   0CA4                                    nfr2% = nfr2% + 1
 0DEE   0CA4                                    fsq%(nfr2%) = VAL(MID$(t$, sp%,
                 i% - sp%))
 0DEE   0CA4                            END IF
 0E63   0CA4                            sp% = i% + 1
 0E63   0CA4                    END IF
 0E6A   0CA4            NEXT
 0E79   0CA4    END SUB
