 0FF7   0018    '----- measure cache slot acs's frame size in pixels (moved fro
                m GAME.BAS): frame
 0FF7   0018    '----- count via AnimK; capped so the region fits a 150-int sav
                e-under slot
 0FF7   0018    SUB AnimDims (acPct%(), acN%(), acs, adw, adh)
 1002   0018            adw = 31: adh = 31
 1002   0018            IF acN%(acs) < 2 THEN EXIT SUB
 103F   0018            CALL AnimK(acPct%(), acN%(), acs, kk%)
 1051   0018            w% = acPct%(acs, 1) \ 2
 1051   0018            h% = acPct%(acs, kk% + 1)
 1051   0018            IF w% < 1 OR h% < 1 THEN EXIT SUB
 10C5   0018            '----- any shape is fine as long as the region fits a 1
                50-int save-under slot
 10C5   0018            IF ((w% * 2 + 7) \ 8) * h% > 296 THEN EXIT SUB
 10DE   0018            adw = w%: adh = h%
 10DE   0018    END SUB
