 1A79   0CB0    
 1A79   0CB0    '----- LoadFade: palette fade-in after loading a game -- steps 
                the whole room
 1A79   0CB0    '----- through black, dark gray, light gray and white, then the
                 room palette
 1A79   0CB0    SUB LoadFade (co2, p1, p2, p3)
 1A84   0CB0            DIM fi AS INTEGER, fc AS INTEGER
 1A84   0CB0            DIM ft AS SINGLE, fd AS SINGLE
 1A84   0CB0            FOR fi = 1 TO 4
 1A8A   0CB0                    fc = 0
 1A8A   0CB0                    IF fi = 2 THEN fc = 8
 1A9C   0CB0                    IF fi = 3 THEN fc = 7
 1AAA   0CB0                    IF fi = 4 THEN fc = 15
 1AB8   0CB0                    PALETTE 1, fc: PALETTE 2, fc: PALETTE 3, fc
 1AB8   0CB0                    ft = TIMER
 1AB8   0CB0                    DO
 1AFC   0CB0                            fd = TIMER - ft
 1AFC   0CB0                            IF fd < 0 THEN fd = fd + 86400
 1B34   0CB0                    LOOP WHILE fd < .13
 1B34   0CB0            NEXT
 1B55   0CB0            CALL RmPal(co2, p1, p2, p3)
 1B66   0CB0    END SUB
