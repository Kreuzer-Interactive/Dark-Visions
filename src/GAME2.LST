 0934   0006    '----- pause rate2*0.05s between animation frames (TIMER-based,
                 midnight-safe)
 0934   0006    SUB AnimWait (rate2)
 093F   0006            t! = TIMER
 093F   0006            DO
 0950   0006                    IF TIMER < t! THEN EXIT SUB
 096A   0006            LOOP WHILE TIMER < t! + rate2 * .05
 096A   0006    END SUB
