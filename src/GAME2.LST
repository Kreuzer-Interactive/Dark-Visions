                > the buttons.
 11A6   0006    '----- Returns the cursor park spot for the focus in mx2%/my2% 
                and act%:
 11A6   0006    '----- 1 selection changed | 2 tab switched | 3 focus moved | 4
                 quit | 5 save/load |
 11A6   0006    '----- 6 exit | 7 combine (grid E on combine tab) | 8 examine (
                grid E on info tab)
 11A6   0006    SUB InvNav (k$, nvz, nvb, isel, cic, invtab, ivscr, ivmax, mx2%
                , my2%, act%)
 11B1   0006            act% = 3
 11B1   0006            IF nvz = 0 THEN
 11B1   0006                    IF k$ = "L" THEN
 11B1   0006                            IF cic = 0 OR (INT(isel) MOD 4) = 0 THE
                N nvz = 1 ELSE isel = isel - 1: act% = 1
 125A   0006                    ELSEIF k$ = "R" THEN
 125D   0006                            IF (INT(isel) MOD 4) < 3 AND isel + 1 <
                 cic THEN isel = isel + 1: act% = 1
 12DA   0006                    ELSEIF k$ = "U" THEN
 12DD   0006                            IF isel - 4 >= 0 THEN isel = isel - 4: 
                act% = 1 ELSE nvz = 1
 132E   0006                    ELSEIF k$ = "D" THEN
 1331   0006                            IF isel + 4 < cic THEN isel = isel + 4:
                 act% = 1 ELSE nvz = 2
 1383   0006                    ELSEIF k$ = "E" THEN
 1386   0006                            IF invtab = 1 THEN act% = 7 ELSE act% =
                 8
 13BF   0006                    END IF
 13BF   0006            ELSEIF nvz = 1 THEN
 13C2   0006                    IF k$ = "L" THEN
 13C2   0006                            IF invtab = 1 THEN invtab = 0: act% = 2
 1412   0006                    ELSEIF k$ = "R" THEN
 1415   0006                            IF invtab = 0 THEN invtab = 1: act% = 2
                 ELSE nvz = 0
 145E   0006                    ELSEIF k$ = "D" THEN
 1461   0006                            nvz = 2
 1461   0006                    END IF
 147F   0006            ELSE
 1482   0006                    '----- bottom row is just Close now (quit butto
                n removed -- q key quits)
 1482   0006                    nvb = 0
 1482   0006                    IF k$ = "U" THEN
 1482   0006                            IF cic > 0 THEN nvz = 0 ELSE nvz = 1
 14D4   0006                    ELSEIF k$ = "E" THEN
 14D7   0006                            act% = 6
 14D7   0006                    END IF
 14EF   0006            END IF
