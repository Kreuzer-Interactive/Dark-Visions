 0030   0006    SUB DeathMusic
 0040   0CA4            DIM mr AS RegType, mo AS RegType
 0040   0CA4            DIM tn$, nt$, ch$
 0040   0CA4            DIM i AS INTEGER, shf AS INTEGER, skp AS INTEGER
 0040   0CA4            RANDOMIZE TIMER
 0040   0CA4            mt = INT(RND * 4)
 0040   0CA4            IF mt = 1 THEN tn$ = "<<<g-2g8a+8f+8e8d-3e4f+5f+5e-5e3>
                d2>>"
 0099   0CA4            IF mt = 2 THEN tn$ = "<<<d+8e-8<a8g8f3b8g8f+8e3g-2g8a8f
                +8e8d-3e4f+5c8c8c3>>>"
 00BC   0CA4            IF mt = 3 THEN tn$ = "<<<c3c3d-5d-5c3c3<b-5a-5>c3c3d-5e
                -5c3c3>>>"
 00DF   0CA4            IF tn$ = "" THEN tn$ = "<g8a8b-8b8<c8g8a8b-8a8a8b8a8>>"
 00FE   0CA4            PLAY "MF"
 0107   0CA4            i = 1: shf = 0: skp = 0
 0107   0CA4            DO WHILE i <= LEN(tn$)
 0116   0CA4                    '----- gather octave shifts (and skip spaces) o
                nto the next note
 0116   0CA4                    nt$ = ""
 0116   0CA4                    DO WHILE i <= LEN(tn$)
 0134   0CA4                            ch$ = MID$(tn$, i, 1)
 0134   0CA4                            IF ch$ <> "<" AND ch$ <> ">" AND ch$ <>
                 " " THEN EXIT DO
 01AF   0CA4                            IF ch$ = "<" THEN nt$ = nt$ + ch$: shf 
                = shf + 1
 01DB   0CA4                            IF ch$ = ">" THEN nt$ = nt$ + ch$: shf 
                = shf - 1
 0207   0CA4                            i = i + 1
 0207   0CA4                    LOOP
 020E   0CA4                    IF i > LEN(tn$) THEN
 020E   0CA4                            IF nt$ <> "" THEN PLAY nt$: shf = 0
 023F   0CA4                            EXIT DO
 023F   0CA4                    END IF
 0242   0CA4                    '----- the note letter plus accidentals / lengt
                h digits / dots
 0242   0CA4                    nt$ = nt$ + MID$(tn$, i, 1): i = i + 1
 0242   0CA4                    DO WHILE i <= LEN(tn$)
 026A   0CA4                            ch$ = MID$(tn$, i, 1)
 026A   0CA4                            IF (ch$ < "0" OR ch$ > "9") AND ch$ <> 
                "+" AND ch$ <> "-" AND ch$ <> "#" AND ch$ <> "." THEN EXIT DO
 0336   0CA4                            nt$ = nt$ + ch$: i = i + 1
 0336   0CA4                    LOOP
 0354   0CA4                    PLAY nt$
 035D   0CA4                    '----- a key or click skips the rest of the dir
                ge
 035D   0CA4                    IF INKEY$ <> "" THEN skp = 1
 0376   0CA4                    IF skp = 0 AND msen = 1 THEN
 0376   0CA4                            mr.ax = 3: CALL INTERRUPT(mvint, mr, mo
                )
 03B8   0CA4                            IF (mo.bx AND 1) <> 0 THEN skp = 1
 03CA   0CA4                    END IF
 03CA   0CA4                    IF skp = 1 THEN
 03CA   0CA4                            IF shf > 0 THEN PLAY STRING$(shf, ">")
 03EE   0CA4                            IF shf < 0 THEN PLAY STRING$(-shf, "<")
