 185D   0012    
 185D   0012    '----- LoadFade: palette fade-in after loading a game -- steps 
                the whole room
 185D   0012    '----- through black, dark gray, light gray and white, then the
                 room palette
 185D   0012    SUB LoadFade (co2, p1, p2, p3)
 1868   0012            DIM fi AS INTEGER, fc AS INTEGER
 1868   0012            DIM ft AS SINGLE, fd AS SINGLE
 1868   0012            FOR fi = 1 TO 4
 186E   0012                    fc = 0
 186E   0012                    IF fi = 2 THEN fc = 8
 1880   0012                    IF fi = 3 THEN fc = 7
 188E   0012                    IF fi = 4 THEN fc = 15
 189C   0012                    PALETTE 1, fc: PALETTE 2, fc: PALETTE 3, fc
 189C   0012                    ft = TIMER
 189C   0012                    DO
 18E0   0012                            fd = TIMER - ft
 18E0   0012                            IF fd < 0 THEN fd = fd + 86400
 1918   0012                    LOOP WHILE fd < .13
 1918   0012            NEXT
 1939   0012            CALL RmPal(co2, p1, p2, p3)
 194A   0012    END SUB
