 1F4C   0CC2    '----- (a 3x6 frame reads 6,6,6,6...). Validate candidates down
                ward: the k whose
 1F4C   0CC2    '----- frame geometry exactly tiles the file wins; fall back to
                 the raw count.
 1F4C   0CC2    SUB AnimK (acPct%(), acN%(), acs, kk%)
 1F57   0CC2            kk% = 1
 1F57   0CC2            anf% = acN%(acs)
 1F57   0CC2            IF anf% < 2 THEN EXIT SUB
 1F84   0CC2            ld% = 0
 1F84   0CC2            DO WHILE ld% < anf%
 1F8A   0CC2                    IF acPct%(acs, ld% + 1) <> acPct%(acs, 1) THEN 
                EXIT DO
 1FEB   0CC2                    ld% = ld% + 1
 1FEB   0CC2            LOOP
 1FF0   0CC2            IF ld% < 1 THEN ld% = 1
 1FFE   0CC2            w0& = acPct%(acs, 1)
 1FFE   0CC2            IF w0& < 0 THEN w0& = w0& + 65536
 2053   0CC2            FOR k% = ld% TO 1 STEP -1
 205A   0CC2                    IF (anf% MOD k%) = 0 THEN
 205A   0CC2                            h& = acPct%(acs, k% + 1)
 205A   0CC2                            IF h& < 0 THEN h& = h& + 65536
 20C3   0CC2                            IF h& >= 1 AND h& <= 140 AND w0& >= 2 A
                ND w0& <= 280 THEN
 20C3   0CC2                                    per& = 2 + INT((INT((w0& + 7) /
                 8) * h& + 1) / 2)
 20C3   0CC2                                    IF per& * k% = anf% THEN kk% = 
                k%: EXIT SUB
 21B2   0CC2                            END IF
 21B2   0CC2                    END IF
 21B2   0CC2            NEXT
 21C1   0CC2            kk% = ld%
 21C1   0CC2    END SUB
