 1B24   0024    '----- step in place ("p6" holds 6 steps). Example: "u;d;u;d;u;
                d;p6;ul5;dr2"
 1B24   0024    SUB MovParse (s$, mdx%(), mdy%(), mn%, bx1%, by1%, bx2%, by2%)
 1B2F   0024            mn% = 0
 1B2F   0024            t$ = LCASE$(s$) + ";"
 1B2F   0024            sp% = 1
 1B2F   0024            FOR i% = 1 TO LEN(t$)
 1B6A   0024                    IF MID$(t$, i%, 1) = ";" THEN
 1B6A   0024                            w$ = MID$(t$, sp%, i% - sp%)
 1B6A   0024                            sp% = i% + 1
 1B6A   0024                            IF w$ <> "" THEN
 1B6A   0024                                    dx% = 0: dy% = 0: rp% = 0
 1B6A   0024                                    FOR j% = 1 TO LEN(w$)
 1BE0   0024                                            c$ = MID$(w$, j%, 1)
 1BE0   0024                                            IF c$ = "u" THEN dy% = 
                dy% - 1
 1C0F   0024                                            IF c$ = "d" THEN dy% = 
                dy% + 1
 1C24   0024                                            IF c$ = "l" THEN dx% = 
                dx% - 1
 1C39   0024                                            IF c$ = "r" THEN dx% = 
                dx% + 1
 1C4E   0024                                            IF c$ >= "0" AND c$ <= 
                "9" THEN rp% = rp% * 10 + VAL(c$)
 1CA4   0024                                    NEXT
 1CB3   0024                                    IF rp% < 1 THEN rp% = 1
 1CC1   0024                                    FOR j% = 1 TO rp%
 1CCE   0024                                            IF mn% < 60 THEN mn% = 
                mn% + 1: mdx%(mn%) = dx%: mdy%(mn%) = dy%
 1D01   0024                                    NEXT
 1D0D   0024                            END IF
 1D0D   0024                    END IF
 1D0D   0024            NEXT
 1D1C   0024            '----- path bounds (cumulative offsets) for player-over
                lap tests during the travel
 1D1C   0024            bx1% = 0: by1% = 0: bx2% = 0: by2% = 0
 1D1C   0024            cx% = 0: cy% = 0
 1D1C   0024            FOR i% = 1 TO mn%
 1D50   0024                    cx% = cx% + mdx%(i%): cy% = cy% + mdy%(i%)
 1D50   0024                    IF cx% < bx1% THEN bx1% = cx%
 1D88   0024                    IF cx% > bx2% THEN bx2% = cx%
 1D9A   0024                    IF cy% < by1% THEN by1% = cy%
 1DAC   0024                    IF cy% > by2% THEN by2% = cy%
 1DBE   0024            NEXT
 1DCA   0024    END SUB
