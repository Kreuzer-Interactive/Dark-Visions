 0A45   0CA4    
 0A45   0CA4    '----- debug readout (moved from GAME.BAS -- 64K ceiling): raw 
                mouse xy, snapped hit
 0A45   0CA4    '----- point, and the object+verb a click here resolves to
 0A45   0CA4    SUB MxyTick (mx%, my%, bx, ay, snr2, ox%(), oy%(), oi%(), ky$()
                )
 0A50   0CA4            oi2% = 0
 0A50   0CA4            mind% = snr2 * snr2 + 1
 0A50   0CA4            FOR i% = 1 TO 257
 0A72   0CA4                    IF oy%(i%) = 0 THEN EXIT FOR
 0A8A   0CA4                    dx% = mx% - ox%(i%)
 0A8A   0CA4                    dy% = my% - oy%(i%)
 0A8A   0CA4                    IF ABS(dx%) <= snr2 AND ABS(dy%) <= snr2 THEN
 0A8A   0CA4                            dd% = dx% * dx% + dy% * dy%
 0A8A   0CA4                            IF dd% < mind% THEN mind% = dd%: oi2% =
                 oi%(i%)
 0B3A   0CA4                    END IF
 0B3A   0CA4            NEXT
 0B49   0CA4            v$ = "-"
 0B49   0CA4            IF oi2% >= 1 AND oi2% <= 25 THEN v$ = ky$(oi2%)
 0B8A   0CA4            IF v$ = "" THEN v$ = "-"
 0BA9   0CA4            LOCATE 24, 1
 0BA9   0CA4            PRINT USING "mxy ### ### hit ### ### obj ## v="; mx%; m
                y%; bx; ay; oi2%;
 0BA9   0CA4            PRINT v$; "  ";
 0BA9   0CA4    END SUB
 0C26   0CA4    
 0C26   0CA4    '----- hit-zone debug overlay (moved from GAME.BAS): ring each 
                hotspot's snr click-zone
 0C26   0CA4    '----- coloured by verb (look=blue, action=brown, get/use=gray)
                 + dot its hit point
 0C26   0CA4    SUB HitZones (hz$, snr2, ox%(), oy%(), oi%(), ky$())
 0C31   0CA4            IF hz$ = "" OR snr2 <= 0 THEN EXIT SUB
 0C66   0CA4            FOR i% = 1 TO 257
 0C6C   0CA4                    IF oy%(i%) = 0 THEN EXIT FOR
 0C84   0CA4                    v$ = ky$(oi%(i%))
 0C84   0CA4                    IF v$ <> "" AND INSTR(hz$, v$) > 0 THEN
 0C84   0CA4                            c% = 2
 0C84   0CA4                            IF v$ = "a" THEN c% = 3
 0CFD   0CA4                            IF v$ = "g" THEN c% = 1
 0D14   0CA4                            IF v$ = "u" THEN c% = 1
