 22E0   0CC2    '----- parse a move-anim script into 1px step arrays (max 60 st
                eps).
 22E0   0CC2    '----- Tokens split on ";": letters u/d/l/r combine into a dire
                ction (ul = up-left),
                                                                      PAGE  13
                                                                      22 Sep 26
                                                                      13:59:25
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 22E0   0CC2    '----- a trailing number repeats it ("ul5"); "p" (no direction 
                letters) = a pause
 22E0   0CC2    '----- step in place ("p6" holds 6 steps). Example: "u;d;u;d;u;
                d;p6;ul5;dr2"
 22E0   0CC2    SUB MovParse (s$, mdx%(), mdy%(), mn%, bx1%, by1%, bx2%, by2%)
 22EB   0CC2            mn% = 0
 22EB   0CC2            t$ = LCASE$(s$) + ";"
 22EB   0CC2            sp% = 1
 22EB   0CC2            FOR i% = 1 TO LEN(t$)
 2326   0CC2                    IF MID$(t$, i%, 1) = ";" THEN
 2326   0CC2                            w$ = MID$(t$, sp%, i% - sp%)
 2326   0CC2                            sp% = i% + 1
 2326   0CC2                            IF w$ <> "" THEN
 2326   0CC2                                    dx% = 0: dy% = 0: rp% = 0
 2326   0CC2                                    FOR j% = 1 TO LEN(w$)
 239C   0CC2                                            c$ = MID$(w$, j%, 1)
 239C   0CC2                                            IF c$ = "u" THEN dy% = 
                dy% - 1
 23CB   0CC2                                            IF c$ = "d" THEN dy% = 
                dy% + 1
 23E0   0CC2                                            IF c$ = "l" THEN dx% = 
                dx% - 1
 23F5   0CC2                                            IF c$ = "r" THEN dx% = 
                dx% + 1
 240A   0CC2                                            IF c$ >= "0" AND c$ <= 
                "9" THEN rp% = rp% * 10 + VAL(c$)
 2460   0CC2                                    NEXT
 246F   0CC2                                    IF rp% < 1 THEN rp% = 1
 247D   0CC2                                    FOR j% = 1 TO rp%
 248A   0CC2                                            IF mn% < 60 THEN mn% = 
                mn% + 1: mdx%(mn%) = dx%: mdy%(mn%) = dy%
 24BD   0CC2                                    NEXT
 24C9   0CC2                            END IF
 24C9   0CC2                    END IF
 24C9   0CC2            NEXT
 24D8   0CC2            '----- path bounds (cumulative offsets) for player-over
                lap tests during the travel
 24D8   0CC2            bx1% = 0: by1% = 0: bx2% = 0: by2% = 0
 24D8   0CC2            cx% = 0: cy% = 0
 24D8   0CC2            FOR i% = 1 TO mn%
 250C   0CC2                    cx% = cx% + mdx%(i%): cy% = cy% + mdy%(i%)
 250C   0CC2                    IF cx% < bx1% THEN bx1% = cx%
 2544   0CC2                    IF cx% > bx2% THEN bx2% = cx%
 2556   0CC2                    IF cy% < by1% THEN by1% = cy%
 2568   0CC2                    IF cy% > by2% THEN by2% = cy%
 257A   0CC2            NEXT
