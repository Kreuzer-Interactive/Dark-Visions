 0E8A   0006    '----- pause rate2*0.05s between animation frames (TIMER-based,
                 midnight-safe)
 0E8A   0006    SUB AnimWait (rate2)
 0E95   0006            t! = TIMER
 0E95   0006            DO
 0EA6   0006                    IF TIMER < t! THEN EXIT SUB
 0EC0   0006            LOOP WHILE TIMER < t! + rate2 * .05
 0EC0   0006    END SUB
 0EEA   0006    
 0EEA   0006    '----- inventory combine: which recipe do items s% (top) + c% (
                bottom) match? 0 = none.
 0EEA   0006    '----- 1: 18+28 -> 22 · 2: formula halves 11+24 -> unreadable 5
                2 · 4: 52 + book 25 ->
 0EEA   0006    '----- complete formula 36 · 3: syringe 29 + drug 34 -> loaded 
                syringe 35
 0EEA   0006    SUB CombChk (s%, c%, r%)
 0EF5   0006            r% = 0
 0EF5   0006            IF (s% = 18 AND c% = 28) OR (s% = 28 AND c% = 18) THEN 
                r% = 1
 0F3A   0006            IF (s% = 11 AND c% = 24) OR (s% = 24 AND c% = 11) THEN 
                r% = 2
 0F78   0006            IF (s% = 52 AND c% = 25) OR (s% = 25 AND c% = 52) THEN 
                r% = 4
 0FB6   0006            IF (s% = 29 AND c% = 34) OR (s% = 34 AND c% = 29) THEN 
                r% = 3
 0FF4   0006    END SUB
 0FFC   0006    
 0FFC   0006    '----- apply combine recipe r%: swap the ingredient ob() flags 
                for the result, and
 0FFC   0006    '----- re-derive 33 (ready to mix) since 36 may just have appea
                red
 0FFC   0006    SUB CombDo2 (r%, ob(), cn%)
 1007   0006            '----- ingredients become state 2 ("used up"): out of t
                he inventory but
 1007   0006            '----- still counting as taken, so their pickup spots n
                ever re-arm
 1007   0006            cn% = 0
 1007   0006            IF r% = 1 THEN ob(18) = 2: ob(28) = 2: ob(22) = 1: cn% 
                = 22
 105F   0006            IF r% = 2 THEN ob(24) = 2: ob(11) = 2: ob(52) = 1: cn% 
                = 52
 10B0   0006            IF r% = 3 THEN ob(29) = 2: ob(34) = 2: ob(35) = 1: cn% 
                = 35
 1101   0006            IF r% = 4 THEN ob(52) = 2: ob(36) = 1: cn% = 36
 113E   0006            IF ob(32) = 1 AND ob(36) = 1 THEN ob(33) = 1
 119E   0006    END SUB
