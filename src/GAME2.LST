 11B1   0CA4                    IF k$ = "L" THEN
 11B1   0CA4                            IF cic = 0 OR (INT(isel) MOD 4) = 0 THE
                N nvz = 1 ELSE isel = isel - 1: act% = 1
 125A   0CA4                    ELSEIF k$ = "R" THEN
 125D   0CA4                            IF (INT(isel) MOD 4) < 3 AND isel + 1 <
                 cic THEN isel = isel + 1: act% = 1
 12DA   0CA4                    ELSEIF k$ = "U" THEN
 12DD   0CA4                            IF isel - 4 >= 0 THEN isel = isel - 4: 
                act% = 1 ELSE nvz = 1
 132E   0CA4                    ELSEIF k$ = "D" THEN
 1331   0CA4                            IF isel + 4 < cic THEN isel = isel + 4:
                 act% = 1 ELSE nvz = 2
 1383   0CA4                    ELSEIF k$ = "E" THEN
 1386   0CA4                            IF invtab = 1 THEN act% = 7 ELSE act% =
                 8
 13BF   0CA4                    END IF
 13BF   0CA4            ELSEIF nvz = 1 THEN
 13C2   0CA4                    IF k$ = "L" THEN
 13C2   0CA4                            IF invtab = 1 THEN invtab = 0: act% = 2
