 0C26   0006    
 0C26   0006    '----- hit-zone debug overlay (moved from GAME.BAS): ring each 
                hotspot's snr click-zone
 0C26   0006    '----- coloured by verb (look=blue, action=brown, get/use=gray)
                 + dot its hit point
 0C26   0006    SUB HitZones (hz$, snr2, ox%(), oy%(), oi%(), ky$())
 0C31   0006            IF hz$ = "" OR snr2 <= 0 THEN EXIT SUB
 0C66   0006            FOR i% = 1 TO 257
 0C6C   0006                    IF oy%(i%) = 0 THEN EXIT FOR
 0C84   0006                    v$ = ky$(oi%(i%))
 0C84   0006                    IF v$ <> "" AND INSTR(hz$, v$) > 0 THEN
 0C84   0006                            c% = 2
 0C84   0006                            IF v$ = "a" THEN c% = 3
 0CFD   0006                            IF v$ = "g" THEN c% = 1
 0D14   0006                            IF v$ = "u" THEN c% = 1
 0D2B   0006                            CIRCLE (ox%(i%), oy%(i%)), snr2, c%
 0D61   0006                            PSET (ox%(i%), oy%(i%)), c%
 0D61   0006                    END IF
 0D8F   0006            NEXT
 0D9E   0006    END SUB
 0DAF   0006    
 0DAF   0006    '----- parse an anim frames field like "0;1;2" into fsq(1..nfr2
                ) frame indices
 0DAF   0006    SUB AnimParse (s$, fsq%(), nfr2%)
 0DBA   0006            nfr2% = 0
 0DBA   0006            t$ = s$ + ";"
 0DBA   0006            sp% = 1
 0DBA   0006            FOR i% = 1 TO LEN(t$)
 0DEE   0006                    IF MID$(t$, i%, 1) = ";" THEN
 0DEE   0006                            IF i% > sp% AND nfr2% < 30 THEN
 0DEE   0006                                    nfr2% = nfr2% + 1
 0DEE   0006                                    fsq%(nfr2%) = VAL(MID$(t$, sp%,
                 i% - sp%))
 0DEE   0006                            END IF
 0E63   0006                            sp% = i% + 1
 0E63   0006                    END IF
 0E6A   0006            NEXT
 0E79   0006    END SUB
