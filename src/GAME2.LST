 1106   0018    '----- parse a move-anim script into 1px step arrays (max 60 st
                eps).
 1106   0018    '----- Tokens split on ";": letters u/d/l/r combine into a dire
                                                                      PAGE   6
                                                                      09 Jul 26
                                                                      14:34:10
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

                ction (ul = up-left),
 1106   0018    '----- a trailing number repeats it ("ul5"); "p" (no direction 
                letters) = a pause
 1106   0018    '----- step in place ("p6" holds 6 steps). Example: "u;d;u;d;u;
                d;p6;ul5;dr2"
 1106   0018    SUB MovParse (s$, mdx%(), mdy%(), mn%, bx1%, by1%, bx2%, by2%)
 1111   0018            mn% = 0
 1111   0018            t$ = LCASE$(s$) + ";"
 1111   0018            sp% = 1
 1111   0018            FOR i% = 1 TO LEN(t$)
 114C   0018                    IF MID$(t$, i%, 1) = ";" THEN
 114C   0018                            w$ = MID$(t$, sp%, i% - sp%)
 114C   0018                            sp% = i% + 1
 114C   0018                            IF w$ <> "" THEN
 114C   0018                                    dx% = 0: dy% = 0: rp% = 0
 114C   0018                                    FOR j% = 1 TO LEN(w$)
 11C2   0018                                            c$ = MID$(w$, j%, 1)
 11C2   0018                                            IF c$ = "u" THEN dy% = 
                dy% - 1
 11F1   0018                                            IF c$ = "d" THEN dy% = 
                dy% + 1
 1206   0018                                            IF c$ = "l" THEN dx% = 
                dx% - 1
 121B   0018                                            IF c$ = "r" THEN dx% = 
                dx% + 1
 1230   0018                                            IF c$ >= "0" AND c$ <= 
                "9" THEN rp% = rp% * 10 + VAL(c$)
 1286   0018                                    NEXT
 1295   0018                                    IF rp% < 1 THEN rp% = 1
 12A3   0018                                    FOR j% = 1 TO rp%
 12B0   0018                                            IF mn% < 60 THEN mn% = 
                mn% + 1: mdx%(mn%) = dx%: mdy%(mn%) = dy%
 12E3   0018                                    NEXT
 12EF   0018                            END IF
 12EF   0018                    END IF
 12EF   0018            NEXT
 12FE   0018            '----- path bounds (cumulative offsets) for player-over
                lap tests during the travel
 12FE   0018            bx1% = 0: by1% = 0: bx2% = 0: by2% = 0
 12FE   0018            cx% = 0: cy% = 0
 12FE   0018            FOR i% = 1 TO mn%
 1332   0018                    cx% = cx% + mdx%(i%): cy% = cy% + mdy%(i%)
 1332   0018                    IF cx% < bx1% THEN bx1% = cx%
 136A   0018                    IF cx% > bx2% THEN bx2% = cx%
 137C   0018                    IF cy% < by1% THEN by1% = cy%
 138E   0018                    IF cy% > by2% THEN by2% = cy%
 13A0   0018            NEXT
 13AC   0018    END SUB
