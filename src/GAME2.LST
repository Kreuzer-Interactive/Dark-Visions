 35A2   0D56            ovf%(ovb% + 2) = ovnext!
 35A2   0D56            ovf%(ovb% + 3) = 0
 35A2   0D56            FOR aj% = 0 TO anpf! - 1: ovf%(ovnext! + aj%) = afrm%(a
                j%): NEXT
 3691   0D56            ovnext! = ovnext! + anpf!
