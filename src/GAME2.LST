 12CC   0CA4            IF r% = 3 THEN ob(29) = 2: ob(34) = 2: ob(35) = 1: cn% 
                = 35
 131D   0CA4            IF r% = 4 THEN ob(52) = 2: ob(36) = 1: cn% = 36
 135A   0CA4            IF ob(32) = 1 AND ob(36) = 1 THEN ob(33) = 1
 13BA   0CA4    END SUB
 13C2   0CA4    
 13C2   0CA4    '----- keyboard/joystick navigation for the inventory screen. Z
                ones: 0 = item grid,
 13C2   0CA4    '----- 1 = tabs (left pane), 2 = bottom buttons. k$ = U/D/L/R m
                ove, E = activate.
 13C2   0CA4    '----- Grid: left off column 0 -> tabs (active tab first); movi
                ng toward the inactive
 13C2   0CA4    '----- tab ACTIVATES it; down off the grid (or from the tabs) -
                > the buttons.
 13C2   0CA4    '----- Returns the cursor park spot for the focus in mx2%/my2% 
                and act%:
 13C2   0CA4    '----- 1 selection changed | 2 tab switched | 3 focus moved | 4
                 quit | 5 save/load |
 13C2   0CA4    '----- 6 exit | 7 combine (grid E on combine tab) | 8 examine (
                grid E on info tab)
 13C2   0CA4    SUB InvNav (k$, nvz, nvb, isel, cic, invtab, ivscr, ivmax, mx2%
                , my2%, act%)
 13CD   0CA4            act% = 3
 13CD   0CA4            IF nvz = 0 THEN
 13CD   0CA4                    IF k$ = "L" THEN
 13CD   0CA4                            IF cic = 0 OR (INT(isel) MOD 4) = 0 THE
                N nvz = 1 ELSE isel = isel - 1: act% = 1
 1476   0CA4                    ELSEIF k$ = "R" THEN
 1479   0CA4                            IF (INT(isel) MOD 4) < 3 AND isel + 1 <
                 cic THEN isel = isel + 1: act% = 1
 14F6   0CA4                    ELSEIF k$ = "U" THEN
 14F9   0CA4                            IF isel - 4 >= 0 THEN isel = isel - 4: 
                act% = 1 ELSE nvz = 1
 154A   0CA4                    ELSEIF k$ = "D" THEN
 154D   0CA4                            IF isel + 4 < cic THEN isel = isel + 4:
                 act% = 1 ELSE nvz = 2
 159F   0CA4                    ELSEIF k$ = "E" THEN
 15A2   0CA4                            IF invtab = 1 THEN act% = 7 ELSE act% =
                 8
 15DB   0CA4                    END IF
 15DB   0CA4            ELSEIF nvz = 1 THEN
