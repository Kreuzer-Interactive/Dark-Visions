 1FE6   008C                    km$(5) = "That's not the key for this lock."
 1FE6   008C                    km$(6) = "No use - this key will never turn it.
                "
 1FE6   008C                    pc$(1) = "The lock is too tough to pick. You'll
                   need the key."
 1FE6   008C                    pc$(2) = "Too sturdy to pick - this one needs i
                ts key."
 1FE6   008C                    rc$(1) = "You need something a little longer to
                   reach it."
 1FE6   008C                    rc$(2) = "You can't quite reach it with that."
 1FE6   008C                    RANDOMIZE TIMER
 1FE6   008C            END IF
 213F   0090            kk = 0
 213F   0090            IF wantbs > 0 AND wantbs <> sel THEN
 213F   0090                    wk = 0
 213F   0090                    IF wantbs = 5 OR wantbs = 8 OR wantbs = 13 OR w
                antbs = 22 THEN wk = 1
 2203   0098                    IF wk = 1 THEN
 2203   0098                            IF sel = 5 OR sel = 8 OR sel = 13 OR se
                l = 22 THEN kk = 1
 228F   0098                            IF sel = 27 THEN kk = 2
 22B2   0098                    END IF
 22B2   0098                    IF sel = 6 AND wantbs = 2 THEN kk = 3
 22F9   0098            END IF
 22F9   0098            IF kk = 2 THEN
 22F9   0098                    pch = (pch MOD 2) + 1
 22F9   0098                    out$ = pc$(pch)
 22F9   0098            ELSEIF kk = 3 THEN
 2356   009C                    rch = (rch MOD 2) + 1
 2356   009C                    out$ = rc$(rch)
 2356   009C            ELSEIF kk = 1 THEN
 23B3   00A0                    DO
 23CA   00A0                            ump = INT(RND * 6) + 1
 23CA   00A0                    LOOP WHILE ump = kh1 OR ump = kh2
 23CA   00A0                    kh2 = kh1
 23CA   00A0                    kh1 = ump
 23CA   00A0                    out$ = km$(ump)
 23CA   00A0            ELSE
