 1FDB   0024    '----- pick a random, non-repeating reply for a use that did no
                thing. sel = the item
 1FDB   0024    '----- being used; wantbs = an item some hit use point wanted i
                nstead (0 = none).
 1FDB   0024    '----- Specials: a key on a lock wanting a DIFFERENT key -> key
                 lines; the paper
 1FDB   0024    '----- clip (27) on a keyed lock -> too-tough-to-pick lines; th
                e bar (6) where the
 1FDB   0024    '----- poker's (2) reach is needed -> too-short lines. Keys: 5,
                 8, 13, 22.
 1FDB   0024    SUB UseMissLine (sel, wantbs, out$) STATIC
 1FE6   0024            DIM us$(12), km$(6), pc$(2), rc$(2)
 1FE6   008C            IF umini = 0 THEN
 1FE6   008C                    umini = 1
 1FE6   008C                    us$(1) = "That doesn't work."
 1FE6   008C                    us$(2) = "You can't use that there."
 1FE6   008C                    us$(3) = "Nothing happens."
 1FE6   008C                    us$(4) = "That's not going to work."
 1FE6   008C                    us$(5) = "You try, but it does nothing."
 1FE6   008C                    us$(6) = "That has no effect."
 1FE6   008C                    us$(7) = "It doesn't seem to fit."
 1FE6   008C                    us$(8) = "You can't find a way to use it here."
 1FE6   008C                    us$(9) = "That won't help here."
 1FE6   008C                    us$(10) = "Try as you might, nothing happens."
 1FE6   008C                    us$(11) = "That accomplishes nothing."
 1FE6   008C                    us$(12) = "No matter how you try, it won't work
                ."
 1FE6   008C                    km$(1) = "The key doesn't fit the lock."
 1FE6   008C                    km$(2) = "The key goes in but refuses to turn."
 1FE6   008C                    km$(3) = "It's the wrong key for this lock."
 1FE6   008C                    km$(4) = "The key rattles but will not turn."
                                                                      PAGE  11
                                                                      13 Jul 26
                                                                      13:22:48
