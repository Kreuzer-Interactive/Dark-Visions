 185D   0372    '----- LoadFade: palette fade-in after loading a game -- steps 
                the whole room
 185D   0372    '----- through black, dark gray, light gray and white, then the
                 room palette
 185D   0372    SUB LoadFade (co2, p1, p2, p3)
 1868   0372            DIM fi AS INTEGER, fc AS INTEGER
 1868   0372            DIM ft AS SINGLE, fd AS SINGLE
 1868   0372            FOR fi = 1 TO 4
 186E   0372                    fc = 0
 186E   0372                    IF fi = 2 THEN fc = 8
 1880   0372                    IF fi = 3 THEN fc = 7
 188E   0372                    IF fi = 4 THEN fc = 15
 189C   0372                    PALETTE 1, fc: PALETTE 2, fc: PALETTE 3, fc
 189C   0372                    ft = TIMER
 189C   0372                    DO
 18E0   0372                            fd = TIMER - ft
 18E0   0372                            IF fd < 0 THEN fd = fd + 86400
 1918   0372                    LOOP WHILE fd < .13
