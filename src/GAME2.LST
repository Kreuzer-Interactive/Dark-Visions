 423A   0418    '----- ShadLoad: parse SHADW2.PAC from the ALREADY-OPEN #3 (GAM
                E.BAS shadload
 423A   0418    '----- does the guarded OPEN so a missing file just leaves the 
                feature off).
 423A   0418    '----- Header line, then 7 arrays each preceded by its int coun
                t, in order:
 423A   0418    '----- door stamp (PSET), idle rect (PSET), lit rect (PSET), ke
                ep-lit (AND),
 423A   0418    '----- outside-light restore (OR), shadow right (AND), shadow l
                eft (AND).
 423A   0418    SUB ShadLoad
 4245   0418            DIM sv AS INTEGER, sn2 AS INTEGER, si2 AS INTEGER, sof 
                AS INTEGER, sar AS INTEGER
 4245   0418            sdwOn = 0
 4245   0418            INPUT #3, sv, sdwTX, sdwTY, sdwTW, sdwTH, sdwDX, sdwDY,
                                                                      PAGE  20
                                                                      11 Aug 26
                                                                      16:32:45
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

                 sdwSW, sdwSH
 4254   0418            IF sv <> 1 THEN CLOSE #3: EXIT SUB
 42DE   0418            sof = 0
 42DE   0418            FOR sar = 1 TO 7
 42EA   0418                    INPUT #3, sn2
 42F3   0418                    IF sof + sn2 > 400 THEN CLOSE #3: EXIT SUB
 4322   0418                    IF sar = 1 THEN sdwODr = sof
 4331   0418                    IF sar = 2 THEN sdwOId = sof
 4340   0418                    IF sar = 3 THEN sdwOLt = sof
 434F   0418                    IF sar = 4 THEN sdwOKp = sof
 435E   0418                    IF sar = 5 THEN sdwOBg = sof
 436D   0418                    IF sar = 6 THEN sdwOSR = sof
 437C   0418                    IF sar = 7 THEN sdwOSL = sof
 438B   0418                    FOR si2 = 1 TO sn2
 4398   0418                            INPUT #3, sdwDat(sof)
 43A1   0418                            sof = sof + 1
 43A1   0418                    NEXT
 43C9   0418            NEXT
 43D8   0418            CLOSE #3
 43D8   0418            sdwDst$ = "room8"
 43D8   0418            '----- right walk bound: the shadow's LEFT edge stays u
                nder the door's base
 43D8   0418            '----- (door width read from the bgDoor GET header = sd
                wDat(ODr) \ 2)
 43D8   0418            sdwXMx = sdwDX + sdwDat(sdwODr) \ 2 - 1
 43D8   0418            '----- pace ALONG the wall (base line runs up-right in 
                this perspective):
 43D8   0418            '----- anchor = tucked at the door's lower base corner 
                (doorX + 2), a few
 43D8   0418            '----- stair-steps up-right and back. Kept SHORT so the
                 whole silhouette
 43D8   0418            '----- hangs at the doorway instead of wandering into t
                he pool.
 43D8   0418            sdwAx = sdwDX + 2
 43D8   0418            sdwDp = 3
 43D8   0418            IF sdwDp > sdwTH - sdwSH - 2 THEN sdwDp = sdwTH - sdwSH
                 - 2
 442F   0418            IF sdwAx + sdwDp > sdwXMx THEN sdwDp = sdwXMx - sdwAx
 4449   0418            sdwOn = 1
 4449   0418    END SUB
