 06DC   0CA4            IF js0 < 40 THEN a2$ = "4"
 06FD   0CA4            IF js0 > 120 THEN a2$ = "6"
 071E   0CA4            IF js1 < 40 THEN a2$ = "8"
 073F   0CA4            IF js1 > 120 THEN a2$ = "2"
 0760   0CA4            IF js1 < 40 AND js0 > 120 THEN a2$ = "9"
 07A3   0CA4            IF js1 < 40 AND js0 < 40 THEN a2$ = "7"
 07E6   0CA4            IF js0 > 120 AND js1 > 120 THEN a2$ = "3"
 0829   0CA4            IF js0 < 40 AND js1 > 120 THEN a2$ = "1"
 086C   0CA4            IF LEN(a2$) = 1 THEN
 086C   0CA4                    IF INSTR("123456789", a2$) > 0 THEN vk2$ = ""
 089B   0CA4            END IF
