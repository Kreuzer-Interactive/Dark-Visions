                r pressed 's'.
 0030   0006    FUNCTION ShowHouse%
 0040   0CA4            ShowHouse% = 0
 0040   0CA4            KEY OFF
 0045   0CA4            PALETTE 1, 2
 0045   0CA4            PALETTE 2, 3
 0045   0CA4            PALETTE 3, 6
 0045   0CA4            DEF SEG = &HB800: BLOAD "house.pic", 0: DEF SEG
 0045   0CA4            '----- storm-arrival: footsteps, then a LIGHTNING FLASH
                 + thunder (reusing the
 0045   0CA4            '----- hill scene's exact flash/rumble so it reads the 
                same), then more steps.
 0045   0CA4            '----- The screen flash is what sells the thunder; audi
                o alone is just a rumble.
 0045   0CA4            FOR i% = 1 TO 5
 009E   0CA4                    IF INKEY$ = "s" THEN ShowHouse% = 1: EXIT FUNCT
                ION
 00BA   0CA4                    SOUND f3, .1: SOUND 32676, 7
 00E3   0CA4            NEXT
 00EF   0CA4            '----- lightning: flicker the CGA background white (COL
                OR 15) like the hill scene
 00EF   0CA4            COLOR 15: SOUND 32676, 2: COLOR 0: SOUND 32676, 1
 0132   0CA4            COLOR 15: SOUND 32676, 2: COLOR 0
 0154   0CA4            '----- thunder: descending rumble mixing f10 (the hill 
                scene's 17340 pattern)
 0154   0CA4            tc = 200
 0154   0CA4            DO
 0170   0CA4                    IF INKEY$ = "s" THEN ShowHouse% = 1: EXIT FUNCT
                ION
 018C   0CA4                    SOUND tc, .1: SOUND f10, .1: SOUND 32676, 1
 01CC   0CA4                    tc = tc - 10
 01CC   0CA4            LOOP WHILE tc >= 50
 01CC   0CA4            FOR i% = 1 TO 4
 01F4   0CA4                    IF INKEY$ = "s" THEN ShowHouse% = 1: EXIT FUNCT
                ION
 0210   0CA4                    SOUND f3, .1: SOUND 32676, 7
 0239   0CA4            NEXT
 0245   0CA4    END FUNCTION
 0250   0CA4    
 0250   0CA4    '----- DeathMusic: play one of four random dirges, note by note
                 so a keypress
 0250   0CA4    '----- or mouse click skips the rest (octave shifts are rebalan
                ced on a skip
 0250   0CA4    '----- since the tunes rely on balanced <...> pairs)
 0250   0CA4    SUB DeathMusic
 025B   0CA4            DIM mr AS RegType, mo AS RegType
 025B   0CA4            DIM tn$, nt$, ch$
 025B   0CA4            DIM i AS INTEGER, shf AS INTEGER, skp AS INTEGER
 025B   0CA4            RANDOMIZE TIMER
 025B   0CA4            mt = INT(RND * 4)
 025B   0CA4            IF mt = 1 THEN tn$ = "<<<g-2g8a+8f+8e8d-3e4f+5f+5e-5e3>
                d2>>"
 02B4   0CA4            IF mt = 2 THEN tn$ = "<<<d+8e-8<a8g8f3b8g8f+8e3g-2g8a8f
                +8e8d-3e4f+5c8c8c3>>>"
                                                                      PAGE   4
                                                                      22 Sep 26
                                                                      13:59:25
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 02D7   0CA4            IF mt = 3 THEN tn$ = "<<<c3c3d-5d-5c3c3<b-5a-5>c3c3d-5e
                -5c3c3>>>"
 02FA   0CA4            IF tn$ = "" THEN tn$ = "<g8a8b-8b8<c8g8a8b-8a8a8b8a8>>"
 0319   0CA4            PLAY "MF"
 0322   0CA4            i = 1: shf = 0: skp = 0
 0322   0CA4            DO WHILE i <= LEN(tn$)
 0332   0CA4                    '----- gather octave shifts (and skip spaces) o
                nto the next note
 0332   0CA4                    nt$ = ""
 0332   0CA4                    DO WHILE i <= LEN(tn$)
 0350   0CA4                            ch$ = MID$(tn$, i, 1)
 0350   0CA4                            IF ch$ <> "<" AND ch$ <> ">" AND ch$ <>
                 " " THEN EXIT DO
 03CB   0CA4                            IF ch$ = "<" THEN nt$ = nt$ + ch$: shf 
                = shf + 1
 03F7   0CA4                            IF ch$ = ">" THEN nt$ = nt$ + ch$: shf 
                = shf - 1
 0423   0CA4                            i = i + 1
 0423   0CA4                    LOOP
 042A   0CA4                    IF i > LEN(tn$) THEN
 042A   0CA4                            IF nt$ <> "" THEN PLAY nt$: shf = 0
 045B   0CA4                            EXIT DO
 045B   0CA4                    END IF
 045E   0CA4                    '----- the note letter plus accidentals / lengt
                h digits / dots
 045E   0CA4                    nt$ = nt$ + MID$(tn$, i, 1): i = i + 1
 045E   0CA4                    DO WHILE i <= LEN(tn$)
 0486   0CA4                            ch$ = MID$(tn$, i, 1)
 0486   0CA4                            IF (ch$ < "0" OR ch$ > "9") AND ch$ <> 
                "+" AND ch$ <> "-" AND ch$ <> "#" AND ch$ <> "." THEN EXIT DO
 0552   0CA4                            nt$ = nt$ + ch$: i = i + 1
 0552   0CA4                    LOOP
 0570   0CA4                    PLAY nt$
 0579   0CA4                    '----- a key or click skips the rest of the dir
                ge
 0579   0CA4                    IF INKEY$ <> "" THEN skp = 1
 0592   0CA4                    IF skp = 0 AND msen = 1 THEN
 0592   0CA4                            mr.ax = 3: CALL INTERRUPT(mvint, mr, mo
                )
 05D4   0CA4                            IF (mo.bx AND 1) <> 0 THEN skp = 1
 05E6   0CA4                    END IF
 05E6   0CA4                    IF skp = 1 THEN
 05E6   0CA4                            IF shf > 0 THEN PLAY STRING$(shf, ">")
 060A   0CA4                            IF shf < 0 THEN PLAY STRING$(-shf, "<")
 0628   0CA4                            '----- signal the caller: the skip pres
                s also ends the death screen
 0628   0CA4                            mt = -1
 0628   0CA4                            EXIT DO
 0628   0CA4                    END IF
 0637   0CA4            LOOP
 063A   0CA4    END SUB
