 1D30   0384    
 1D30   0384    '----- derive cache slot acs's frame count. k frames interleave
                 word0 x k then
 1D30   0384    '----- height x k -- but when width*2 = height the leading-equa
                l count OVERSHOOTS
 1D30   0384    '----- (a 3x6 frame reads 6,6,6,6...). Validate candidates down
                ward: the k whose
 1D30   0384    '----- frame geometry exactly tiles the file wins; fall back to
                 the raw count.
 1D30   0384    SUB AnimK (acPct%(), acN%(), acs, kk%)
 1D3B   0384            kk% = 1
 1D3B   0384            anf% = acN%(acs)
 1D3B   0384            IF anf% < 2 THEN EXIT SUB
 1D68   0384            ld% = 0
 1D68   0384            DO WHILE ld% < anf%
 1D6E   0384                    IF acPct%(acs, ld% + 1) <> acPct%(acs, 1) THEN 
                EXIT DO
 1DCF   0384                    ld% = ld% + 1
 1DCF   0384            LOOP
 1DD4   0384            IF ld% < 1 THEN ld% = 1
 1DE2   0384            w0& = acPct%(acs, 1)
 1DE2   0384            IF w0& < 0 THEN w0& = w0& + 65536
 1E37   0384            FOR k% = ld% TO 1 STEP -1
 1E3E   0384                    IF (anf% MOD k%) = 0 THEN
 1E3E   0384                            h& = acPct%(acs, k% + 1)
 1E3E   0384                            IF h& < 0 THEN h& = h& + 65536
 1EA7   0384                            IF h& >= 1 AND h& <= 140 AND w0& >= 2 A
                ND w0& <= 280 THEN
 1EA7   0384                                    per& = 2 + INT((INT((w0& + 7) /
                 8) * h& + 1) / 2)
 1EA7   0384                                    IF per& * k% = anf% THEN kk% = 
                k%: EXIT SUB
 1F96   0384                            END IF
 1F96   0384                    END IF
 1F96   0384            NEXT
 1FA5   0384            kk% = ld%
 1FA5   0384    END SUB
