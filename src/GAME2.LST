                = 35
 1101   0CA4            IF r% = 4 THEN ob(52) = 2: ob(36) = 1: cn% = 36
 113E   0CA4            IF ob(32) = 1 AND ob(36) = 1 THEN ob(33) = 1
 119E   0CA4    END SUB
