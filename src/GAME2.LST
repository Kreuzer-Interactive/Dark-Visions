 065D   0CA4    '----- movement direction into a2$; any direction cancels a pen
                ding verb (vk2$)
 065D   0CA4    SUB JoyPoll (a2$, vk2$)
 0668   0CA4            DIM js0 AS SINGLE, js1 AS SINGLE
 0668   0CA4            IF jsen <> 1 THEN EXIT SUB
 067E   0CA4            js0 = STICK(0)
 067E   0CA4            js1 = STICK(1)
