 0DAF   0366    
 0DAF   0366    '----- parse an anim frames field like "0;1;2" into fsq(1..nfr2
                ) frame indices
 0DAF   0366    SUB AnimParse (s$, fsq%(), nfr2%)
 0DBA   0366            nfr2% = 0
 0DBA   0366            t$ = s$ + ";"
 0DBA   0366            sp% = 1
 0DBA   0366            FOR i% = 1 TO LEN(t$)
 0DEE   0366                    IF MID$(t$, i%, 1) = ";" THEN
 0DEE   0366                            IF i% > sp% AND nfr2% < 30 THEN
 0DEE   0366                                    nfr2% = nfr2% + 1
 0DEE   0366                                    fsq%(nfr2%) = VAL(MID$(t$, sp%,
                 i% - sp%))
 0DEE   0366                            END IF
 0E63   0366                            sp% = i% + 1
 0E63   0366                    END IF
 0E6A   0366            NEXT
 0E79   0366    END SUB
 0E8A   0366    
 0E8A   0366    '----- pause rate2*0.05s between animation frames (TIMER-based,
                 midnight-safe)
 0E8A   0366    SUB AnimWait (rate2)
 0E95   0366            t! = TIMER
 0E95   0366            DO
 0EA6   0366                    IF TIMER < t! THEN EXIT SUB
 0EC0   0366            LOOP WHILE TIMER < t! + rate2 * .05
 0EC0   0366    END SUB
