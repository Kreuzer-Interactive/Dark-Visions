                l count OVERSHOOTS
 0D72   0018    '----- (a 3x6 frame reads 6,6,6,6...). Validate candidates down
                ward: the k whose
 0D72   0018    '----- frame geometry exactly tiles the file wins; fall back to
                 the raw count.
 0D72   0018    SUB AnimK (acPct%(), acN%(), acs, kk%)
 0D7D   0018            kk% = 1
 0D7D   0018            anf% = acN%(acs)
 0D7D   0018            IF anf% < 2 THEN EXIT SUB
 0DAA   0018            ld% = 0
 0DAA   0018            DO WHILE ld% < anf%
 0DB0   0018                    IF acPct%(acs, ld% + 1) <> acPct%(acs, 1) THEN 
                EXIT DO
 0E11   0018                    ld% = ld% + 1
 0E11   0018            LOOP
 0E16   0018            IF ld% < 1 THEN ld% = 1
 0E24   0018            w0& = acPct%(acs, 1)
 0E24   0018            IF w0& < 0 THEN w0& = w0& + 65536
 0E79   0018            FOR k% = ld% TO 1 STEP -1
 0E80   0018                    IF (anf% MOD k%) = 0 THEN
 0E80   0018                            h& = acPct%(acs, k% + 1)
 0E80   0018                            IF h& < 0 THEN h& = h& + 65536
 0EE9   0018                            IF h& >= 1 AND h& <= 140 AND w0& >= 2 A
                ND w0& <= 280 THEN
 0EE9   0018                                    per& = 2 + INT((INT((w0& + 7) /
                 8) * h& + 1) / 2)
 0EE9   0018                                    IF per& * k% = anf% THEN kk% = 
                k%: EXIT SUB
 0FD8   0018                            END IF
 0FD8   0018                    END IF
 0FD8   0018            NEXT
 0FE7   0018            kk% = ld%
 0FE7   0018    END SUB
