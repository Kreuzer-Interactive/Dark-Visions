 0030   0006    
 0030   0006    '----- DeathMusic: play one of four random dirges, note by note
                 so a keypress
 0030   0006    '----- or mouse click skips the rest (octave shifts are rebalan
                ced on a skip
 0030   0006    '----- since the tunes rely on balanced <...> pairs)
 0030   0006    SUB DeathMusic
 0040   0366            DIM mr AS RegType, mo AS RegType
 0040   0366            DIM tn$, nt$, ch$
 0040   0366            DIM i AS INTEGER, shf AS INTEGER, skp AS INTEGER
 0040   0366            RANDOMIZE TIMER
 0040   0366            mt = INT(RND * 4)
 0040   0366            IF mt = 1 THEN tn$ = "<<<g-2g8a+8f+8e8d-3e4f+5f+5e-5e3>
                d2>>"
 0099   0366            IF mt = 2 THEN tn$ = "<<<d+8e-8<a8g8f3b8g8f+8e3g-2g8a8f
                +8e8d-3e4f+5c8c8c3>>>"
 00BC   0366            IF mt = 3 THEN tn$ = "<<<c3c3d-5d-5c3c3<b-5a-5>c3c3d-5e
                -5c3c3>>>"
 00DF   0366            IF tn$ = "" THEN tn$ = "<g8a8b-8b8<c8g8a8b-8a8a8b8a8>>"
 00FE   0366            PLAY "MF"
 0107   0366            i = 1: shf = 0: skp = 0
 0107   0366            DO WHILE i <= LEN(tn$)
 0116   0366                    '----- gather octave shifts (and skip spaces) o
                nto the next note
 0116   0366                    nt$ = ""
 0116   0366                    DO WHILE i <= LEN(tn$)
 0134   0366                            ch$ = MID$(tn$, i, 1)
 0134   0366                            IF ch$ <> "<" AND ch$ <> ">" AND ch$ <>
                 " " THEN EXIT DO
 01AF   0366                            IF ch$ = "<" THEN nt$ = nt$ + ch$: shf 
                = shf + 1
 01DB   0366                            IF ch$ = ">" THEN nt$ = nt$ + ch$: shf 
                = shf - 1
 0207   0366                            i = i + 1
 0207   0366                    LOOP
 020E   0366                    IF i > LEN(tn$) THEN
 020E   0366                            IF nt$ <> "" THEN PLAY nt$: shf = 0
 023F   0366                            EXIT DO
 023F   0366                    END IF
 0242   0366                    '----- the note letter plus accidentals / lengt
                h digits / dots
 0242   0366                    nt$ = nt$ + MID$(tn$, i, 1): i = i + 1
 0242   0366                    DO WHILE i <= LEN(tn$)
 026A   0366                            ch$ = MID$(tn$, i, 1)
 026A   0366                            IF (ch$ < "0" OR ch$ > "9") AND ch$ <> 
                "+" AND ch$ <> "-" AND ch$ <> "#" AND ch$ <> "." THEN EXIT DO
 0336   0366                            nt$ = nt$ + ch$: i = i + 1
 0336   0366                    LOOP
 0354   0366                    PLAY nt$
 035D   0366                    '----- a key or click skips the rest of the dir
                ge
 035D   0366                    IF INKEY$ <> "" THEN skp = 1
 0376   0366                    IF skp = 0 AND msen = 1 THEN
                                                                      PAGE   3
                                                                      11 Aug 26
                                                                      16:32:45
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 0376   0366                            mr.ax = 3: CALL INTERRUPT(mvint, mr, mo
                )
 03B8   0366                            IF (mo.bx AND 1) <> 0 THEN skp = 1
 03CA   0366                    END IF
 03CA   0366                    IF skp = 1 THEN
 03CA   0366                            IF shf > 0 THEN PLAY STRING$(shf, ">")
 03EE   0366                            IF shf < 0 THEN PLAY STRING$(-shf, "<")
 040C   0366                            '----- signal the caller: the skip pres
                s also ends the death screen
 040C   0366                            mt = -1
 040C   0366                            EXIT DO
 040C   0366                    END IF
 041B   0366            LOOP
 041E   0366    END SUB
 0441   0366    
 0441   0366    '----- joystick poll (moved from GAME.BAS -- 64K ceiling): read
                 STICK, set the
 0441   0366    '----- movement direction into a2$; any direction cancels a pen
                ding verb (vk2$)
 0441   0366    SUB JoyPoll (a2$, vk2$)
 044C   0366            DIM js0 AS SINGLE, js1 AS SINGLE
 044C   0366            IF jsen <> 1 THEN EXIT SUB
 0462   0366            js0 = STICK(0)
 0462   0366            js1 = STICK(1)
 0462   0366            IF js1 = 0# AND js0 = 0 THEN EXIT SUB
 04C0   0366            IF js0 < 40 THEN a2$ = "4"
 04E1   0366            IF js0 > 120 THEN a2$ = "6"
 0502   0366            IF js1 < 40 THEN a2$ = "8"
 0523   0366            IF js1 > 120 THEN a2$ = "2"
 0544   0366            IF js1 < 40 AND js0 > 120 THEN a2$ = "9"
 0587   0366            IF js1 < 40 AND js0 < 40 THEN a2$ = "7"
 05CA   0366            IF js0 > 120 AND js1 > 120 THEN a2$ = "3"
 060D   0366            IF js0 < 40 AND js1 > 120 THEN a2$ = "1"
 0650   0366            IF LEN(a2$) = 1 THEN
 0650   0366                    IF INSTR("123456789", a2$) > 0 THEN vk2$ = ""
 067F   0366            END IF
 067F   0366    END SUB
