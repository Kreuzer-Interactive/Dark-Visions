 0C5B   0006                    IF k$ = "L" THEN
 0C5B   0006                            IF cic = 0 OR (INT(isel) MOD 4) = 0 THE
                N nvz = 1 ELSE isel = isel - 1: act% = 1
 0D04   0006                    ELSEIF k$ = "R" THEN
 0D07   0006                            IF (INT(isel) MOD 4) < 3 AND isel + 1 <
                 cic THEN isel = isel + 1: act% = 1
 0D84   0006                    ELSEIF k$ = "U" THEN
 0D87   0006                            IF isel - 4 >= 0 THEN isel = isel - 4: 
                act% = 1 ELSE nvz = 1
 0DD8   0006                    ELSEIF k$ = "D" THEN
 0DDB   0006                            IF isel + 4 < cic THEN isel = isel + 4:
                 act% = 1 ELSE nvz = 2
 0E2D   0006                    ELSEIF k$ = "E" THEN
 0E30   0006                            IF invtab = 1 THEN act% = 7 ELSE act% =
