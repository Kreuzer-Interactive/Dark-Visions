 0030   0006    '----- GAME2.BAS: secondary module for the multi-module split (
                sound effects)
 0030   0006    '----- gets its own 64K code segment; shares scalars with GAME.
                BAS via COMMON SHARED.
 0030   0006    '----- The COMMON SHARED line below MUST match GAME.BAS exactly
                 (same names + order).
 0030   0006    TYPE RegType
 0030   0006            ax AS INTEGER
 0030   0006            bx AS INTEGER
 0030   0006            cx AS INTEGER
 0030   0006            dx AS INTEGER
 0030   0006            bp AS INTEGER
 0030   0006            si AS INTEGER
 0030   0006            di AS INTEGER
 0030   0006            flags AS INTEGER
 0030   0006            ds AS INTEGER
 0030   0006            es AS INTEGER
 0030   0006    END TYPE
 0030   0006    DECLARE SUB INTERRUPT (intnum AS INTEGER, inreg AS RegType, out
                reg AS RegType)
 0030   0006    COMMON SHARED f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, sa, sb, 
                sc, mt, sfps, fpsc, fpst, jsen, inon, msen, snr, exsen, mxyon, 
                nfon, hzon$, klon, wksen, qkon, rvon
 0030   0006    COMMON SHARED mcur AS INTEGER, mvint AS INTEGER
 0030   0006    
 0030   0006    '----- DeathMusic: play one of four random dirges, note by note
                 so a keypress
 0030   0006    '----- or mouse click skips the rest (octave shifts are rebalan
                ced on a skip
 0030   0006    '----- since the tunes rely on balanced <...> pairs)
 0030   0006    SUB DeathMusic
 0040   0006            DIM mr AS RegType, mo AS RegType
 0040   0006            DIM tn$, nt$, ch$
 0040   0006            DIM i AS INTEGER, shf AS INTEGER, skp AS INTEGER
 0040   0006            RANDOMIZE TIMER
 0040   0006            mt = INT(RND * 4)
 0040   0006            IF mt = 1 THEN tn$ = "<<<g-2g8a+8f+8e8d-3e4f+5f+5e-5e3>
                d2>>"
 0099   0006            IF mt = 2 THEN tn$ = "<<<d+8e-8<a8g8f3b8g8f+8e3g-2g8a8f
                +8e8d-3e4f+5c8c8c3>>>"
 00BC   0006            IF mt = 3 THEN tn$ = "<<<c3c3d-5d-5c3c3<b-5a-5>c3c3d-5e
                -5c3c3>>>"
 00DF   0006            IF tn$ = "" THEN tn$ = "<g8a8b-8b8<c8g8a8b-8a8a8b8a8>>"
 00FE   0006            PLAY "MF"
 0107   0006            i = 1: shf = 0: skp = 0
 0107   0006            DO WHILE i <= LEN(tn$)
 0116   0006                    '----- gather octave shifts (and skip spaces) o
                nto the next note
 0116   0006                    nt$ = ""
 0116   0006                    DO WHILE i <= LEN(tn$)
 0134   0006                            ch$ = MID$(tn$, i, 1)
 0134   0006                            IF ch$ <> "<" AND ch$ <> ">" AND ch$ <>
                 " " THEN EXIT DO
 01AF   0006                            IF ch$ = "<" THEN nt$ = nt$ + ch$: shf 
                                                                      PAGE   2
                                                                      02 Aug 26
                                                                      13:38:35
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

                = shf + 1
 01DB   0006                            IF ch$ = ">" THEN nt$ = nt$ + ch$: shf 
                = shf - 1
 0207   0006                            i = i + 1
 0207   0006                    LOOP
 020E   0006                    IF i > LEN(tn$) THEN
 020E   0006                            IF nt$ <> "" THEN PLAY nt$: shf = 0
 023F   0006                            EXIT DO
 023F   0006                    END IF
 0242   0006                    '----- the note letter plus accidentals / lengt
                h digits / dots
 0242   0006                    nt$ = nt$ + MID$(tn$, i, 1): i = i + 1
 0242   0006                    DO WHILE i <= LEN(tn$)
 026A   0006                            ch$ = MID$(tn$, i, 1)
 026A   0006                            IF (ch$ < "0" OR ch$ > "9") AND ch$ <> 
                "+" AND ch$ <> "-" AND ch$ <> "#" AND ch$ <> "." THEN EXIT DO
 0336   0006                            nt$ = nt$ + ch$: i = i + 1
 0336   0006                    LOOP
 0354   0006                    PLAY nt$
 035D   0006                    '----- a key or click skips the rest of the dir
                ge
 035D   0006                    IF INKEY$ <> "" THEN skp = 1
 0376   0006                    IF skp = 0 AND msen = 1 THEN
 0376   0006                            mr.ax = 3: CALL INTERRUPT(mvint, mr, mo
                )
 03B8   0006                            IF (mo.bx AND 1) <> 0 THEN skp = 1
 03CA   0006                    END IF
 03CA   0006                    IF skp = 1 THEN
 03CA   0006                            IF shf > 0 THEN PLAY STRING$(shf, ">")
 03EE   0006                            IF shf < 0 THEN PLAY STRING$(-shf, "<")
 040C   0006                            '----- signal the caller: the skip pres
                s also ends the death screen
 040C   0006                            mt = -1
 040C   0006                            EXIT DO
 040C   0006                    END IF
 041B   0006            LOOP
 041E   0006    END SUB
