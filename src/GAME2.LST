 210A   0024                                    FOR j% = 1 TO LEN(w$)
 2180   0024                                            c$ = MID$(w$, j%, 1)
 2180   0024                                            IF c$ = "u" THEN dy% = 
                dy% - 1
 21AF   0024                                            IF c$ = "d" THEN dy% = 
                dy% + 1
 21C4   0024                                            IF c$ = "l" THEN dx% = 
                dx% - 1
 21D9   0024                                            IF c$ = "r" THEN dx% = 
                dx% + 1
 21EE   0024                                            IF c$ >= "0" AND c$ <= 
                "9" THEN rp% = rp% * 10 + VAL(c$)
 2244   0024                                    NEXT
 2253   0024                                    IF rp% < 1 THEN rp% = 1
 2261   0024                                    FOR j% = 1 TO rp%
 226E   0024                                            IF mn% < 60 THEN mn% = 
                mn% + 1: mdx%(mn%) = dx%: mdy%(mn%) = dy%
 22A1   0024                                    NEXT
 22AD   0024                            END IF
 22AD   0024                    END IF
 22AD   0024            NEXT
