 04EF   0006    '----- create/read dark.ini settings (showfps, joystick)
 04EF   0006    SUB LoadConfig
 04FA   0006            CLOSE
 04FA   0006            OPEN "dark.ini" FOR APPEND AS #1
 04FA   0006            IF LOF(1) = 0 THEN
 04FA   0006                    PRINT #1, "; Dark Visions settings"
 04FA   0006                    PRINT #1, "; showfps=1 shows main loop speed to
                p right + intro pace"
 04FA   0006                    PRINT #1, "showfps=0"
 04FA   0006                    PRINT #1, "; joystick=1 enables joystick/gamepa
                d control (off avoids stray input)"
 04FA   0006                    PRINT #1, "joystick=0"
 04FA   0006                    PRINT #1, "; mouse=1 enables mouse cursor + har
                dware pointer (needs a mouse driver)"
 04FA   0006                    PRINT #1, "mouse=0"
 04FA   0006                    PRINT #1, "; mousecursor: 0 driver default, 1 a
                rrow, 2 crosshair, 3 box, 4 crosshair(xor)"
 04FA   0006                    PRINT #1, "mousecursor=1"
 04FA   0006                    PRINT #1, "; mousesnap: click pulls to nearest 
                hotspot within N pixels (0=off/exact)"
 04FA   0006                    PRINT #1, "mousesnap=6"
 04FA   0006                    PRINT #1, "; exitcursor=1 changes the pointer t
                o a direction arrow near room exits"
 04FA   0006                    PRINT #1, "exitcursor=1"
 04FA   0006                    PRINT #1, "; mousexy=1 shows live mouse x,y + s
                napped hit point bottom row (debug; needs mouse=1)"
 04FA   0006                    PRINT #1, "mousexy=0"
 04FA   0006                    PRINT #1, "; lookmiss=1 shows a random 'nothing
                 to see' line after looking 3x at an empty spot"
 04FA   0006                    PRINT #1, "lookmiss=1"
 04FA   0006                    PRINT #1, "; intro=1 plays the opening cutscene
