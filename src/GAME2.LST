 20C4   0024    
 20C4   0024    '----- parse a move-anim script into 1px step arrays (max 60 st
                eps).
 20C4   0024    '----- Tokens split on ";": letters u/d/l/r combine into a dire
                ction (ul = up-left),
 20C4   0024    '----- a trailing number repeats it ("ul5"); "p" (no direction 
                letters) = a pause
 20C4   0024    '----- step in place ("p6" holds 6 steps). Example: "u;d;u;d;u;
                d;p6;ul5;dr2"
 20C4   0024    SUB MovParse (s$, mdx%(), mdy%(), mn%, bx1%, by1%, bx2%, by2%)
 20CF   0024            mn% = 0
 20CF   0024            t$ = LCASE$(s$) + ";"
 20CF   0024            sp% = 1
 20CF   0024            FOR i% = 1 TO LEN(t$)
 210A   0024                    IF MID$(t$, i%, 1) = ";" THEN
 210A   0024                            w$ = MID$(t$, sp%, i% - sp%)
 210A   0024                            sp% = i% + 1
 210A   0024                            IF w$ <> "" THEN
 210A   0024                                    dx% = 0: dy% = 0: rp% = 0
