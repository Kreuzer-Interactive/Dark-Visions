 0A45   0366    
 0A45   0366    '----- debug readout (moved from GAME.BAS -- 64K ceiling): raw 
                mouse xy, snapped hit
 0A45   0366    '----- point, and the object+verb a click here resolves to
 0A45   0366    SUB MxyTick (mx%, my%, bx, ay, snr2, ox%(), oy%(), oi%(), ky$()
                )
 0A50   0366            oi2% = 0
 0A50   0366            mind% = snr2 * snr2 + 1
 0A50   0366            FOR i% = 1 TO 257
 0A72   0366                    IF oy%(i%) = 0 THEN EXIT FOR
 0A8A   0366                    dx% = mx% - ox%(i%)
 0A8A   0366                    dy% = my% - oy%(i%)
 0A8A   0366                    IF ABS(dx%) <= snr2 AND ABS(dy%) <= snr2 THEN
 0A8A   0366                            dd% = dx% * dx% + dy% * dy%
 0A8A   0366                            IF dd% < mind% THEN mind% = dd%: oi2% =
                 oi%(i%)
 0B3A   0366                    END IF
 0B3A   0366            NEXT
 0B49   0366            v$ = "-"
 0B49   0366            IF oi2% >= 1 AND oi2% <= 25 THEN v$ = ky$(oi2%)
 0B8A   0366            IF v$ = "" THEN v$ = "-"
 0BA9   0366            LOCATE 24, 1
 0BA9   0366            PRINT USING "mxy ### ### hit ### ### obj ## v="; mx%; m
                y%; bx; ay; oi2%;
 0BA9   0366            PRINT v$; "  ";
 0BA9   0366    END SUB
