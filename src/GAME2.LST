 2219   0CC2            CALL AnimK(acPct%(), acN%(), acs, kk%)
 222B   0CC2            w% = acPct%(acs, 1) \ 2
 222B   0CC2            h% = acPct%(acs, kk% + 1)
 222B   0CC2            IF w% < 1 OR h% < 1 THEN EXIT SUB
 229F   0CC2            '----- any shape is fine as long as the region fits a 2
                10-int save-under slot
 229F   0CC2            IF ((w% * 2 + 7) \ 8) * h% > 416 THEN EXIT SUB
 22B8   0CC2            adw = w%: adh = h%
 22B8   0CC2    END SUB
