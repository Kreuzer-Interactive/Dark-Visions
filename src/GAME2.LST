 04E1   0006            IF js0 > 120 THEN a2$ = "6"
 0502   0006            IF js1 < 40 THEN a2$ = "8"
 0523   0006            IF js1 > 120 THEN a2$ = "2"
 0544   0006            IF js1 < 40 AND js0 > 120 THEN a2$ = "9"
 0587   0006            IF js1 < 40 AND js0 < 40 THEN a2$ = "7"
