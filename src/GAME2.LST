 2AB2   0418    SUB LoadConfig
 2ABD   0418            CLOSE
 2ABD   0418            OPEN "dark.ini" FOR APPEND AS #1
 2ABD   0418            IF LOF(1) = 0 THEN
 2ABD   0418                    PRINT #1, "; Dark Visions settings"
 2ABD   0418                    PRINT #1, "; showfps=1 shows main loop speed to
                p right + intro pace"
 2ABD   0418                    PRINT #1, "showfps=0"
 2ABD   0418                    PRINT #1, "; joystick=1 enables joystick/gamepa
                d control (off avoids stray input)"
 2ABD   0418                    PRINT #1, "joystick=0"
 2ABD   0418                    PRINT #1, "; mouse=1 enables mouse cursor + har
                dware pointer (needs a mouse driver)"
 2ABD   0418                    PRINT #1, "mouse=0"
 2ABD   0418                    PRINT #1, "; mousecursor: 0 driver default, 1 a
                rrow, 2 crosshair, 3 box, 4 crosshair(xor)"
 2ABD   0418                    PRINT #1, "mousecursor=1"
 2ABD   0418                    PRINT #1, "; mousesnap: click pulls to nearest 
                hotspot within N pixels (0=off/exact)"
 2ABD   0418                    PRINT #1, "mousesnap=6"
 2ABD   0418                    PRINT #1, "; exitcursor=1 changes the pointer t
                o a direction arrow near room exits"
 2ABD   0418                    PRINT #1, "exitcursor=1"
 2ABD   0418                    PRINT #1, "; mousexy=1 shows live mouse x,y + s
                napped hit point bottom row (debug; needs mouse=1)"
 2ABD   0418                    PRINT #1, "mousexy=0"
 2ABD   0418                    PRINT #1, "; lookmiss=1 shows a random 'nothing
                 to see' line after looking 3x at an empty"
 2ABD   0418                    PRINT #1, "; spot, and a random 'that doesn't w
                ork' line when a use action does nothing"
 2ABD   0418                    PRINT #1, "lookmiss=1"
 2ABD   0418                    PRINT #1, "; killers=0 turns off the roaming ki
                llers (for testing; scripted deaths still happen)"
 2ABD   0418                    PRINT #1, "killers=1"
 2ABD   0418                    PRINT #1, "; walkto=1 walks the player over to 
                an item before get/use actions fire (0=instant, as the original
                )"
 2ABD   0418                    PRINT #1, "walkto=1"
