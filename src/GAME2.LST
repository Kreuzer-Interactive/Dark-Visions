 35CA   00B8            IF lxs% = 0 AND lys% = -1 THEN d2$ = "8"
 35F3   00B8            IF lxs% = 1 AND lys% = -1 THEN d2$ = "9"
 361C   00B8            IF lxs% = -1 AND lys% = 0 THEN d2$ = "4"
 3645   00B8            IF lxs% = 1 AND lys% = 0 THEN d2$ = "6"
 366E   00B8            IF lxs% = -1 AND lys% = 1 THEN d2$ = "1"
 3697   00B8            IF lxs% = 1 AND lys% = 1 THEN d2$ = "3"
