                pst ride in COMMON
 1A98   0CB0    SUB FpsTick
 1AA3   0CB0            fpsc = fpsc + 1
 1AA3   0CB0            fd! = TIMER - fpst
 1AA3   0CB0            IF fd! < 0 OR fd! >= 2 THEN
 1AA3   0CB0                    fpst = TIMER
 1AA3   0CB0                    fpsc = 0
 1AA3   0CB0            ELSEIF fd! >= 1 THEN
 1B20   0CB0                    fv! = fpsc / fd!
 1B20   0CB0                    IF fv! > 99999 THEN fv! = 99999
 1B64   0CB0                    LOCATE 1, 35
 1B64   0CB0                    PRINT USING "#####"; fv!;
 1B64   0CB0                    fpst = TIMER
 1B64   0CB0                    fpsc = 0
