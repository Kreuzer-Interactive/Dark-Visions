 10A6   0CA4    '----- pause rate2*0.05s between animation frames (TIMER-based,
                 midnight-safe)
 10A6   0CA4    SUB AnimWait (rate2)
 10B1   0CA4            t! = TIMER
 10B1   0CA4            DO
 10C2   0CA4                    IF TIMER < t! THEN EXIT SUB
 10DC   0CA4            LOOP WHILE TIMER < t! + rate2 * .05
 10DC   0CA4    END SUB
 1106   0CA4    
 1106   0CA4    '----- inventory combine: which recipe do items s% (top) + c% (
                bottom) match? 0 = none.
 1106   0CA4    '----- 1: 18+28 -> 22 � 2: formula halves 11+24 -> unreadable
                 52 � 4: 52 + book 25 ->
 1106   0CA4    '----- complete formula 36 � 3: syringe 29 + drug 34 -> loade
                d syringe 35
 1106   0CA4    SUB CombChk (s%, c%, r%)
 1111   0CA4            r% = 0
 1111   0CA4            IF (s% = 18 AND c% = 28) OR (s% = 28 AND c% = 18) THEN 
                r% = 1
 1156   0CA4            IF (s% = 11 AND c% = 24) OR (s% = 24 AND c% = 11) THEN 
                r% = 2
 1194   0CA4            IF (s% = 52 AND c% = 25) OR (s% = 25 AND c% = 52) THEN 
                r% = 4
 11D2   0CA4            IF (s% = 29 AND c% = 34) OR (s% = 34 AND c% = 29) THEN 
                r% = 3
 1210   0CA4    END SUB
 1218   0CA4    
 1218   0CA4    '----- apply combine recipe r%: swap the ingredient ob() flags 
                for the result, and
 1218   0CA4    '----- re-derive 33 (ready to mix) since 36 may just have appea
                red
 1218   0CA4    SUB CombDo2 (r%, ob(), cn%)
 1223   0CA4            '----- ingredients become state 2 ("used up"): out of t
                he inventory but
 1223   0CA4            '----- still counting as taken, so their pickup spots n
                ever re-arm
 1223   0CA4            cn% = 0
 1223   0CA4            IF r% = 1 THEN ob(18) = 2: ob(28) = 2: ob(22) = 1: cn% 
                = 22
 127B   0CA4            IF r% = 2 THEN ob(24) = 2: ob(11) = 2: ob(52) = 1: cn% 
