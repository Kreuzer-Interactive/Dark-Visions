 0441   0CA4    
 0441   0CA4    '----- joystick poll (moved from GAME.BAS -- 64K ceiling): read
                 STICK, set the
 0441   0CA4    '----- movement direction into a2$; any direction cancels a pen
                ding verb (vk2$)
 0441   0CA4    SUB JoyPoll (a2$, vk2$)
 044C   0CA4            DIM js0 AS SINGLE, js1 AS SINGLE
 044C   0CA4            IF jsen <> 1 THEN EXIT SUB
 0462   0CA4            js0 = STICK(0)
 0462   0CA4            js1 = STICK(1)
 0462   0CA4            IF js1 = 0# AND js0 = 0 THEN EXIT SUB
 04C0   0CA4            IF js0 < 40 THEN a2$ = "4"
 04E1   0CA4            IF js0 > 120 THEN a2$ = "6"
 0502   0CA4            IF js1 < 40 THEN a2$ = "8"
 0523   0CA4            IF js1 > 120 THEN a2$ = "2"
 0544   0CA4            IF js1 < 40 AND js0 > 120 THEN a2$ = "9"
 0587   0CA4            IF js1 < 40 AND js0 < 40 THEN a2$ = "7"
 05CA   0CA4            IF js0 > 120 AND js1 > 120 THEN a2$ = "3"
 060D   0CA4            IF js0 < 40 AND js1 > 120 THEN a2$ = "1"
 0650   0CA4            IF LEN(a2$) = 1 THEN
 0650   0CA4                    IF INSTR("123456789", a2$) > 0 THEN vk2$ = ""
 067F   0CA4            END IF
 067F   0CA4    END SUB
