 0030   0006    '----- GAME2.BAS: secondary module for the multi-module split (
                sound effects)
 0030   0006    '----- gets its own 64K code segment; shares scalars with GAME.
                BAS via COMMON SHARED.
 0030   0006    '----- The COMMON SHARED line below MUST match GAME.BAS exactly
                 (same names + order).
 0030   0006    TYPE RegType
 0030   0006            ax AS INTEGER
 0030   0006            bx AS INTEGER
 0030   0006            cx AS INTEGER
 0030   0006            dx AS INTEGER
 0030   0006            bp AS INTEGER
 0030   0006            si AS INTEGER
 0030   0006            di AS INTEGER
 0030   0006            flags AS INTEGER
 0030   0006            ds AS INTEGER
 0030   0006            es AS INTEGER
 0030   0006    END TYPE
 0030   0006    DECLARE SUB INTERRUPT (intnum AS INTEGER, inreg AS RegType, out
                reg AS RegType)
 0030   0006    COMMON SHARED f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, sa, sb, 
                sc, mt, sfps, fpsc, fpst, jsen, inon, msen, snr, exsen, mxyon, 
                nfon, hzon$, klon, wksen, qkon, rvon
 0030   0006    COMMON SHARED mcur AS INTEGER, mvint AS INTEGER
 0030   0006    DECLARE SUB KillChk (q2$, w!, h9b!, t1b!, t2b!, t3b!, f3b!, kw%
                )
 0030   0006    
 0030   0006    '----- shadow-door (room2 west wall): warning light + pacing si
                lhouette, gated
 0030   0006    '----- on the killer-schedule lookahead ("would walking through
                 this door kill
 0030   0006    '----- me"). Data = SHADW2.PAC (tools\build_shadow_art.ps1): 7 
                GET blocks in
 0030   0006    '----- one packed pool -- each keeps its own w*2/h PUT header, 
                so drawing is
 0030   0006    '----- PUT (x, y), sdwDat(offset). Static module array: seconda
                ry modules never
 0030   0006    '----- run module-level code, so a REDIM here would never execu
                te.
 0030   0006    DIM SHARED sdwDat(400) AS INTEGER
 0030   0006    DIM SHARED sdwOn AS INTEGER, sdwHave AS INTEGER, sdwArm AS INTE
                GER, sdwWant AS INTEGER
 0030   0006    DIM SHARED sdwODr AS INTEGER, sdwOId AS INTEGER, sdwOLt AS INTE
                GER, sdwOKp AS INTEGER
 0030   0006    DIM SHARED sdwOBg AS INTEGER, sdwOSR AS INTEGER, sdwOSL AS INTE
                GER
 0030   0006    DIM SHARED sdwTX AS INTEGER, sdwTY AS INTEGER, sdwTW AS INTEGER
                , sdwTH AS INTEGER
 0030   0006    DIM SHARED sdwDX AS INTEGER, sdwDY AS INTEGER, sdwSW AS INTEGER
                , sdwSH AS INTEGER
 0030   0006    DIM SHARED sdwX AS INTEGER, sdwDir AS INTEGER, sdwBob AS INTEGE
                R, sdwXMx AS INTEGER
 0030   0006    DIM SHARED sdwY AS INTEGER, sdwMode AS INTEGER, sdwAx AS INTEGE
                R, sdwDp AS INTEGER
