 0EEA   0366    '----- inventory combine: which recipe do items s% (top) + c% (
                bottom) match? 0 = none.
 0EEA   0366    '----- 1: 18+28 -> 22 � 2: formula halves 11+24 -> unreadable
                 52 � 4: 52 + book 25 ->
 0EEA   0366    '----- complete formula 36 � 3: syringe 29 + drug 34 -> loade
                d syringe 35
 0EEA   0366    SUB CombChk (s%, c%, r%)
 0EF5   0366            r% = 0
 0EF5   0366            IF (s% = 18 AND c% = 28) OR (s% = 28 AND c% = 18) THEN 
                r% = 1
 0F3A   0366            IF (s% = 11 AND c% = 24) OR (s% = 24 AND c% = 11) THEN 
                r% = 2
 0F78   0366            IF (s% = 52 AND c% = 25) OR (s% = 25 AND c% = 52) THEN 
                r% = 4
