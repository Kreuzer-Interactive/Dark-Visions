 4796   0418            END IF
 479F   0418            IF sdwArm = 0 THEN EXIT SUB
 47A9   0418            IF TIMER < sdwNxt - 5 THEN sdwNxt = TIMER
 47DA   0418            IF TIMER < sdwNxt THEN EXIT SUB
 47F5   0418            sdwNxt = TIMER + .12
 47F5   0418            IF sdwMode = 0 THEN
 47F5   0418                    '----- entry: slide out from behind the door, l
                eft to right along the
 47F5   0418                    '----- pool's bottom row, with the 1px bob; han
                d off at the anchor
 47F5   0418                    sdwX = sdwX + 1
 47F5   0418                    sdwBob = 1 - sdwBob
 47F5   0418                    sdwY = sdwTY + sdwTH - sdwSH - 1 - sdwBob
 47F5   0418                    IF sdwX >= sdwAx THEN
 47F5   0418                            sdwX = sdwAx: sdwY = sdwTY + sdwTH - sd
                wSH - 1
 47F5   0418                            sdwMode = 1: sdwDir = 1: sdwBob = 0
 47F5   0418                            sdwNxt = TIMER + .4 + RND * .6
 47F5   0418                    END IF
 488F   0418            ELSE
 4892   0418                    '----- pacing ALONG the wall as stair-steps -- 
                one tick moves x, the
 4892   0418                    '----- next moves y (right,up,... going out; do
                wn,left,... coming
