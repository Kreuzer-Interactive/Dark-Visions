 32F7   00B8    '----- GAME.BAS -- 64K code ceiling). ovh=1 when a mask exists;
                 ovnext = next
 32F7   00B8    '----- free element (by ref).
 32F7   00B8    SUB OvReg (ovf%(), afrm%(), amfrm%(), anpf!, ovh!, ovnext!, PX!
                , PY!)
 3302   00B8            IF ovf%(0) >= 4 THEN EXIT SUB
 3318   00B8            IF ovnext! + anpf! * 2 > 1500 THEN EXIT SUB
 333A   00B8            ovf%(0) = ovf%(0) + 1
 333A   00B8            ovb% = 1 + (ovf%(0) - 1) * 4
 333A   00B8            ovf%(ovb%) = PX!: ovf%(ovb% + 1) = PY!
 333A   00B8            ovf%(ovb% + 2) = ovnext!
 333A   00B8            ovf%(ovb% + 3) = 0
 333A   00B8            FOR aj% = 0 TO anpf! - 1: ovf%(ovnext! + aj%) = afrm%(a
                j%): NEXT
 3429   00B8            ovnext! = ovnext! + anpf!
 3429   00B8            IF ovh! = 1 THEN
 3429   00B8                    ovf%(ovb% + 3) = ovnext!
 3429   00B8                    FOR aj% = 0 TO anpf! - 1: ovf%(ovnext! + aj%) =
                 amfrm%(aj%): NEXT
 34CB   00B8                    ovnext! = ovnext! + anpf!
 34CB   00B8            END IF
 34DC   00B8    END SUB
 34E4   00B8    '----- LookDir: 8-way facing digit from the player's eyes (px+1
