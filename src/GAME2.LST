 0859   0006    '----- parse an anim frames field like "0;1;2" into fsq(1..nfr2
                ) frame indices
 0859   0006    SUB AnimParse (s$, fsq%(), nfr2%)
 0864   0006            nfr2% = 0
 0864   0006            t$ = s$ + ";"
 0864   0006            sp% = 1
 0864   0006            FOR i% = 1 TO LEN(t$)
 0898   0006                    IF MID$(t$, i%, 1) = ";" THEN
 0898   0006                            IF i% > sp% AND nfr2% < 30 THEN
 0898   0006                                    nfr2% = nfr2% + 1
 0898   0006                                    fsq%(nfr2%) = VAL(MID$(t$, sp%,
                 i% - sp%))
 0898   0006                            END IF
 090D   0006                            sp% = i% + 1
 090D   0006                    END IF
 0914   0006            NEXT
 0923   0006    END SUB
