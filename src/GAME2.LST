 0A22   0006            IF (s% = 52 AND c% = 25) OR (s% = 25 AND c% = 52) THEN 
                r% = 4
 0A60   0006            IF (s% = 29 AND c% = 34) OR (s% = 34 AND c% = 29) THEN 
                r% = 3
 0A9E   0006    END SUB
 0AA6   0006    
 0AA6   0006    '----- apply combine recipe r%: swap the ingredient ob() flags 
                for the result, and
 0AA6   0006    '----- re-derive 33 (ready to mix) since 36 may just have appea
                red
 0AA6   0006    SUB CombDo2 (r%, ob(), cn%)
 0AB1   0006            cn% = 0
 0AB1   0006            IF r% = 1 THEN ob(18) = 0: ob(28) = 0: ob(22) = 1: cn% 
                = 22
 0B09   0006            IF r% = 2 THEN ob(24) = 0: ob(11) = 0: ob(52) = 1: cn% 
                = 52
 0B5A   0006            IF r% = 3 THEN ob(29) = 0: ob(34) = 0: ob(35) = 1: cn% 
                = 35
 0BAB   0006            IF r% = 4 THEN ob(52) = 0: ob(36) = 1: cn% = 36
 0BE8   0006            IF ob(32) = 1 AND ob(36) = 1 THEN ob(33) = 1
 0C48   0006    END SUB
