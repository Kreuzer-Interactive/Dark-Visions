 13BF   0366                    END IF
 13BF   0366            ELSEIF nvz = 1 THEN
 13C2   0366                    IF k$ = "L" THEN
 13C2   0366                            IF invtab = 1 THEN invtab = 0: act% = 2
 1412   0366                    ELSEIF k$ = "R" THEN
 1415   0366                            IF invtab = 0 THEN invtab = 1: act% = 2
