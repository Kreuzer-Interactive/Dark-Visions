 1D30   0CC2    
 1D30   0CC2    '----- derive cache slot acs's frame count. k frames interleave
                 word0 x k then
 1D30   0CC2    '----- height x k -- but when width*2 = height the leading-equa
                l count OVERSHOOTS
 1D30   0CC2    '----- (a 3x6 frame reads 6,6,6,6...). Validate candidates down
                ward: the k whose
 1D30   0CC2    '----- frame geometry exactly tiles the file wins; fall back to
                 the raw count.
 1D30   0CC2    SUB AnimK (acPct%(), acN%(), acs, kk%)
 1D3B   0CC2            kk% = 1
 1D3B   0CC2            anf% = acN%(acs)
 1D3B   0CC2            IF anf% < 2 THEN EXIT SUB
 1D68   0CC2            ld% = 0
 1D68   0CC2            DO WHILE ld% < anf%
 1D6E   0CC2                    IF acPct%(acs, ld% + 1) <> acPct%(acs, 1) THEN 
                EXIT DO
 1DCF   0CC2                    ld% = ld% + 1
 1DCF   0CC2            LOOP
 1DD4   0CC2            IF ld% < 1 THEN ld% = 1
 1DE2   0CC2            w0& = acPct%(acs, 1)
 1DE2   0CC2            IF w0& < 0 THEN w0& = w0& + 65536
 1E37   0CC2            FOR k% = ld% TO 1 STEP -1
 1E3E   0CC2                    IF (anf% MOD k%) = 0 THEN
 1E3E   0CC2                            h& = acPct%(acs, k% + 1)
 1E3E   0CC2                            IF h& < 0 THEN h& = h& + 65536
 1EA7   0CC2                            IF h& >= 1 AND h& <= 140 AND w0& >= 2 A
                ND w0& <= 280 THEN
 1EA7   0CC2                                    per& = 2 + INT((INT((w0& + 7) /
                 8) * h& + 1) / 2)
 1EA7   0CC2                                    IF per& * k% = anf% THEN kk% = 
                k%: EXIT SUB
 1F96   0CC2                            END IF
 1F96   0CC2                    END IF
 1F96   0CC2            NEXT
 1FA5   0CC2            kk% = ld%
 1FA5   0CC2    END SUB
