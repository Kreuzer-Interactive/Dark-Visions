                 <> 0) + "  1 page:" + STR$(r2 <> 0) + "  (-1 = ok, 0 = refused
                )"
 0665   0038            END IF
 06BC   0038            '----- EMS driver present? (INT 67h vector -> device he
                ader "EMMXXXX0")
 06BC   0038            DEF SEG = 0
 06BC   0038            sg = PEEK(&H67 * 4 + 2) + 256& * PEEK(&H67 * 4 + 3)
 06BC   0038            s = ""
 06BC   0038            IF sg <> 0 THEN s = PeekStr$(sg, 10, 8)
 075A   0038            IF s = "EMMXXXX0" THEN
 075A   0038                    vi = &H67
 075A   0038                    r.ax = &H4200
 075A   0038                    CALL INTERRUPT(vi, r, r0)
 0787   0038                    PRINT #fh, "EMS: present, free pages" + STR$(r0
                .bx) + " of" + STR$(r0.dx) + " (16 KB each)"
 0787   0038            ELSE
 07CD   0038                    PRINT #fh, "EMS: none (not needed for uGL modes
                )"
 07CD   0038            END IF
 07DE   0038            '----- VESA info block (4F00h): signature, version, OEM
                , memory, mode list
 07DE   0038            FOR i = 0 TO 255: vbuf(i) = 0: NEXT
 0802   0038            rx.ax = &H4F00: rx.bx = 0: rx.cx = 0: rx.dx = 0
 0802   0038            CALL VbeCall(fh, "4F00 info", rx)
 083D   0038            IF rx.ax = &H4F THEN
 083D   0038                    s = CHR$(VBb%(0)) + CHR$(VBb%(1)) + CHR$(VBb%(2
                )) + CHR$(VBb%(3))
 083D   0038                    PRINT #fh, "  sig " + s + " vbe " + LTRIM$(STR$
                (VBb%(5))) + "." + LTRIM$(STR$(VBb%(4))) + " caps " + HEX$(VBb%
                (10)) + " total vram KB" + STR$(VBw&(18) * 64)
 083D   0038                    PRINT #fh, "  oem: " + PeekStr$(VBw&(8), VBw&(6
                ), 40)
 083D   0038                    sg = VBw&(16): ofs = VBw&(14): s = ""
 083D   0038                    FOR k = 0 TO 47
 0A8E   0038                            DEF SEG = sg
