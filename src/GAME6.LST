 2328   0052    '----- CRTC register read / write (index at 3D4h, data at 3D5h)
 2328   0052    FUNCTION CrtcR% (idx AS INTEGER)
 2333   0052            OUT &H3D4, idx
 2333   0052            CrtcR% = INP(&H3D5)
 2333   0052    END FUNCTION
