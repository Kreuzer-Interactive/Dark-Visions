 2091   0038            IF v = 0 THEN np = 1: v = uglSetVideoDC(UGL.8BIT, xr, y
                r, np)
 212F   0038            k2 = (v <> 0)
 212F   0038            IF v = 0 THEN
 212F   0038                    CALL VgaDiag(k1, k2, -1)
 2175   0038                    xr = 320: yr = 200: v = uglSetVideoDC(UGL.8BIT,
