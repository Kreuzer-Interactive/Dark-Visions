 1D91   0038    
 1D91   0038    '----- turn to view n with a fade through black (the page-flip 
                effect)
 1D91   0038    SUB PageTurn (n AS INTEGER)
 1D9C   0038            DIM i AS INTEGER
 1D9C   0038            IF n < 0 OR n > mNPages - 1 OR n = mPage THEN EXIT SUB
 1DCB   0038            FOR i = 10 TO 0 STEP -1
 1DD2   0038                    CALL VgaSync
 1DD7   0038                    CALL VgaPalApply(i * 16 \ 10)
 1DF4   0038            NEXT
 1DFF   0038            CALL VgaPalBlack
 1E04   0038            IF LoadView%(n) = 0 THEN i = LoadView%(mPage)
 1E2A   0038            FOR i = 0 TO 10
 1E30   0038                    CALL VgaSync
 1E35   0038                    CALL VgaPalApply(i * 16 \ 10)
 1E52   0038            NEXT
 1E5E   0038    END SUB
 1E66   0038    
 1E66   0038    '----- VgaOpen: uglInit once + remember the caller's BIOS mode,
                 then set the mode.
 1E66   0038    '----- pref = 640 -> VESA 640x480x256 one page -> 320x200 (the 
                manual);
 1E66   0038    '----- pref = 800 -> VESA 800x600x256 one page -> 640x480x1 -> 
                320x200 (legacy);
 1E66   0038    '----- pref = 0 -> the logo/intro ladder 640x480x2 -> 1 -> 320x
                200 (with VGA.LOG on a miss).
 1E66   0038    FUNCTION VgaOpen& (pref AS INTEGER, xr AS INTEGER, yr AS INTEGE
                R, np AS INTEGER)
 1E71   0038            DIM v AS LONG, r AS RegType, r2 AS RegType, vi AS INTEG
                ER, k1 AS INTEGER, k2 AS INTEGER
 1E71   0038            VgaOpen& = 0
 1E71   0038            IF mInit = 0 THEN
 1E71   0038                    IF NOT uglInit THEN CALL VgaDiag(-2, -2, -1): E
                XIT FUNCTION
 1EBC   0038                    mInit = -1
 1EBC   0038            END IF
 1EC2   0038            vi = &H10
 1EC2   0038            r.ax = &HF00
 1EC2   0038            CALL INTERRUPT(vi, r, r2)
 1EDD   0038            mMode = r2.ax AND 255
 1EDD   0038            IF pref = 640 THEN
 1EDD   0038                    '----- the manual: 640x480x256 one page, drops 
                to 320x200 on a VESA miss
 1EDD   0038                    xr = 640: yr = 480: np = 1
 1EDD   0038                    v = uglSetVideoDC(UGL.8BIT, xr, yr, np)
 1EDD   0038                    IF v = 0 THEN xr = 320: yr = 200: np = 1: v = u
                glSetVideoDC(UGL.8BIT, xr, yr, np)
 1F83   0038                    VgaOpen& = v
