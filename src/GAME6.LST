 1865   0038    '----- the manual: 640x480 full-page view flipper (see the head
                er notes)
 1865   0038    SUB ManualScroll (msen AS SINGLE)
 1870   0038            DIM xr AS INTEGER, yr AS INTEGER, np AS INTEGER, i AS I
                NTEGER, k AS STRING, code AS INTEGER
 1870   0038            DIM mx AS INTEGER, my AS INTEGER, mb AS INTEGER, wasDow
                n AS INTEGER
 1870   0038            DIM r AS RegType, r2 AS RegType, mi AS INTEGER, lf2 AS 
                INTEGER
 1870   0038            REDIM mPal(0 TO 255) AS tRGB
 1888   0038            '----- no manual installed (SETUP skipped disk 2): quie
                t no-op, stay in the game
 1888   0038            IF NOT FileExists%("manp00.bmp") THEN EXIT SUB
 18B6   0038            mv = VgaOpen&(640, xr, yr, np)
 18B6   0038            IF mv = 0 THEN EXIT SUB
 18FA   0038            IF xr <> 640 THEN CALL ManualSimple(mv, xr, np): EXIT S
                UB
 1918   0038            '----- count the composed views MANP00.. on disk
 1918   0038            mNPages = 0
 1918   0038            FOR i = 0 TO 29
 1924   0038                    IF FileExists%("manp" + RIGHT$("0" + LTRIM$(STR
                $(i)), 2) + ".bmp") THEN mNPages = i + 1 ELSE EXIT FOR
 1990   0038            NEXT
 199C   0038            IF mNPages = 0 THEN CALL VgaClose: EXIT SUB
 19AE   0038            uglSetWrkPage 0
 19B6   0038            uglSetVisPage 0
 19BE   0038            CALL VgaPalBlack
 19C3   0038            IF LoadView%(0) = 0 THEN CALL VgaClose: EXIT SUB
 19E5   0038            '----- MANOK.LOG: one line per open (views, mode, free 
                heap) - field diagnostic
 19E5   0038            lf2 = FREEFILE
 19E5   0038            OPEN "manok.log" FOR APPEND AS #lf2
 19E5   0038            PRINT #lf2, "manual open: views" + STR$(mNPages) + " mo
                de" + STR$(xr) + "x" + STR$(yr) + " free" + STR$(FRE(-1))
 19E5   0038            CLOSE #lf2
 19E5   0038            '----- mouse: range to the 640x480 screen, driver curso
                r hidden (we click page halves)
 19E5   0038            mMouse = 0
 19E5   0038            IF msen = 1 THEN
 19E5   0038                    mi = &H33
 19E5   0038                    r.ax = 7: r.cx = 0: r.dx = 639: CALL INTERRUPT(
                mi, r, r2)
