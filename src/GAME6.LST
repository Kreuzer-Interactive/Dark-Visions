 1AC3   0038                    r.ax = 8: r.cx = 0: r.dx = 479: CALL INTERRUPT(
                mi, r, r2)
 1AE3   0038                    r.ax = 2: CALL INTERRUPT(mi, r, r2)
 1AF9   0038                    mMouse = 1
 1AF9   0038            END IF
 1AFF   0038            FOR i = 0 TO 10
 1B04   0038                    CALL VgaSync
 1B09   0038                    CALL VgaPalApply(i * 16 \ 10)
 1B26   0038            NEXT
 1B32   0038            DO: LOOP WHILE INKEY$ <> ""
 1B32   0038            wasDown = 0
 1B32   0038            DO
 1B48   0038                    k = INKEY$
