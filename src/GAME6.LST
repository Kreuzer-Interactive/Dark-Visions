 107E   0052    SUB VbeCall (fh AS INTEGER, tag AS STRING, rx AS RegTypeX)
 1089   0052            DIM rx2 AS RegTypeX, vi AS INTEGER
 1089   0052            rx.bp = 0: rx.si = 0: rx.flags = 0: rx.ds = -1
