 0590   0052    '----- VGA.LOG report. r1/r2 = the 640x480 two-page / one-page 
                rungs (0 = refused,
 0590   0052    '----- -2 = uglInit itself failed); full = also set mode 101h b
                y hand and try the
 0590   0052    '----- calls uGL needs (logical scanline 1024, display start), 
                then restore mMode.
 0590   0052    SUB VgaDiag (r1 AS INTEGER, r2 AS INTEGER, full AS INTEGER)
 059B   0052            DIM fh AS INTEGER, i AS INTEGER, k AS INTEGER, sg AS LO
                NG, ofs AS LONG, w AS LONG
 059B   0052            DIM rx AS RegTypeX, s AS STRING, r AS RegType, r0 AS Re
                gType, vi AS INTEGER
 059B   0052            REDIM vbuf(0 TO 255) AS INTEGER
 05B3   0052            fh = FREEFILE
 05B3   0052            OPEN "vga.log" FOR APPEND AS #fh
 05B3   0052            PRINT #fh, "--- " + DATE$ + " " + TIME$ + " from bios m
                ode" + STR$(mMode) + " far heap" + STR$(FRE(-1)) + " strings" +
                 STR$(FRE(""))
 05B3   0052            IF r1 = -2 THEN
 05B3   0052                    PRINT #fh, "uglInit FAILED"
 05B3   0052            ELSE
 067D   0052                    PRINT #fh, "uGL 640x480x256 2 pages:" + STR$(r1
                 <> 0) + "  1 page:" + STR$(r2 <> 0) + "  (-1 = ok, 0 = refused
                )"
 067D   0052            END IF
 06D4   0052            '----- EMS driver present? (INT 67h vector -> device he
                ader "EMMXXXX0")
 06D4   0052            DEF SEG = 0
 06D4   0052            sg = PEEK(&H67 * 4 + 2) + 256& * PEEK(&H67 * 4 + 3)
 06D4   0052            s = ""
 06D4   0052            IF sg <> 0 THEN s = PeekStr$(sg, 10, 8)
 0772   0052            IF s = "EMMXXXX0" THEN
 0772   0052                    vi = &H67
 0772   0052                    r.ax = &H4200
 0772   0052                    CALL INTERRUPT(vi, r, r0)
 079F   0052                    PRINT #fh, "EMS: present, free pages" + STR$(r0
                .bx) + " of" + STR$(r0.dx) + " (16 KB each)"
 079F   0052            ELSE
 07E5   0052                    PRINT #fh, "EMS: none (not needed for uGL modes
                )"
 07E5   0052            END IF
 07F6   0052            '----- VESA info block (4F00h): signature, version, OEM
                , memory, mode list
 07F6   0052            FOR i = 0 TO 255: vbuf(i) = 0: NEXT
 081A   0052            rx.ax = &H4F00: rx.bx = 0: rx.cx = 0: rx.dx = 0
 081A   0052            CALL VbeCall(fh, "4F00 info", rx)
