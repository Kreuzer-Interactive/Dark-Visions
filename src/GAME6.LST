 1678   0052    
 1678   0052    '----- 256 BGRA entries at file offset 55 (54-byte header) -> m
                Pal()
 1678   0052    SUB VgaPalLoad (bmp AS STRING)
 1683   0052            DIM i AS INTEGER, fh AS INTEGER, s AS STRING
 1683   0052            fh = FREEFILE
 1683   0052            OPEN bmp FOR BINARY AS #fh
 1683   0052            SEEK #fh, 55
 1683   0052            s = INPUT$(1024, #fh)
 1683   0052            CLOSE #fh
 1683   0052            FOR i = 0 TO 255
 16D2   0052                    mPal(i).blue = MID$(s, i * 4 + 1, 1)
 16D2   0052                    mPal(i).green = MID$(s, i * 4 + 2, 1)
 16D2   0052                    mPal(i).red = MID$(s, i * 4 + 3, 1)
 16D2   0052            NEXT
