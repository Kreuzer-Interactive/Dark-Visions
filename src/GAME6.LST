                )) + CHR$(VBb%(3))
 0855   0052                    PRINT #fh, "  sig " + s + " vbe " + LTRIM$(STR$
                (VBb%(5))) + "." + LTRIM$(STR$(VBb%(4))) + " caps " + HEX$(VBb%
                (10)) + " total vram KB" + STR$(VBw&(18) * 64)
