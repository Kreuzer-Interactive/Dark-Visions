 1F92   0038                    xr = 800: yr = 600: np = 1
 1F92   0038                    v = uglSetVideoDC(UGL.8BIT, xr, yr, np)
 1F92   0038                    IF v = 0 THEN xr = 640: yr = 480: np = 1: v = u
                glSetVideoDC(UGL.8BIT, xr, yr, np)
 202F   0038                    IF v = 0 THEN xr = 320: yr = 200: np = 1: v = u
                glSetVideoDC(UGL.8BIT, xr, yr, np)
