 1365   0038            DIM t9 AS SINGLE, d9 AS SINGLE
 1365   0038            t9 = TIMER
 1365   0038            DO
 1376   0038                    IF INKEY$ <> "" THEN EXIT DO
 138A   0038                    d9 = TIMER - t9: IF d9 < 0 THEN d9 = d9 + 86400
 13C2   0038            LOOP WHILE d9 < secs
 13D6   0038    END SUB
