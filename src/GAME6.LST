 1F03   0052    '----- turn to view n: horizontal nudge-slide where the mode al
                lows it, else a fade
 1F03   0052    SUB PageTurn (n AS INTEGER)
 1F0E   0052            DIM i AS INTEGER
 1F0E   0052            IF n < 0 OR n > mNPages - 1 OR n = mPage THEN EXIT SUB
 1F3D   0052            IF gSlide THEN CALL SlideTo(n): EXIT SUB
 1F52   0052            '----- fallback (320x200, or a mode with no scroll marg
                in): fade through the bg
 1F52   0052            FOR i = 10 TO 0 STEP -1
 1F58   0052                    CALL VgaSync
 1F5D   0052                    CALL VgaPalApply(i * 16 \ 10)
 1F7A   0052            NEXT
 1F85   0052            CALL VgaPalApply(0)
 1F93   0052            IF LoadView%(n) = 0 THEN i = LoadView%(mPage)
 1FB9   0052            FOR i = 0 TO 10
 1FBE   0052                    CALL VgaSync
 1FC3   0052                    CALL VgaPalApply(i * 16 \ 10)
 1FE0   0052            NEXT
 1FEC   0052    END SUB
 1FF4   0052    
 1FF4   0052    '----- the horizontal page turn (proven on the 486SX - FPU-free
                ): nudge the current
 1FF4   0052    '----- page LEFT a few px while fading to black, load the next 
                page unseen, then slide
 1FF4   0052    '----- it in from the left back to normal while fading up. Scro
                llX moves the display
 1FF4   0052    '----- start by direct CRTC writes (VESA's 4F07h is broken on t
                he target Cirrus), and
 1FF4   0052    '----- a few px only needs the standard VGA CR0C/CR0D, so it wo
                rks on any VGA card.
 1FF4   0052    SUB SlideTo (n AS INTEGER)
 1FFF   0052            DIM i AS INTEGER, nud AS INTEGER, steps AS INTEGER
 1FFF   0052            '----- nud = px of horizontal travel; steps = fade gran
                ularity. Fewer steps and no
 1FFF   0052            '----- extra hold (SlideFrame is already retrace-paced)
                 = a snappier turn. Tune here.
 1FFF   0052            nud = 16: steps = 3
 1FFF   0052            FOR i = 0 TO steps
 2014   0052                    CALL SlideFrame(nud * i \ steps, (steps - i) * 
                16 \ steps)
 2040   0052            NEXT
 204C   0052            IF LoadView%(n) = 0 THEN IF LoadView%(mPage) = 0 THEN E
                XIT SUB
 2075   0052            FOR i = 0 TO steps
 2080   0052                    CALL SlideFrame(nud * (steps - i) \ steps, i * 
                16 \ steps)
 20AE   0052            NEXT
 20BA   0052            CALL ScrollX(0)
 20C8   0052    END SUB
 20D0   0052    
 20D0   0052    '----- one flicker-free slide frame: compute the faded palette 
                OFF-screen (the slow
 20D0   0052    '----- part - string math over 256 colours), then in the vertic
                al blank do ONLY the
                                                                      PAGE  33
                                                                      22 Sep 26
                                                                      13:59:26
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 20D0   0052    '----- fast register writes: move the display start (the scroll
                ) and load the DAC. So
 20D0   0052    '----- the palette never changes while the beam is drawing the 
                picture.
 20D0   0052    SUB SlideFrame (px AS INTEGER, f AS INTEGER)
 20DB   0052            DIM u AS INTEGER
 20DB   0052            CALL VgaPalCalc(f)
 20E3   0052            IF gUnit = 0 THEN gUnit = 1
 20F3   0052            u = px \ gUnit
 20F3   0052            WAIT &H3DA, 8, 8
 20F3   0052            WAIT &H3DA, 8
 20F3   0052            CALL CrtcW(&HC, (u \ 256) AND 255)
 2135   0052            CALL CrtcW(&HD, u AND 255)
 2150   0052            uglPalSetBuff 0, 256, pBuf(0)
 2169   0052    END SUB
 2171   0052    
 2171   0052    '----- scale mPal by f/16 into pBuf (no DAC write, no per-frame
                 REDIM - both of which
 2171   0052    '----- would push the actual palette load out of the vertical b
                lank and cause flicker)
 2171   0052    SUB VgaPalCalc (f AS INTEGER)
 217C   0052            DIM i AS INTEGER
 217C   0052            FOR i = 0 TO 255
 2182   0052                    pBuf(i).red = CHR$(bgR + ((ASC(mPal(i).red) - b
                gR) * f) \ 16)
 2182   0052                    pBuf(i).green = CHR$(bgG + ((ASC(mPal(i).green)
                 - bgG) * f) \ 16)
 2182   0052                    pBuf(i).blue = CHR$(bgB + ((ASC(mPal(i).blue) -
                 bgB) * f) \ 16)
 2182   0052            NEXT
 229A   0052    END SUB
 22A2   0052    
 22A2   0052    '----- set the horizontal display start to pixel px (line 0) vi
                a the CRTC, waiting out
 22A2   0052    '----- the retrace so it latches cleanly. Small offsets only to
                uch CR0C/CR0D = plain
 22A2   0052    '----- VGA (every card); gUnit is the mode's byte/word/dword ad
                dressing unit.
 22A2   0052    SUB ScrollX (px AS INTEGER)
 22AD   0052            DIM u AS INTEGER
 22AD   0052            IF gUnit = 0 THEN gUnit = 1
 22BD   0052            u = px \ gUnit
 22BD   0052            WAIT &H3DA, 8, 8
 22BD   0052            CALL CrtcW(&HC, (u \ 256) AND 255)
 22FA   0052            CALL CrtcW(&HD, u AND 255)
 2315   0052            WAIT &H3DA, 8
 2315   0052    END SUB
