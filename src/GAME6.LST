                AS STRING, vis AS INTEGER)
 01C9   0052            DIM bmp AS STRING, hid AS INTEGER
 01C9   0052            bmp = "man" + RIGHT$("0" + LTRIM$(STR$(n)), 2) + sfx + 
                ".bmp"
 01C9   0052            ManPage% = 0
