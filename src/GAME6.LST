 160D   0038    SUB VgaPalBMP (bmp AS STRING)
 1618   0038            REDIM mPal(0 TO 255) AS tRGB
 1630   0038            CALL VgaPalLoad(bmp)
 1638   0038            CALL VgaPalApply(16)
 1646   0038    END SUB
 164E   0038    
 164E   0038    '----- 256 BGRA entries at file offset 55 (54-byte header) -> m
                Pal()
 164E   0038    SUB VgaPalLoad (bmp AS STRING)
 1659   0038            DIM i AS INTEGER, fh AS INTEGER, s AS STRING
 1659   0038            fh = FREEFILE
 1659   0038            OPEN bmp FOR BINARY AS #fh
 1659   0038            SEEK #fh, 55
 1659   0038            s = INPUT$(1024, #fh)
 1659   0038            CLOSE #fh
 1659   0038            FOR i = 0 TO 255
 16A8   0038                    mPal(i).blue = MID$(s, i * 4 + 1, 1)
 16A8   0038                    mPal(i).green = MID$(s, i * 4 + 2, 1)
 16A8   0038                    mPal(i).red = MID$(s, i * 4 + 3, 1)
 16A8   0038            NEXT
 175A   0038            s = ""
 175A   0038    END SUB
