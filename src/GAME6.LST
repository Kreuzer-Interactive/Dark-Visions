 1B98   0038                            SELECT CASE code
 1B98   0038                                    CASE 75, 72, 73: CALL PageTurn(
                mPage - 1)
 1BED   0038                                    CASE 77, 80, 81: CALL PageTurn(
                mPage + 1)
 1C1B   0038                                    CASE 71: CALL PageTurn(0)
 1C35   0038                                    CASE 79: CALL PageTurn(mNPages 
                - 1)
 1C51   0038                            END SELECT
 1C54   0038                    END IF
 1C54   0038                    IF mMouse THEN
