 0B67   0038            FOR i = 0 TO 255: vbuf(i) = 0: NEXT
 0B8A   0038            rx.ax = &H4F01: rx.cx = &H101
 0B8A   0038            CALL VbeCall(fh, "4F01 mode 101h", rx)
 0BBE   0038            IF rx.ax = &H4F THEN
