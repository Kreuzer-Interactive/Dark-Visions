 13DE   0038    
 13DE   0038    '----- mPal() scaled by f/16 into the DAC (16 = as loaded, 0 = 
                black)
 13DE   0038    SUB VgaPalApply (f AS INTEGER)
 13E9   0038            DIM i AS INTEGER
 13E9   0038            REDIM p(0 TO 255) AS tRGB
 1401   0038            FOR i = 0 TO 255
 1406   0038                    p(i).red = CHR$(ASC(mPal(i).red) * f \ 16)
 1406   0038                    p(i).green = CHR$(ASC(mPal(i).green) * f \ 16)
 1406   0038                    p(i).blue = CHR$(ASC(mPal(i).blue) * f \ 16)
