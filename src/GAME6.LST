 02F5   0052    
 02F5   0052    '----- fallback viewer for the one-page / 320x200 rungs: whole 
                page, Left/Right only
 02F5   0052    SUB ManualSimple (v AS LONG, xr AS INTEGER, np AS INTEGER)
 0300   0052            DIM pg AS INTEGER, n AS INTEGER, vis AS INTEGER, k AS S
                TRING, sfx AS STRING
 0300   0052            IF xr = 640 THEN sfx = "h" ELSE sfx = "l"
 0329   0052            vis = 0
 0329   0052            uglSetWrkPage 0
 0336   0052            uglSetVisPage 0
 033E   0052            CALL VgaPalBlack
 0343   0052            pg = 1
 0343   0052            IF ManPage%(v, pg, 1, sfx, vis) = 0 THEN CALL VgaClose:
                 EXIT SUB
 0379   0052            DO: LOOP WHILE INKEY$ <> ""
 037A   0052            DO
 038C   0052                    k = INKEY$
 038C   0052                    IF k = CHR$(9) OR k = CHR$(27) THEN EXIT DO
 03DC   0052                    IF LEN(k) = 2 THEN
 03DC   0052                            n = pg
 03DC   0052                            IF ASC(RIGHT$(k, 1)) = 77 OR ASC(RIGHT$
                (k, 1)) = 81 THEN n = pg + 1
 043F   0052                            IF ASC(RIGHT$(k, 1)) = 75 OR ASC(RIGHT$
                (k, 1)) = 73 THEN n = pg - 1
 048B   0052                            IF n >= 1 AND n <> pg THEN
 048B   0052                                    IF ManPage%(v, n, np, sfx, vis)
                 THEN
 048B   0052                                            pg = n
 048B   0052                                    ELSE
 04D9   0052                                            CALL VgaPalBMP("man" + 
                RIGHT$("0" + LTRIM$(STR$(pg)), 2) + sfx + ".bmp")
 0535   0052                                    END IF
 0535   0052                            END IF
 0535   0052                    END IF
 0535   0052            LOOP
 0538   0052            CALL VgaPalBlack
 053D   0052            CALL VgaClose
 0542   0052    END SUB
