 1C6F   0038                            IF (mb AND 1) THEN
 1C6F   0038                                    IF wasDown = 0 THEN
 1C6F   0038                                            IF mx < 320 THEN CALL P
                ageTurn(mPage - 1) ELSE CALL PageTurn(mPage + 1)
 1CB2   0038                                    END IF
 1CB2   0038                                    wasDown = -1
 1CB2   0038                            ELSE
 1CBA   0038                                    wasDown = 0
 1CBA   0038                            END IF
 1CBF   0038                    END IF
