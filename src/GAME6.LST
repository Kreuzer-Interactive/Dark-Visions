 2375   0052    
 2375   0052    '----- VgaOpen: uglInit once + remember the caller's BIOS mode,
                 then set the mode.
 2375   0052    '----- pref = 640 -> VESA 640x480x256 one page -> 320x200 (the 
                manual);
 2375   0052    '----- pref = 800 -> VESA 800x600x256 one page -> 640x480x1 -> 
                320x200 (legacy);
 2375   0052    '----- pref = 0 -> the logo/intro ladder 640x480x2 -> 1 -> 320x
                200 (with VGA.LOG on a miss).
 2375   0052    FUNCTION VgaOpen& (pref AS INTEGER, xr AS INTEGER, yr AS INTEGE
                R, np AS INTEGER)
 2380   0052            DIM v AS LONG, r AS RegType, r2 AS RegType, vi AS INTEG
                ER, k1 AS INTEGER, k2 AS INTEGER
 2380   0052            VgaOpen& = 0
 2380   0052            IF mInit = 0 THEN
 2380   0052                    IF NOT uglInit THEN CALL VgaDiag(-2, -2, -1): E
                XIT FUNCTION
 23CB   0052                    mInit = -1
 23CB   0052            END IF
 23D1   0052            vi = &H10
 23D1   0052            r.ax = &HF00
 23D1   0052            CALL INTERRUPT(vi, r, r2)
 23EC   0052            mMode = r2.ax AND 255
 23EC   0052            IF pref = 640 THEN
 23EC   0052                    '----- the manual: 640x480x256 TWO pages (the 1
                024-byte pitch gives the off-
 23EC   0052                    '----- screen margin the horizontal page-slide 
                nudges into) -> one page (fade
 23EC   0052                    '----- turns) -> 320x200 (fade) on a VESA miss
 23EC   0052                    xr = 640: yr = 480: np = 2
 23EC   0052                    v = uglSetVideoDC(UGL.8BIT, xr, yr, np)
 23EC   0052                    IF v = 0 THEN np = 1: v = uglSetVideoDC(UGL.8BI
                T, xr, yr, np)
 2484   0052                    IF v = 0 THEN xr = 320: yr = 200: np = 1: v = u
                glSetVideoDC(UGL.8BIT, xr, yr, np)
 24D7   0052                    VgaOpen& = v
 24D7   0052                    EXIT FUNCTION
 24D7   0052            END IF
 24E6   0052            IF pref = 800 THEN
 24E6   0052                    xr = 800: yr = 600: np = 1
 24E6   0052                    v = uglSetVideoDC(UGL.8BIT, xr, yr, np)
 24E6   0052                    IF v = 0 THEN xr = 640: yr = 480: np = 1: v = u
                glSetVideoDC(UGL.8BIT, xr, yr, np)
 2583   0052                    IF v = 0 THEN xr = 320: yr = 200: np = 1: v = u
                glSetVideoDC(UGL.8BIT, xr, yr, np)
 25D6   0052                    VgaOpen& = v
 25D6   0052                    EXIT FUNCTION
 25D6   0052            END IF
 25E5   0052            xr = 640: yr = 480: np = 2
 25E5   0052            v = uglSetVideoDC(UGL.8BIT, xr, yr, np)
                                                                      PAGE  35
                                                                      22 Sep 26
                                                                      13:59:26
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 25E5   0052            k1 = (v <> 0)
 25E5   0052            IF v = 0 THEN np = 1: v = uglSetVideoDC(UGL.8BIT, xr, y
                r, np)
 2683   0052            k2 = (v <> 0)
 2683   0052            IF v = 0 THEN
 2683   0052                    CALL VgaDiag(k1, k2, -1)
 26C9   0052                    xr = 320: yr = 200: v = uglSetVideoDC(UGL.8BIT,
