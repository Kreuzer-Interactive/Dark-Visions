 11AB   0038    '----- byte / word i of vbuf (unsigned)
 11AB   0038    FUNCTION VBb% (i AS INTEGER)
 11B6   0038            DIM w AS LONG
 11B6   0038            w = vbuf(i \ 2)
 11B6   0038            IF w < 0 THEN w = w + 65536
 11FF   0038            IF (i AND 1) THEN VBb% = w \ 256 ELSE VBb% = w AND 255
 1234   0038    END FUNCTION
 123F   0038    
 123F   0038    FUNCTION VBw& (i AS INTEGER)
 124A   0038            VBw& = VBb%(i) + 256& * VBb%(i + 1)
 124A   0038    END FUNCTION
 129F   0038    
 129F   0038    '----- up to n bytes of text at sg:ofs, stops at a zero byte
 129F   0038    FUNCTION PeekStr$ (sg AS LONG, ofs AS LONG, n AS INTEGER)
 12AA   0038            DIM s AS STRING, k AS INTEGER, b AS INTEGER
 12AA   0038            DEF SEG = sg
 12AA   0038            FOR k = 0 TO n - 1
 12C4   0038                    b = PEEK(ofs + k)
 12C4   0038                    IF b = 0 THEN EXIT FOR
 12E4   0038                    IF b < 32 OR b > 126 THEN b = 46
 1306   0038                    s = s + CHR$(b)
 1306   0038            NEXT
 132E   0038            DEF SEG
 132E   0038            PeekStr$ = s
 132E   0038    END FUNCTION
