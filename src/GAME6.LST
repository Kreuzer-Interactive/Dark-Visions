 1536   0038    
 1536   0038    SUB VgaPalBlack
 1541   0038            DIM i AS INTEGER
 1541   0038            REDIM blk(0 TO 255) AS tRGB
 1559   0038            FOR i = 0 TO 255
 155E   0038                    blk(i).red = CHR$(0): blk(i).green = CHR$(0): b
                lk(i).blue = CHR$(0)
