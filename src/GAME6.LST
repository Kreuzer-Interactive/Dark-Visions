 12B7   0052    '----- up to n bytes of text at sg:ofs, stops at a zero byte
 12B7   0052    FUNCTION PeekStr$ (sg AS LONG, ofs AS LONG, n AS INTEGER)
 12C2   0052            DIM s AS STRING, k AS INTEGER, b AS INTEGER
 12C2   0052            DEF SEG = sg
 12C2   0052            FOR k = 0 TO n - 1
 12DC   0052                    b = PEEK(ofs + k)
 12DC   0052                    IF b = 0 THEN EXIT FOR
 12FC   0052                    IF b < 32 OR b > 126 THEN b = 46
 131E   0052                    s = s + CHR$(b)
 131E   0052            NEXT
 1346   0052            DEF SEG
 1346   0052            PeekStr$ = s
 1346   0052    END FUNCTION
