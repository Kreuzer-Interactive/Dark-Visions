 0A46   0026    SUB drawStats (ob() AS SINGLE, cl AS SINGLE, cr AS SINGLE, font
                Data() AS INTEGER)
 0A51   0026            DIM tmin AS INTEGER, hh AS INTEGER, mm AS INTEGER, pcnt
                 AS INTEGER, i AS INTEGER
 0A51   0026            tmin = INT(cl * cr): hh = 8 + tmin \ 60: mm = tmin - (h
                h - 8) * 60
 0A51   0026            pcnt = 0
 0A51   0026            FOR i = 1 TO 51
 0A94   0026                    IF ob(i) >= 1 THEN pcnt = pcnt + 1
 0ABB   0026            NEXT i
 0AC7   0026            IF ob(36) >= 1 THEN pcnt = pcnt + 2
 0AEC   0026            IF ob(35) >= 1 THEN pcnt = pcnt + 2
 0B11   0026            pcnt = CINT(pcnt * 100 / 47)
 0B11   0026            CALL drawText(49, 11, LTRIM$(STR$(pcnt)) + "%", 2, font
                Data())
 0B79   0026            CALL drawText(278, 11, LTRIM$(STR$(hh)) + ":" + RIGHT$(
                "0" + LTRIM$(STR$(mm)), 2), 2, fontData())
