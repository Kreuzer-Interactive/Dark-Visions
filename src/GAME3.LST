 0030   0006    '----- GAME3.BAS: variable-width small-font renderer (from ART/
                font2.png, proportional ~7px).
 0030   0006    '----- Own 64K code segment. Pure PSET = transparent over backg
                rounds. Pass a CGA attr (0-3) as textColor.
 0030   0006    '----- font file: a HEIGHT line, then per glyph = ASCII code, w
                idth, then <height> rows of width-bit binary.
 0030   0006    '----- fontData(0) = height H; fontData(code*(H+1)) = width; +1
                +row = that row's bits.  DIM fontData(2047) in GAME.BAS.
 0030   0006    '----- gItal = italic flag (module-shared): drawText sets it fr
                om the _ markup, drawChar shears each row by it.
 0030   0006    DIM SHARED gItal AS INTEGER
 0030   0006    '----- pw2(n) = 2^n bit-mask LUT (filled in initFontSystem); av
                oids per-pixel floating-point 2^n in drawChar
 0030   0006    DIM SHARED pw2(14) AS INTEGER
 0030   0006    
 0030   0006    '----- load font.txt: ASCII code, width, then 7 rows
 0030   0006    SUB initFontSystem (fontData() AS INTEGER, fpath AS STRING)
 0040   0026            DIM lineText AS STRING
 0040   0026            DIM cc AS INTEGER, wdt AS INTEGER, row AS INTEGER, di A
                S INTEGER, pat AS INTEGER, i AS INTEGER, hh AS INTEGER
 0040   0026            pw2(0) = 1: FOR i = 1 TO 14: pw2(i) = pw2(i - 1) * 2: N
                EXT i
 0063   0026            FOR i = 0 TO 2047
 0068   0026                    fontData(i) = 0
 0068   0026            NEXT i
 0086   0026            CLOSE #1
 0086   0026            OPEN fpath FOR INPUT AS #1
 0086   0026            hgtRead:
 00A4   0026            IF EOF(1) THEN GOTO fsExit
 00B9   0026            LINE INPUT #1, lineText
 00C2   0026            IF LEFT$(lineText, 1) = "#" OR LEN(lineText) = 0 THEN G
                OTO hgtRead
 0111   0026            hh = VAL(lineText): fontData(0) = hh
 0111   0026            DO WHILE NOT EOF(1)
 0136   0026                    LINE INPUT #1, lineText
 0151   0026                    IF LEFT$(lineText, 1) = "#" OR LEN(lineText) = 
                0 THEN GOTO fsMain
 01A3   0026                    cc = VAL(lineText): di = cc * (hh + 1)
 01A3   0026                    fsWid:
 01C2   0026                    IF EOF(1) THEN GOTO fsMain
 01D7   0026                    LINE INPUT #1, lineText
 01E0   0026                    IF LEFT$(lineText, 1) = "#" OR LEN(lineText) = 
                0 THEN GOTO fsWid
 022F   0026                    wdt = VAL(lineText): fontData(di) = wdt
 022F   0026                    FOR row = 0 TO hh - 1
 0262   0026                            fsRow:
 0262   0026                            IF EOF(1) THEN EXIT FOR
 0277   0026                            LINE INPUT #1, lineText
 0280   0026                            IF LEFT$(lineText, 1) = "#" OR LEN(line
                Text) = 0 THEN GOTO fsRow
 02CF   0026                            lineText = LTRIM$(RTRIM$(lineText))
 02CF   0026                            pat = 0
 02CF   0026                            FOR i = 1 TO LEN(lineText)
 0300   0026                                    IF MID$(lineText, i, 1) = "1" T
                                                                      PAGE   2
                                                                      25 Aug 26
                                                                      17:32:11
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

                HEN pat = pat + pw2(LEN(lineText) - i)
 0336   0026                            NEXT i
 0342   0026                            fontData(di + 1 + row) = pat
 0342   0026                    NEXT row
 036D   0026                    fsMain:
 036D   0026            LOOP
 0376   0026            fsExit:
 0376   0026            CLOSE #1
 0376   0026    END SUB
 0396   0026    
 0396   0026    '----- draw one glyph (variable width); each of 7 rows holds (w
                idth) bits, MSB = leftmost pixel
 0396   0026    SUB drawChar (x AS INTEGER, y AS INTEGER, char AS STRING, textC
                olor AS INTEGER, fontData() AS INTEGER)
 03A1   0026            DIM cc AS INTEGER, di AS INTEGER, w AS INTEGER, r AS IN
                TEGER, c AS INTEGER, pat AS INTEGER, hh AS INTEGER, sh AS INTEG
                ER
 03A1   0026            DIM bit AS INTEGER, msb AS INTEGER
 03A1   0026            hh = fontData(0)
 03A1   0026            cc = ASC(char): di = cc * (hh + 1): w = fontData(di)
 03A1   0026            IF w = 0 THEN EXIT SUB
 03DD   0026            msb = pw2(w - 1)
 03DD   0026            FOR r = 0 TO hh - 1
 03F6   0026                    pat = fontData(di + 1 + r)
 03F6   0026                    IF pat <> 0 THEN
 03F6   0026                            IF gItal <> 0 THEN sh = (hh - 1 - r) \ 
                5 ELSE sh = 0
 0438   0026                            bit = msb
 0438   0026                            FOR c = 0 TO w - 1
 044A   0026                                    IF (pat AND bit) <> 0 THEN PSET
                 (x + c + sh, y + r), textColor
 0478   0026                                    bit = bit \ 2
 0478   0026                            NEXT c
 0490   0026                    END IF
 0490   0026            NEXT r
 049F   0026    END SUB
 04A7   0026    
 04A7   0026    '----- underline cols x0..x1 at row uy, leaving 1px black on ea
                ch side of any glyph pixel (descender tails). POINT-based, assu
                mes black bg (message bar).
 04A7   0026    SUB drawUnder (x0 AS INTEGER, x1 AS INTEGER, uy AS INTEGER, col
                 AS INTEGER)
 04B2   0026            DIM ux AS INTEGER, gp AS INTEGER, gc AS INTEGER, gn AS 
                INTEGER
 04B2   0026            gp = 0
 04B2   0026            FOR ux = x0 TO x1
 04C8   0026                    IF POINT(ux, uy) <> 0 THEN gc = 1 ELSE gc = 0
 04E7   0026                    IF POINT(ux + 1, uy) <> 0 THEN gn = 1 ELSE gn =
                 0
 050A   0026                    IF gp = 0 AND gc = 0 AND gn = 0 THEN PSET (ux, 
                uy), col
 054A   0026                    gp = gc
 054A   0026            NEXT ux
 055F   0026    END SUB
