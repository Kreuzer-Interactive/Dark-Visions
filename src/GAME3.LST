Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

                HEN pat = pat + pw2(LEN(lineText) - i)
 0336   0026                            NEXT i
 0342   0026                            fontData(di + 1 + row) = pat
 0342   0026                    NEXT row
 036D   0026                    fsMain:
 036D   0026            LOOP
 0376   0026            fsExit:
 0376   0026            CLOSE #1
 0376   0026    END SUB
 0396   0026    
 0396   0026    '----- draw one glyph (variable width); each of 7 rows holds (w
                idth) bits, MSB = leftmost pixel
 0396   0026    SUB drawChar (x AS INTEGER, y AS INTEGER, char AS STRING, textC
                olor AS INTEGER, fontData() AS INTEGER)
 03A1   0026            DIM cc AS INTEGER, di AS INTEGER, w AS INTEGER, r AS IN
                TEGER, c AS INTEGER, pat AS INTEGER, hh AS INTEGER, sh AS INTEG
                ER
 03A1   0026            DIM bit AS INTEGER, msb AS INTEGER
 03A1   0026            hh = fontData(0)
 03A1   0026            cc = ASC(char): di = cc * (hh + 1): w = fontData(di)
 03A1   0026            IF w = 0 THEN EXIT SUB
 03DD   0026            msb = pw2(w - 1)
 03DD   0026            FOR r = 0 TO hh - 1
 03F6   0026                    pat = fontData(di + 1 + r)
 03F6   0026                    IF pat <> 0 THEN
 03F6   0026                            IF gItal <> 0 THEN sh = (hh - 1 - r) \ 
                5 ELSE sh = 0
 0438   0026                            bit = msb
 0438   0026                            FOR c = 0 TO w - 1
 044A   0026                                    IF (pat AND bit) <> 0 THEN PSET
                 (x + c + sh, y + r), textColor
 0478   0026                                    bit = bit \ 2
 0478   0026                            NEXT c
 0490   0026                    END IF
 0490   0026            NEXT r
 049F   0026    END SUB
 04A7   0026    
 04A7   0026    '----- underline cols x0..x1 at row uy, leaving 1px black on ea
                ch side of any glyph pixel (descender tails). POINT-based, assu
                mes black bg (message bar).
 04A7   0026    SUB drawUnder (x0 AS INTEGER, x1 AS INTEGER, uy AS INTEGER, col
                 AS INTEGER)
 04B2   0026            DIM ux AS INTEGER, gp AS INTEGER, gc AS INTEGER, gn AS 
                INTEGER
 04B2   0026            gp = 0
 04B2   0026            FOR ux = x0 TO x1
 04C8   0026                    IF POINT(ux, uy) <> 0 THEN gc = 1 ELSE gc = 0
 04E7   0026                    IF POINT(ux + 1, uy) <> 0 THEN gn = 1 ELSE gn =
                 0
 050A   0026                    IF gp = 0 AND gc = 0 AND gn = 0 THEN PSET (ux, 
                uy), col
 054A   0026                    gp = gc
 054A   0026            NEXT ux
 055F   0026    END SUB
