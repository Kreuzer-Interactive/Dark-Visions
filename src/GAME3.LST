 0567   0026    
 0567   0026    '----- draw a string left-to-right; each glyph advances by its 
                own width + 1px, space = 4px
 0567   0026    SUB drawText (x AS INTEGER, y AS INTEGER, text AS STRING, textC
                olor AS INTEGER, fontData() AS INTEGER)
 0572   0026            DIM i AS INTEGER, cx AS INTEGER, cc AS INTEGER, w AS IN
                TEGER, hh AS INTEGER, curcol AS INTEGER, ulOn AS INTEGER, ulSta
                rt AS INTEGER
 0572   0026            hh = fontData(0): cx = x: curcol = textColor: gItal = 0
                : ulOn = 0
 0572   0026            FOR i = 1 TO LEN(text)
 05B0   0026                    cc = ASC(MID$(text, i, 1))
 05B0   0026                    IF cc = 126 THEN
 05B0   0026                            IF curcol = textColor THEN curcol = 2 E
                LSE curcol = textColor
 05EB   0026                    ELSEIF cc = 95 THEN
 05EE   0026                            IF gItal = 0 THEN gItal = 1 ELSE gItal 
                = 0
 0610   0026                    ELSEIF cc = 124 THEN
 0613   0026                            IF ulOn = 0 THEN
 0613   0026                                    ulOn = 1: ulStart = cx
 0613   0026                            ELSE
 0633   0026                                    ulOn = 0: CALL drawUnder(ulStar
                t, cx - 2, y + hh - 1, curcol)
 0662   0026                            END IF
 0662   0026                    ELSEIF cc = 32 THEN
 0665   0026                            cx = cx + 4
 0665   0026                    ELSE
 0675   0026                            CALL drawChar(cx, y, MID$(text, i, 1), 
                curcol, fontData())
 06AE   0026                            w = fontData(cc * (hh + 1)): IF w = 0 T
                HEN w = 3
 06D4   0026                            cx = cx + w + 1
 06D4   0026                    END IF
 06DE   0026            NEXT i
 06ED   0026            gItal = 0
 06ED   0026    END SUB
 06FB   0026    
 06FB   0026    '----- pixel width of a string (for proportional word-wrap)
 06FB   0026    FUNCTION textWidth (text AS STRING, fontData() AS INTEGER)
 0706   0026            DIM i AS INTEGER, cc AS INTEGER, w AS INTEGER, tot AS I
                NTEGER, hh AS INTEGER
 0706   0026            hh = fontData(0): tot = 0
 0706   0026            FOR i = 1 TO LEN(text)
 072E   0026                    cc = ASC(MID$(text, i, 1))
 072E   0026                    IF cc = 32 THEN
 072E   0026                            tot = tot + 4
 072E   0026                    ELSEIF cc <> 126 AND cc <> 95 AND cc <> 124 THE
                N
 0753   0026                            w = fontData(cc * (hh + 1)): IF w = 0 T
                HEN w = 3
 07A2   0026                            tot = tot + w + 1
 07A2   0026                    END IF
 07AC   0026            NEXT i
                                                                      PAGE   4
                                                                      25 Aug 26
                                                                      17:32:11
Offset  Data    Source Line      Microsoft (R) QuickBASIC Compiler Version 4.50

 07BB   0026            textWidth = tot
 07BB   0026    END FUNCTION
 07D6   0026    
 07D6   0026    '----- draw a string word-wrapped to maxpx pixels/line (collaps
                es space runs); a backslash forces a line break, two backslashe
                s = a blank line
 07D6   0026    SUB drawWrap (x AS INTEGER, y AS INTEGER, txt AS STRING, col AS
                 INTEGER, maxpx AS INTEGER, lineh AS INTEGER, fontData() AS INT
                EGER)
 07E1   0026            DIM cy AS INTEGER, i AS INTEGER, ch AS STRING, word AS 
                STRING, ln AS STRING, ww AS INTEGER, lw AS INTEGER, brc AS STRI
                NG
 07E1   0026            cy = y: ln = "": lw = 0: word = "": brc = CHR$(92)
 07E1   0026            FOR i = 1 TO LEN(txt) + 1
 082E   0026                    IF i <= LEN(txt) THEN ch = MID$(txt, i, 1) ELSE
                 ch = " "
 0867   0026                    IF ch = " " OR ch = brc THEN
 0867   0026                            IF LEN(word) > 0 THEN
 0867   0026                                    ww = textWidth(word, fontData()
                )
 0867   0026                                    IF lw = 0 THEN
 0867   0026                                            ln = word: lw = ww
 0867   0026                                    ELSEIF lw + 4 + ww > maxpx THEN
 08E7   0026                                            CALL drawText(x, cy, ln
                , col, fontData()): cy = cy + lineh: ln = word: lw = ww
 0910   0026                                    ELSE
 092E   0026                                            ln = ln + " " + word: l
                w = lw + 4 + ww
 092E   0026                                    END IF
 095B   0026                                    word = ""
 095B   0026                            END IF
 0968   0026                            IF ch = brc THEN
 0968   0026                                    CALL drawText(x, cy, ln, col, f
                ontData())
 0990   0026                                    '----- a blank row (double back
                slash) advances HALF a line: paragraph
 0990   0026                                    '----- gaps stay clear while lo
                ng book pages still fit 200 rows
 0990   0026                                    IF LEN(ln) = 0 THEN cy = cy + l
                ineh \ 2 ELSE cy = cy + lineh
 09B9   0026                                    ln = "": lw = 0
 09B9   0026                            END IF
 09CB   0026                    ELSE
 09CE   0026                            word = word + ch
 09CE   0026                    END IF
 09E5   0026            NEXT i
 09F4   0026            IF LEN(ln) > 0 THEN CALL drawText(x, cy, ln, col, fontD
                ata())
 0A1A   0026    END SUB
