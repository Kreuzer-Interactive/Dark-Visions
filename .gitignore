# QB45/LINK build intermediates (regenerated by every build; EXEs stay tracked)
src/**/*.OBJ
src/**/*.obj
src/**/*.LST
src/**/*.lst
src/**/*.MAP
src/**/*.map
src/BUILD.LOG
src/**/*BUILD.LOG
src/**/*BLD.LOG
# uGL library stub objects are inputs, not outputs
!src/ugl/stubs/*.obj

# game-run outputs and the shadow cache the game writes itself
# (*.TMP: far-heap pools and page art parked on disk while a full-screen page is up)
src/*.TMP
src/C3D.LOG
src/C3DTEST.LOG
src/tools/C3DTES_B.LOG
src/SHADW2.BIN
src/tools/hill_drive_frames.png
src/C3DTAB.DAT
src/JOED.BIN

# debug output: the hill-drive frame dumps (C3DDUMP=2) and tool build logs
src/C3DHILL*.BMP
src/tools/*_B.LOG

# the 3D man's test shots (M3DUMP: M3SHOT*, M3HALL*, M3SHAD*) and the PC-speaker / vector probes' outputs
src/M3SHOT*.PIC
src/M3HALL*.PIC
src/M3SHAD*.PIC
src/tools/SNDPROBE.LOG
src/tools/SPKPROBE.LOG
src/tools/VECPROBE.LOG
src/tools/VECPROBE.EXE
src/tools/VECPROBE.LNK
